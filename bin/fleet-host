#!/usr/bin/env python3
"""fleet-host — per-peer shortcut. Symlinked as `hertsi`, `esarmbp`, `olga` (the
peer alias IS the command name). Typing the bare host name does the common thing;
a verb after it picks another action.

  hertsi               → mount the MacPro in Finder (fleet-files finder)
  hertsi screen        → Screen Sharing
  hertsi wake          → Wake-on-LAN via the Mini
  hertsi find <term>   → search its file index (instant, works while asleep)
  hertsi ls [path]     → list a remote dir
  hertsi shell         → ssh in

All routed through the Mini over Tailscale, so it works home or away.
"""
import os, sys, subprocess

ME = os.path.basename(sys.argv[0])           # the peer alias = this command's name
BIN = os.path.dirname(os.path.realpath(__file__))
FF = os.path.join(BIN, "fleet-files")
args = sys.argv[1:]
verb = args[0] if args else "finder"
rest = args[1:]

if verb in ("finder", "screen", "ls", "mount", "index", "wake"):
    cmd = [FF, verb, ME] + rest
elif verb == "find":
    cmd = [FF, "find"] + rest + ["--peer", ME]
elif verb in ("shell", "ssh"):
    cmd = ["ssh", ME] + rest
else:                                         # bare unknown arg → treat as a find
    cmd = [FF, "find", verb, "--peer", ME] if args else [FF, "finder", ME]

sys.exit(subprocess.run(cmd).returncode)
