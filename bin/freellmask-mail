#!/usr/bin/env python3
"""freellmask-mail — an email research agent on AgentMail, answered by FreeLLMAPI.

Polls an AgentMail inbox; for each NEW inbound email it runs research through the
FreeLLMAPI gateway (free-tier models, $0) and sends a THREADED reply as HTML, so
the answer renders with real bold/headings/lists in any mail client. Replying to
that email continues the conversation (the bot pulls prior thread messages as
context). No public URL needed — pure polling. Runs as a Cloudcity-Boot pane.

  freellmask-mail poll          # one cycle (for cron/testing)
  freellmask-mail loop          # continuous (the pane runs this)
  freellmask-mail status        # config + seen count + last poll

Secrets / config (never in git):
  AGENTMAIL_API_KEY  or  ~/.agentmail.key      (the am_... key from console.agentmail.to)
  AGENTMAIL_INBOX    (default below)           (the am_us_inbox_... id)
  FM_FREE_KEY / ~/.fm-free.key                 (FreeLLMAPI unified key — the research brain)
  FM_FREE_HOST       (default cloudcity Mini :3001)
"""
# FEATURE-CARD >> features/freellmask-mail-anti-loop-and-video-gate.feature
import atexit, base64, json, os, re, shutil, subprocess, sys, tempfile, time, urllib.parse, urllib.request, urllib.error, uuid
from pathlib import Path

def enc(s):  # message_ids look like <...@email.amazonses.com> — must be URL-encoded in the path
    return urllib.parse.quote(s, safe="")

AM_BASE   = "https://api.agentmail.to/v0"
INBOX     = os.environ.get("AGENTMAIL_INBOX", "cloudcity-llm@agentmail.to")
STATE     = Path(os.environ.get("FREELLMASK_MAIL_STATE", Path.home()/"work"/"comms"/"queue"/"freellmask-mail-state.json"))
POLL_SEC  = int(os.environ.get("FREELLMASK_MAIL_POLL", "45"))
FM_HOST   = os.environ.get("FM_FREE_HOST", "http://cloudcitymacmini:3001/v1")
FM_MODEL  = os.environ.get("FREELLMASK_MAIL_MODEL", "nemotron-3-super-120b")
# Big-context escalation: nemotron holds ~256k tokens. When the assembled context (attachments +
# wiki + thread + question) is large, escalate that call to Gemini's 1M window AND stop truncating,
# so a whole book/paper emailed in is read IN FULL instead of clipped. nemotron stays the default.
BIG_MODEL     = os.environ.get("FREELLMASK_MAIL_BIG_MODEL", "gemini-2.5-flash")
BIG_CTX_CHARS = int(os.environ.get("FREELLMASK_MAIL_BIG_CHARS", "180000"))   # ~45k tokens → escalate
BIG_ATT_CAP   = int(os.environ.get("FREELLMASK_MAIL_BIG_ATT_CAP", "2200000")) # ~550k tok of attachments
BIG_WIKI_CAP  = int(os.environ.get("FREELLMASK_MAIL_BIG_WIKI_CAP", "400000"))  # ~100k tok of wiki
SMALL_ATT_CAP = 24000
SMALL_WIKI_CAP= 16000
BCC       = os.environ.get("FREELLMASK_MAIL_BCC", "esaruoho@gmail.com")   # blind-copy every outbound reply
FORWARD_TO= os.environ.get("FREELLMASK_MAIL_FORWARD", "esaruoho@gmail.com")  # forward inbound + answer + attachments here
VISION_OCR= Path.home()/"work"/"apple"/"bin"/"vision-ocr"                  # Apple Vision OCR (PDFs + images, on the Mini)
MAX_ATT   = int(os.environ.get("FREELLMASK_MAIL_MAX_ATT_MB","25"))*1024*1024
MAX_CHARS = int(os.environ.get("FREELLMASK_MAIL_MAX_ATT_CHARS","12000"))   # per-attachment text cap (free-tier context)

def env_bool(name, default="1"):
    return str(os.environ.get(name, default)).strip().lower() in {"1", "true", "yes", "on"}

def lens_voices_enabled():
    return env_bool("FREE_ENERGY_LENS_VOICES", "1")

def _read_key(env, path):
    k = os.environ.get(env, "")
    if not k and Path(path).expanduser().exists(): k = Path(path).expanduser().read_text().strip()
    return k
def am_key():
    k=_read_key("AGENTMAIL_API_KEY","~/.agentmail.key")
    if not k: sys.exit("freellmask-mail: no AgentMail key (AGENTMAIL_API_KEY or ~/.agentmail.key)")
    return k
def fm_key():
    k=_read_key("FM_FREE_KEY","~/.fm-free.key")
    if not k: sys.exit("freellmask-mail: no FreeLLMAPI key (~/.fm-free.key)")
    return k

def http(url, key, method="GET", body=None):
    data=json.dumps(body).encode() if body is not None else None
    req=urllib.request.Request(url, data=data, method=method,
        headers={"Authorization":f"Bearer {key}","Content-Type":"application/json"})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=120) as r: return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code==429 and attempt<2: time.sleep(5*(attempt+1)); continue
            raise
        except urllib.error.URLError:
            if attempt<2: time.sleep(3); continue
            raise

# ── attachments: text/markdown read directly; PDF + images via on-Mini Apple Vision OCR ──
def _att_bytes(k, mid, att_id):
    meta=http(f"{AM_BASE}/inboxes/{INBOX}/messages/{enc(mid)}/attachments/{enc(att_id)}", k)
    url=meta.get("download_url")
    if not url: return None
    with urllib.request.urlopen(url, timeout=90) as r: return r.read()   # signed URL — no auth header

def _extract_one(k, mid, att):
    name=att.get("filename","attachment"); ct=(att.get("content_type") or "").lower()
    size=att.get("size") or 0; low=name.lower()
    if size>MAX_ATT: return name, f"[skipped: {size//1024//1024}MB exceeds {MAX_ATT//1024//1024}MB limit]"
    aid=att.get("attachment_id")
    if not aid: return name, "[no attachment_id]"
    try: raw=_att_bytes(k, mid, aid)
    except Exception as e: return name, f"[download failed: {e}]"
    if raw is None: return name, "[no download url]"
    # text / markdown / json / xml → decode directly (no OCR)
    if ct.startswith("text/") or low.endswith((".md",".txt",".markdown",".csv")) or ct in ("application/json","application/xml"):
        return name, raw.decode("utf-8","ignore")[:MAX_CHARS]
    # pdf / image → Apple Vision OCR on the Mini (synchronous; handles text PDFs AND scans/images)
    if ct=="application/pdf" or ct.startswith("image/") or low.endswith((".pdf",".png",".jpg",".jpeg",".heic",".tiff",".tif",".gif",".bmp",".webp")):
        suffix=os.path.splitext(name)[1] or (".pdf" if "pdf" in ct else ".png")
        tmp=None
        try:
            with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as tf: tf.write(raw); tmp=tf.name
            cmd=[str(VISION_OCR), tmp] + (["--pages","20"] if suffix.lower()==".pdf" else [])
            out=subprocess.run(cmd, capture_output=True, text=True, timeout=240)
            txt=(out.stdout or "")
            # Drop Vision/TextRecognition framework log noise that can leak into stdout — it must
            # never reach the LLM as if it were document content (the E5-model error bug).
            txt="\n".join(l for l in txt.splitlines()
                          if not re.search(r'(?i)\.mlmodelc|\.bundle|TextRecognition|could not (locate|find)'
                                           r'|MLModel|E5 model|jit\.bundle|universal\.bundle|VK[A-Z]|CRImage', l)).strip()
            return name, (txt[:MAX_CHARS] if txt else "[no readable text found in the image/PDF]")
        except FileNotFoundError:
            return name, "[vision-ocr not available on this host]"
        except Exception as e:
            return name, f"[OCR error: {e}]"
        finally:
            if tmp:
                try: os.unlink(tmp)
                except Exception: pass
    return name, f"[unsupported attachment type: {ct or low}]"

def extract_attachments(k, mid, attachments, verbose=False):
    blocks=[]
    for att in (attachments or []):
        nm,txt=_extract_one(k, mid, att)
        if verbose: print(f"    · attachment {nm}: {len(txt)} chars")
        blocks.append(f"--- ATTACHMENT: {nm} ---\n{txt}")
    return "\n\n".join(blocks)

def _looks_garbage(text):
    """True if an LLM reply is UNUSABLE: empty, `<unk>`/replacement-char salad, glued token-salad,
    too few Latin letters (the multilingual gibberish Olga got 2026-06-30), or one token repeated to
    death. The anti-junk gate: never EMAIL anything this flags — regenerate instead."""
    t=(text or "").strip()
    if len(t)<40: return True
    if "<unk>" in t or "�" in t: return True
    letters=sum(1 for c in t if c.isascii() and c.isalpha())
    if letters/len(t) < 0.55: return True              # English/Finnish are mostly Latin; salad isn't
    words=t.split()
    if words:
        if sum(1 for w in words if len(w)>28)/len(words) > 0.05: return True   # glued token salad
        from collections import Counter
        if len(words)>25 and Counter(words).most_common(1)[0][1]/len(words) > 0.12: return True
    return False

def _has_leak(text):
    """nemotron (a reasoning model) leaks its chain-of-thought as a preamble ~2/3 of the time
    ('The user asks:', 'Okay, the user is…'). Not a final answer — regenerate."""
    head=(text or "").strip().lower()
    return head.startswith(("the user asks","we need to","okay, the user","the user is asking",
        "the user wants","let me answer","i need to answer","let's answer","the question is",
        "okay, so","alright, the user","so the user"))

def _fm_call(messages, max_tokens=3000, temperature=0.3, model=None):
    """One FreeLLMAPI /chat/completions call, with 429 backoff. Returns (text, model_used)."""
    body={"model":model or FM_MODEL,"messages":messages,"max_tokens":max_tokens,"temperature":temperature}
    req=urllib.request.Request(FM_HOST.rstrip('/')+"/chat/completions", data=json.dumps(body).encode(),
        headers={"Authorization":f"Bearer {fm_key()}","Content-Type":"application/json"})
    d=None
    RL_WAIT=int(os.environ.get("FREELLMASK_MAIL_RL_WAIT","40"))  # seconds to wait out a rate-limit window
    # 240s was far too patient. When the gateway falters it closes the socket without answering
    # (observed as CLOSE_WAIT), so waiting four minutes for a reply that will never come — six times
    # over, silently — let one call burn 25 minutes while the log said nothing at all. A whole
    # compose could hang for hours looking exactly like normal slowness.
    CALL_TIMEOUT=int(os.environ.get("FREELLMASK_MAIL_CALL_TIMEOUT","120"))
    DEADLINE=time.time()+int(os.environ.get("FREELLMASK_MAIL_CALL_DEADLINE","480"))
    for attempt in range(6):
        if attempt and time.time() > DEADLINE:
            raise RuntimeError(f"gateway deadline exceeded after {attempt} attempt(s)")
        try:
            with urllib.request.urlopen(req, timeout=CALL_TIMEOUT) as r: d=json.load(r); break
        except urllib.error.HTTPError as e:
            # 429 = free-tier per-minute cap (Gemini) or provider throttle. DON'T fail — WAIT for the
            # window to clear (≈40s, or the server's Retry-After if longer), then retry. This is the
            # "delayed" automatic pacing: the call is deferred, never pushed past the free tier.
            if e.code==429 and attempt<5:
                ra=e.headers.get("Retry-After") if e.headers else None
                try: wait=max(RL_WAIT, int(ra)) if ra else RL_WAIT
                except (ValueError, TypeError): wait=RL_WAIT
                # A rate-limit wait is LEGITIMATE pacing, not the gateway faltering — the deadline
                # must not abort it, or we would give up precisely when the server told us exactly
                # when to come back. The deadline bounds brokenness, not politeness.
                print(f"        ⏸ rate-limited, waiting {wait}s (Retry-After)", flush=True)
                DEADLINE += wait
                time.sleep(wait); continue
            # 5xx = the gateway itself faltering (502 Bad Gateway is routine on the free leg,
            # especially on big payloads), NOT a bad request. Until 2026-08-12 only 429 was retried,
            # so a transient 502 killed the attempt outright — and since every rejection path was
            # silent, twelve attempts of pure gateway noise were reported as "the model would not
            # produce the required shape". The model never got the chance to produce anything.
            if e.code in (500, 502, 503, 504) and attempt < 5:
                w = min(60, 5 * (2 ** attempt))
                print(f"        ⏸ gateway {e.code}, retry {attempt+1}/6 in {w}s", flush=True)
                time.sleep(w); continue
            raise
        except (urllib.error.URLError, TimeoutError) as e:
            # A dropped connection or a read timeout is the same class of event: the gateway, not us.
            if attempt < 5:
                w = min(60, 5 * (2 ** attempt))
                print(f"        ⏸ {type(e).__name__}, retry {attempt+1}/6 in {w}s", flush=True)
                time.sleep(w); continue
            raise
    return d["choices"][0]["message"]["content"].strip(), d.get("model","?")

def _is_wiki_refusal(t):
    """Detect the failure where the model refuses because the WIKI pages don't cover the topic —
    which must NEVER happen (the wiki augments; the model should answer from its own knowledge)."""
    tl=(t or "").lower()
    # A real refusal is SHORT and dominated by the refusal; a full answer that merely mentions a
    # gap in passing (now common with the '## Thought about it' section) must NOT be flagged.
    if len(tl) > 700: return False
    return any(p in tl for p in (
        "do not contain any information","does not contain any information","no source material",
        "the supplied wiki","the provided wiki","wiki pages do not","pages do not contain",
        "pages do not cover","not covered in the supplied","no information about"))

# Returned by fm_research when the free-energy viewpoint is active but the model would not produce
# the required '## Thought about it' heading within this pass. The poll loop treats it as "not
# sendable yet": it does NOT send and does NOT mark the email seen, so the next poll retries it fresh.
TRY_FLOOR = 12                 # attempts the viewpoint template gets; compose lowers it (see fm_research)

# The four sections that used to be a SEPARATE email from `convey email-transcript --analyze`. They
# only make sense when there is material (a transcript, a document) — a bare question has nothing to
# quote. Folded in here so one email carries everything (Esa, 2026-08-12: "its super important we
# dont lose any of the three specific individual features, but that we only have one mailer system").
MATERIAL_SECTIONS = (
    "## Summary\n(2-4 sentences: what this material IS, who is speaking, and about what)\n"
    "## Key points\n(5-9 bullets, each a concrete claim, measurement or step from the material itself)\n"
    "## Notable quotes\n(2-5 verbatim quotes from the material, each in quotation marks. Quote ONLY "
    "what is actually there — never invent or paraphrase into quotation marks.)\n"
    "## People & entities mentioned\n(bullets: people, devices, companies, papers named in the "
    "material, each with a few words on their role. Omit the section's bullets rather than invent.)\n"
    # Esa, 2026-08-12, on an email he liked: "summary of the paper / what holds up plausible aspects /
    # whats worth checking, needs verification (this was a table!) / overall assessment". The
    # holds-up-vs-needs-checking SPLIT is the useful part — it separates what the material earns from
    # what it merely asserts, without collapsing into either credulity or dismissal.
    "## What holds up\n(3-6 bullets: the parts that are plausible ON THE MATERIAL'S OWN TERMS — "
    "sound method, a measurement actually taken, a mechanism consistent with known physics or with "
    "an open-system reading. Say WHY each holds up, concretely.)\n"
    "## What is worth checking\n(a MARKDOWN TABLE, exactly these columns: | Claim | Why it needs "
    "verification | How to verify it |. 3-6 rows. Each 'how' must be a real, specific measurement or "
    "document anyone could actually perform — calorimetry over an hour, both ports metered; a named "
    "paper to pull; a scope measurement with the probe placement stated. No vague 'more research "
    "needed'.)\n"
    "## Overall assessment\n(3-5 sentences: what this material is worth, what it establishes versus "
    "what it only claims, and what would change the verdict. Land somewhere — never a shrug.)\n")

# EVERY heading the viewpoint template promises is now CHECKED. The prompt has always said "A reply
# missing any of these headings is rejected and regenerated" — but only "Thought about it" was ever
# verified in code, which is exactly why Prigogine kept vanishing from the emails and nobody noticed
# (Esa, 2026-08-12: "where was prigogine from freellmask-mail???").
TONE_HEADINGS = ["In Walter Russell's tone", "In Tom Bearden's tone", "In Ilya Prigogine's tone",
                 "In Hilarion's tone", "In the skeptical closed-system electrical engineer's tone"]
MATERIAL_HEADINGS = ["Summary", "Key points", "Notable quotes", "People & entities mentioned",
                     "What holds up", "What is worth checking", "Overall assessment"]
REQUEUE_NO_THINKING = "\x00REQUEUE-NO-THINKING\x00"
# Returned when the model BAILED ('please provide the content') despite content being available — the
# poll loop re-queues (does not send the bail) and debug-logs it for inspection.
REQUEUE_FAILED = "\x00REQUEUE-FAILED\x00"
_FAILURE_RE=re.compile(r'(?i)('
    r'unable to (formulate|provide|generate|craft|give) (a |an )?(response|reply|answer)'
    r'|please provide (the |me )?(the )?(email|content|text|details|message|body)'
    r'|without (the )?(actual )?(content|text|body|details) of (the|your|this|the latest)'
    r'|(could|can) you (please )?provide (the )?(email|content|text|details|message)'
    r'|i (need|require|would need) (the )?(actual )?(content|text|body|details|more (info|information|context))'
    r'|no (email )?(content|body|text) (was )?(provided|available|found|included)'
    r'|there (is|was) no (content|text|body|email|message))')
def _is_failure_answer(t):
    """The model bailed instead of answering (usually 'please provide the content') — short + bail-shaped.
    A long substantive answer that merely mentions missing detail is NOT flagged."""
    tl=(t or "").strip()
    if not tl: return True
    if len(tl)>900: return False
    return bool(_FAILURE_RE.search(tl))

def fm_research(question, thread_context, attachments="", tries=6, wiki_ctx="", viewpoint="", lens="",
                honour_tries=False,
                model_override="", material=False):
    """Answer an email via FreeLLMAPI, GATED for clean output. The WIKI CONTEXT (if any) and the
    VIEWPOINT AUGMENT the answer — they NEVER gate it. The model uses the wiki + attachments + its
    OWN knowledge and ALWAYS gives a full answer; it must not refuse for lack of wiki coverage."""
    base=("You are a research assistant answering an email. Markdown (## headings, **bold**, bullets). "
          "Ground claims in fact (don't invent). Use the WIKI CONTEXT and ATTACHMENTS if provided AND your "
          "OWN knowledge to give a FULL answer. NEVER refuse or say 'the wiki/pages do not cover this' — "
          "if the wiki is incomplete, answer from your own knowledge anyway. If a follow-up, use the prior conversation. "
          "DO NOT invent specifics you are not sure of — exact command flags, API names, version numbers, file "
          "schemas, measured figures, or dates. If you don't KNOW the exact detail (e.g. a brand-new command's "
          "flags), say so plainly and say how to verify it (run `--help`, check the docs) rather than presenting a "
          "plausible-looking guess as fact. Better an honest 'I'm not certain of the exact syntax' than a confident fabrication. "
          "SPECIFICALLY FOR COMMANDS/CLI: never show an EXAMPLE invocation containing flags/options you have not "
          "verified — no `--format json`, `--output`, `--project` etc. for a command whose real flags you cannot "
          "confirm, even if you label it 'example'. Show ONLY the bare verified command (e.g. `xcrun agent skills "
          "export`) and tell the user to run `<command> --help` for the actual flags. Zero invented flags, not "
          "plausible-looking ones.")
    voices_on = lens_voices_enabled()
    if viewpoint and voices_on:   # in-corpus (free-energy) → think out loud + speak in four voices, ONE call, no extra roundtrip
        # The promised count must MATCH what the template actually asks for: material mode injects four
        # more sections, so a hardcoded "SEVEN" was telling the model seven while showing it eleven.
        # A contract that miscounts its own clauses is the reason headings kept going missing.
        n_head = 2 + len(TONE_HEADINGS) + (len(MATERIAL_HEADINGS) if material else 0)
        struct=(f"\n\nYour reply MUST contain ALL {n_head} of the following markdown headings, in this EXACT order and "
          "spelling. The FIRST line of your reply MUST be the heading '## Thought about it' — never open with the "
          f"answer, never omit the thinking section, never rename it. A reply missing any of these {n_head} headings is "
          "rejected and regenerated.\n"
          "## Thought about it\n(4-7 sentences of GENUINE reasoning — how you're approaching it, what connects "
          "across the sources, where the tension is. Think out loud, here only.)\n"
          "## Answer\n(the substantive, concrete analysis — grounded in the wiki context + your knowledge)\n"
          + (MATERIAL_SECTIONS if material else "") +
          "## In Walter Russell's tone\n(2-4 sentences in Russell's cadence: universe as rhythmic balanced "
          "interchange of two opposed lights, giving and re-giving, all motion spiral/vortular, no dead matter, love as the balancing act)\n"
          "## In Tom Bearden's tone\n(2-4 sentences in Bearden's cadence: scalar/longitudinal EM potentials, "
          "energy from the active vacuum, asymmetric regauging, the dipole's broken symmetry as a negentropy source)\n"
          "## In Ilya Prigogine's tone\n(2-4 sentences in Prigogine's cadence — measured, humane, precise, a Nobel "
          "laureate bridging physics and meaning: entropy changes for two reasons only, dS = d_eS + d_iS, and far "
          "from equilibrium the second law is not the enemy of order but its ENGINE — an open system fed by a flow "
          "exports entropy and self-organises into a dissipative structure, order paid for by the throughput, not "
          "stolen from nothing. He AFFIRMS open-system order and COP>1 fed by a real reservoir, and DISTINGUISHES "
          "it from a perpetuum mobile, which the second law still forbids — that honest boundary is the point, "
          "never dropped.)\n"
          "## In Hilarion's tone\n(2-4 sentences in the Hilarion channel's cadence: one living substance, "
          "consciousness as ground, gentle didactic cosmology — everything a modulation of the one energy)\n"
          # The eleventh voice, LAST on purpose (Esa, 2026-08-12). Rigorous, not dismissive: it demands
          # the books balance and names the measurement that would settle it. It is ONE lens of eleven
          # and it speaks after the open-system readings — it never becomes the frame they are judged by.
          "## In the skeptical closed-system electrical engineer's tone\n(3-5 sentences from a working "
          "EE who wants the energy books to balance: what is on the INPUT side that is not being "
          "metered (the supply's own draw, bias, drive, standby), what a single clamp meter cannot see "
          "(phase, harmonics, RF, common-mode), and the ONE measurement that would settle it — "
          "calorimetry over an hour, joules out minus joules in, both ports metered. Name the step "
          "where this class of claim usually dies. Be specific and testable; do NOT declare it "
          "impossible and do NOT argue from the ceiling — say what would falsify it.)")
        sysm=viewpoint+"\n\n"+base+struct
    elif viewpoint:
        sysm=(viewpoint+"\n\n"+base+
              " Output Markdown with a direct substantive answer. FREE_ENERGY_LENS_VOICES is off, "
              "so do not add Walter Russell, Tom Bearden, Ilya Prigogine, or Hilarion tone sections.")
    else:           # off-corpus (e.g. parenting) → plain direct answer, no preamble, no tones
        sysm=base+" Output ONLY the final answer — no reasoning preamble; begin directly with the answer."
        if lens:    # a skill-backed space (apple/health/hyp) → frame the answer through the skill's lens
            sysm=("You are answering WITHIN this skill/role space. Honour its rules and grounding "
                  "(especially any anti-fabrication rules) as the authoritative frame:\n"+lens.strip()
                  +"\n\n"+sysm)
    # STANDING RULES the reader established by ADJUSTING earlier answers. One shared ledger with
    # `convey adjust` (kb/adjust/rules.md), so a wording Esa corrected in a prism viewer is not
    # written again by the mail agent either — one methodology, two surfaces.
    _rules = adjust_rules()
    if _rules:
        sysm += ("\n\nSTANDING RULES the reader has established by adjusting earlier answers — "
                 "honour every one of them:\n" + "\n".join(f"- {r}" for r in _rules))

    # BIG-CONTEXT ESCALATION: if the raw context is large, use Gemini's 1M window and DON'T truncate;
    # otherwise nemotron with the normal caps. Decided on RAW sizes (pre-truncation) so a big
    # attachment that would be clipped for nemotron triggers the escalation.
    raw_len = len(question or "") + len(thread_context or "") + len(attachments or "") + len(wiki_ctx or "")
    big = raw_len > BIG_CTX_CHARS
    # model precedence: big-context always escalates to the 1M-window model; else a space's model
    # override (e.g. apple → gemini for instruction-following on 'no invented flags'); else nemotron.
    chosen_model = BIG_MODEL if big else (model_override or FM_MODEL)
    att_cap  = BIG_ATT_CAP  if big else SMALL_ATT_CAP
    wiki_cap = BIG_WIKI_CAP if big else SMALL_WIKI_CAP
    user=(f"PRIOR CONVERSATION (oldest first):\n{thread_context}\n\n" if thread_context else "") + \
         f"LATEST EMAIL TO ANSWER:\n{question or '(no body text — answer based on the attachments)'}" + \
         (f"\n\nRELEVANT CONTEXT (retrieved from your knowledge base — build on it, but also use your own "
          f"knowledge; it may be incomplete):\n{wiki_ctx[:wiki_cap]}" if wiki_ctx else "") + \
         (f"\n\nATTACHMENTS (extracted text):\n{attachments[:att_cap]}" if attachments else "")
    msgs=[{"role":"system","content":sysm},{"role":"user","content":user}]
    # Fallback message set with NO wiki context — used if the model gets biased into refusing
    # ("the wiki pages do not contain…"). Stripping the wiki lets it answer from its own knowledge.
    user_nowiki=(f"PRIOR CONVERSATION (oldest first):\n{thread_context}\n\n" if thread_context else "") + \
         f"LATEST EMAIL TO ANSWER:\n{question or '(no body text — answer based on the attachments)'}" + \
         (f"\n\nATTACHMENTS (extracted text):\n{attachments[:att_cap]}" if attachments else "")
    msgs_nowiki=[{"role":"system","content":sysm},{"role":"user","content":user_nowiki}]
    # When the viewpoint is active the reply MUST carry the '## Thought about it' thinking heading.
    # nemotron drops it ~1/3 of the time. We NEVER send without it and NEVER fabricate it: we
    # regenerate for the whole (enlarged) budget, and if it still won't comply this pass we return
    # REQUEUE_NO_THINKING so the poll loop leaves the email unseen and a later poll retries it fresh.
    required = (["Thought about it", "Answer"]
                + (MATERIAL_HEADINGS if material else [])
                + TONE_HEADINGS) if (viewpoint and voices_on) else []

    def _missing_headings(t):
        """Which promised headings are absent. The template claims all of them are mandatory; until
        2026-08-12 only 'Thought about it' was checked, so Prigogine (and any other tone) could be
        silently dropped and the reply still shipped."""
        out = []
        for h in required:
            pat = r'(?im)^\s*#{1,3}\s*' + re.escape(h).replace(r"\ ", r"\s+") + r"\b"
            if re.search(pat, t or "") is None:
                out.append(h)
        return out

    def _missing_thinking(t):
        return bool(_missing_headings(t))

    def _sections(t):
        """Split a reply into {required heading: body}. Only the headings we asked for are harvested,
        so a stray heading the model invents cannot displace a real one."""
        found, order = {}, []
        for h in required:
            pat = r'(?im)^\s*#{1,3}\s*' + re.escape(h).replace(r"\ ", r"\s+") + r"\b[^\n]*\n"
            m = re.search(pat, t or "")
            if m:
                order.append((m.start(), m.end(), h))
        order.sort()
        for i, (s, e, h) in enumerate(order):
            end = order[i + 1][0] if i + 1 < len(order) else len(t)
            found[h] = (t[e:end] or "").strip()
        return found

    def _substantive(h, body):
        """A heading with nothing under it is not a section — keeping it would let an empty shell
        satisfy the gate forever and ship a hollow email."""
        w = len((body or "").split())
        return w >= (18 if h in TONE_HEADINGS else 8)

    def _assemble(have):
        return "\n\n".join(f"## {h}\n\n{have[h]}" for h in required if h in have)
    NUDGE=("\n\nREMINDER: your previous reply OMITTED required section(s). Every heading in the template is "
           "mandatory and is checked: emit each one, verbatim, in order, and never merge or rename them.")
    # The six-heading template makes nemotron drop the required heading ~1/3 of the time, so the poll
    # loop gives it 12 attempts — fine when a human is waiting for a reply, fatal for a BELT email:
    # 12 × ~60s ran past a 900s timeout and the transcript was never answered at all (2026-08-11).
    # TRY_FLOOR lets a caller bound it; compose sets it, the poll loop keeps 12.
    # TRY_FLOOR exists because the template used to need many shots at the same all-or-nothing
    # lottery. With the MOSAIC each attempt contributes, so a floor of twelve is no longer a safety
    # net — it is a liability: the free gateway rate-limits with Retry-After ~545s, so twelve
    # attempts is over an hour and a half of waiting for ONE email. A caller that states its budget
    # is now believed (2026-08-12).
    eff_tries = (max(1, tries) if honour_tries
                 else (max(tries, TRY_FLOOR) if (viewpoint and voices_on) else max(1, tries)))
    has_content = bool((question or "").strip()) or bool((attachments or "").strip())
    used=chosen_model; cur=msgs; saw_failure=False; have={}
    # Every rejection SAYS WHY. Until 2026-08-12 only the missing-heading branch printed, so a run that
    # burned twelve attempts on 502s looked identical to one that burned them on a refusal — the log
    # said only "would not produce the required shape", which was not even true.
    for _attempt in range(1, eff_tries + 1):
        try:
            ans, used = _fm_call(cur, model=chosen_model)
        except Exception as e:
            print(f"      ↻ {_attempt}/{eff_tries} call failed: {e}", flush=True); continue
        if not ans:
            print(f"      ↻ {_attempt}/{eff_tries} empty reply", flush=True); continue
        if _looks_garbage(ans):
            print(f"      ↻ {_attempt}/{eff_tries} garbage ({len(ans.split())}w)", flush=True); continue
        if _has_leak(ans):
            print(f"      ↻ {_attempt}/{eff_tries} reasoning leak", flush=True); continue
        if _is_wiki_refusal(ans):          # the wiki context biased it into refusing → drop it, retry
            print(f"      ↻ {_attempt}/{eff_tries} wiki refusal — dropping wiki", flush=True)
            cur=msgs_nowiki; continue
        if has_content and _is_failure_answer(ans):   # model BAILED though content exists → retry, never send the bail
            print(f"      ↻ {_attempt}/{eff_tries} model bailed despite content", flush=True)
            saw_failure=True; cur=msgs_nowiki; continue
        if not required:
            return ans, used               # off-corpus: no section contract to satisfy
        # THE MOSAIC (Esa, 2026-08-12): "analyze = got 3, missed 2 does not result in oh, chuck 3,
        # re-do". Sections that came back GOOD are kept; only the missing ones are re-asked. The old
        # loop threw away eleven good sections because one was absent, so each attempt had to win the
        # whole lottery at once — which is why twelve attempts could produce nothing at all.
        got_now = []
        for h, body in _sections(ans).items():
            if h not in have and _substantive(h, body):
                have[h] = body; got_now.append(h)
        miss = [h for h in required if h not in have]
        if got_now:
            print(f"      🧩 {_attempt}/{eff_tries} +{len(got_now)} kept "
                  f"({len(have)}/{len(required)} held)", flush=True)
        if not miss:
            return _assemble(have), used   # every section held — assemble the mosaic and send
        print(f"      ↻ {_attempt}/{eff_tries} still missing: {', '.join(miss)}", flush=True)
        # Ask ONLY for what is missing. Re-requesting sections we already hold wastes the attempt and
        # invites the model to spend its tokens rewriting work that was already good.
        nudge = ("\n\nWRITE ONLY THESE SECTIONS, nothing else — the rest of the reply is already "
                 "written and will be kept:\n" + "\n".join(f"## {m}" for m in miss) +
                 "\n\nEmit each heading verbatim, in that order, with its full content beneath. Do "
                 "not write any other heading, and do not apologise or explain.")
        cur=[{"role":"system","content":sysm+nudge},{"role":"user","content":cur[1]["content"]}]
        continue
    if saw_failure:                        # kept bailing despite content → re-queue + debug-log, don't send
        return (REQUEUE_FAILED, used)
    if viewpoint and voices_on:
        # Exhausted — but a mosaic that is MOSTLY built is worth more than silence. If the thinking
        # and the answer are present and two-thirds of the sections held, send what stands and say
        # plainly which sections could not be produced, rather than mailing nothing.
        miss = [h for h in required if h not in have]
        if have.get("Thought about it") and have.get("Answer") and len(have) >= (2 * len(required)) // 3:
            print(f"      🧩 sending partial mosaic: {len(have)}/{len(required)} sections", flush=True)
            body = _assemble(have)
            body += ("\n\n---\n\n_Not produced this pass, after "
                     f"{eff_tries} attempts: {', '.join(miss)}. Reply to this email to try again._")
            return body, used
        return (REQUEUE_NO_THINKING, used)
    return ("I wasn't able to generate a reliable answer this time — the model returned an unusable "
            "response on every attempt. Please reply to this email to try again.", used)

def _md_inline(t):
    t=(t.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;"))
    t=re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", t)
    t=re.sub(r"(?<!\*)\*([^*\n]+)\*(?!\*)", r"<em>\1</em>", t)
    t=re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
    t=re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', t)
    return t

_TH='style="border:1px solid #999;padding:4px 8px;background:#eef;text-align:left"'
_TD='style="border:1px solid #999;padding:4px 8px;text-align:left;vertical-align:top"'
def md_to_inner_html(md):
    """Markdown→HTML body: headings, bold/italic/code/links, lists, and real TABLES."""
    out=[]; i=0; lines=(md or "").split("\n"); in_ul=in_ol=False
    def close():
        nonlocal in_ul,in_ol
        if in_ul: out.append("</ul>"); in_ul=False
        if in_ol: out.append("</ol>"); in_ol=False
    def cells(row): return [c.strip() for c in row.strip().strip("|").split("|")]
    n=len(lines)
    while i<n:
        line=lines[i]; s=line.strip()
        # pipe table: a |row| followed by a |---|---| separator
        if s.startswith("|") and i+1<n and re.match(r"^\s*\|?[\s:|-]+\|?\s*$", lines[i+1]) and "-" in lines[i+1]:
            close()
            out.append('<table style="border-collapse:collapse;width:100%;margin:6px 0;font-size:10px"><thead><tr>'
                       + "".join(f"<th {_TH}>{_md_inline(c)}</th>" for c in cells(line)) + "</tr></thead><tbody>")
            i+=2
            while i<n and lines[i].strip().startswith("|"):
                out.append("<tr>"+"".join(f"<td {_TD}>{_md_inline(c)}</td>" for c in cells(lines[i]))+"</tr>"); i+=1
            out.append("</tbody></table>"); continue
        h=re.match(r"^(#{1,6})\s*(\S.*)$", line)   # tolerate '##Heading' with no space after #
        ol=re.match(r"^\s*\d+\.\s+(.*)$", line); ul=re.match(r"^\s*[-*+]\s+(.*)$", line)
        if h: close(); out.append(f"<h{len(h.group(1))}>{_md_inline(h.group(2))}</h{len(h.group(1))}>")
        elif ol:
            if not in_ol: close(); out.append("<ol>"); in_ol=True
            out.append(f"<li>{_md_inline(ol.group(1))}</li>")
        elif ul:
            if not in_ul: close(); out.append("<ul>"); in_ul=True
            out.append(f"<li>{_md_inline(ul.group(1))}</li>")
        elif s=="": close()
        else: close(); out.append(f"<p>{_md_inline(line)}</p>")
        i+=1
    close()
    return "\n".join(out)

def md_to_html(md):
    """Email-body HTML (rich, renders in any mail client)."""
    return ('<div style="font-family:-apple-system,Segoe UI,sans-serif;line-height:1.5;font-size:14px">'
            + md_to_inner_html(md) + '<hr><p style="color:#888;font-size:12px">— freellmask · '
            'answered by FreeLLMAPI on cloudcity ($0). Reply to continue.</p></div>')

def load_state():
    try: return json.loads(STATE.read_text())
    except Exception: return {"seen":[], "last_poll":None}
def save_state(s): STATE.parent.mkdir(parents=True, exist_ok=True); STATE.write_text(json.dumps(s,indent=2))

SEEN_CAP = int(os.environ.get("FREELLMASK_MAIL_SEEN_CAP", "5000"))

class OrderedSeen:
    """Insertion-ORDERED set of handled message-ids. `list(x)` yields oldest→newest, so `[-CAP:]`
    keeps the NEWEST ones and evicts only genuinely old ones.

    This used to be a plain `set` persisted as `list(seen)[-500:]` — and a set has NO order, so each
    save kept an ARBITRARY 500 mids and silently evicted already-answered ones. The evicted mid was
    still inside the newest-50 API listing, so the next poll answered it again… and again. That is the
    2026-07-28 mail storm: 25 'Re: Schaffranke' replies to ONE inbound email in 45 minutes, 5 for
    'I Spent 16 months…'. Never persist a set by slicing it."""
    def __init__(self, it=()): self._d=dict.fromkeys(it or [])
    def add(self, x): self._d[x]=None
    def discard(self, x): self._d.pop(x, None)
    def __contains__(self, x): return x in self._d
    def __iter__(self): return iter(self._d)
    def __len__(self): return len(self._d)

# ── ANTI-LOOP LEDGER: an append-only record of every mid we have actually REPLIED to. Independent of
# `seen` (which is capped and lives in a rewritable JSON), so even if the state file is lost, rolled
# back by Syncthing, or truncated, a message that already got an answer can NEVER be answered twice.
# Also gives a per-thread rate ceiling: a genuine mail storm is stopped at the source, whatever caused it.
REPLIED   = Path(os.environ.get("FREELLMASK_MAIL_REPLIED", Path.home()/"work"/"comms"/"queue"/"freellmask-mail-replied.jsonl"))
THREAD_MAX_PER_HOUR = int(os.environ.get("FREELLMASK_MAIL_THREAD_MAX_HOUR", "4"))

def replied_load():
    """(set of replied mids, {thread_id: [epoch,…]}). Best-effort — never raises into the poll loop."""
    mids=set(); threads={}
    try:
        for line in REPLIED.read_text().splitlines():
            try: r=json.loads(line)
            except Exception: continue
            if r.get("mid"): mids.add(r["mid"])
            t=r.get("thread")
            if t: threads.setdefault(t, []).append(float(r.get("t") or 0))
    except Exception: pass
    return mids, threads

def replied_seed(k, msgs):
    """First run only: build the ledger from the inbox itself, so the fix takes effect immediately and
    needs no file shipped between machines. Any RECEIVED message whose thread already contains a SENT
    message that came AFTER it has evidently been answered → record it, so the newly-ordered `seen` (which
    inherits a state file that had already lost mids) cannot re-answer the whole backlog once."""
    if REPLIED.exists(): return 0
    try:                                            # reach further back than the poll window for the seed
        _big=http(f"{AM_BASE}/inboxes/{INBOX}/messages?limit=200", k)
        msgs=_big.get("messages", _big if isinstance(_big,list) else []) or msgs
    except Exception: pass
    sent_by_thread={}
    for m in msgs:
        if "sent" in (m.get("labels") or []):
            sent_by_thread.setdefault(m.get("thread_id"), []).append(m.get("timestamp") or "")
    n=0
    for m in msgs:
        if "sent" in (m.get("labels") or []): continue
        ts=m.get("timestamp") or ""
        if any(s > ts for s in sent_by_thread.get(m.get("thread_id"), [])):
            # keep the ORIGINAL time, so seeded history doesn't trip the per-thread hourly ceiling
            replied_add(m.get("message_id"), m.get("thread_id"), m.get("subject",""), t=_epoch(ts))
            n+=1
    if n: print(f"  🌱 seeded replied-ledger with {n} already-answered message(s)")
    return n

def replied_add(mid, thread, subject="", t=None):
    try:
        REPLIED.parent.mkdir(parents=True, exist_ok=True)
        with REPLIED.open("a") as f:
            f.write(json.dumps({"mid":mid,"thread":thread,"subj":(subject or "")[:120],
                                "t":float(t if t is not None else time.time()),
                                "ts":time.strftime("%Y-%m-%dT%H:%M:%S")})+"\n")
    except Exception: pass

def _epoch(ts):
    """AgentMail ISO timestamp → epoch seconds (0 if unparseable)."""
    try:
        import datetime
        return datetime.datetime.strptime((ts or "")[:19], "%Y-%m-%dT%H:%M:%S").replace(
            tzinfo=datetime.timezone.utc).timestamp()
    except Exception:
        return 0.0

DEBUG_LOG=Path(os.environ.get("FREELLMASK_MAIL_DEBUG", Path.home()/"work"/"comms"/"queue"/"freellmask-mail-debug.log"))
def debug_log(kind, mid, subject="", question="", answer="", note=""):
    """Flagged, saved record of every degraded / re-queued / failed answer, so failures are VISIBLE and
    inspectable (Syncthing-synced) instead of being silently sent. Appended, never raises."""
    try:
        DEBUG_LOG.parent.mkdir(parents=True, exist_ok=True)
        with DEBUG_LOG.open("a") as f:
            f.write(f"\n===== [{time.strftime('%Y-%m-%dT%H:%M:%S')}] FLAG:{kind} =====\n")
            f.write(f"mid: {mid}\nsubject: {subject}\n")
            if note: f.write(f"note: {note}\n")
            if question: f.write(f"--- question ({len(question)} chars) ---\n{question[:1500]}\n")
            if answer: f.write(f"--- answer ---\n{answer[:1500]}\n")
        print(f"  🚩 debug-logged [{kind}] {mid}")
    except Exception: pass

def thread_context(key, msgs, thread_id, exclude_id):
    """Build an oldest-first transcript of the thread for follow-up context."""
    same=[m for m in msgs if m.get("thread_id")==thread_id and m.get("message_id")!=exclude_id]
    same.sort(key=lambda m: m.get("timestamp") or "")
    out=[]
    for m in same[-6:]:
        who=m.get("from","?"); pv=(m.get("preview") or "").strip()
        out.append(f"[{who}] {pv}")
    return "\n".join(out)

import html as _htmlmod
def html_to_text(h):
    """Recover body text from an HTML-only email (forwards from Gmail are often HTML-only)."""
    if not h: return ""
    h=re.sub(r'(?is)<(script|style|head).*?</\1>',' ',h)
    h=re.sub(r'(?i)<br\s*/?>','\n',h); h=re.sub(r'(?i)</(p|div|tr|li|h[1-6])>','\n',h)
    h=re.sub(r'<[^>]+>',' ',h)
    return re.sub(r'\n{3,}','\n\n', _htmlmod.unescape(h)).strip()

def _og_meta(html):
    """Pull og:/twitter:/description meta — where social sites (Threads, X, Instagram, Facebook) put
    the ACTUAL post text for link previews, even when the page body is JS-only and html_to_text yields
    nothing. This is what lets the bot READ a Threads/X link instead of hallucinating about it."""
    if not html: return ""
    out=[]
    for prop in ("og:title","og:description","twitter:title","twitter:description"):
        m=(re.search(r'<meta[^>]+(?:property|name)=["\']'+re.escape(prop)+r'["\'][^>]+content=["\'](.*?)["\']', html, re.I|re.S)
           or re.search(r'<meta[^>]+content=["\'](.*?)["\'][^>]+(?:property|name)=["\']'+re.escape(prop)+r'["\']', html, re.I|re.S))
        if m:
            v=_htmlmod.unescape(m.group(1)).strip()
            if v and v not in out: out.append(v)
    m=re.search(r'<meta[^>]+name=["\']description["\'][^>]+content=["\'](.*?)["\']', html, re.I|re.S)
    if m:
        v=_htmlmod.unescape(m.group(1)).strip()
        if v and v not in out: out.append(v)
    return "\n".join(out)

def strip_signature(text):
    """Drop the email signature so the model doesn't 'research' a name/phone/Patreon URL.
    Cuts at a TRAILING sig delimiter (--, — , __, 'Sent via/from'), then trims trailing contact lines.

    2026-07-01 bug: a FORWARDED email (Apple Mail/Gmail) puts the forwarder's OWN signature at the TOP,
    before 'Begin forwarded message:'. Cutting at that leading '—' discarded the ENTIRE forwarded body,
    so the mail looked empty and was silently skipped (the Jeane Manning newsletter). Fix: (1) if there
    is a forward marker, start from it (drop the leading forwarder sig); (2) only accept a delimiter as
    a signature cut when its TAIL is short (<=10 non-empty lines) — a '—' with the whole body after it
    is not a signature."""
    if not text: return ""
    t=text.replace("\r","")
    fm=re.search(r'(?im)^\s*(begin forwarded message:|-{2,}\s*forwarded message)', t)
    if fm: t=t[fm.start():]                          # forwarded content — not the forwarder's leading sig
    lines=t.split("\n"); cut=len(lines)
    for i,l in enumerate(lines):
        s=l.strip()
        if s in ("--","-- ","—","–","__") or re.match(r'(?i)^(sent (via|from) |get outlook)', s):
            tail=[x for x in lines[i+1:] if x.strip()]
            if i>0 and len(tail)<=10:                # a real trailing sig (short tail), not mid-body
                cut=i; break
    lines=lines[:cut]
    while lines:                                   # trim trailing contact-only lines
        s=lines[-1].strip()
        # NOTE: do NOT strip generic content URLs (e.g. an x.com link IS the request).
        # Only obvious signature lines: empty, phone, Patreon, the name.
        if (s=="" or re.match(r'^\+?[\d][\d ()\-]{6,}$', s)
            or re.match(r'(?i)^https?://(www\.)?patreon\.com/\S+$', s)
            or (re.match(r'(?i)^esa\b.*ruoho', s) and len(s)<40)):
            lines.pop(); continue
        break
    return "\n".join(lines).strip()

_TRACKING_URL=re.compile(r'https?://\S{110,}')          # giant redirect/tracking URLs (substack etc.)
_BOILERPLATE=re.compile(r'(?im)^\s*(forwarded this email\?|subscribe here|unsubscribe|view (this|it|in) '
    r'(email |post )?(in (your )?browser)?|you.?re receiving this|manage your subscription|'
    r'begin forwarded message:|-{2,}\s*forwarded message|from:\s|subject:\s|date:\s|to:\s|reply-to:\s|cc:\s|'
    r'©\s*\d{4}|sent from my )', re.I)
def clean_forwarded_body(t):
    """After strip_signature: de-quote a forwarded message and strip newsletter/tracking noise so the
    ACTUAL prose survives. Forwarded Substack/newsletter mail buries the article under '>' quote markers
    + giant tracking URLs; without this the model sees only noise and bails ('please provide the content').
    Conservative: if de-noising would nuke almost everything, keep the original."""
    if not t: return t
    out=[]
    for ln in t.split("\n"):
        s=re.sub(r'^\s*>+\s?','',ln)                    # de-quote forwarded lines
        s=re.sub(r'\s*<https?://\S{70,}>','',s)         # drop long <url> anchors
        s=_TRACKING_URL.sub('',s).rstrip()              # drop giant tracking URLs
        if _BOILERPLATE.match(s): continue              # drop forwarded headers / newsletter chrome
        out.append(s)
    cleaned=re.sub(r'\n{3,}','\n\n',"\n".join(out)).strip()
    return cleaned if len(cleaned)>=40 else t.strip()

_URL_RE=re.compile(r'https?://[^\s<>"\')\]]+', re.I)
def _fetch_tweet(u):
    """X/Twitter blocks scraping — use the public fxtwitter API to get the tweet text."""
    m=re.search(r'(?:x|twitter)\.com/([^/]+)/status/(\d+)', u, re.I)
    if not m: return None
    api=f"https://api.fxtwitter.com/{m.group(1)}/status/{m.group(2)}"
    try:
        req=urllib.request.Request(api, headers={"User-Agent":"freellmask/1.0"})
        with urllib.request.urlopen(req, timeout=25) as r: d=json.load(r)
        t=d.get("tweet") or {}
        au=(t.get("author") or {}).get("name") or (t.get("author") or {}).get("screen_name") or ""
        txt=t.get("text") or ""
        return f"Tweet by {au}: {txt}".strip()
    except Exception:
        return None

def fetch_url_content(body, verbose=False):
    """Fetch and read content LINKED BY URL in the body: tweets (via fxtwitter), PDFs
    (download + on-Mini OCR), and general web pages (HTML→text). Feeds it to research."""
    # Hard ceiling on how many links ONE email can make us fetch. A link-dump page has
    # hundreds; fetching them all is a self-inflicted crawl, not reading the email.
    cap=int(os.environ.get("FA_URL_FETCH_CAP","10"))
    blocks=[]; done=set(); fetched=0
    for u in _URL_RE.findall(body or ""):
        u=u.rstrip('.,);')
        if u in done: continue
        done.add(u)
        if cap and fetched>=cap:
            if verbose: print(f"    · url-fetch cap {cap} reached — skipping the rest")
            break
        fetched+=1
        low=u.lower()
        if "patreon.com/" in low: continue          # signature link, not content
        # A VIDEO's page is NOT the video. Scraping youtube's og: title+description put the blurb into
        # the answer context, which (a) made `extra` non-empty and so silently defeated the bare-video
        # gate below, and (b) gave the model something to reason from — producing exactly the reply Esa
        # got on 2026-07-28: "the only concrete material we have is the Finnish description … because we
        # do not possess the full transcript, we must treat the video's specific claims as unknown".
        # A description is not content. The whisp transcript belt is the ONLY authority on what a video
        # says, so skip these here and let the video be conveyed and answered from the real transcript.
        if youtube_urls(u): continue
        try:
            if re.search(r'(?:x|twitter)\.com/[^/]+/status/\d+', low):
                tw=_fetch_tweet(u)
                if tw: blocks.append(f"--- X/Tweet: {u} ---\n{tw[:MAX_CHARS]}")
                elif verbose: print(f"    · tweet {u}: could not fetch")
                continue
            req=urllib.request.Request(u, headers={"User-Agent":"Mozilla/5.0 freellmask/1.0"})
            with urllib.request.urlopen(req, timeout=45) as r:
                ct=(r.headers.get("Content-Type") or "").lower()
                is_pdf = low.split("?")[0].endswith(".pdf") or "application/pdf" in ct
                data=r.read(MAX_ATT+1)
            if len(data)>MAX_ATT:
                blocks.append(f"--- {u} ---\n[skipped: exceeds size limit]"); continue
            if is_pdf:
                tmp=None
                try:
                    with tempfile.NamedTemporaryFile(suffix=".pdf",delete=False) as tf: tf.write(data); tmp=tf.name
                    out=subprocess.run([str(VISION_OCR),tmp,"--pages","20"],capture_output=True,text=True,timeout=240)
                    txt=(out.stdout or "").strip()
                finally:
                    if tmp:
                        try: os.unlink(tmp)
                        except Exception: pass
                blocks.append(f"--- PDF from URL: {u} ---\n{txt[:MAX_CHARS] if txt else '[no text found]'}")
                if verbose: print(f"    · url-pdf {u}: {len(txt)} chars")
            elif "text/html" in ct or "text/plain" in ct or not ct:
                html_s=data.decode("utf-8","ignore")
                og=_og_meta(html_s)                    # social/link-preview text (Threads/X/IG post body)
                body_txt=html_to_text(html_s)
                # For JS-only social pages the body is empty/login-wall → the og: meta IS the content.
                txt=("\n".join(x for x in (og, body_txt) if x)).strip() or og or body_txt
                if txt: blocks.append(f"--- Page: {u} ---\n{txt[:MAX_CHARS]}")
                if verbose: print(f"    · url-page {u}: {len(txt)} chars (og:{len(og)})")
        except Exception as e:
            if verbose: print(f"    · url {u}: {e}")
        if len(blocks)>=5: break
    return "\n\n".join(blocks)
fetch_url_pdfs = fetch_url_content   # back-compat alias

TEXT_TO_PDF = Path.home()/"work"/"apple"/"bin"/"text-to-pdf"
WANT_PDF = re.compile(r'\b(printable|pdf|one[\s-]?pager|as a (document|file|pdf)|attach (it|a|the))\b', re.I)
_REFORMAT_FILLER = re.compile(r'(?i)\b(printable|pdf|one|pager|onepager|document|file|attach|it|a|an|the|of|this|that|these|please|gimme|give|me|us|can|could|you|i|want|need|version|formatted?|as|to|make|create|generate|send|now|just|and|then|in|on|with|for|your|my|here|s|copy)\b')
def is_pure_reformat(q):
    """True only if the email is JUST 'make a printable PDF' (boilerplate), with no new
    question. Then we render the existing thread answer instead of generating new content."""
    if not q or not WANT_PDF.search(q): return False
    leftover=re.sub(r'[^a-z]','', _REFORMAT_FILLER.sub(' ', q).lower())
    return len(leftover) < 6
HTML_TO_PDF = Path.home()/"work"/"apple"/"bin"/"html-to-pdf"
_PDF_CSS = """
*{box-sizing:border-box} body{font-family:-apple-system,'Helvetica Neue',Helvetica,Arial,sans-serif;
font-size:11px;line-height:1.45;color:#111;margin:40px}
h1{font-size:20px;margin:0 0 10px} h2{font-size:14px;border-bottom:1px solid #ccc;padding-bottom:3px;margin:14px 0 6px}
h3{font-size:12px;margin:10px 0 4px}
table{border-collapse:collapse;width:100%;font-size:10px;margin:8px 0}
th,td{border:1px solid #888;padding:4px 8px;text-align:left;vertical-align:top} th{background:#eef}
ul,ol{margin:5px 0 5px 22px} li{margin:3px 0}
code{font-family:Menlo,monospace;background:#f4f4f4;padding:1px 4px;border-radius:3px;font-size:10px}
hr{border:none;border-top:1px solid #ddd;margin:12px 0} a{color:#1a5fb4}
"""
def pdf_filename(answer, subject=None):
    """A findable filename from the answer's first heading (or the subject)."""
    m=re.search(r'^#{1,6}\s*(.+)$', answer or "", re.M)
    base=(m.group(1) if m else (subject or "")).strip()
    base=re.sub(r'[*_`#]', '', base)
    base=re.sub(r'[^A-Za-z0-9]+','-', base).strip('-')[:60]
    return (base or "freellmask-answer")+".pdf"

# ── ADJUSTMENTS BY EMAIL ────────────────────────────────────────────────────────────────────
# Esa's methodology (2026-07-29): "when i make an adjustment to a voices response, that adjustment
# should be sent out to the voice for a response, that specific area" — he marks destructive wording
# ("pretend-scientists"), writes better wording over it, and that goes back to the voice. The
# accumulating half matters more than any single edit: every substitution becomes a standing rule
# re-given on every later answer. THE LEDGER IS SHARED with `convey adjust`, so a correction made in
# a prism viewer also binds the mail agent and vice versa — one methodology, two surfaces.
ADJUST_RULES = Path.home()/"work"/"convey"/"kb"/"adjust"/"rules.md"
ADJUST_BANK  = Path.home()/"work"/"convey"/"kb"/"adjust"/"adjustments.jsonl"

def adjust_rules(limit=60):
    """The standing rules, newest last. Soft-guarded: no ledger yet is the normal early state."""
    try:
        out=[l.strip()[2:].strip() for l in ADJUST_RULES.read_text(errors="replace").splitlines()
             if l.strip().startswith("- ") and l.strip()[2:].strip()]
        return out[-limit:]
    except Exception:
        return []

def adjust_rule_for(marked, better):
    """Same derivation `convey adjust` uses — deterministic, no model. Asking a model to generalize
    the reader's intent would invent intent; the literal substitution is what they actually said."""
    marked, better = " ".join((marked or "").split()), " ".join((better or "").split())
    if not better:
        return f'never write "{marked}" — the reader struck it as unwanted wording'
    if len(marked.split())<=6 and len(better.split())<=8:
        return f'write "{better}", never "{marked}"'
    return f'prefer the reader\'s wording here: "{better[:120]}" over "{marked[:120]}"'

def adjust_bank(marked, better, voice, question, area, reply, adopted):
    try:
        ADJUST_BANK.parent.mkdir(parents=True, exist_ok=True)
        with ADJUST_BANK.open("a") as f:
            f.write(json.dumps({"ts":time.strftime("%Y-%m-%dT%H:%M:%S"),"voice":voice,"brain":"freellmask",
                                "question":question,"marked":marked,"better":better,"area":area,
                                "reply":reply,"adopted":adopted,"warning":None,
                                "source":"email","target":"cloudcity-llm@"}, ensure_ascii=False)+"\n")
        rule=adjust_rule_for(marked, better)
        if rule and rule not in adjust_rules(limit=10_000):
            ADJUST_RULES.parent.mkdir(parents=True, exist_ok=True)
            if not ADJUST_RULES.exists():
                ADJUST_RULES.write_text("# Voice rules — learned from adjustments\n\n")
            with ADJUST_RULES.open("a") as f: f.write(f"- {rule}\n")
        return rule
    except Exception as e:
        print(f"  adjust-bank error: {e}"); return None

# Two ways to state an adjustment from a phone. sed shape is the terse one; the block shape is for
# passages with slashes in them. Both are unambiguous — no guessing at whether an email is an edit.
_ADJ_SED = re.compile(r'(?m)^\s*s/((?:[^/\\]|\\.)+)/((?:[^/\\]|\\.)*)/\s*$')
#  `\Z` (not `$`) ends the LAST block: with MULTILINE, `$` matches at every line end, so a final
#  block with no trailing ADJUST: never terminated and the whole match failed.
_ADJ_BLOCK = re.compile(r'(?is)^[ \t]*ADJUST:[ \t]*(.+?)\n[ \t]*BETTER:[ \t]*(.*?)(?=\n[ \t]*ADJUST:|\Z)', re.M)

def parse_adjustments(body):
    """[(marked, better)] stated in a reply. Empty list = an ordinary email; nothing is inferred."""
    out=[]
    for m in _ADJ_SED.finditer(body or ""):
        out.append((m.group(1).replace("\\/","/").strip(), m.group(2).replace("\\/","/").strip()))
    for m in _ADJ_BLOCK.finditer(body or ""):
        out.append((m.group(1).strip(), m.group(2).strip()))
    return [(a,b) for a,b in out if a]

def _adj_span(span):
    return re.compile(r"\s+".join(re.escape(w) for w in span.split()), re.I)

def apply_email_adjustment(prior, marked, better, question, space_sys=""):
    """Send ONE marked area of our prior answer back to the voice that wrote it. Returns
    (revised_answer, area, voice_reply, adopted, error)."""
    m=_adj_span(marked).search(prior or "")
    if not m:
        return None, "", "", False, (f"I could not find “{marked[:80]}” in my previous answer — "
                                     f"quote it as it appears and I'll adjust it.")
    start,end=m.span()
    before,after=prior[max(0,start-420):start], prior[end:end+420]
    sysm=((space_sys.strip()+"\n\n") if space_sys else "") + (
        "The reader is IMPROVING your answer with you. They marked one passage and wrote what they "
        "consider better wording. Receive that warmly and collegially — it is a collaboration, not a "
        "correction of your worth, and you do not apologise or grovel.\n"
        "Adopt their wording. Rewrite ONLY the marked passage, keeping it grammatical with the text on "
        "either side. Do not rewrite the rest of your answer.\n"
        "Then say one or two sentences back to them about what you changed and why.\n\n"
        "Reply in EXACTLY this shape, nothing before or after:\nAREA: <the rewritten passage only>\n"
        "REPLY: <one or two sentences to the reader>")
    rules=adjust_rules()
    if rules:
        sysm += "\n\nSTANDING RULES to honour:\n" + "\n".join(f"- {r}" for r in rules)
    user=((f"THE ORIGINAL QUESTION:\n{question}\n\n" if question else "")
          + f"YOUR PREVIOUS ANSWER, IN FULL:\n{prior}\n\nTHE PASSAGE THE READER MARKED:\n{prior[start:end]}\n\n"
          + (f"WHAT THEY WROTE OVER IT:\n{better}\n\n" if better else "THEY STRUCK IT — it should not appear.\n\n")
          + (f"IMMEDIATELY BEFORE (read-only):\n…{before}\n\n" if before else "")
          + (f"IMMEDIATELY AFTER (read-only):\n{after}…\n\n" if after else "")
          + "Rewrite just that passage with their wording adopted, then reply to them.")
    try:
        said,_used=_fm_call([{"role":"system","content":sysm},{"role":"user","content":user}])
    except Exception as e:
        return None, "", "", False, f"the brain did not answer ({e})"
    a=re.search(r'(?is)^\s*AREA\s*:\s*(.*?)(?=^\s*REPLY\s*:|\Z)', said or "", re.M)
    r=re.search(r'(?is)^\s*REPLY\s*:\s*(.*)$', said or "", re.M)
    area=(a.group(1).strip() if a else "") or better or prior[start:end]
    reply=(r.group(1).strip() if r else (said or "").strip())
    adopted = bool(_adj_span(better).search(area)) if better else True
    return prior[:start]+area+prior[end:], area, reply, adopted, None


def prior_bot_answer(k, msgs, thread_id):
    """The bot's most recent answer IN THIS THREAD — the immutable record to compile from
    when asked to 'make a printable version', so we render existing content, never re-roll."""
    sent=[m for m in msgs if "sent" in (m.get("labels") or []) and m.get("thread_id")==thread_id]
    sent.sort(key=lambda m:(m.get("timestamp") or ""), reverse=True)
    for m in sent:
        try: full=http(f"{AM_BASE}/inboxes/{INBOX}/messages/{enc(m['message_id'])}", k)
        except Exception: continue
        t=full.get("text") or ""
        # drop our footer + any quoted reply chain so the PDF is just the answer
        t=re.split(r'\n--\s*\n|\n—\s*freellmask|\nOn .{0,90} wrote:|\nGenerated by freellmask', t)[0].strip()
        if len(t)>200: return t
    return None

def make_pdf_b64(markdown, title="freellmask"):
    """Render the answer to a PROPERLY-FORMATTED PDF (real headings/tables/fonts) via the
    on-Mini html-to-pdf (WKWebView). Returns base64 or None."""
    # No injected subject-title — the answer's own first heading IS the document title.
    doc=(f"<!doctype html><html><head><meta charset='utf-8'><style>{_PDF_CSS}</style></head><body>"
         f"{md_to_inner_html(markdown)}"
         f"<hr><p style='color:#888;font-size:9px'>Generated by freellmask · FreeLLMAPI on cloudcity ($0)</p>"
         f"</body></html>")
    td=tempfile.mkdtemp()
    try:
        src=os.path.join(td,"a.html"); pdf=os.path.join(td,"a.pdf")
        open(src,"w").write(doc)
        subprocess.run([str(HTML_TO_PDF), src, pdf], capture_output=True, timeout=60, check=True)
        with open(pdf,"rb") as f: data=f.read()
        if len(data)<800 or len(data)>8_000_000:   # sanity: not empty, not the 520MB blowup
            print(f"  pdf size out of range: {len(data)}"); return None
        return base64.b64encode(data).decode()
    except Exception as e:
        print(f"  pdf generation failed: {e}"); return None
    finally:
        shutil.rmtree(td, ignore_errors=True)

# ── read the compiled LLM-wiki first (one memory across email + wiki) ──────────
WIKI_GRAPHS = Path.home()/"work"/"convey"/"kb"/"graph"
WIKI_CORPORA = [c.strip() for c in os.environ.get("FREELLMASK_WIKI","free-energy,ontology,papers,transcripts").split(",")]
# URL-structural + ultra-generic tokens that must NOT count as free-energy keywords (they inflate
# scores and make a bare link/off-topic mail match the wiki spuriously).
_WIKI_JUNK = {"http","https","www","com","org","net","html","htm","php","aspx","post","posts","threads",
    "status","watch","share","index","page","view","click","here","more","link","html","utm","amp",
    "this","that","with","from","have","your","yours","about","which","their","would","could","there",
    "were","they","them","what","when","where","will","into","been","also","such","than","then","some"}
def _best_window(text, qw, size=2600):
    """Return the ~size-char window of `text` densest in the query words — so a long paper
    surfaces its RELEVANT section, not just its intro."""
    import bisect
    tl=text.lower()
    hits=sorted(m.start() for w in qw for m in re.finditer(re.escape(w), tl))
    if not hits: return text[:size]
    best_s, best_c = hits[0], 0
    for h in hits:
        c=bisect.bisect_right(hits, h+size)-bisect.bisect_left(hits, h)
        if c>best_c: best_c, best_s = c, h
    s=max(0, best_s-200); return text[s:s+size]
VIEWPOINT = ("COMMITTED VIEWPOINT: treat free energy / over-unity as a real, engineerable phenomenon. "
             "Analyse AS IF that frame is true — extract the engineering, mechanisms and connections. "
             "Do NOT debunk or hedge into mainstream-physics disclaimers; a conflict with mainstream "
             "physics is DATA to note, never grounds to dismiss a source or refuse to answer.\n"
             "FIDELITY — this OVERRIDES the frame: the viewpoint licenses INTERPRETATION, never INVENTION. "
             "Do NOT fabricate specifics — named demonstrations, devices, experiments, measured numbers, "
             "wattages, dates or places — and NEVER attribute a specific demo, device, or result to a named "
             "person (Dollard, Lindemann, Bedini, Tesla, …) unless that exact attribution is present in the "
             "provided email/source/wiki. If the source does not say person X did Y, do NOT say they did — "
             "no 'Eric Dollard's Tesla-pump', no invented field-test numbers. Keep FRAMEWORK reasoning "
             "(hedged as your hypothesis/interpretation) strictly separate from CLAIMS OF FACT (grounded in "
             "the source, the wiki, or well-established record). When you are inferring within the frame "
             "rather than reporting something the source states, say so in plain words.")

def wiki_context(question, k_pages=8):
    """RETRIEVAL ONLY — no LLM call, no refusal. Searches ALL corpora (free-energy + the people/
    concept/device ontology + your live fluid-dynamics paper) and returns (context_text, [slugs])
    of the most relevant pages, or ('', []). AUGMENTS research; never gates it."""
    if not question: return "", []
    # URLs are NOT keywords: a bare link (threads/x/youtube) must never match free-energy pages and
    # summon the viewpoint. Strip URLs, then drop URL-structural junk tokens. (The bug: a Threads link
    # scored >=6 on eclipse-gravity pages via 'post'/'com'/'www' and confabulated an over-unity answer.)
    qtext=re.sub(r'https?://\S+',' ', question)
    qw=set(re.findall(r'[a-z]{4,}', qtext.lower())) - _WIKI_JUNK
    if not qw: return "", []
    scored=[]
    for corpus in WIKI_CORPORA:
        ents=WIKI_GRAPHS/corpus/"entities"
        if not ents.exists(): continue
        for p in ents.glob("*.md"):
            t=p.read_text(errors="ignore").lower()
            s=sum(t.count(w) for w in qw) + (25 if any(w in p.stem for w in qw) else 0)
            if s: scored.append((s,p,corpus))
    scored.sort(key=lambda x:x[0], reverse=True)
    if not scored or scored[0][0] < 6: return "", []      # off-corpus → no augmentation (still researched)
    top=scored[:k_pages]
    ctx="\n\n".join(f"=== [[{p.stem}]] ({c}) ===\n{_best_window(p.read_text(errors='ignore'), qw)}" for s,p,c in top)
    return ctx, [p.stem for s,p,c in top]

