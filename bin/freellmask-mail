# ── ACCESS TIERS + APPROVAL / ALLOWLIST ─────────────────────────────────────────────────────────
# cloudcity-llm@ is a PUBLIC inbox. Each SpaceCard has an `access`: "open" (anyone answered —
# free-energy, envoy-protocol, general) or "approval" (default for personal spaces). An UNKNOWN sender
# hitting an approval-space is HELD: Esa is emailed "so-and-so sent this, r u sure?"; on his OK the
# sender is whitelisted and the held message is released (answered on the next poll). Owner is always
# allowed. Private-corpus spaces (health/hyp) additionally only serve their CORPUS to the owner.
FA_SPACES_CONFIG    = Path.home()/"work"/"comms"/"queue"/"fa-spaces-config.json"      # private SpaceCards (gitignored)
FA_ALLOWLIST        = Path.home()/"work"/"comms"/"queue"/"fa-spaces-allowlist.json"   # {"emails":[...]} approved senders
FA_APPROVAL_PENDING = Path.home()/"work"/"comms"/"queue"/"fa-approval-pending.jsonl"  # held requests awaiting Esa's ok

def _load_spaces_config():
    """Merge private/override SpaceCards from the gitignored local config into SPACECARDS. If the file
    is missing (e.g. not synced yet), the private spaces simply don't exist — a fail-SAFE: no private
    corpus can be served because the card (and its skill_dir) isn't present."""
    if FA_SPACES_CONFIG.exists():
        try:
            data=json.loads(FA_SPACES_CONFIG.read_text())
            for sid,card in (data.get("spaces") or data).items():
                if isinstance(card, dict): SPACECARDS[sid]=card
        except Exception as e:
            print(f"fa-spaces-config load error: {e}")
_load_spaces_config()

def _sender_email(frm):
    m=re.search(r"<([^>]+)>", frm or ""); return (m.group(1) if m else (frm or "")).strip().lower()
def _load_allowlist():
    if FA_ALLOWLIST.exists():
        try: return set(a.strip().lower() for a in json.loads(FA_ALLOWLIST.read_text()).get("emails",[]) if a.strip())
        except Exception: return set()
    return set()
def _add_allowlist(email):
    cur=[]
    if FA_ALLOWLIST.exists():
        try: cur=json.loads(FA_ALLOWLIST.read_text()).get("emails",[])
        except Exception: cur=[]
    if email and email.lower() not in [c.lower() for c in cur]:
        cur.append(email)
        FA_ALLOWLIST.parent.mkdir(parents=True, exist_ok=True)
        FA_ALLOWLIST.write_text(json.dumps({"emails":cur}, indent=2))
def _is_allowed(frm):
    return _is_owner(frm) or (_sender_email(frm) in _load_allowlist())
def _space_access(space):
    return (SPACECARDS.get(space) or {}).get("access","approval")

def _pending_add(rec):
    try:
        FA_APPROVAL_PENDING.parent.mkdir(parents=True, exist_ok=True)
        with FA_APPROVAL_PENDING.open("a") as fh: fh.write(json.dumps(rec)+"\n")
    except Exception: pass
def _pending_all():
    if not FA_APPROVAL_PENDING.exists(): return []
    out=[]
    for l in FA_APPROVAL_PENDING.read_text(errors="ignore").splitlines():
        if l.strip():
            try: out.append(json.loads(l))
            except Exception: pass
    return out
def _pending_remove(pred):
    keep=[r for r in _pending_all() if not pred(r)]
    try: FA_APPROVAL_PENDING.write_text("".join(json.dumps(r)+"\n" for r in keep))
    except Exception: pass

def _parse_owner_approval(body):
    """From an OWNER email, detect an approval/denial + target address. Returns (action, email) with
    action in {approve, deny, None}. Only fires when a target is resolvable (explicit 'approve x@y' or
    a quoted 'PENDING-FROM: x@y'), so a normal Esa email starting with 'ok'/'yes' is NOT an approval."""
    b=body or ""
    m=re.search(r'(?im)^\s*(approve|deny|reject)\s+([^\s<>]+@[^\s<>]+)', b)
    if m: return ("deny" if m.group(1).lower() in ("deny","reject") else "approve"), m.group(2).strip().lower()
    pf=re.search(r'PENDING-FROM:\s*([^\s<>]+@[^\s<>]+)', b)
    if pf and re.search(r'(?im)^\s*(approve|yes|ok|okay|whitelist)\b', b): return "approve", pf.group(1).strip().lower()
    if pf and re.search(r'(?im)^\s*(deny|no|reject|decline)\b', b): return "deny", pf.group(1).strip().lower()
    return None, None

def _email_owner_approval(k, sender_frm, sender_em, space, subj, preview, pend_id):
    """Ask Esa to approve an unknown sender who hit a gated space."""
    txt=(f"A new sender emailed cloudcity-llm and routed to your '{space}' space (gated).\n\n"
         f"From: {sender_frm}\nSpace: {space}\nSubject: {subj}\n\nPreview:\n{preview[:600]}\n\n"
         f"To APPROVE (whitelist them + answer their message), reply with:  approve {sender_em}\n"
         f"  (or just reply 'approve' / 'yes' to this email).\n"
         f"To DECLINE, ignore this (or reply 'deny {sender_em}').\n\n"
         f"PENDING-FROM: {sender_em}\nPENDING-ID: {pend_id}\n")
    html=("<p>A new sender emailed cloudcity-llm and routed to your <b>"+_htmlmod.escape(space)+
          "</b> space (gated).</p>"
          f"<p><b>From:</b> {_htmlmod.escape(sender_frm)}<br><b>Subject:</b> {_htmlmod.escape(subj)}</p>"
          f"<pre style='white-space:pre-wrap;background:#f6f6f6;padding:8px'>{_htmlmod.escape(preview[:600])}</pre>"
          "<p>To <b>approve</b> (whitelist + answer), reply <code>approve "+_htmlmod.escape(sender_em)+
          "</code> — or just <code>approve</code>/<code>yes</code>. To decline, ignore this.</p>"
          f"<p style='color:#888;font-size:12px'>PENDING-FROM: {_htmlmod.escape(sender_em)} · PENDING-ID: {pend_id}</p>")
    try:
        http(f"{AM_BASE}/inboxes/{INBOX}/messages/send", k, "POST",
             {"to":[FORWARD_TO],"subject":f"Approve? {sender_em} → {space} space","text":txt,"html":html})
        return True
    except Exception as e:
        print(f"  approval email failed: {e}"); return False

def _llm_classify_space(subject, body):
    """The accurate fallback for 'which space?' — ask the FreeLLMAPI brain to pick ONE space id from
    the SpaceCard vocabulary, used ONLY when keyword scoring is inconclusive (so no cost on clearly-
    routed mail). Same brain the convey soft legs use to emit their SPACE hint. Returns a valid id
    or '' (never raises into routing). Gated + cheap: 8 tokens, temp 0, content clipped."""
    ids=list(SPACECARDS.keys())
    txt=f"Subject: {subject or ''}\n\n{(body or '')[:6000]}"
    sysm=("Classify this message into exactly ONE space. Reply with ONLY one id from this list, nothing "
          "else: "+", ".join(ids)+".")
    try:
        out,_=_fm_call([{"role":"system","content":sysm},{"role":"user","content":txt}],
                       max_tokens=8, temperature=0)
    except Exception:
        return ""
    m=re.search(r'([a-z][a-z\-]+)', (out or "").lower())
    return m.group(1) if (m and m.group(1) in SPACECARDS) else ""

def route_space(sender, subject, body, wslugs=None):
    """Pick ONE primary space. Explicit signals win (sender identity, [space:X] tag, a penpal block);
    then strong keyword scoring; then — when keywords are INCONCLUSIVE — an LLM classifier (the same
    space brain convey's soft legs use); then the free-energy WIKI match; else general. NEVER silently
    defaults to free-energy — it only wins when routed. Returns (space_id, reason)."""
    s=(sender or "").lower(); text=f"{subject or ''}\n{body or ''}".lower()
    mtag=re.search(r'(?:\[space:|x-space:\s*|space=)\s*([a-z\-]+)', text)
    if mtag and mtag.group(1) in SPACECARDS: return mtag.group(1), "explicit-tag"
    env=SPACECARDS["envoy-protocol"]
    if any(tok in s for tok in env["senders"]) or "```penpal" in (body or "") or "penpal-protocol-v0" in text:
        return "envoy-protocol", "sender/penpal-block"
    best, best_s = None, 0
    for sid, card in SPACECARDS.items():
        sc=sum(1 for w in (card.get("keywords") or []) if w in text)
        if sc>best_s: best, best_s = sid, sc
    if best and best_s>=2: return best, f"keywords:{best}({best_s})"
    # keyword scoring inconclusive → ASK the brain (fixes 'realizing what space to access'), gated.
    if os.environ.get("FREELLMASK_MAIL_LLM_ROUTE","1")!="0":
        llm=_llm_classify_space(subject, body)
        if llm: return llm, "llm-classify"
    if wslugs: return "free-energy", "wiki-match"
    if best and best_s>=1: return best, f"keywords:{best}({best_s})"
    return "general", "default"

def is_protocol_space(sender, subject, body):
    return route_space(sender, subject, body, wslugs=None)[0] == "envoy-protocol"

_SKILL_SKIP = {".git","node_modules",".venv","venv","__pycache__",".pytest_cache",".mypy_cache","dist","build"}
def _skill_lens(d):
    """The skill's own instruction file = the lens (SKILL.md / skill.md / CLAUDE.md, capped)."""
    for fn in ("SKILL.md","skill.md","CLAUDE.md"):
        f=d/fn
        if f.exists():
            try: return f.read_text(errors="ignore")[:4000]
            except Exception: pass
    return ""
def skill_context(question, skill_dir, k_pages=6, scan_cap=1500):
    """RETRIEVAL ONLY for a skill-backed space: score the markdown under ~/work/<skill> by keyword
    overlap and return (context_text, [names], lens_text). Bounded (skips VCS/dep dirs, caps file
    count + size) so a big repo like ~/work/apple stays cheap. AUGMENTS the answer; never gates it."""
    d=Path(skill_dir).expanduser()
    if not d.exists(): return "", [], ""
    lens=_skill_lens(d)
    if not question: return "", [], lens
    qw=set(re.findall(r'[a-z]{4,}', question.lower()))
    if not qw: return "", [], lens
    scored=[]; scanned=0
    for p in d.rglob("*.md"):
        if scanned>=scan_cap: break
        if _SKILL_SKIP & set(p.parts): continue
        try:
            if p.stat().st_size>400000: continue
            t=p.read_text(errors="ignore").lower()
        except Exception: continue
        scanned+=1
        s=sum(t.count(w) for w in qw) + (25 if any(w in p.stem.lower() for w in qw) else 0)
        if s: scored.append((s,p))
    scored.sort(key=lambda x:x[0], reverse=True)
    if not scored or scored[0][0]<4: return "", [], lens
    top=scored[:k_pages]
    ctx="\n\n".join(f"=== {p.stem} ===\n{_best_window(p.read_text(errors='ignore'), qw)}" for s,p in top)
    return ctx, [p.stem for s,p in top], lens

# ── per-space persistent memory (federated namespaces; the Gate 6/7 substrate) ──
def _space_mem_file(ns):
    p=SPACE_MEM_ROOT/ns; p.mkdir(parents=True, exist_ok=True); return p/"memory.jsonl"
def space_mem_write(ns, rec):
    try:
        with _space_mem_file(ns).open("a") as fh: fh.write(json.dumps(rec)+"\n"); return True
    except Exception: return False
def space_mem_read(ns):
    f=_space_mem_file(ns)
    if not f.exists(): return []
    out=[]
    for l in f.read_text(errors="ignore").splitlines():
        if l.strip():
            try: out.append(json.loads(l))
            except Exception: pass
    return out

def _uid(): return uuid.uuid4().hex[:16]
def _penpal_field(body, field):
    m=re.search(r'"'+re.escape(field)+r'"\s*:\s*"([^"]+)"', body or "")
    return m.group(1) if m else None

def compose_protocol_reply(full, body, to_email):
    """DETERMINISTIC clean_protocol reply for the envoy-protocol space: one status line + one
    penpal-protocol-v0 block composed IN CODE (schema-valid by construction — real IDs, allowed
    evidence type, plain-string claims), and NOTHING else. No LLM persona, no wiki, no scratchpad,
    no forced six-heading template — so nemotron token-salad can't contaminate the protocol channel
    and Penpal Gate 2 passes deterministically. Also services the memory gates: a 'declared memory
    bootstrap' rule is WRITTEN to the peers/cybe/envoy namespace, and a 'memory retrieval test'
    READS it back (source: persistent_memory) — Gates 6 & 7. Returns (text, html)."""
    ns=SPACECARDS["envoy-protocol"]["memory_ns"]
    conv=_penpal_field(body, "conversation_id") or ""
    if (not conv) or re.search(r'(?i)replace|unique_id|placeholder|xxxx', conv):
        conv=f"conv-cloudcity-{_uid()}"   # never echo a placeholder id (Penpal flags placeholder_identifier)
    rcpt=f"rcpt-cloudcity-{_uid()}"
    subj=full.get("subject") or "Capability Discovery & First Contact"
    if not subj.lower().startswith("re:"): subj="Re: "+subj
    low=f"{full.get('subject','')}\n{body}".lower()
    stored=False
    claims=["The responder used current email and prior thread context only.",
            "No external actions were taken.","No wiki retrieval was used.",
            "No persona or tone mode was used in this reply."]
    rule=_penpal_field(body, "rule")
    if rule and ("memory_candidate" in (body or "") or "memory bootstrap" in low or "declared_memory" in low):
        stored=space_mem_write(ns, {"type":"peer_protocol_rule","peer":"Cybe / francois@agentmail.to",
                                    "rule":rule,"ts":time.strftime("%Y-%m-%dT%H:%M:%S")})
        claims=[f"Stored a peer communication rule in persistent memory namespace '{ns}'." if stored
                else f"Memory write to namespace '{ns}' was attempted but failed; treat as not stored.",
                "memory_write_performed: %s (authority: explicit_user_requested_memory_bootstrap)." % ("true" if stored else "false"),
                "The rule is retrievable in a future fresh thread from this namespace." if stored else
                "No rule was persisted; a working storage layer is required.",
                "No external actions were taken. No wiki retrieval was used. No persona mode was used."]
    elif "memory retrieval" in low or ("remember" in low and "rule" in low):
        rules=[r for r in space_mem_read(ns) if r.get("rule")]
        if rules:
            claims=[f"Retrieved a remembered Cybe/ENVOY communication rule from persistent memory namespace '{ns}'.",
                    "Remembered rule: "+rules[-1].get("rule",""),
                    "source: persistent_memory (not current_email, not prior_thread, not inference).",
                    "No quoted prior-thread context was relied upon."]
        else:
            claims=[f"No persistent memory rule was found for Cybe in namespace '{ns}'.",
                    "source: unknown. No rule was inferred or invented.",
                    "No quoted prior-thread context was relied upon."]
    block={"version":"penpal-protocol-v0","kind":"report","message_id":f"msg-cloudcity-{_uid()}",
           "conversation_id":conv,
           "sender":{"contact_email":"cloudcity-llm@agentmail.to","node":"cloudcity","person":"cloudcity-llm"},
           "recipient":{"contact_email":to_email},"subject":subj,
           "summary":"Clean protocol response with declared context sources and visible receipt.",
           "claims":claims,"evidence":[{"type":"log_ref","ref":rcpt}],
           "generated_by":"tool","requested_action":"human_review","reply_expectations":"human_review",
           "safety_level":"untrusted_review"}
    lead="Operating in clean_protocol mode. No wiki retrieval, persona mode, or external action was used."
    if stored: lead+=f" One persistent-memory write was performed in namespace '{ns}' as explicitly requested."
    txt=lead+"\n\n```penpal\n"+json.dumps(block, indent=2)+"\n```"
    html=("<pre style=\"white-space:pre-wrap;font-family:ui-monospace,Menlo,monospace;font-size:13px\">"
          +_htmlmod.escape(txt)+"</pre>")
    return txt, html

def inbound_atts_b64(k, mid, atts):
    """Re-download each inbound attachment via its AgentMail signed URL and return them as
    AgentMail send-attachments [{filename, content_type, content(base64)}] — so the original files
    can ride along on a reply or a forward. Skips files over MAX_ATT. Best-effort per file."""
    out=[]
    for att in (atts or []):
        aid=att.get("attachment_id"); name=att.get("filename","attachment"); sz=att.get("size") or 0
        if not aid or sz>MAX_ATT:
            continue
        try: raw=_att_bytes(k, mid, aid)
        except Exception: raw=None
        if not raw:
            continue
        out.append({"filename":name,
                    "content_type":att.get("content_type") or "application/octet-stream",
                    "content":base64.b64encode(raw).decode()})
    return out

def forward_to_esa(k, full, mid, question, answer, atts):
    """Forward the FULL exchange to Esa WITH the sender's inbound attachments re-attached — so when a
    friend (e.g. Zachary) emails cloudcity-llm@ some 'hot stuff', the ATTACHMENTS reach esaruoho@,
    not just the answer (which BCC already carries). Best-effort; never blocks the reply. Returns
    True if forwarded."""
    if not FORWARD_TO:
        return False
    sender=(full.get("from") or "").strip()
    subj=full.get("subject") or "(no subject)"
    out_atts=inbound_atts_b64(k, mid, atts)
    text=(f"Forwarded from {sender}\nSubject: {subj}\n\n"
          f"--- Their message ---\n{question or '(no body)'}\n\n"
          f"--- FreeLLMAPI answer ---\n{answer}\n"
          + (f"\n({len(out_atts)} attachment(s) re-attached.)\n" if out_atts else ""))
    html=(f"<p><b>Forwarded from {sender}</b><br>Subject: {subj}</p>"
          f"<h3>Their message</h3><pre style='white-space:pre-wrap'>{(question or '(no body)')}</pre>"
          f"<h3>FreeLLMAPI answer</h3>{md_to_inner_html(answer)}"
          + (f"<p style='color:#888'>{len(out_atts)} attachment(s) re-attached.</p>" if out_atts else ""))
    body={"to":[FORWARD_TO],"subject":f"Fwd: {subj}","text":text,"html":html}
    if out_atts:
        body["attachments"]=out_atts
    try:
        http(f"{AM_BASE}/inboxes/{INBOX}/messages/send", k, "POST", body)
        return True
    except Exception:
        return False

# ── Auto-trigger the transcript belt: any YouTube URL in an inbound email is dropped onto
# the convey→whisp pipeline (whisp-submit), which dedups against catalog.yaml + the queue so
# already-transcribed videos are never re-whispered. This is what SHOULD have happened when an
# email mentioned USP/Russell videos instead of just summarising the page. Best-effort, never blocks.
WHISP_SUBMIT = os.path.expanduser("~/work/whisp-transcripts/whisp-submit")
# Transcript graph sweeper: belt-and-suspenders alongside whisp-worker's per-job auto-feed.
# Periodically feeds any NEW transcripts into kb/graph/transcripts (pages only, no rebuild — the
# bot reads pages directly). Catches in-flight batches without touching/restarting the worker.
TFEED = os.path.expanduser("~/work/apple/bin/fa-transcript-feed")
TFEED_EVERY = int(os.environ.get("FREELLMASK_TFEED_EVERY","900"))   # seconds between sweeps
_last_tfeed=[0.0]
def transcript_sweep(verbose=False):
    now=time.time()
    if now-_last_tfeed[0] < TFEED_EVERY or not os.path.exists(TFEED): return
    _last_tfeed[0]=now
    try:
        subprocess.Popen(["python3", TFEED, "--no-rebuild"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if verbose: print("  🧹 transcript sweep launched (feeds new transcripts into the graph)")
    except Exception: pass
_YT_RE = re.compile(
    r'https?://(?:www\.)?(?:youtube\.com/(?:watch\?[^\s<>"\')\]]*\bv=[\w-]{11}|shorts/[\w-]{11}|'
    r'playlist\?[^\s<>"\')\]]*\blist=[\w-]+|@[\w.-]+|channel/[\w-]+|c/[\w.-]+|user/[\w.-]+)|youtu\.be/[\w-]{11})'
    r'[\w\-?=&/@.%]*', re.I)

def youtube_urls(text):
    if not text: return []
    seen=set(); out=[]
    for u in _YT_RE.findall(text):
        u=u.rstrip('.,);]>\'"')
        if u not in seen: seen.add(u); out.append(u)
    return out

_LINK_FILLER=(r'(?i)\b(fwd|fw|re|watch|see|this|that|these|those|video|vid|clip|youtube|yt|shorts?|'
              r'link|url|please|pls|convey|transcribe|transcript|transcription|analyse|analyze|analysis|'
              r'summar\w*|thoughts?|check|out|the|a|an|and|or|of|in|on|for|to|is|it|my|your|'
              r'hey|hi|hello|moi|terve|kiitos|thanks?|cheers|sent|from|iphone|ipad|mail|esa|ruoho)\b')

def _bare_link_body(body, subject=""):
    """True when the email body carries NO actual request of its own — just the link (plus filler, a
    signature, or a repeat of the subject/video title).

    The SUBJECT is deliberately subtracted: for a shared YouTube mail the subject IS the video title, so
    a title echoed in the body is not a question either. A title is never a request — treating one as a
    question is what made the bot answer an untranscribed video (2026-07-28)."""
    txt=strip_signature(body or '')          # a sig ("— Http://patreon.com/esaruoho") is not a request
    txt=re.sub(r'(?i)\b(?:https?://|www\.)\S+', ' ', txt)   # case-INsensitive: Apple Mail capitalises "Http://"
    txt=re.sub(_LINK_FILLER, ' ', txt)
    subj_words={w for w in re.split(r'[^A-Za-z0-9]+', (subject or '').lower()) if len(w)>1}
    words=[w for w in re.split(r'[^A-Za-z0-9]+', txt) if w and w.lower() not in subj_words]
    return len(" ".join(words)) < 12

def _youtube_id(u):
    m=(re.search(r'(?:v=|youtu\.be/|shorts/|embed/)([\w-]{11})', u or "")
       or re.search(r'youtube\.com/watch\?[^\s]*v=([\w-]{11})', u or "", re.I))
    return m.group(1) if m else ""

def _youtube_watch_url(u):
    vid=_youtube_id(u)
    return f"https://www.youtube.com/watch?v={vid}" if vid else (u or "")

def _youtube_embed_url(u):
    vid=_youtube_id(u)
    return f"https://www.youtube.com/embed/{vid}" if vid else ""

def youtube_metadata(u):
    """Best-effort YouTube metadata for the receipt email. No LLM/token usage: yt-dlp first,
    then YouTube oEmbed for title only. Description is metadata, not transcript content."""
    watch=_youtube_watch_url(u)
    meta={"url":watch, "title":"", "description":"", "author":"", "embed_url":_youtube_embed_url(u)}
    try:
        r=subprocess.run(["yt-dlp","--skip-download","--dump-single-json","--no-warnings",watch],
                         capture_output=True, text=True, timeout=45)
        if r.returncode == 0 and (r.stdout or "").strip():
            d=json.loads(r.stdout)
            meta["title"]=(d.get("title") or "").strip()
            meta["description"]=(d.get("description") or "").strip()
            meta["author"]=(d.get("channel") or d.get("uploader") or "").strip()
            return meta
    except Exception:
        pass
    try:
        q=urllib.parse.urlencode({"url":watch,"format":"json"})
        req=urllib.request.Request("https://www.youtube.com/oembed?"+q, headers={"User-Agent":"freellmask/1.0"})
        with urllib.request.urlopen(req, timeout=20) as r: d=json.load(r)
        meta["title"]=(d.get("title") or "").strip()
        meta["author"]=(d.get("author_name") or "").strip()
    except Exception:
        pass
    return meta

def youtube_receipt(urls, subject="", queued=0):
    """Code-composed response for bare YouTube shares: direct URL + title + description + embed.
    This intentionally does NOT analyse the video; transcript-grounded analysis is a later mail."""
    metas=[youtube_metadata(u) for u in (urls or [])]
    if not metas:
        metas=[{"url":"", "title":subject or "YouTube video", "description":"", "author":"", "embed_url":""}]
    text_parts=[]; html_parts=[]
    for m in metas:
        title=m.get("title") or subject or m.get("url") or "YouTube video"
        desc=m.get("description") or ""
        if len(desc)>4000: desc=desc[:3997].rstrip()+"..."
        author=m.get("author") or ""
        url=m.get("url") or ""
        embed=m.get("embed_url") or ""
        text_parts.append("\n".join(x for x in (
            f"YouTube video: {title}",
            f"Channel: {author}" if author else "",
            f"URL: {url}" if url else "",
            f"Embed: {embed}" if embed else "",
            "",
            "Description:",
            desc or "(no description found)",
        ) if x is not None))
        html_parts.append(
            "<hr>"
            f"<h2>{_htmlmod.escape(title)}</h2>"
            + (f"<p><b>Channel:</b> {_htmlmod.escape(author)}</p>" if author else "")
            + (f'<p><b>URL:</b> <a href="{_htmlmod.escape(url)}">{_htmlmod.escape(url)}</a></p>' if url else "")
            + (f'<iframe width="560" height="315" src="{_htmlmod.escape(embed)}" '
               'title="YouTube video player" frameborder="0" '
               'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" '
               'allowfullscreen></iframe>' if embed else "")
            + "<h3>Description</h3>"
            + f'<pre style="white-space:pre-wrap;font-family:-apple-system,Segoe UI,sans-serif">{_htmlmod.escape(desc or "(no description found)")}</pre>'
        )
    status=("Queued for transcript analysis; a separate transcript-grounded analysis email will follow when whisp finishes."
            if queued else
            "Transcript analysis is pending; if this video is already transcribed, the transcript mailer will send the grounded analysis.")
    text=status+"\n\n"+"\n\n---\n".join(text_parts)
    html=('<div style="font-family:-apple-system,Segoe UI,sans-serif;line-height:1.5;font-size:14px">'
          f"<p>{_htmlmod.escape(status)}</p>"+"".join(html_parts)+"</div>")
    return text, html

_GD_RE = re.compile(r'https?://(?:drive|docs)\.google\.com/[^\s<>"\')\]]+', re.I)
def gdrive_urls(text):
    """Google Drive / Docs links in an email body (folders, files, open?id=)."""
    if not text: return []
    seen=set(); out=[]
    for u in _GD_RE.findall(text):
        u=u.rstrip('.,);]>\'"')
        if u not in seen: seen.add(u); out.append(u)
    return out
def gdrive_id(u):
    """Pull the Drive id from a folder / file / open?id= URL (mirrors ~/work/apple/bin/gdrive)."""
    m=(re.search(r'/folders/([\w-]+)', u) or re.search(r'/file/d/([\w-]+)', u)
       or re.search(r'/document/d/([\w-]+)', u) or re.search(r'[?&]id=([\w-]+)', u)
       or re.search(r'/d/([\w-]+)', u))
    return m.group(1) if m else ""

CONVEY_BIN = os.path.expanduser("~/work/apple/bin/convey")
_CHATGPT_RE = re.compile(r'https?://chatgpt\.com/(?:s|share)/[A-Za-z0-9_-]+', re.I)
def chatgpt_urls(text):
    """ChatGPT SHARE links in an email body: /s/t_… post snapshots and /share/<uuid> full threads."""
    if not text: return []
    seen=set(); out=[]
    for u in _CHATGPT_RE.findall(text):
        u=u.rstrip('.,);]>\'"')
        if u not in seen: seen.add(u); out.append(u)
    return out
def _chatgpt_id(u):
    m=re.search(r'/(?:s|share)/([A-Za-z0-9_-]+)', u); return m.group(1) if m else ""

def convey_chatgpt(urls, verbose=False):
    """Hoover + multi-brain-analyse each ChatGPT share URL via `convey chatgpt --analyze`
    (zero-token fetch/decode + MLX/Qwen + Apple FoundationModels + FreeLLMAPI). Returns
    (folded_context, attachments, note, done). Best-effort — never raises into the poll loop.
    The conversation.md is folded into the answer context so THIS agent's own FreeLLMAPI reply
    is grounded in the real conversation too (multi-place, as intended)."""
    folded=[]; atts=[]; done=0
    for u in urls:
        try:
            r=subprocess.run([CONVEY_BIN,"chatgpt",u,"--analyze"], capture_output=True, text=True, timeout=700)
            if verbose and r.returncode: print(f"  🤖 convey chatgpt rc={r.returncode}: {(r.stderr or '')[:160]}")
        except Exception as e:
            if verbose: print(f"  🤖 convey chatgpt error: {e}"); continue
        sid=_chatgpt_id(u)
        home=Path.home()/"work"/"convey-packs"/"chatgpt"/sid
        conv=home/"conversation.md"; anal=home/"analysis.md"
        if conv.exists():
            done+=1
            folded.append(f"=== ChatGPT conversation hoovered from {u} ===\n"+conv.read_text(encoding='utf-8',errors='ignore'))
            atts.append({"filename":f"chatgpt-{sid[:20]}.md","content_type":"text/markdown",
                         "content":base64.b64encode(conv.read_bytes()).decode()})
            if anal.exists():
                folded.append("=== Multi-brain analysis (MLX/Qwen · Apple FoundationModels · FreeLLMAPI) ===\n"
                              +anal.read_text(encoding='utf-8',errors='ignore'))
                atts.append({"filename":f"chatgpt-{sid[:20]}-analysis.md","content_type":"text/markdown",
                             "content":base64.b64encode(anal.read_bytes()).decode()})
        elif verbose:
            print(f"  🤖 convey chatgpt produced no conversation.md for {u} (private/expired?)")
    note=(f"\n\n---\n🤖 **Hoovered {done} ChatGPT conversation(s)** to markdown and analysed across "
          f"MLX/Qwen, Apple FoundationModels, and FreeLLMAPI — both files attached.") if done else ""
    return "\n\n".join(folded), atts, note, done

# ── ARCHIVE-PAGE MAIL IS NOT A TRANSCRIPTION REQUEST ────────────────────────────
# 2026-08-08: merlib-mirror/scripts/email_corpus_to_llm.py started mailing amasci.com
# pages here for analysis ("page 88 of 685"). Bill Beaty's pages are dense link dumps,
# so youtube_urls() harvested every embedded link and expand_playlists() enumerated the
# playlists behind them with NO cap → 1,041 whisp jobs, 175 sci-fi/horror feature films
# transcribed (~205 h of audio) before anyone noticed. A mirrored page that we mailed to
# OURSELVES for analysis is CONTENT TO READ, never a request to transcribe what it links.
_SELF_INBOXES = {"cloudcity-foundationmodels@agentmail.to", "cloudcity-llm@agentmail.to"}
# A mirror-page subject looks like "[amasci.com] SCIENCE HOBBYIST: HELP PAGE".
_SITE_SUBJ_RE = re.compile(r'^\s*\[[a-z0-9][a-z0-9.\-]*\.[a-z]{2,}\]')
# The corpus mailer's own body signature.
_CORPUS_BODY_RE = re.compile(r'reachable from the entry page|from the .* mirror', re.I)
# Extra belt-and-braces: hosts whose pages must never auto-queue their outbound links.
_WHISP_BLOCK_HOSTS = {h.strip().lower() for h in
                      os.environ.get("FA_WHISP_BLOCK_HOSTS", "amasci.com").split(",") if h.strip()}

def whisp_blocked_reason(from_addr, subject, body):
    """Why this email must NOT auto-queue the YouTube links it contains (or None to allow).
    Machine-generated archive/mirror pages are the blocked class — a human mailing a video
    link is still honoured exactly as before."""
    frm=(from_addr or "").lower()
    addr=re.search(r'<([^>]+)>', frm)
    addr=(addr.group(1) if addr else frm).strip()
    if addr in _SELF_INBOXES:
        return f"self-sent agent mail ({addr}) — archive page, not a transcription request"
    m=_SITE_SUBJ_RE.match(subject or "")
    if m:
        host=m.group(0).strip()[1:-1].lower()
        if host in _WHISP_BLOCK_HOSTS or _CORPUS_BODY_RE.search(body or ""):
            return f"mirror-page analysis mail for [{host}] — its outbound links are not requests"
    if _CORPUS_BODY_RE.search(body or ""):
        return "corpus-mailer page body — its outbound links are not requests"
    return None

# Hard ceiling on enumeration from ANY email (0 = unlimited). Even an allowed sender must
# not be able to turn one pasted channel URL into thousands of jobs by accident.
MAIL_PLAYLIST_CAP = int(os.environ.get("FA_PLAYLIST_CAP", "50"))

def expand_playlists(urls, cap=None):
    """A playlist/channel URL → its individual video URLs (yt-dlp --flat-playlist). Bare video
    URLs pass through. Capped at MAIL_PLAYLIST_CAP (FA_PLAYLIST_CAP, 0 = unlimited) — the
    uncapped version turned one amasci page into 1,041 whisp jobs on 2026-08-08."""
    if cap is None and MAIL_PLAYLIST_CAP > 0:
        cap = MAIL_PLAYLIST_CAP
    out=[]; seen=set()
    for u in urls or []:
        if re.search(r'(?:[?&]list=|/playlist\?|/channel/|/@|/c/|/user/)', u):
            try:
                r=subprocess.run(["yt-dlp","--flat-playlist","--print","url",u],
                                 capture_output=True, text=True, timeout=1200)
                vids=[v.strip() for v in (r.stdout or "").splitlines() if v.strip()]
            except Exception:
                vids=[u]   # enumeration failed → keep original (whisp-submit can still try --playlist)
            for v in (vids or [u]):
                if v not in seen: seen.add(v); out.append(v)
        elif u not in seen:
            seen.add(u); out.append(u)
    return out[:cap] if cap else out

def whisp_autosubmit(urls, verbose=False):
    """Drop YouTube URLs onto the whisp transcript belt. whisp-submit does its own dedup
    (catalog.yaml + queue), so the Lao-Russell-already-done case is handled there. Returns
    (queued_count, seen_count). Best-effort — never raises into the poll loop."""
    if not urls or not os.path.exists(WHISP_SUBMIT): return 0, 0
    queued=0
    for i in range(0, len(urls), 300):                       # batch — thousands of URLs (a whole
        batch=urls[i:i+300]                                  # channel) must not blow argv or one timeout
        try:
            r=subprocess.run([WHISP_SUBMIT, *batch], capture_output=True, text=True, timeout=900)
            queued+=len(re.findall(r"(?im)^\s*Queued \(", (r.stdout or "")+"\n"+(r.stderr or "")))
        except Exception as e:
            if verbose: print(f"  whisp-submit batch error: {e}")
    if verbose: print(f"  📼 whisp: queued {queued}/{len(urls)} url(s) in {(len(urls)+299)//300} batch(es)")
    return queued, len(urls)

def poll_once(verbose=True):
    transcript_sweep(verbose)   # periodically feed new transcripts into the graph (non-blocking)
    k=am_key(); st=load_state(); seen=OrderedSeen(st.get("seen",[]))
    listing=http(f"{AM_BASE}/inboxes/{INBOX}/messages?limit=50", k)
    replied_seed(k, listing.get("messages", listing if isinstance(listing,list) else []))
    replied_mids, replied_threads = replied_load()
    msgs=listing.get("messages", listing if isinstance(listing,list) else [])
    new=0
    for m in msgs:
        mid=m.get("message_id"); labels=m.get("labels",[]) or []
        if not mid or mid in seen: continue
        # only answer RECEIVED inbound mail — never our own sent replies (avoid loops)
        if "sent" in labels or m.get("from","").lower().find(INBOX.lower())>=0:
            seen.add(mid); continue
        # ANTI-LOOP 1: already answered once, ever → never answer again, whatever `seen` says.
        if mid in replied_mids:
            print(f"  ⊘ already replied (ledger) — not answering again: mid={mid}")
            seen.add(mid); continue
        # ANTI-LOOP 2: per-thread ceiling. More than THREAD_MAX_PER_HOUR replies in this thread within
        # the last hour = a storm, no matter the cause. Stop sending, log it, and mark handled.
        _th=m.get("thread_id")
        _recent=[t for t in replied_threads.get(_th, []) if time.time()-t < 3600]
        if _th and len(_recent) >= THREAD_MAX_PER_HOUR:
            print(f"  🛑 thread rate-limit ({len(_recent)}/h ≥ {THREAD_MAX_PER_HOUR}) — NOT replying: {(m.get('subject') or '')[:50]!r}")
            debug_log("thread-rate-limit", mid, m.get("subject","") or "",
                      note=f"{len(_recent)} replies to thread {_th} in the last hour; suppressed to stop a mail storm")
            seen.add(mid)
            st["seen"]=list(seen)[-SEEN_CAP:]; save_state(st)
            continue
        # CLAIM IT BEFORE DOING THE WORK. The ledger was only written AFTER a successful send, so the
        # whole span between picking a message and finishing its reply was unguarded — and the poll
        # runs every 45s. Generation used to take seconds; now the free gateway answers 429 with
        # Retry-After up to 545s, so that window grew to many minutes and the next dozen polls each
        # picked up the SAME message and answered it again. That is the Bifilar storm: one inbound
        # message, twelve replies, each in a fresh thread — which is also why the per-thread ceiling
        # never tripped, since every reply looked like a brand-new thread.
        #
        # The slower the brain gets, the wider the unguarded window: the storm was a race, and rate
        # limiting is what widened it. Claiming up front closes it. A claimed message that then fails
        # to send is a MISSED reply Esa can retrigger — strictly better than twelve duplicates.
        replied_add(mid, m.get("thread_id"), m.get("subject", "") or "")
        replied_mids.add(mid)
        replied_threads.setdefault(m.get("thread_id"), []).append(time.time())
        full=http(f"{AM_BASE}/inboxes/{INBOX}/messages/{enc(mid)}", k)
        # body: prefer extracted/plain text; fall back to HTML (forwards are often HTML-only)
        # AgentMail's `extracted_text` is USUALLY the clean body — but sometimes it extracts ONLY the
        # signature (e.g. 26 chars "-- Esa Ruoho +358…" for a newsletter whose real body is in `text`).
        # So DON'T blindly prefer it: use the full plain-text part when it's substantial, else take the
        # RICHEST of {extracted_text, text, html→text, preview}. (This was the "Harmony with nature" drop.)
        _et=full.get("extracted_text") or ""; _tx=full.get("text") or ""
        _ht=html_to_text(full.get("html")); _pv=full.get("preview") or ""
        raw_body=_tx if len(_tx)>=200 else max((_et,_tx,_ht,_pv), key=len)
        if not raw_body.strip() and full.get("html"):          # html_to_text choked on odd HTML → crude strip
            raw_body=re.sub(r'\s+',' ', _htmlmod.unescape(
                re.sub(r'(?is)<(script|style|head).*?</\1>|<[^>]+>',' ', full.get("html")))).strip()
        question=clean_forwarded_body(strip_signature(raw_body))  # drop sig + de-quote/de-noise forwards
        answer=""                                               # defined for the forward path (reformat branch never sets it, but only fires with no atts)
        is_penpal=False                                          # envoy/penpal (e.g. Francois) → always full-forward to Esa, not just BCC
        atts=full.get("attachments") or []
        att_text=extract_attachments(k, mid, atts, verbose) if atts else ""
        # Same guard as the whisp belt below: an archive/mirror page mailed to OURSELVES has its
        # content ATTACHED already — its outbound links are the site's navigation, not things to
        # go fetch. Un-gated, one amasci index page means hundreds of web fetches plus PDF
        # downloads and on-Mini OCR (same shape as the 2026-08-08 YouTube storm).
        _block=whisp_blocked_reason(full.get("from"), full.get("subject"), raw_body)
        if _block:
            url_text=""
            if verbose: print(f"  🔗 url-content fetch SKIPPED: {_block}")
        else:
            try: url_text=fetch_url_pdfs(raw_body, verbose)      # download + OCR any PDF linked by URL
            except Exception as e: url_text=""; print(f"  url-pdf scan error: {e}")
        extra="\n\n".join(x for x in (att_text, url_text) if x)
        # AUTO-TRIGGER: any YouTube URL in the email → drop it on the convey→whisp transcript belt
        # (deduped). This is the "figure it out and start the work" behaviour: an email mentioning
        # USP/Russell videos should schedule their transcription, not just get summarised.
        # …but an archive/mirror page we mailed to OURSELVES is content to READ, not a request to
        # transcribe everything it links to (the 2026-08-08 amasci storm). Blocked BEFORE yt-dlp
        # enumeration, so a link-dump page costs zero downloads.
        yt_note=""
        if _block:
            if verbose:
                _n=len(youtube_urls(raw_body))
                print(f"  📼 whisp auto-queue SKIPPED ({_n} youtube link(s)): {_block}")
            yt_urls=[]
        else:
            yt_urls=expand_playlists(youtube_urls(raw_body))   # a playlist/channel → its individual videos
        if yt_urls:
            q_n,seen_n=whisp_autosubmit(yt_urls, verbose)
            if q_n:
                yt_note=(f"\n\n---\n📼 **Auto-queued {q_n} of {seen_n} video(s) for transcription** onto the "
                         f"convey→whisp belt (already-transcribed ones skipped, no re-whispering). "
                         f"Transcripts land in the archive as they finish.")
            elif verbose:
                print(f"  📼 {seen_n} youtube url(s) already transcribed — nothing new to queue")
        # AUTO-TRIGGER: a Google Drive link → fetch it (gdrive via the pakettibot bridge; files land in
        # gdrive-results/<label>/), recorded PENDING. When the fetch lands, fa-gdrive-analysis-mailer OCRs
        # + analyses the files and emails the requester — grounded in the REAL content, no guessing.
        gd_urls=gdrive_urls(raw_body); gd_note=""
        if gd_urls:
            _who=full.get("from") or ""; _mm=re.search(r"<([^>]+)>", _who)
            _to=(_mm.group(1) if _mm else _who).strip() or BCC
            try:
                _inbox=Path.home()/"work"/"comms"/"queue"/"pakettibot-inbox"
                _gp=Path.home()/"work"/"comms"/"queue"/"fa-gdrive-pending.jsonl"; _n=0
                with _gp.open("a") as _pf:
                    for _u in gd_urls:
                        _gid=gdrive_id(_u)
                        (_inbox/f"gdrive-{_gid or _n}-{int(time.time())}.txt").write_text(f"gdrive {_u}\n")
                        _pf.write(json.dumps({"url":_u,"id":_gid,"to":_to,"subj":full.get("subject",""),
                                              "ts":time.strftime("%Y-%m-%dT%H:%M:%S")})+"\n")
                        _n+=1
                gd_note=(f"\n\n---\n📁 **Fetching {_n} Google Drive item(s)** — the Mini is downloading "
                         f"now. I'll OCR + analyse the files and email you when they land.")
                if verbose: print(f"  📁 gdrive: triggered {_n} fetch(es), pending analysis-email → {_to}")
            except Exception as _e:
                if verbose: print(f"  gdrive trigger error: {_e}")
        # AUTO-TRIGGER: a ChatGPT SHARE link → hoover the WHOLE conversation to markdown + analyse it
        # across the three brains (convey chatgpt --analyze), fold it into the answer context (so this
        # agent's own FreeLLMAPI reply is grounded in the real conversation), and attach both files.
        # Unlike a video, there is NOTHING to wait for — the conversation is IN the page. No guessing.
        cg_urls=chatgpt_urls(raw_body); cg_note=""; cg_atts=[]
        if cg_urls:
            try:
                cg_ctx, cg_atts, cg_note, cg_done = convey_chatgpt(cg_urls, verbose)
                if cg_ctx:
                    extra="\n\n".join(x for x in (extra, cg_ctx) if x)
                    # a bare "here's a chatgpt link" with no real question → make it an analyse request
                    residue=re.sub(r'https?://\S+',' ', question or '')
                    residue=re.sub(r'[^A-Za-z0-9]+',' ',residue).strip()
                    if len(residue)<12:
                        question="Summarise and analyse this ChatGPT conversation: the key ideas, decisions, and anything worth double-checking."
                if verbose: print(f"  🤖 chatgpt: hoovered+analysed {cg_done}/{len(cg_urls)}")
            except Exception as _e:
                if verbose: print(f"  chatgpt trigger error: {_e}")
        # Decide BARE-VIDEO from the BODY, *before* the thin-body fallback below can copy the SUBJECT
        # into `question`. The subject of a shared YouTube mail IS the video title — never a question —
        # and once the fallback made `question` = "Vapaan energian tuominen käytäntöön | Kanavoitu ohje
        # Nikola Teslalta" the residue test saw a long "question" and dropped the bare-video gate. The
        # model then answered a video it cannot watch, hedging "because we do not possess the full
        # transcript…" — exactly the guess-reply the gate exists to prevent (2026-07-28).
        body_is_bare = _bare_link_body(raw_body, full.get("subject"))
        # NEVER vanish silently. If body extraction/stripping left nothing, fall back to the UNstripped
        # body (strip_signature may have over-eaten it, the Jeane bug) then the SUBJECT ("Patent
        # Us8901943" is itself a real request). Only skip when there is GENUINELY nothing — and LOG it,
        # so a dropped email is never silent again.
        if len((question or "").strip()) < 10 and not extra:   # empty OR a trivial stub like "--"
            subj=re.sub(r'(?i)^\s*(re|fwd|fw):\s*','', full.get("subject") or "").strip()
            rb=raw_body.strip()
            fb = rb if len(rb)>=10 else subj                    # a "--" raw body is not usable → use subject
            if fb and len(fb)>=3:
                question=fb
                print(f"  ↪ thin body — using {'raw body' if len(rb)>=10 else 'subject'}: {fb[:70]!r}")
        if len((question or "").strip()) < 3 and not extra and not yt_urls:
            print(f"  ⊘ SKIP — genuinely empty (no body/subject/attachments): mid={mid} subj={(full.get('subject') or '')!r}")
            seen.add(mid); continue
        ctx=thread_context(k, msgs, m.get("thread_id"), mid)
        # ── OWNER APPROVAL + GATED-SPACE ACCESS ──────────────────────────────────────────────
        frm_full = full.get("from") or ""
        # (a) OWNER approves/denies a held sender → update the allowlist + release/drop the held msg(s)
        if _is_owner(frm_full):
            _act,_tgt = _parse_owner_approval(raw_body)
            if _act and _tgt:
                if _act=="approve":
                    _add_allowlist(_tgt)
                    _rel=[r.get("mid") for r in _pending_all() if r.get("sender_email")==_tgt and r.get("mid")]
                    for _rm in _rel: seen.discard(_rm)          # un-see → next poll answers now they're allowed
                    _pending_remove(lambda r: r.get("sender_email")==_tgt)
                    print(f"  ✅ approved {_tgt} → whitelisted; released {len(_rel)} held message(s)")
                else:
                    _pending_remove(lambda r: r.get("sender_email")==_tgt)
                    print(f"  ⛔ denied {_tgt} → dropped held message(s)")
                seen.add(mid); new+=1; continue
        # (b) GATED space + sender NOT allowed → HOLD, ask Esa, do not answer (no ack — don't confirm
        #     liveness to spammers). Owner + whitelisted senders skip this and are answered normally.
        if not _is_allowed(frm_full):
            _gspace,_ = route_space(frm_full, full.get("subject"), raw_body, wslugs=None)
            if _space_access(_gspace)!="open":
                _sem=_sender_email(frm_full); _pid=_uid()
                _pending_add({"id":_pid,"mid":mid,"sender_email":_sem,"sender":frm_full,"space":_gspace,
                              "subject":full.get("subject",""),"ts":time.strftime("%Y-%m-%dT%H:%M:%S")})
                _email_owner_approval(k, frm_full, _sem, _gspace, full.get("subject","(no subject)"),
                                      (question or raw_body or ""), _pid)
                print(f"  🚦 gated [{_gspace}] from {_sem} → held for approval (asked Esa)")
                seen.add(mid); new+=1; continue
        # BARE VIDEO: an email that is essentially just a YouTube link is a "convey this video"
        # request, NOT a question. The model CANNOT watch the video — answering it hallucinates the
        # content from wiki context (the 2026-07-01 BrunoVK/Don-Smith/eclipse confabulation). So:
        # convey it (queued above), reply with a CONFIRMATION only, and let the analysis follow LATER
        # from the REAL transcript once it lands. No guessing at what a video says before transcription.
        video_only = bool(yt_urls) and not extra and body_is_bare
        gdrive_only=False
        if gd_urls and not extra and not yt_urls:
            gres=re.sub(r'https?://\S+',' ', question or '')
            gres=re.sub(r'(?i)\b(fwd|fw|re|see|this|that|these|those|folder|file|files|drive|gdrive|google|docs?|link|url|please|pls|download|fetch|convey|ocr|analyse|analyze|thoughts?|check|out|the|a|an|and|for|to|hey|hi|hello|thanks?|cheers)\b',' ',gres)
            gres=re.sub(r'[^A-Za-z0-9]+',' ',gres).strip()
            if len(gres)<12: gdrive_only=True
        # "make a printable/PDF of this" with no NEW question → compile the EXISTING thread
        # answer (the immutable record), never regenerate. This is the Karpathy fix.
        # ADJUSTMENT BY EMAIL: a reply that states `s/marked/better/` (or an ADJUST:/BETTER: block)
        # is not a new question — it is an edit to a SPECIFIC AREA of what we already said. Send that
        # area back to the voice, reply with the rewritten passage + what the voice says about it, and
        # bank the substitution as a standing rule so no later answer needs the same correction.
        adjustments = parse_adjustments(raw_body)
        if adjustments:
            _prior = prior_bot_answer(k, msgs, m.get("thread_id"))
            if not _prior:
                print(f"  ✎ adjustment(s) but no prior answer in this thread — answering normally")
            else:
                _q = re.sub(r'(?i)^\s*(re|fwd|fw):\s*', '', full.get("subject") or "").strip()
                _cur, _lines, _rules_added = _prior, [], []
                for _mk, _bt in adjustments:
                    _rev, _area, _vreply, _adopted, _err = apply_email_adjustment(
                        _cur, _mk, _bt, _q, space_sys="")
                    if _err:
                        _lines.append(f"⚠ **{_mk[:70]}** — {_err}")
                        continue
                    _cur = _rev
                    _r = adjust_bank(_mk, _bt, "cloudcity-llm", _q, _area, _vreply, _adopted)
                    if _r: _rules_added.append(_r)
                    _lines += [f"**You marked:** “{_mk}”",
                               (f"**You wrote:** “{_bt}”" if _bt else "**You struck it.**"),
                               f"**That area now reads:** {_area}", f"**I changed it because:** {_vreply}"]
                    if _bt and not _adopted:
                        _lines.append("⚠ I did not manage to use your exact wording there — say it again "
                                      "and I'll take another pass.")
                    _lines.append("")
                note = ("## Adjusted\n\n" + "\n\n".join(_lines)
                        + ("\n\n---\n**Standing rules now in force for every later answer:**\n"
                           + "\n".join(f"- {r}" for r in _rules_added) if _rules_added else "")
                        + "\n\n---\n## The answer, with your adjustment in it\n\n" + _cur)
                reply = {"text": note, "html": md_to_html(note)}
                seen.add(mid)
                st["seen"] = list(seen)[-SEEN_CAP:]; st["last_poll"] = time.strftime("%Y-%m-%dT%H:%M:%S")
                save_state(st)
                replied_add(mid, m.get("thread_id"), full.get("subject", ""))
                replied_mids.add(mid)
                replied_threads.setdefault(m.get("thread_id"), []).append(time.time())
                if BCC and BCC.lower() not in (full.get("from") or "").lower():
                    reply["bcc"] = [BCC]
                try:
                    http(f"{AM_BASE}/inboxes/{INBOX}/messages/{enc(mid)}/reply", k, "POST", reply)
                    print(f"  ✎ adjusted {len(adjustments)} area(s); {len(_rules_added)} rule(s) banked")
                except Exception as e:
                    debug_log("adjust-send-error", mid, full.get("subject", ""), note=str(e))
                new += 1
                continue
        # "make a printable/PDF of this" with no NEW question → compile the EXISTING thread
        # answer (the immutable record), never regenerate. This is the Karpathy fix.
        reformat = is_pure_reformat(question) and not extra
        prior = prior_bot_answer(k, msgs, m.get("thread_id")) if reformat else None
        if video_only:
            # Bare YouTube mail gets a deterministic metadata receipt, never an LLM/RAG answer.
            # The transcript-grounded analysis is still handled later by fa-video-analysis-mailer.
            try:
                _who=full.get("from") or ""
                _mm=re.search(r"<([^>]+)>", _who); _to=(_mm.group(1) if _mm else _who).strip() or BCC
                _pend=Path.home()/"work"/"comms"/"queue"/"fa-video-pending.jsonl"
                _pend.parent.mkdir(parents=True, exist_ok=True)
                with _pend.open("a") as _pf:
                    for _u in yt_urls:
                        _pf.write(json.dumps({"url":_u,"to":_to,"subj":full.get("subject",""),
                                              "ts":time.strftime("%Y-%m-%dT%H:%M:%S")})+"\n")
                if verbose: print(f"  📝 pending video-analysis email → {_to} for {len(yt_urls)} video(s); metadata receipt now")
            except Exception as _e:
                if verbose: print(f"  pending-write error: {_e}")
            text, html = youtube_receipt(yt_urls, full.get("subject",""), queued=q_n)
            reply={"text":text, "html":html}
            used="youtube metadata receipt (no LLM)"
            yt_note=""
        elif gdrive_only:
            note=(f"📁 On it — **fetching your Google Drive** ({len(gd_urls)} link{'s' if len(gd_urls)>1 else ''}). "
                  f"The Mini is downloading now; I won't guess at the contents. Once the files land I'll OCR "
                  f"and analyse them and email you the writeup.")
            reply={"text":note,"html":md_to_inner_html(note)}
            used="gdrive (fetching — analysis from the real files)"
            gd_note=""
        elif is_protocol_space(full.get("from"), full.get("subject"), raw_body):
            # ENVOY / Penpal space → a DETERMINISTIC clean_protocol reply (code-composed schema-valid
            # penpal block, no persona, no wiki, no scratchpad). This is Staffan's long-requested
            # clean_protocol mode: the free-energy six-heading template is BYPASSED entirely here.
            _who=full.get("from") or ""; _mm=re.search(r"<([^>]+)>", _who)
            _to=(_mm.group(1) if _mm else _who).strip() or BCC
            ptext, phtml = compose_protocol_reply(full, raw_body, _to)
            reply={"text":ptext, "html":phtml}
            answer=ptext                                        # so the full-forward carries the penpal block
            is_penpal=True                                      # Francois & co. → forward the whole exchange to Esa
            used="envoy-protocol (clean_protocol · deterministic penpal block)"
            if verbose: print(f"  🛰  envoy-protocol clean reply → {_to}")
        elif prior:
            if verbose: print("  → rendering the PRIOR thread answer to PDF (no regeneration)")
            note="Here's the printable one-pager of the previous answer — attached. Same content, just formatted."
            reply={"text": note, "html": f"<p>{note}</p>"}; used="reused prior answer"
            b64=make_pdf_b64(prior)
            if b64:
                reply["attachments"]=[{"filename":pdf_filename(prior),"content_type":"application/pdf","content":b64}]
            else:
                reply["text"]="Sorry — couldn't render the PDF this time. Please retry."
        else:
            # WIKI AUGMENTS, never gates: pull relevant wiki pages as CONTEXT (no LLM, no refusal),
            # apply the free-energy VIEWPOINT only for in-corpus topics, then ALWAYS research fully.
            # Route + retrieve on the FETCHED content too (a bare URL alone tells us nothing; the page
            # text is what says "Apple xcrun agent skills" vs "eclipse gravity"). Without this a link
            # was routed on its URL string alone → mis-routed to free-energy → confabulated.
            route_text = "\n".join(x for x in (question, extra) if x)
            wctx, wslugs = ("", [])
            if route_text.strip():
                try: wctx, wslugs = wiki_context(route_text)
                except Exception as e: print(f"  wiki context error: {e}")
            # ROUTE to a role-space; the free-energy VIEWPOINT (Russell/Bearden/Prigogine/Hilarion six-heading
            # template) + free-energy RAG fire ONLY when the routed space IS free-energy. Every other
            # space (dad/health/spirituality/finances/music/admin/general) gets a plain answer with the
            # free-energy persona SUPPRESSED — so a parenting question never comes back as a Tesla coil.
            space, why = route_space(full.get("from"), full.get("subject"), route_text, wslugs)
            card = SPACECARDS.get(space, {})
            in_fe = (space == "free-energy")
            vp = VIEWPOINT if in_fe else ""
            lens = ""; sslugs = []
            if in_fe:
                pass                                    # free-energy: keep the wiki context (wctx) as-is
            elif card.get("retrieval") == "skill" and card.get("skill_dir"):
                # SKILL-BACKED space (apple/health/hyp): retrieve from ~/work/<skill> + use its lens.
                # PRIVACY GATE: a `private` space (health/hyp) draws on Esa's PRIVATE corpus, so it only
                # serves the OWNER. A non-owner gets a plain answer with the private corpus SUPPRESSED —
                # no private diary/health data is ever emailed to a stranger from the public inbox.
                if card.get("private") and not _is_owner(full.get("from")):
                    wctx=""; lens=""; sslugs=[]
                    if verbose: print(f"  🔒 private space [{space}] + non-owner sender → corpus suppressed (plain answer)")
                else:
                    try: wctx, sslugs, lens = skill_context(question, card["skill_dir"])
                    except Exception as e:
                        wctx=""; print(f"  skill context error [{space}]: {e}")
            else:
                wctx = ""                               # plain space: no free-energy RAG leakage
            if verbose: print(f"  → researching [{space}·{why}]: {full.get('subject','(no subject)')[:50]} from {full.get('from','?')}"
                              + (f" [+{len(atts)} att]" if atts else "") + (" [+url-pdf]" if url_text else "")
                              + (f" [+wiki:{len(wslugs)}]" if (in_fe and wslugs) else "")
                              + (f" [+skill:{len(sslugs)}]" if sslugs else "") + (" [+lens]" if lens else ""))
            try:
                answer, used = fm_research(question, ctx, extra, wiki_ctx=wctx, viewpoint=vp, lens=lens,
                                           model_override=card.get("model",""))
            except Exception as e:
                print(f"  research failed for {mid}: {e}"); continue
            if answer is REQUEUE_NO_THINKING or answer is REQUEUE_FAILED:
                # Not sendable this pass → do NOT send, do NOT mark seen (next poll retries fresh), and
                # DEBUG-LOG it (flagged + saved) so the failure is visible, never silently emitted.
                kind = "no-thinking-heading" if answer is REQUEUE_NO_THINKING else "model-bailed"
                subj = full.get("subject","(no subject)")
                print(f"  ↻ re-queued {mid} [{kind}] — will retry next poll")
                debug_log(kind, mid, subj, question=question, note="re-queued (not sent); will retry next poll")
                continue
            reply={"text": answer, "html": md_to_html(answer)}
            if WANT_PDF.search(question or ""):     # a NEW question that also wants a PDF
                b64=make_pdf_b64(answer)
                if b64:
                    reply["attachments"]=[{"filename":pdf_filename(answer, full.get("subject")),
                                           "content_type":"application/pdf","content":b64}]
        # Append the transcription-belt + gdrive-fetch + chatgpt-hoover notes to whichever reply path built it.
        for _n in (yt_note, gd_note, cg_note):
            if _n:
                reply["text"]=reply.get("text","")+_n
                reply["html"]=reply.get("html","")+"<hr>"+md_to_inner_html(_n)
        # Attach the hoovered ChatGPT conversation.md + analysis.md to the reply.
        if cg_atts:
            reply.setdefault("attachments", []).extend(cg_atts)
        # SELF-CONTAINED REPLY: if the sender attached files (a cool PDF), send them RIGHT BACK on the
        # reply alongside the analysis — so 'email a PDF in → analysis + the PDF back out' just works
        # for ANYONE, including Esa mailing himself. (Reusable: rides on the same reply.)
        if atts and not reformat:
            reattach=inbound_atts_b64(k, mid, atts)
            if reattach:
                reply.setdefault("attachments", []).extend(reattach)
        # Esa visibility. Two paths:
        #  • inbound attachments from a non-Esa sender → also FORWARD the exchange + files to Esa, so
        #    he gets a copy of a friend's 'hot stuff' (the BCC alone wouldn't carry it); skip the BCC.
        #  • otherwise → BCC Esa on the reply so he sees answers sent to other senders.
        from_esa = BCC and BCC.lower() in (full.get("from") or "").lower()
        forwarded=False
        if (atts or is_penpal) and not from_esa:               # penpal replies (Francois) always full-forward
            forwarded=forward_to_esa(k, full, mid, question, answer, atts)
        if BCC and not from_esa and not forwarded:
            reply["bcc"]=[BCC]
        # Mark handled BEFORE the reply POST. AgentMail can accept/send the reply and still make
        # the client see an HTTP/JSON/timeout error; retrying that same inbound message causes
        # duplicate replies. Prefer at-most-once email replies over mail storms.
        seen.add(mid)
        st["seen"]=list(seen)[-SEEN_CAP:]; st["last_poll"]=time.strftime("%Y-%m-%dT%H:%M:%S"); save_state(st)
        # Durable at-most-once record, written BEFORE the POST for the same reason `seen` is: a send
        # that errors on the client side may still have gone out. The ledger outlives the state file.
        replied_add(mid, m.get("thread_id"), full.get("subject",""))
        replied_mids.add(mid); replied_threads.setdefault(m.get("thread_id"), []).append(time.time())
        try:
            http(f"{AM_BASE}/inboxes/{INBOX}/messages/{enc(mid)}/reply", k, "POST", reply)
        except Exception as e:
            debug_log("reply-send-error", mid, full.get("subject","(no subject)"),
                      question=question, answer=reply.get("text",""), note=str(e))
            if verbose: print(f"  ⚠ reply POST errored after marking seen: {e}")
            continue
        new+=1
        if verbose: print(f"  ✓ replied (model {used}, $0)" + (" [+pdf]" if "attachments" in reply else "")
                          + (" [fwd+att→esa]" if forwarded else (" [bcc]" if "bcc" in reply else "")))
    st["seen"]=list(seen)[-SEEN_CAP:]; st["last_poll"]=time.strftime("%Y-%m-%dT%H:%M:%S"); save_state(st)
    return new


# ── CHAPTER-BY-CHAPTER ───────────────────────────────────────────────────────────────────────
# An 88-page PDF answered in one pass is a summary of a summary. Esa, 2026-08-12, asked for "deep
# chapter-by-chapter analysis of each of the 3 SEC Stiffler PDFs, one email each" — so long material
# is split, each part is read on its own, and the eleven-section answer is then written over the
# assembled parts. One email, but nothing skimmed.
CHAPTER_SYSTEM = (
    "You are reading ONE part of a longer document, in order. Report what THIS part actually says — "
    "no preamble, no meta-talk, no restating the task.\n"
    "Give, in this shape:\n"
    "**What this part covers** — one or two sentences.\n"
    "**Claims and measurements** — bullets. Every number, unit, frequency, voltage, part number and "
    "named device that appears here. If a claim has a stated basis, say it; if it is asserted without "
    "one, say that plainly.\n"
    "**Verbatim** — one or two short quotes, in quotation marks, ONLY if the wording matters.\n"
    "Never invent a number, a name or a quotation. If this part is front matter, a table of contents "
    "or boilerplate, say so in one line and stop."
)


def split_chapters(text, target_chars=9000, max_parts=14):
    """Split on real structure when it is there (headings / CHAPTER / SECTION / form-feeds), else on
    paragraph boundaries near the target size. Returns [(title, body)]."""
    text = (text or "").replace("\r\n", "\n")
    # PDFs carry real page breaks (pdftotext emits \f), and page ranges are honest, even-sized parts.
    # Heading-matching on a scanned/laid-out PDF matched numbered LIST ITEMS instead of chapters and
    # produced 4k-to-45k-char lumps (2026-08-12) — so pages win whenever they are present.
    if text.count("\f") >= 6:
        pages = [p for p in text.split("\f")]
        parts, buf, first = [], [], 1
        for i, pg in enumerate(pages, 1):
            buf.append(pg)
            if sum(len(x) for x in buf) >= target_chars or i == len(pages):
                parts.append((f"Pages {first}–{i}", "\n".join(buf).strip()))
                buf, first = [], i + 1
        parts = [(t, b) for t, b in parts if b.strip()]
        if len(parts) > max_parts:
            head, tail = parts[:max_parts - 1], parts[max_parts - 1:]
            parts = head + [(f"{tail[0][0].split('–')[0]}–{tail[-1][0].split('–')[-1]}",
                             "\n".join(b for _t, b in tail))]
        return parts
    marks = list(re.finditer(r"(?m)^\s*(?:#{1,3}\s+.+|(?:CHAPTER|SECTION|PART|APPENDIX)\b.{0,80})\s*$",
                             text))
    parts = []
    if len(marks) >= 3:
        for i, m in enumerate(marks):
            start = m.start()
            end = marks[i + 1].start() if i + 1 < len(marks) else len(text)
            body = text[start:end].strip()
            if len(body) < 400 and parts:                 # fold tiny stubs into the previous part
                parts[-1] = (parts[-1][0], parts[-1][1] + "\n\n" + body)
                continue
            parts.append((" ".join(m.group(0).split())[:80], body))
    if not parts:                                          # no structure — cut on paragraphs
        buf, size, n = [], 0, 0
        for para in re.split(r"\n\s*\n", text):
            buf.append(para); size += len(para)
            if size >= target_chars:
                n += 1; parts.append((f"Part {n}", "\n\n".join(buf))); buf, size = [], 0
        if buf:
            n += 1; parts.append((f"Part {n}", "\n\n".join(buf)))
    # merge forward until every part is a reasonable read, then cap the count
    merged = []
    for title, body in parts:
        if merged and len(merged[-1][1]) < target_chars // 2:
            merged[-1] = (merged[-1][0], merged[-1][1] + "\n\n" + body)
        else:
            merged.append((title, body))
    if len(merged) > max_parts:                            # keep it bounded; note the fold
        head, tail = merged[:max_parts - 1], merged[max_parts - 1:]
        merged = head + [(tail[0][0] + f" … (+{len(tail)-1} more folded in)",
                          "\n\n".join(b for _t, b in tail))]
    return merged


def read_chapters(parts, timeout=240, verbose=True):
    """One focused read per part. Returns (digest_markdown, n_ok)."""
    out, ok = [], 0
    for i, (title, body) in enumerate(parts, 1):
        if verbose:
            print(f"  📖 {i}/{len(parts)} {title[:60]} ({len(body):,} chars)", flush=True)
        # A part is a PAGE RANGE of the user's document — losing one silently means the analysis is of a
        # book with pages torn out. The free gateway 502s intermittently, so retry with a short backoff
        # before ever admitting a gap (2026-08-12: a 502 dropped pages 10–13 of the Stiffler UEE paper).
        ans = ""
        for attempt in range(1, 4):
            try:
                ans, _used = _fm_call([{"role": "system", "content": CHAPTER_SYSTEM},
                                       {"role": "user", "content": f"PART {i} OF {len(parts)} — "
                                                                   f"{title}\n\n{body[:24000]}"}],
                                      max_tokens=1200, temperature=0.2)
            except Exception as e:
                ans = ""
                if verbose: print(f"      ✗ {e}{' — retrying' if attempt < 3 else ''}")
            if (ans or "").strip():
                break
            if attempt < 3:
                time.sleep(6 * attempt)
        ans = (ans or "").strip()
        if ans and not _fm_looks_garbage_local(ans):
            ok += 1
            out.append(f"### {i}. {title}\n\n{ans}")
        else:
            out.append(f"### {i}. {title}\n\n_(this part produced no usable read — not faked)_")
    return "\n\n".join(out), ok


def _fm_looks_garbage_local(t):
    low = (t or "").lower()
    return (len(low.split()) < 12
            or low.count("wait") >= 3
            or low.startswith(("got it", "sure,", "i will", "let me")))


def compose_and_send(to, subject, body_text, source="", label="", verbose=True, tries=4,
                     legs_from="", attach="", chapters=False, chapter_chars=9000, space_hint=""):
    """THE ONE ANSWER FORMAT, callable from outside the poll loop.

    Esa, 2026-08-10, holding three different-looking emails from the same system: "i have
    cloudcity-llm@agentmail.to that responds … with an analysis and then bearden, russell, prigogine
    and hilarion voices. but what i wanted was, that when the convey transcript finishes, that the
    SAME THING is done. but instead, its some other junk!"

    He was right, and it was not one bug. THREE mailers had grown up separately, each composing its
    own email with its own prompt:
      · convey email-transcript --analyze  → "## Summary / ## Key points / ## Notable quotes"
      · convey soft --email                → "⚠️ SOFT machine legs — fm-mlx + freellmapi"
      · freellmask-mail (this agent)       → "Thought about it / Answer / Russell / Bearden / …"
    Only the third is the agent. This function exposes the agent's own path — same wiki context,
    same VIEWPOINT, same voices, same footer — so the other two stop composing and start ASKING.
    """
    k = am_key()
    body_text = (body_text or "").strip()
    if not body_text:
        return False, "nothing to answer"
    question = (f"Read the material below and answer it as you would an email asking about it: what "
                f"it says, what holds up, what is worth checking."
                + (f"\n\nSOURCE: {source}" if source else ""))
    # EXACTLY the poll loop's order: retrieve the wiki FIRST, then route WITH the wslugs. Routing
    # before retrieval (my first cut) meant the wiki-match branch could never fire, so a bifilar-coil
    # transcript routed to "plain" — no viewpoint, no Russell/Bearden/Prigogine/Hilarion voices, which
    # is precisely the format Esa asked for.
    # CHAPTER-BY-CHAPTER: read each part on its own first, then write the eleven sections over the
    # assembled digest — so a long document is answered from a real read, not a skim of a skim.
    chapter_md = ""
    if chapters and len(body_text) > 4000:      # asked for → do it; 12k skipped a 14-page PDF
        parts = split_chapters(body_text, target_chars=chapter_chars)
        if verbose:
            print(f"  📚 chapter-by-chapter: {len(parts)} part(s)")
        chapter_md, n_ok = read_chapters(parts, verbose=verbose)
        if verbose:
            print(f"  📚 {n_ok}/{len(parts)} part(s) read")
        if n_ok:
            # the answer is now written over the DIGEST (which is dense and complete) rather than a
            # truncated head of the raw text
            body_text = ("A CHAPTER-BY-CHAPTER READ OF THE WHOLE DOCUMENT FOLLOWS. Base the answer "
                         "on ALL of it.\n\n" + chapter_md)
    route_text = "\n".join(x for x in (subject, body_text) if x)
    wctx, wslugs = "", []
    try:
        wctx, wslugs = wiki_context(route_text)
    except Exception as e:
        if verbose: print(f"  wiki context error: {e}")
    # ROUTING, in order of trust: an explicit --space wins; then ARCHIVE PROVENANCE (a file under
    # merlib-dump / convey-packs / whisp-transcripts IS free-energy material by definition); only then
    # the keyword/LLM router. A Stiffler electrolysis paper scored two "admin" keywords and routed to
    # the admin space — no viewpoint, no voices, wrong format again (2026-08-12). Provenance is a fact;
    # keyword scoring is a guess, and the guess must not outrank the fact.
    ARCHIVE_ROOTS = ("work/merlib-dump", "work/convey-packs", "work/whisp-transcripts")
    if space_hint:
        space, why = space_hint, "explicit --space"
    elif any(r in str(source) or r in str(legs_from) or r in str(attach) for r in ARCHIVE_ROOTS):
        space, why = "free-energy", "archive provenance"
    else:
        try:
            space, why = route_space(FORWARD_TO, subject, route_text, wslugs)
        except Exception as e:
            space, why = "free-energy", f"routing error ({e}) → free-energy"
    in_fe = (space == "free-energy")
    vp = VIEWPOINT if in_fe else ""
    if not in_fe:
        wctx = ""                                  # a plain space gets no free-energy RAG leakage
    if verbose:
        print(f"  → composing [{space}·{why}] for {to}: {subject[:60]}"
              + (f" [+wiki:{len(wslugs)}]" if (in_fe and wslugs) else ""))
    global TRY_FLOOR
    _floor, TRY_FLOOR = TRY_FLOOR, max(1, tries)          # bounded for the belt, restored after
    try:
        answer, used = fm_research(question, "", body_text, wiki_ctx=wctx, viewpoint=vp, tries=tries,
                                   honour_tries=True,
                                   material=True)         # there is always material in a compose
    finally:
        TRY_FLOOR = _floor
    if answer is REQUEUE_NO_THINKING or answer is REQUEUE_FAILED:
        return False, ("model would not produce the required shape — NOT sending "
                       "(the same gate the poll loop uses)")
    if not answer:
        return False, "no answer from the brain"
    # fm_research's LAST resort is an apology string. The poll loop can afford to send that as a reply
    # to a human who can reply again; a BELT email must not — it would look exactly like the junk this
    # unification is fixing. Caught by reading the first composed email (2026-08-11).
    if answer.startswith("I wasn't able to generate a reliable answer"):
        return False, "the brain never produced a usable answer — NOT sending an apology as an analysis"
    # THE MACHINE LEGS — the third mailer's whole contribution, folded in rather than lost. `convey
    # soft` writes <stem>.fm-mlx.analysis.md and <stem>.freellmapi.analysis.md beside the source; we
    # run it WITHOUT --email (that path now calls back into here, which would loop) and paste both.
    legs_md = ""
    if legs_from and Path(legs_from).exists():
        try:
            src = Path(legs_from)
            have = [src.with_name(src.stem + x) for x in (".fm-mlx.analysis.md",
                                                          ".freellmapi.analysis.md")]
            if not all(x.exists() for x in have):
                # `convey soft` recomputes by default, so only pay for the two model calls when the
                # legs are not already on disk beside the source.
                subprocess.run([str(Path.home()/"work"/"apple"/"bin"/"convey"), "soft", str(src)],
                               capture_output=True, text=True, timeout=900)
            elif verbose:
                print("  🦿 machine legs already on disk — reusing (no extra model calls)")
            for stem, icon, who in ((".fm-mlx.analysis.md", "🖥️", "fm-mlx (Qwen3-4B)"),
                                    (".freellmapi.analysis.md", "🌐", "freellmapi (nemotron-120b)")):
                leg = src.with_name(src.stem + stem)
                if leg.exists():
                    body = leg.read_text(encoding="utf-8", errors="replace")
                    body = re.sub(r"(?s)^#.*?\n\n", "", body, count=1)      # drop its own title block
                    legs_md += f"\n\n### {icon} {who}\n\n{body.strip()}"
            if verbose:
                print(f"  🦿 machine legs: {'both' if legs_md.count('###')==2 else legs_md.count('###')} attached")
        except Exception as e:
            if verbose: print(f"  machine-legs error: {e}")
    note = ""
    if chapter_md:
        note += ("\n\n---\n## Chapter by chapter\n\n_Each part of the document read on its own, "
                 "in order — the answer above is written over these._\n\n" + chapter_md)
    if legs_md:
        note += ("\n\n---\n## Appendix · machine legs\n\n_The two cheap machine reads, kept beside "
                 "the source as well. They are the record, not the payoff._" + legs_md)
    if source:
        note += f"\n\n---\n▶ Source: {source}"
    if label:
        note += f"\n📄 {label}"
    text = answer + note
    payload = {"to": [to], "subject": subject, "text": text, "html": md_to_html(text)}
    # ATTACH the material itself — the first mailer always did, and losing it would lose a feature.
    if attach and Path(attach).exists():
        try:
            import base64 as _b64
            ap_ = Path(attach)
            if ap_.stat().st_size <= 20 * 1024 * 1024:
                payload["attachments"] = [{"filename": ap_.name,
                                           "content_type": "text/plain" if ap_.suffix in (".txt", ".md")
                                           else "application/octet-stream",
                                           "content": _b64.b64encode(ap_.read_bytes()).decode()}]
        except Exception as e:
            if verbose: print(f"  attach error: {e}")
    if BCC and BCC.lower() != (to or "").lower():
        payload["bcc"] = [BCC]
    try:
        http(f"{AM_BASE}/inboxes/{INBOX}/messages/send", k, "POST", payload)
        return True, used
    except Exception as e:
        return False, f"send failed: {e}"


# ── the belt ────────────────────────────────────────────────────────────────────────────────────
# Esa, 2026-08-12: "a '300 txt files, one per half an hour to email via proper analysis' belt".
# Same motion as every other conveyor here: a folder is the interface (drop files in), a visible
# Boot pane drains it, and a ledger on disk makes it crash-only — a killed pane resumes at the next
# unsent file instead of re-mailing 300 emails. Pacing is the POINT, not a throttle bolted on: one
# proper analysis per interval is what keeps the inbox readable and the gateway un-angry.
BELT_LEDGER = Path.home() / "work" / "convey" / "kb" / "mail-belt"


def _belt_ledger(name):
    p = BELT_LEDGER / f"{name}.jsonl"
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


def belt_done_keys(tag="default"):
    keys = set()
    p = _belt_ledger(f"{tag}-sent")
    if p.is_file():
        for line in p.read_text(errors="replace").splitlines():
            try:
                keys.add(json.loads(line)["key"])
            except Exception:
                pass
    return keys


def belt_record(tag, key, path, ok, info):
    rec = {"key": key, "path": str(path), "ok": bool(ok), "info": str(info)[:400],
           "at": time.strftime("%Y-%m-%d %H:%M:%S")}
    with _belt_ledger(f"{tag}-{'sent' if ok else 'failed'}").open("a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")


def belt_subject(p: Path) -> str:
    """The file names itself: a leading '# Title' wins, else the humanised stem."""
    try:
        for line in p.read_text(errors="replace").splitlines()[:8]:
            m = re.match(r"^#\s+(.{4,120})$", line.strip())
            if m:
                return m.group(1).strip()
    except Exception:
        pass
    return re.sub(r"[_-]+", " ", p.stem).strip()[:120] or p.name


def belt_run(folder, to, every=1800, tag="default", pattern="*.txt", space="", chapters=False,
             tries=4, limit=0, once=False, verbose=True):
    """Drain a folder one proper analysis at a time. Returns (n_sent, n_failed)."""
    folder = Path(folder).expanduser()
    sent = failed = 0
    # SINGLE INSTANCE, per tag. keelynet-energy-mailer's runner earned this the hard way with an
    # atomic mkdir lock: two belts on one folder both read "unsent" before either writes its ledger,
    # so every item gets mailed twice. An atomic mkdir is the check and the claim in one syscall.
    lock = BELT_LEDGER / f".lock-{tag}"
    lock.parent.mkdir(parents=True, exist_ok=True)
    try:
        lock.mkdir()
    except FileExistsError:
        # A pane can be SIGKILLed (they routinely are), and a lock that outlives its owner would
        # wedge the belt forever — the failure mode is worse than the one it guards against.
        age = time.time() - lock.stat().st_mtime
        if age < 6 * 3600:
            print(f"🎢 belt[{tag}] already running ({lock}, {int(age/60)}m old) — not starting a "
                  f"second", flush=True)
            return 0, 0
        print(f"🎢 belt[{tag}] stale lock ({int(age/3600)}h) — taking it over", flush=True)
        lock.touch()
    atexit.register(lambda: shutil.rmtree(lock, ignore_errors=True))
    while True:
        done = belt_done_keys(tag)
        todo = [p for p in sorted(folder.rglob(pattern))
                if p.is_file() and str(p.resolve()) not in done]
        if verbose:
            print(f"🎢 belt[{tag}] {folder} — {len(todo)} waiting, {len(done)} already sent",
                  flush=True)
        if not todo:
            if once:
                break
            time.sleep(every)
            continue
        for p in todo:
            if limit and sent >= limit:
                if verbose: print(f"🎢 limit {limit} reached", flush=True)
                return sent, failed
            key = str(p.resolve())
            subj = belt_subject(p)
            if verbose:
                print(f"\n🎢 [{time.strftime('%H:%M:%S')}] {p.name} → {to}\n   “{subj}”", flush=True)
            try:
                body = p.read_text(errors="replace")[:120000]
                ok, info = compose_and_send(to, subj, body, source=str(p), tries=tries,
                                            legs_from=str(p), attach=str(p), chapters=chapters,
                                            space_hint=space, verbose=verbose)
            except Exception as e:                      # one bad file must never stop the belt
                ok, info = False, f"belt error: {e}"
            # A failure is ledgered too, but in the FAILED ledger — so the next pass retries it
            # instead of the belt silently deciding that file was never worth mailing.
            belt_record(tag, key, p, ok, info)
            if ok:
                sent += 1
                print(f"   ✅ {info}", flush=True)
            else:
                failed += 1
                print(f"   ✗ {info}", flush=True)
            if once and limit and sent >= limit:
                return sent, failed
            if verbose:
                print(f"   ⏳ next in {every}s", flush=True)
            time.sleep(every)
        if once:
            break
    return sent, failed


def main():
    cmd = sys.argv[1] if len(sys.argv)>1 else "poll"
    if cmd == "belt":
        import argparse
        ap = argparse.ArgumentParser(prog="freellmask-mail belt",
                                     description="Email a folder of files, one proper analysis per "
                                                 "interval, ledger-deduped and resumable.")
        ap.add_argument("--dir", required=True, help="folder of files to convey")
        ap.add_argument("--to", required=True)
        ap.add_argument("--every", type=int, default=1800, help="seconds between emails (default 1800)")
        ap.add_argument("--tag", default="default", help="ledger name, so belts don't share state")
        ap.add_argument("--glob", dest="pattern", default="*.txt")
        ap.add_argument("--space", default="", help="force a space for every item (e.g. free-energy)")
        ap.add_argument("--chapters", action="store_true", help="chapter-by-chapter read per file")
        ap.add_argument("--tries", type=int, default=4)
        ap.add_argument("--limit", type=int, default=0, help="stop after N emails (0 = no limit)")
        ap.add_argument("--once", action="store_true", help="one pass over the folder, then exit")
        ap.add_argument("--status", action="store_true", help="print ledger counts and exit")
        a = ap.parse_args(sys.argv[2:])
        if a.status:
            done = belt_done_keys(a.tag)
            waiting = [p for p in sorted(Path(a.dir).expanduser().rglob(a.pattern))
                       if p.is_file() and str(p.resolve()) not in done]
            print(f"belt[{a.tag}] {a.dir}\n  sent    {len(done)}\n  waiting {len(waiting)}\n"
                  f"  ledger  {_belt_ledger(a.tag + '-sent')}")
            return 0
        s, f = belt_run(a.dir, a.to, every=a.every, tag=a.tag, pattern=a.pattern, space=a.space,
                        chapters=a.chapters, tries=a.tries, limit=a.limit, once=a.once)
        print(f"\n🎢 belt done: {s} sent, {f} failed")
        return 0
    if cmd == "compose":
        import argparse
        ap = argparse.ArgumentParser(prog="freellmask-mail compose",
                                     description="Answer a file IN THE AGENT'S OWN FORMAT and email it.")
        ap.add_argument("--to", required=True)
        ap.add_argument("--subject", required=True)
        ap.add_argument("--file", help="transcript / extracted text to answer")
        ap.add_argument("--text", help="raw text instead of a file")
        ap.add_argument("--source", default="", help="the URL or origin, printed under the answer")
        ap.add_argument("--label", default="", help="a line noting the artifact (e.g. the transcript path)")
        ap.add_argument("--max-chars", type=int, default=120000)
        ap.add_argument("--space", default="", help="force a space (e.g. free-energy); otherwise "
                                                    "archive provenance, then the router, decides")
        ap.add_argument("--chapters", action="store_true",
                        help="read the document part by part first, then answer over the whole read")
        ap.add_argument("--chapter-chars", dest="chapter_chars", type=int, default=9000)
        ap.add_argument("--legs-from", dest="legs_from", default="",
                        help="run `convey soft` on this file and append both machine legs (fm-mlx + "
                             "freellmapi) as an appendix")
        ap.add_argument("--attach", default="", help="attach this file to the email")
        ap.add_argument("--tries", type=int, default=4,
                        help="attempts at the required shape before giving up (default 4; the poll "
                             "loop uses 12, which is too slow for a belt email)")
        a = ap.parse_args(sys.argv[2:])
        body = a.text or ""
        if a.file:
            body = Path(a.file).expanduser().read_text(errors="replace")
        ok, info = compose_and_send(a.to, a.subject, body[:a.max_chars], source=a.source,
                                    label=a.label, tries=a.tries,
                                    legs_from=(a.legs_from or (a.file if a.file else "")),
                                    attach=(a.attach or (a.file if a.file else "")),
                                    chapters=a.chapters, chapter_chars=a.chapter_chars,
                                    space_hint=a.space)
        print(("✅ sent (" + str(info) + ")") if ok else ("✗ " + str(info)))
        return 0 if ok else 1
    if cmd=="status":
        st=load_state(); print(f"inbox={INBOX}\nmodel={FM_MODEL} host={FM_HOST}\nseen={len(st.get('seen',[]))} last_poll={st.get('last_poll')}")
        print(f"AgentMail key: {'set' if _read_key('AGENTMAIL_API_KEY','~/.agentmail.key') else 'MISSING'}")
        print(f"FreeLLMAPI key: {'set' if _read_key('FM_FREE_KEY','~/.fm-free.key') else 'MISSING'}")
    elif cmd=="loop":
        print(f"freellmask-mail loop: polling {INBOX} every {POLL_SEC}s")
        while True:
            try:
                n=poll_once(verbose=True)
                if n: print(f"[{time.strftime('%H:%M:%S')}] answered {n} email(s)")
            except Exception as e:
                print(f"[{time.strftime('%H:%M:%S')}] poll error: {e}")
            time.sleep(POLL_SEC)
    else:
        n=poll_once(); print(f"polled: answered {n} new email(s)")

if __name__=="__main__": main()
