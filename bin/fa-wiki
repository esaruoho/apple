#!/usr/bin/env python3
"""fa-wiki — Karpathy LLM-WIKI ingest for the archive, powered by FreeLLMAPI.

Karpathy's LLM-WIKI.md doctrine, made operational with free tokens:
  I  sources immutable   → we READ raw/, never edit it
  II separate layers     → raw archive | wiki-suggestions/ (model draft) | accepted → DreamGraph
  III model owns wiki    → FreeLLMAPI does the bookkeeping (summarize, cross-ref, link, file)
  IV compile not retrieve→ the accepted graph IS the compiled artifact (convey DreamGraph), not RAG
  V  one source at a time→ `fa-wiki ingest <one-file>`
  VI link everything     → related entities become typed edges in the graph
  VII navigate by index  → DreamGraph dream_graph.json {nodes,edges}
  VIII lint              → `fa-wiki lint` surfaces contradictions, duplicate-spelling entities, orphans
  IX start small         → ingest a handful, supervise, then scale
The human owns judgment: ingest STAGES a suggestion; accept commits it.

  fa-wiki ingest <source-file> [--model ID] [--out DIR] [--host URL]
  fa-wiki batch  <dir|glob> [--limit N] [--accept] [--graph G] [--sleep S] [--out DIR]
  fa-wiki accept <suggestion.json> [--graph kb/graph/free-energy]
  fa-wiki lint   [--graph kb/graph/free-energy] [--model ID]

Key from $FM_FREE_KEY or ~/.fm-free.key. Host default = cloudcity Mini :3001.
"""
import argparse, glob, json, os, re, subprocess, sys, time, urllib.request
from pathlib import Path

_FM_RENDER = Path.home()/"work"/"apple"/"bin"/"fm_render.py"
def show_md(text):
    """Rich-render markdown to the terminal (ANSI on a TTY, plain when piped)."""
    if _FM_RENDER.exists():
        try: subprocess.run([sys.executable,str(_FM_RENDER),"--chat","--force-color"],input=text,text=True); return
        except Exception: pass
    print(text)

REL_TYPES = ["references","influences","implements","depends_on","part_of",
             "contradicts","associated_with","exemplified_by","produces","derived_from"]
CONVEY = Path.home()/"work"/"convey"

def key():
    k = os.environ.get("FM_FREE_KEY","")
    if not k:
        p = Path.home()/".fm-free.key"
        if p.exists(): k = p.read_text().strip()
    if not k: sys.exit("fa-wiki: no key (FM_FREE_KEY or ~/.fm-free.key)")
    return k

def norm_host(h):
    return h if h.rstrip("/").endswith("/v1") else h.rstrip("/")+"/v1"

def call(host, k, model, system, user, max_tokens=1600):
    body=json.dumps({"model":model,"messages":[{"role":"system","content":system},
        {"role":"user","content":user}],"max_tokens":max_tokens}).encode()
    req=urllib.request.Request(host.rstrip("/")+"/chat/completions",data=body,
        headers={"Authorization":"Bearer "+k,"Content-Type":"application/json"})
    for attempt in range(4):                      # free-tier 429: brief backoff, let the router re-pick
        try:
            with urllib.request.urlopen(req,timeout=180) as r: d=json.load(r); break
        except urllib.error.HTTPError as e:
            if e.code==429 and attempt<3: time.sleep(5*(attempt+1)); continue
            raise
    if "error" in d: raise RuntimeError(json.dumps(d["error"])[:300])
    u=d.get("usage",{})
    return d["choices"][0]["message"]["content"].strip(), f"{d.get('provider','?')}/{d.get('model','?')}", u.get("total_tokens",0)

def parse_json(text):
    start=text.find("{")
    while start!=-1:
        depth=0
        for i in range(start,len(text)):
            if text[i]=="{": depth+=1
            elif text[i]=="}":
                depth-=1
                if depth==0:
                    try: return json.loads(text[start:i+1])
                    except Exception: break
        start=text.find("{", start+1)
    raise ValueError("no parseable JSON object in model reply")

INGEST_SYS = (
  "You are the COMPILER in a Karpathy-style LLM-WIKI for a free-energy research archive, "
  "working from the committed viewpoint that free energy is a real, engineerable phenomenon. "
  "Read ONE raw source and compile it into a single linked wiki page. Output STRICT JSON only, "
  "no prose, no thinking out loud, with keys:\n"
  '{"entity": "canonical subject name this page is ABOUT",\n'
  ' "kind": "person|device|concept|experiment|claim",\n'
  ' "summary": "2-3 sentence compiled summary",\n'
  ' "claims": [{"claim":"one factual/technical claim","anchor":"shortest verbatim quote/figure from the text"}],\n'
  ' "relations": [{"type":"one of '+ "|".join(REL_TYPES) +'","target":"another canonical entity"}],\n'
  ' "contradictions": ["any claim conflicting with mainstream physics — state, do not resolve"],\n'
  ' "confidence": 0.0-1.0, "open_question": "best replication target or unknown"}\n'
  "Use canonical names (always 'Viktor Schauberger', never 'Schauberger' or 'Schaubergers'; "
  "'Nikola Tesla', 'Repulsine', 'Implosion'). Anchors must be real substrings of the source.")

def slugify(s): return re.sub(r"[^a-z0-9]+","-",(s or "untitled").lower()).strip("-")[:80]

def ingest_one(host, k, model, src, chars=8000):
    # Big token budget: reasoning models (nemotron) spend tokens THINKING then emit
    # the JSON last — too small a budget truncates before the JSON and parse fails.
    text=src.read_text(errors="ignore")[:chars]
    raw,used,tok=call(host,k,model,INGEST_SYS,f"RAW SOURCE: {src}\n\n{text}",max_tokens=5000)
    try: obj=parse_json(raw)
    except Exception:
        # Retry on the SAME model (the one with headroom) with a hard JSON-only nudge.
        raw,used,tok2=call(host,k,model,
            INGEST_SYS+"\n\nIMPORTANT: reply with ONLY the JSON object — first character '{', last character '}', nothing else.",
            f"RAW SOURCE: {src}\n\n{text}",max_tokens=5000)
        tok+=tok2; obj=parse_json(raw)
    obj["_source"]=str(src); obj["_provenance"]={"model":used,"tokens":tok,"cost":0}
    return obj, used, tok

def render_suggestion(obj, out):
    src=obj.get("_source",""); used=obj.get("_provenance",{}).get("model","?"); tok=obj.get("_provenance",{}).get("tokens",0)
    slug=slugify(obj.get("entity"))
    (out/f"{slug}.json").write_text(json.dumps(obj,indent=2,ensure_ascii=False))
    md=[f"# {obj.get('entity','?')}  ", f"_SUGGESTION — judge before accepting · {used} · {tok} tok · $0_  ",
        f"_kind: {obj.get('kind','?')} · confidence: {obj.get('confidence','?')} · source: {src}_\n",
        "## Summary", obj.get("summary","").strip(), "\n## Claims (source-anchored)"]
    for c in obj.get("claims",[]):
        md.append(f"- {c.get('claim','').strip()}")
        if c.get("anchor"): md.append(f"  > {c['anchor'].strip()}")
    md.append("\n## Relationships (graph edges)")
    for r in obj.get("relations",[]): md.append(f"- {r.get('type','associated_with')} → [[{r.get('target','?')}]]")
    if obj.get("contradictions"):
        md.append("\n## Contradictions / lint"); md += [f"- {c}" for c in obj["contradictions"]]
    if obj.get("open_question"): md += ["\n## Open question / replication target", obj["open_question"]]
    (out/f"{slug}.suggestion.md").write_text("\n".join(md)+"\n")
    return slug

def graph_base(g):
    b=Path(g)
    return b if b.is_absolute() else CONVEY/g

def accept_obj(obj, g, build=True):
    sys.path.insert(0, str(CONVEY))
    from convey.graph import DreamGraph
    dg=DreamGraph(base=graph_base(g))
    rels=[(r.get("type","associated_with"), r.get("target","")) for r in obj.get("relations",[]) if r.get("target")]
    ent=obj["entity"]; src=obj.get("_source",""); conf=float(obj.get("confidence",0.5) or 0.5)
    dg.add_memory(ent, summary=obj.get("summary",""), source=src, kind=obj.get("kind","entity"),
                  confidence=conf, relations=rels)
    for c in obj.get("claims",[]):
        dg.add_memory(ent, claim=c.get("claim",""), source=src, confidence=conf)
    if build: dg.build()
    return ent, len(obj.get("claims",[])), len(rels)

def collect(target, limit):
    if any(c in target for c in "*?["): paths=[Path(p) for p in glob.glob(target, recursive=True)]
    else:
        t=Path(target)
        paths=[t] if t.is_file() else list(t.rglob("*.md"))+list(t.rglob("*.txt"))
    paths=[p for p in sorted(set(paths)) if p.is_file()]
    return paths[:limit]

# ── subcommands ──────────────────────────────────────────────────────────────
def cmd_ingest(a):
    host=norm_host(a.host); out=Path(a.out); out.mkdir(parents=True, exist_ok=True)
    src=Path(a.source)
    if not src.is_file(): sys.exit(f"fa-wiki: not a file: {src}")
    t0=time.time()
    try: obj,used,tok=ingest_one(host,key(),a.model,src,a.chars)
    except Exception as e: sys.exit(f"fa-wiki: ingest failed ({e})")
    slug=render_suggestion(obj,out)
    print(f"\n\033[1m═══ SUGGESTION — {obj.get('entity')} ═══\033[0m  ({used.split('/')[0]}, {tok} tok, {time.time()-t0:.0f}s, $0)")
    show_md((out/f"{slug}.suggestion.md").read_text())   # RICH render, not raw markdown
    print(f"\n  READ it, then: fa-wiki accept {out}/{slug}.json --graph kb/graph/free-energy")

def cmd_batch(a):
    host=norm_host(a.host); k=key(); out=Path(a.out); out.mkdir(parents=True, exist_ok=True)
    files=collect(a.target, a.limit)
    if not files: sys.exit(f"fa-wiki: no files under {a.target}")
    print(f"fa-wiki batch: {len(files)} file(s) · model={a.model} · accept={a.accept} · graph={a.graph}\n")
    ok=fail=tot=ents=edges=0
    for i,src in enumerate(files,1):
        try:
            obj,used,tok=ingest_one(host,k,a.model,src,a.chars); tot+=tok
            slug=render_suggestion(obj,out)
            line=f"[{i}/{len(files)}] {src.name:46.46s} → {obj.get('entity','?')[:30]:30.30s} {len(obj.get('claims',[]))}c/{len(obj.get('relations',[]))}e ({used.split('/')[0][:7]}, {tok}t)"
            if a.accept:
                en,nc,ne=accept_obj(obj,a.graph,build=False); ents+=1; edges+=ne; line+=" ✓graphed"
            print(line); ok+=1
        except Exception as e:
            print(f"[{i}/{len(files)}] {src.name:46.46s} → ERROR {str(e)[:60]}"); fail+=1
        time.sleep(a.sleep)
    if a.accept and ents:
        sys.path.insert(0,str(CONVEY)); from convey.graph import DreamGraph
        res=DreamGraph(base=graph_base(a.graph)).build()
        print(f"\ngraph built: {res['nodes']} nodes, {res['edges']} edges at {graph_base(a.graph)}")
    print(f"\n{ok} ingested · {fail} failed · {tot} tokens · $0 · suggestions in {out}/")
    if a.accept: print(f"now: fa-wiki lint --graph {a.graph}")

def cmd_accept(a):
    obj=json.loads(Path(a.suggestion).read_text())
    en,nc,ne=accept_obj(obj,a.graph)
    print(f"accepted '{en}' → DreamGraph at {graph_base(a.graph)}  (+{nc} claims, +{ne} edges)")

def cmd_lint(a):
    """Karpathy rule VIII — find contradictions, duplicate-spelling entities, orphans."""
    base=graph_base(a.graph)
    jf=base/"dream_graph.json"
    if not jf.exists(): sys.exit(f"fa-wiki: no graph at {base} (run batch --accept first)")
    G=json.loads(jf.read_text())
    nodes=[n["id"] for n in G.get("nodes",[])]
    ent_nodes=[n for n in nodes if not n.startswith("src:")]
    edges=G.get("edges",[])
    deg={}
    for e in edges:
        deg[e["from"]]=deg.get(e["from"],0)+1; deg[e["to"]]=deg.get(e["to"],0)+1

    print(f"# fa-wiki lint — {base.name}  ({len(ent_nodes)} entities, {len(edges)} edges)\n")

    # 1. ORPHANS — entity nodes with no edges (Karpathy: 'orphans nobody linked' = lazy ingest)
    orphans=[n for n in ent_nodes if deg.get(n,0)==0]
    print(f"## Orphans ({len(orphans)})  — entities with no graph edges")
    for o in orphans: print(f"  - {o}")
    if not orphans: print("  (none — every entity is linked)")

    # 2. DUPLICATE-SPELLING — entity slugs that normalise to near-identical tokens
    def toks(s): return set(re.sub(r"s\b","",s.lower()).replace("-"," ").split())
    dupes=[]
    for i in range(len(ent_nodes)):
        for j in range(i+1,len(ent_nodes)):
            a1,b1=ent_nodes[i],ent_nodes[j]; ta,tb=toks(a1),toks(b1)
            if not ta or not tb: continue
            ov=len(ta&tb)/max(len(ta),len(tb))
            if ov>=0.6 and a1!=b1: dupes.append((a1,b1,round(ov,2)))
    print(f"\n## Duplicate-spelling candidates ({len(dupes)})  — likely the SAME entity under two names")
    for a1,b1,ov in dupes: print(f"  - [[{a1}]] ~ [[{b1}]]  (overlap {ov})")
    if not dupes: print("  (none detected)")

    # 3. CONTRADICTIONS — one FreeLLMAPI pass over all claims (free, single request)
    claims=[]
    edir=base/"entities"
    if edir.exists():
        for f in sorted(edir.glob("*.md")):
            for ln in f.read_text(errors="ignore").splitlines():
                if ln.startswith("- ") and "[source:" in ln: claims.append(f"{f.stem}: {ln[2:].split('[source:')[0].strip()}")
    print(f"\n## Contradictions  — {len(claims)} claims scanned via FreeLLMAPI")
    if claims:
        sysm=("You are linting a knowledge graph. Given a list of CLAIMS (each prefixed by its entity), "
              "list ONLY pairs that genuinely contradict each other or contradict established physics in a "
              "notable way. Format each as '- <claimA> ⟂ <claimB> — why'. If none, say 'No contradictions found.' "
              "Be terse; max 8 items.")
        try:
            ans,used,tok=call(norm_host(a.host),key(),a.model,sysm,"CLAIMS:\n"+"\n".join(claims[:120]),max_tokens=1200)
            print(ans+f"\n  _(via {used.split('/')[0]}, {tok} tok, $0)_")
        except Exception as e:
            print(f"  (contradiction scan skipped — {str(e)[:80]})")
    else:
        print("  (no claims yet)")

# ── the LLM-wiki engine: lens, index/log, query-reads-wiki-first, DOI frontier ──
DOI_RE=re.compile(r'10\.\d{4,9}/[-._;()/:A-Za-z0-9]+')

def read_lens(base):
    p=base/"lens.md"
    return p.read_text().strip() if p.exists() else \
        "You are a faithful research-wiki synthesist. Cite [[pages]] you use; if the wiki doesn't cover it, say so."

def log_append(base, line):
    lp=base/"log.md"
    if not lp.exists(): lp.write_text("# Log\n\n")
    with lp.open("a") as f: f.write(line.rstrip()+"\n")

def entity_pages(base):
    d=base/"entities"
    return sorted(d.glob("*.md")) if d.exists() else []

def page_meta(p):
    t=p.read_text(errors="ignore")
    name=re.search(r'^name:\s*(.+)$', t, re.M); kind=re.search(r'^kind:\s*(.+)$', t, re.M)
    summ=re.search(r'## Summary\s*\n(.+?)(?=\n##|\Z)', t, re.S)
    claims=len(re.findall(r'^- .+\[source:', t, re.M))
    return {"slug":p.stem, "name":(name.group(1).strip() if name else p.stem),
            "kind":(kind.group(1).strip() if kind else "entity"),
            "summary":(summ.group(1).strip().split("\n")[0] if summ else ""), "claims":claims}

def cmd_index(a):
    base=graph_base(a.graph); pages=[page_meta(p) for p in entity_pages(base)]
    by_kind={}
    for m in pages: by_kind.setdefault(m["kind"],[]).append(m)
    lines=[f"# Index — {base.name}", f"_{len(pages)} pages · regenerated {time.strftime('%Y-%m-%d')}_\n"]
    for kind in sorted(by_kind):
        lines.append(f"## {kind}")
        for m in sorted(by_kind[kind], key=lambda x:x["name"]):
            lines.append(f"- [[{m['slug']}]] — {m['summary'][:120]} ({m['claims']} claims)")
        lines.append("")
    (base/"index.md").write_text("\n".join(lines)+"\n")
    log_append(base, f"## [{time.strftime('%Y-%m-%d %H:%M')}] index | {len(pages)} pages")
    print(f"index → {base}/index.md ({len(pages)} pages, {len(by_kind)} kinds)")

def select_pages(base, question, k=8):
    """Index-first retrieval: score entity pages by keyword overlap (Karpathy: read the index, drill in)."""
    qw=set(re.findall(r'[a-z]{4,}', question.lower())); scored=[]
    for p in entity_pages(base):
        t=p.read_text(errors="ignore").lower()
        score=sum(t.count(w) for w in qw)
        if any(w in p.stem for w in qw): score+=20
        if score: scored.append((score,p))
    scored.sort(key=lambda x:x[0], reverse=True)
    return [p for _,p in scored[:k]]

_EXOTIC=[(0x0400,0x04FF),(0x0600,0x06FF),(0x4E00,0x9FFF),(0xAC00,0xD7AF),(0x0E00,0x0E7F),(0x3040,0x30FF)]
def _wiki_junk(text):
    """The anti-junk gate (same doctrine as freellmask-mail): never FILE a `<unk>` / token-salad /
    script-spam string into the wiki — a self-growing loop that compounds garbage poisons itself.
    Catches even LATIN-HEAVY salad (glued fake words + a sprinkle of cyrillic/arabic/CJK), which a
    naive latin-ratio check misses. True = unusable."""
    t=(text or "").strip()
    if len(t)<15: return True
    if "<unk>" in t or "�" in t or "(blank)" in t.lower(): return True
    # ≥2 exotic scripts (cyrillic + arabic + CJK + hangul + thai + kana) in one short string = salad
    if sum(1 for lo,hi in _EXOTIC if any(lo<=ord(c)<=hi for c in t)) >= 2: return True
    letters=sum(1 for c in t if c.isascii() and c.isalpha())
    if letters/len(t)<0.55: return True
    words=re.findall(r"[A-Za-z]+", t)
    if words:
        if sum(1 for w in words if len(w)>30)/len(words)>0.08: return True
        # nonsense words: a CamelCase seam mid-word ('IllustrPoint') or a 5+ letter word with no vowel
        weird=sum(1 for w in words if len(w)>=5 and (re.search(r'[a-z][A-Z]',w) or not re.search(r'[aeiouyAEIOUY]',w)))
        if weird/len(words)>0.15: return True
    return False

def _answer_and_file(base, host, k, model, lens, question, kpages=8, quiet=False):
    """The query CORE (reused by `query` and the `grow` loop): index-first retrieval → answer THROUGH
    THE LENS from the wiki pages → GATE the answer (regenerate on junk) → file back to queries/ + log.
    Returns the slug, or None if no pages matched / every attempt was junk (the loop never files garbage)."""
    pages=select_pages(base, question, kpages)
    if not pages:
        if not quiet: print("no relevant wiki pages — ingest sources first, or rephrase.")
        return None
    corpus="\n\n".join(f"=== [[{p.stem}]] ===\n{p.read_text(errors='ignore')[:3000]}" for p in pages)
    sysm=(lens+"\n\nAnswer the QUESTION using ONLY the WIKI PAGES provided. Cite each claim with the "
          "[[page-slug]] it came from. If the pages don't cover something, say so — do not invent. "
          "Output ONLY the answer in markdown — no reasoning, no preamble (never start with 'The user' "
          "or 'Okay').")
    user=f"QUESTION: {question}\n\nWIKI PAGES (the compiled knowledge — answer from THESE):\n{corpus}"
    ans=used=""; tok=0
    for _ in range(4):                                  # regenerate on junk (nemotron melts sometimes)
        ans,used,tok=call(host,k,model,sysm,user,max_tokens=2000)
        if not _wiki_junk(ans): break
    if _wiki_junk(ans):
        if not quiet: print("(answer was unusable on every attempt — not filed)")
        return None
    if not quiet:
        print(f"\n{ans}\n")
        print(f"_[from {len(pages)} wiki pages · {used.split('/')[0]} · {tok} tok · $0 · "
              + ", ".join(f'[[{p.stem}]]' for p in pages)+"]_")
    qdir=base/"queries"; qdir.mkdir(exist_ok=True); slug=slugify(question)[:60]
    (qdir/f"{slug}.md").write_text(
        f"# Q: {question}\n_filed {time.strftime('%Y-%m-%d %H:%M')} · {used} · {tok} tok · $0_\n"
        f"_sources: {', '.join('[[%s]]'%p.stem for p in pages)}_\n\n{ans}\n")
    log_append(base, f"## [{time.strftime('%Y-%m-%d %H:%M')}] query | {question[:70]} -> queries/{slug}.md")
    return slug

def cmd_query(a):
    base=graph_base(a.graph); host=norm_host(a.host); k=key()
    slug=_answer_and_file(base, host, k, a.model, read_lens(base), a.question, a.k)
    if slug: print(f"filed back → {base.name}/queries/{slug}.md")

_Q_LEAK=("we need","we can ask","we can propose","could ask","not sure","for example","e.g.",
         "similarly","maybe","unclear","i think","okay","let me","the user","provide ","etc.",
         "that is answerable","that's answerable","likely","probably","perhaps","we should","first,",
         "so the","let's","we could")
# META questions interrogate the wiki's bookkeeping, not its subject — useless to file. Reject them.
_Q_META=("how many claims","according to the index","page according to","number of claims",
         "listed in the index","in the index?","entity page")
def _clean_question(ln):
    """Pull ONE clean question from a model line, rejecting nemotron's reasoning leaks. A valid question
    ends in '?', is 15-180 chars, and carries none of the chain-of-thought tells ('We need to', 'For
    example', 'maybe', …). If a line buries a real question inside reasoning, extract the LAST '?'-ended
    sentence and re-check it. Returns the question or None."""
    q=re.sub(r'^\s*(?:[-*•]|\d+[.)])\s*', '', ln).strip().strip('"').strip()
    low=q.lower()
    if any(m in low for m in _Q_LEAK):
        sents=re.findall(r'[A-Z][^?]{12,180}\?', q)       # salvage a buried, clean question
        cand=next((s.strip() for s in reversed(sents)
                   if not any(m in s.lower() for m in _Q_LEAK)), None)
        if not cand: return None
        q=cand; low=q.lower()
    if not q.endswith("?") or not (15<=len(q)<=180): return None
    if any(m in q.lower() for m in _Q_META): return None      # drop wiki-bookkeeping meta-questions
    return q

def _lint_findings(base):
    """The lint signals the grow-loop turns into questions: orphan entities (no edges) and
    duplicate-spelling candidates. Reuses cmd_lint's graph logic, minus the slow contradiction scan."""
    jf=base/"dream_graph.json"
    if not jf.exists(): return {"orphans":[], "dupes":[], "entities":[]}
    G=json.loads(jf.read_text()); nodes=[n["id"] for n in G.get("nodes",[])]
    ent=[n for n in nodes if not n.startswith("src:")]; deg={}
    for e in G.get("edges",[]): deg[e["from"]]=deg.get(e["from"],0)+1; deg[e["to"]]=deg.get(e["to"],0)+1
    orphans=[n for n in ent if deg.get(n,0)==0]
    def toks(s): return set(re.sub(r"s\b","",s.lower()).replace("-"," ").split())
    dupes=[]
    for i in range(len(ent)):
        for j in range(i+1,len(ent)):
            ta,tb=toks(ent[i]),toks(ent[j])
            if ta and tb and ent[i]!=ent[j] and len(ta&tb)/max(len(ta),len(tb))>=0.6:
                dupes.append((ent[i],ent[j]))
    return {"orphans":orphans, "dupes":dupes, "entities":ent}

def cmd_grow(a):
    """THE SELF-GROWING LOOP (Karpathy 'lint → ask → file back'), one cycle, ZERO human typing:
    lint the graph → propose N answerable questions THROUGH THE LENS (link orphans, deepen thin
    pages, surface missing connections, resolve contradictions) → answer each FROM the wiki (files
    back to queries/, gated against junk, deduped against already-asked) → re-index → log. Run on a
    cadence (a Cloudcity-Boot pane) and the wiki compounds itself between sessions, at $0, in one voice."""
    base=graph_base(a.graph); host=norm_host(a.host); k=key(); lens=read_lens(base)
    find=_lint_findings(base)
    index_md=(base/"index.md").read_text() if (base/"index.md").exists() else ""
    existing={p.stem for p in (base/"queries").glob("*.md")} if (base/"queries").exists() else set()
    lint_summary=(f"Orphans (entities with NO links — connect them): {', '.join(find['orphans']) or 'none'}\n"
                  f"Possible duplicate entities (reconcile): "
                  f"{', '.join('%s~%s'%(x,y) for x,y in find['dupes']) or 'none'}")
    sysm=(lens+"\n\nPropose the NEXT questions to GROW this wiki. STRICT FORMAT: output EXACTLY one "
          "question per line; each line is a SINGLE specific question that ENDS WITH '?'; output NOTHING "
          "else — no numbering, no reasoning, no 'We need to', no 'For example', no 'Similarly', no "
          "commentary, no blank analysis. Example of a GOOD line: 'What primary-source measurement "
          "supports the Repulsine's claimed lift?'. Each question must be answerable FROM the existing "
          "corpus: link an orphan, deepen a thin page, connect two existing entities, or resolve a "
          "contradiction. Begin directly with the first question.")
    user=f"INDEX:\n{index_md[:4000]}\n\nLINT:\n{lint_summary}\n\nGive {a.n+5} questions, one per line."
    qs=[]; seen_q=set()
    for _ in range(5):                                    # nemotron leaks reasoning — retry for clean lines
        raw,_used,_tok=call(host,k,a.model,sysm,user,max_tokens=700)
        for ln in raw.splitlines():
            q=_clean_question(ln)
            if not q or _wiki_junk(q):
                continue
            sl=slugify(q)[:60]
            if sl in existing or sl in seen_q:            # already answered / already proposed this cycle
                continue
            seen_q.add(sl); qs.append(q)
            if len(qs)>=a.n: break
        if len(qs)>=a.n: break
    print(f"# fa-wiki grow — {base.name}  ·  {len(qs)} new question(s) "
          f"(lint: {len(find['orphans'])} orphans, {len(find['dupes'])} dup-candidates)\n")
    for q in qs: print(f"  ? {q}")
    if not qs:
        print("  (nothing new to ask — the loop is caught up; ingest more sources to open new questions)")
        return
    if getattr(a, "dry", False):
        print("\n(--dry — proposed only, nothing filed)"); return
    filed=[]
    for q in qs:
        slug=_answer_and_file(base, host, k, a.model, lens, q, a.k, quiet=True)
        if slug: filed.append(slug); print(f"  ✓ filed → queries/{slug}.md")
        else: print(f"  ✗ skipped (no pages / junk): {q[:60]}")
    cmd_index(a)                                          # regenerate index (a has .graph)
    log_append(base, f"## [{time.strftime('%Y-%m-%d %H:%M')}] grow | proposed {len(qs)}, filed {len(filed)}")
    print(f"\n✅ grow cycle: {len(filed)} new answer(s) filed back — the wiki compounded itself.")

def cmd_dois(a):
    """DOI branch frontier: DOIs in the corpus' raw sources → convey's DOI->DOI->DOI chasing."""
    base=graph_base(a.graph); found={}
    for p in entity_pages(base):
        for doi in DOI_RE.findall(p.read_text(errors="ignore")): found.setdefault(doi.rstrip('.'), p.stem)
        srcm=re.search(r'source:\s*(\S+)', p.read_text(errors="ignore"))
        if srcm:
            sp=Path(srcm.group(1));
            if not sp.is_absolute(): sp=Path.home()/"work"/"merlib-dump"/srcm.group(1)
            if sp.exists():
                for doi in DOI_RE.findall(sp.read_text(errors='ignore')[:20000]): found.setdefault(doi.rstrip('.'), p.stem)
    print(f"# DOI branch frontier — {len(found)} DOI(s) referenced in {base.name}")
    for doi,ent in sorted(found.items()):
        print(f"  {doi}  (from [[{ent}]])  → convey scihub {doi}")
    if not found: print("  (no DOIs in the corpus sources yet — ingest papers with reference lists to branch)")

def cmd_yaml(a):
    """Ingest a STRUCTURED ontology YAML (people.yaml etc.) straight into the graph — no LLM,
    no rate limits, instant. Overlapping entities MERGE with existing compiled pages (enriching
    them). Each mapping key → an entity page; related_people/domain → typed edges."""
    import yaml as _yaml
    base=graph_base(a.graph)
    sys.path.insert(0, str(CONVEY)); from convey.graph import DreamGraph
    dg=DreamGraph(base=base)
    data=_yaml.safe_load(Path(a.file).read_text(errors="ignore"))
    if not isinstance(data, dict): sys.exit("fa-wiki yaml: expected a mapping of entities at the top level")
    items=[(k,v) for k,v in data.items() if isinstance(v, dict)]
    if a.limit: items=items[:a.limit]
    n=0; src_default=str(Path(a.file).relative_to(Path.home()) if str(a.file).startswith(str(Path.home())) else a.file)
    def L(v): return v if isinstance(v,list) else ([] if v in (None,"") else [v])   # coerce to list
    def S(v): return ", ".join(map(str,v)) if isinstance(v,list) else str(v)
    for key, p in items:
        _nm=p.get("full_name") or p.get("name") or key
        subj=(str(_nm[0]) if isinstance(_nm,list) and _nm else str(_nm)).strip() or str(key)
        src=(L(p.get("key_sources") or p.get("sources")) or [src_default])[0] or src_default
        rels=[]
        # any related_* field → associated_with edges (related_people/concepts/devices/patents…)
        for fld,val in p.items():
            if str(fld).startswith("related_"):
                for r in L(val): rels.append(("associated_with", str(r)))
        for d in L(p.get("domain") or p.get("domains")): rels.append(("part_of", str(d)))
        for inf in L(p.get("influenced_by")): rels.append(("influences", str(inf)))
        _desc=p.get("description") or ""
        summ=(" ".join(map(str,_desc)) if isinstance(_desc,list) else str(_desc)).strip()
        dg.add_memory(subj, summary=summ[:700], source=str(src), kind=a.kind, confidence=0.8, relations=rels)
        claims=[]
        for f in ("role","nationality","active_period","also_known_as","formula","year","type","status","patent_number"):
            if p.get(f): claims.append(f"{f.replace('_',' ').title()}: {S(p[f])}")
        for c in L(p.get("key_concepts")): claims.append(f"Key concept: {S(c) if isinstance(c,(list,dict)) else c}")
        for pub in L(p.get("publications")):
            if isinstance(pub, dict): claims.append(f"Publication: {pub.get('title','?')} ({pub.get('year','?')}, {pub.get('type','')})")
            elif pub: claims.append(f"Publication: {pub}")
        for c in claims: dg.add_memory(subj, claim=str(c), source=str(src), confidence=0.8)
        n+=1
        if a.verbose and n%250==0: print(f"  {n}/{len(items)} ...")
    res=dg.build()
    nn=len(res.get('nodes',[])) if isinstance(res.get('nodes'),list) else res.get('nodes',0)
    ne=len(res.get('edges',[])) if isinstance(res.get('edges'),list) else res.get('edges',0)
    print(f"ingested {n} entities from {Path(a.file).name} → {base.name} ({nn} nodes, {ne} edges, $0, no LLM)")

def main():
    ap=argparse.ArgumentParser(); sub=ap.add_subparsers(dest="cmd",required=True)
    HOST=os.environ.get("FM_FREE_HOST","http://cloudcitymacmini:3001/v1")
    pi=sub.add_parser("ingest"); pi.add_argument("source")
    pi.add_argument("--model",default="qwen3-coder-480b"); pi.add_argument("--out",default="./wiki-suggestions")
    pi.add_argument("--chars",type=int,default=8000); pi.add_argument("--host",default=HOST); pi.set_defaults(fn=cmd_ingest)
    pb=sub.add_parser("batch"); pb.add_argument("target")
    pb.add_argument("--model",default="qwen3-coder-480b"); pb.add_argument("--out",default="./wiki-suggestions")
    pb.add_argument("--limit",type=int,default=20); pb.add_argument("--chars",type=int,default=8000)
    pb.add_argument("--accept",action="store_true"); pb.add_argument("--graph",default="kb/graph/free-energy")
    pb.add_argument("--sleep",type=float,default=4.0); pb.add_argument("--host",default=HOST); pb.set_defaults(fn=cmd_batch)
    pa=sub.add_parser("accept"); pa.add_argument("suggestion"); pa.add_argument("--graph",default="kb/graph/free-energy"); pa.set_defaults(fn=cmd_accept)
    pl=sub.add_parser("lint"); pl.add_argument("--graph",default="kb/graph/free-energy")
    pl.add_argument("--model",default="nemotron-3-super-120b"); pl.add_argument("--host",default=HOST); pl.set_defaults(fn=cmd_lint)
    px=sub.add_parser("index"); px.add_argument("--graph",default="kb/graph/free-energy"); px.set_defaults(fn=cmd_index)
    pq=sub.add_parser("query"); pq.add_argument("question")
    pq.add_argument("--graph",default="kb/graph/free-energy"); pq.add_argument("--k",type=int,default=8)
    pq.add_argument("--model",default="nemotron-3-super-120b"); pq.add_argument("--host",default=HOST); pq.set_defaults(fn=cmd_query)
    pd=sub.add_parser("dois"); pd.add_argument("--graph",default="kb/graph/free-energy"); pd.set_defaults(fn=cmd_dois)
    py=sub.add_parser("yaml"); py.add_argument("file"); py.add_argument("--graph",default="kb/graph/free-energy")
    py.add_argument("--kind",default="person"); py.add_argument("--limit",type=int,default=0)
    py.add_argument("--verbose",action="store_true"); py.set_defaults(fn=cmd_yaml)
    pg=sub.add_parser("grow")          # the self-growing loop: lint → ask → answer-from-wiki → file back
    pg.add_argument("--graph",default="kb/graph/free-energy"); pg.add_argument("--n",type=int,default=3)
    pg.add_argument("--k",type=int,default=8); pg.add_argument("--dry",action="store_true")
    pg.add_argument("--model",default="nemotron-3-super-120b"); pg.add_argument("--host",default=HOST); pg.set_defaults(fn=cmd_grow)
    a=ap.parse_args(); a.fn(a)

if __name__=="__main__": main()
