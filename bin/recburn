#!/bin/bash
# recburn — the full screencast in one word: screen + system audio + microphone +
# webcam circle, then on stop flatten (YouTube-ready) + transcribe + burn subtitles.
# Extra args pass straight through, e.g. `recburn --out ~/demo.mov` or `recburn --burn-model medium.en`.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$DIR/rec" --mic --pip --burn "$@"
