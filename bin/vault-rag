#!/usr/bin/env swift
// vault-rag — paragraph-level semantic search over a folder of notes.
//
// Why this exists: vault-grep embeds and ranks ONE LINE at a time, so short
// keyword-dense lines (code snippets, commit-log entries) outrank explanatory
// prose, and a great prose file can miss the top hits entirely. vault-rag chunks
// each file into paragraphs (blank-line-separated blocks), embeds each CHUNK with
// NLEmbedding, and ranks chunks — so the unit returned is a quotable passage, not
// a stray line. On-device, Apple-native (NaturalLanguage), no network, no pip.
//
// Embeddings are cached per file (keyed by path+mtime) at
// ~/.cache/apple/vault-rag-cache.json, so only changed files re-embed.
//
// Usage:
//   vault-rag "query" --root DIR [--top N] [--ext .md,.txt] [--json]

import Foundation
import NaturalLanguage

// ---- args ----
var args = Array(CommandLine.arguments.dropFirst())
func opt(_ flag: String) -> String? {
    guard let i = args.firstIndex(of: flag), i + 1 < args.count else { return nil }
    let v = args[i + 1]; args.removeSubrange(i...(i + 1)); return v
}
let asJSON = args.contains("--json"); args.removeAll { $0 == "--json" }
let root = (opt("--root") ?? FileManager.default.currentDirectoryPath)
let top = Int(opt("--top") ?? "5") ?? 5
let exts = Set((opt("--ext") ?? ".md,.txt").split(separator: ",").map {
    $0.hasPrefix(".") ? String($0.dropFirst()) : String($0)
})
let query = args.filter { !$0.hasPrefix("--") }.joined(separator: " ")
func die(_ m: String) -> Never { FileHandle.standardError.write(Data((m + "\n").utf8)); exit(2) }
if query.isEmpty { die("usage: vault-rag \"query\" --root DIR [--top N]") }

guard let emb = NLEmbedding.sentenceEmbedding(for: .english) else {
    die("NLEmbedding sentence model unavailable")
}

// ---- embedding: vector for a chunk; average sentence vectors if needed ----
func embed(_ text: String) -> [Double]? {
    if let v = emb.vector(for: text) { return v }
    // NLEmbedding can balk at very long input — retry on a truncated head.
    // (No per-sentence averaging: that pegged multiple cores for ~95s cold.)
    return emb.vector(for: String(text.prefix(600)))
}
func cosine(_ a: [Double], _ b: [Double]) -> Double {
    let n = min(a.count, b.count); if n == 0 { return 0 }
    var d = 0.0, na = 0.0, nb = 0.0
    for i in 0..<n { d += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i] }
    return (na == 0 || nb == 0) ? 0 : d / (sqrt(na) * sqrt(nb))
}

// ---- chunking: header-aware sections (a Markdown heading + its body, up to the
// next heading). This keeps "## What is ASObjC" attached to its explanation so a
// "what is ASObjC" query matches the whole section, not a stray header or code line.
// Over-long sections are split by line accumulation; tiny ones are dropped.
func chunks(_ body: String) -> [String] {
    var out: [String] = []
    var cur: [String] = []
    func flush() {
        let s = cur.joined(separator: "\n").trimmingCharacters(in: .whitespacesAndNewlines)
        cur = []
        if s.count < 40 { return }
        if s.count <= 1600 { out.append(s); return }
        var piece = ""
        for ln in s.components(separatedBy: "\n") {
            if piece.count + ln.count > 1300 { if piece.count >= 40 { out.append(piece) }; piece = "" }
            piece += (piece.isEmpty ? "" : "\n") + ln
        }
        if piece.count >= 40 { out.append(piece) }
    }
    for ln in body.components(separatedBy: "\n") {
        if ln.hasPrefix("#") { flush() }   // a heading starts a new section
        cur.append(ln)
    }
    flush()
    return out
}

// ---- cache ----
struct CachedChunk: Codable { let text: String; let vec: [Double] }
struct CachedFile: Codable { let mtime: Double; let chunks: [CachedChunk] }
let cacheDir = NSHomeDirectory() + "/.cache/apple"
let cachePath = cacheDir + "/vault-rag-cache-v2.json"   // v2 = header-aware section chunks
try? FileManager.default.createDirectory(atPath: cacheDir, withIntermediateDirectories: true)
var cache: [String: CachedFile] = [:]
if let d = FileManager.default.contents(atPath: cachePath),
   let c = try? JSONDecoder().decode([String: CachedFile].self, from: d) { cache = c }

// ---- walk the root for matching files ----
let fm = FileManager.default
guard let en = fm.enumerator(atPath: root) else { die("cannot read root: \(root)") }
var files: [String] = []
for case let rel as String in en {
    let ext = (rel as NSString).pathExtension.lowercased()
    if exts.contains(ext) { files.append(rel) }
}

// ---- build/refresh chunk vectors (only re-embed changed files) ----
struct Hit { let score: Double; let rel: String; let text: String }
var dirty = false
var allChunks: [(rel: String, text: String, vec: [Double])] = []
for rel in files {
    let abs = root + "/" + rel
    let attrs = try? fm.attributesOfItem(atPath: abs)
    let mtime = (attrs?[.modificationDate] as? Date)?.timeIntervalSince1970 ?? 0
    if let cf = cache[abs], cf.mtime == mtime {
        for ch in cf.chunks { allChunks.append((rel, ch.text, ch.vec)) }
        continue
    }
    guard let body = try? String(contentsOfFile: abs, encoding: .utf8) else { continue }
    var cfChunks: [CachedChunk] = []
    for ch in chunks(body) {
        guard let v = embed(ch) else { continue }
        cfChunks.append(CachedChunk(text: ch, vec: v))
        allChunks.append((rel, ch, v))
    }
    cache[abs] = CachedFile(mtime: mtime, chunks: cfChunks)
    dirty = true
}
if dirty, let d = try? JSONEncoder().encode(cache) { try? d.write(to: URL(fileURLWithPath: cachePath)) }

// ---- rank ----
guard let qv = embed(query) else { die("could not embed query") }
let ranked = allChunks.map { Hit(score: cosine(qv, $0.vec), rel: $0.rel, text: $0.text) }
    .sorted { $0.score > $1.score }
    .prefix(top)

if asJSON {
    let arr = ranked.map { ["score": $0.score, "file": $0.rel, "text": $0.text] as [String: Any] }
    if let d = try? JSONSerialization.data(withJSONObject: arr, options: [.prettyPrinted]) {
        print(String(data: d, encoding: .utf8) ?? "[]")
    }
} else {
    for h in ranked {
        print(String(format: "[%.3f] %@", h.score, h.rel))
        print(h.text)
        print("\n---\n")
    }
}
