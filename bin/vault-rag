#!/usr/bin/env swift
// vault-rag — paragraph/section-level semantic search over a folder of notes,
// using a CoreML sentence-transformer (all-MiniLM-L6-v2) on the Neural Engine.
//
// Why MiniLM and not NLEmbedding: NLEmbedding's static vectors are too coarse —
// they couldn't surface concepts/asobjc.md for an "AppleScriptObjC" query even in
// the top 30. MiniLM is a real sentence-transformer (384-dim, fine-tuned for
// similarity), so a query matches the right passage. Runtime is pure CoreML + a
// hand-rolled WordPiece tokenizer — no pip, no network; the .mlpackage is built
// once by bin/build-minilm.sh. Each note is chunked into header-aware sections
// (heading + body) so a hit is a whole quotable passage.
//
// Embeddings cached per file (path+mtime) at ~/.cache/apple/vault-rag-cache-v3.json.
// Usage: vault-rag "query" --root DIR [--top N] [--ext .md,.txt] [--json]
// Model dir via $MINILM_DIR (default ~/work/apple/models/minilm).

import Foundation
import CoreML

// ---- args ----
var args = Array(CommandLine.arguments.dropFirst())
func opt(_ flag: String) -> String? {
    guard let i = args.firstIndex(of: flag), i + 1 < args.count else { return nil }
    let v = args[i + 1]; args.removeSubrange(i...(i + 1)); return v
}
let asJSON = args.contains("--json"); args.removeAll { $0 == "--json" }
let root = (opt("--root") ?? FileManager.default.currentDirectoryPath)
let top = Int(opt("--top") ?? "5") ?? 5
let exts = Set((opt("--ext") ?? ".md,.txt").split(separator: ",").map {
    $0.hasPrefix(".") ? String($0.dropFirst()) : String($0)
})
let query = args.filter { !$0.hasPrefix("--") }.joined(separator: " ")
func die(_ m: String) -> Never { FileHandle.standardError.write(Data((m + "\n").utf8)); exit(2) }
if query.isEmpty { die("usage: vault-rag \"query\" --root DIR [--top N]") }

let SEQ = 256, DIM = 384
let cacheDir = NSHomeDirectory() + "/.cache/apple"
try? FileManager.default.createDirectory(atPath: cacheDir, withIntermediateDirectories: true)
let modelDir = ProcessInfo.processInfo.environment["MINILM_DIR"] ?? "\(NSHomeDirectory())/work/apple/models/minilm"

// ---- load vocab.txt → token:id ----
guard let vocabText = try? String(contentsOfFile: "\(modelDir)/vocab.txt", encoding: .utf8) else {
    die("vault-rag: vocab.txt not found in \(modelDir) — run bin/build-minilm.sh first")
}
var vocab: [String: Int] = [:]
for (i, line) in vocabText.split(separator: "\n", omittingEmptySubsequences: false).enumerated() {
    vocab[String(line)] = i
}
let clsId = vocab["[CLS]"] ?? 101, sepId = vocab["[SEP]"] ?? 102
let padId = vocab["[PAD]"] ?? 0, unkId = vocab["[UNK]"] ?? 100

// ---- load / compile the CoreML model (cache the compiled .mlmodelc) ----
let fmgr = FileManager.default
let pkgURL = URL(fileURLWithPath: "\(modelDir)/MiniLM.mlpackage")
let compiledURL = URL(fileURLWithPath: "\(cacheDir)/MiniLM.mlmodelc")
func mtime(_ p: String) -> Date { (try? fmgr.attributesOfItem(atPath: p)[.modificationDate] as? Date) ?? Date.distantPast }
var needCompile = !fmgr.fileExists(atPath: compiledURL.path)
if !needCompile { needCompile = mtime(compiledURL.path) < mtime(pkgURL.path) }
if needCompile {
    guard fmgr.fileExists(atPath: pkgURL.path) else {
        die("vault-rag: MiniLM.mlpackage not found in \(modelDir) — run bin/build-minilm.sh first")
    }
    guard let tmp = try? MLModel.compileModel(at: pkgURL) else { die("vault-rag: model compile failed") }
    try? fmgr.removeItem(at: compiledURL)
    try? fmgr.copyItem(at: tmp, to: compiledURL)
}
let cfg = MLModelConfiguration(); cfg.computeUnits = .all
guard let model = try? MLModel(contentsOf: compiledURL, configuration: cfg) else {
    die("vault-rag: could not load model from \(compiledURL.path)")
}

// ---- WordPiece tokenizer (bert-base-uncased: lowercase, split punctuation) ----
func wordpiece(_ token: String) -> [Int] {
    if let id = vocab[token] { return [id] }
    let chars = Array(token); var ids: [Int] = []; var start = 0
    while start < chars.count {
        var end = chars.count; var cur: Int? = nil
        while start < end {
            let sub = (start > 0 ? "##" : "") + String(chars[start..<end])
            if let id = vocab[sub] { cur = id; break }
            end -= 1
        }
        guard let c = cur else { return [unkId] }
        ids.append(c); start = end
    }
    return ids
}
func tokenize(_ text: String) -> [Int] {
    var basic: [String] = []; var word = ""
    for ch in text.lowercased() {
        if ch.isWhitespace {
            if !word.isEmpty { basic.append(word); word = "" }
        } else if !(ch.isLetter || ch.isNumber) {
            if !word.isEmpty { basic.append(word); word = "" }
            basic.append(String(ch))
        } else { word.append(ch) }
    }
    if !word.isEmpty { basic.append(word) }
    var ids = [clsId]
    outer: for b in basic {
        for id in wordpiece(b) {
            if ids.count >= SEQ - 1 { break outer }
            ids.append(id)
        }
    }
    ids.append(sepId)
    return ids
}

// ---- embed one text → L2-normalized mean-pooled 384-dim vector ----
func embed(_ text: String) -> [Double]? {
    let ids = tokenize(text)
    guard let idArr = try? MLMultiArray(shape: [1, NSNumber(value: SEQ)], dataType: .int32),
          let mkArr = try? MLMultiArray(shape: [1, NSNumber(value: SEQ)], dataType: .int32) else { return nil }
    let idp = idArr.dataPointer.bindMemory(to: Int32.self, capacity: SEQ)
    let mkp = mkArr.dataPointer.bindMemory(to: Int32.self, capacity: SEQ)
    for i in 0..<SEQ {
        if i < ids.count { idp[i] = Int32(ids[i]); mkp[i] = 1 }
        else { idp[i] = Int32(padId); mkp[i] = 0 }
    }
    guard let prov = try? MLDictionaryFeatureProvider(dictionary: ["input_ids": idArr, "attention_mask": mkArr]),
          let out = try? model.prediction(from: prov),
          let hs = out.featureValue(for: "hidden_states")?.multiArrayValue else { return nil }
    // hs shape [1, SEQ, DIM]; offset = t*DIM + d
    var vec = [Double](repeating: 0, count: DIM)
    let realCount = min(ids.count, SEQ)
    if hs.dataType == .float32 {
        let p = hs.dataPointer.bindMemory(to: Float32.self, capacity: SEQ * DIM)
        for t in 0..<realCount { let base = t * DIM; for d in 0..<DIM { vec[d] += Double(p[base + d]) } }
    } else {
        for t in 0..<realCount { for d in 0..<DIM { vec[d] += hs[[0, NSNumber(value: t), NSNumber(value: d)]].doubleValue } }
    }
    let n = Double(max(realCount, 1))
    for d in 0..<DIM { vec[d] /= n }
    let norm = sqrt(vec.reduce(0) { $0 + $1 * $1 })
    if norm > 0 { for d in 0..<DIM { vec[d] /= norm } }
    return vec
}
func cosine(_ a: [Double], _ b: [Double]) -> Double {   // both L2-normalized → dot product
    let n = min(a.count, b.count); var d = 0.0
    for i in 0..<n { d += a[i] * b[i] }
    return d
}

// ---- chunking: header-aware sections (heading + body up to the next heading) ----
func chunks(_ body: String) -> [String] {
    var out: [String] = []; var cur: [String] = []
    func flush() {
        let s = cur.joined(separator: "\n").trimmingCharacters(in: .whitespacesAndNewlines); cur = []
        if s.count < 40 { return }
        if s.count <= 1600 { out.append(s); return }
        var piece = ""
        for ln in s.components(separatedBy: "\n") {
            if piece.count + ln.count > 1300 { if piece.count >= 40 { out.append(piece) }; piece = "" }
            piece += (piece.isEmpty ? "" : "\n") + ln
        }
        if piece.count >= 40 { out.append(piece) }
    }
    for ln in body.components(separatedBy: "\n") {
        if ln.hasPrefix("#") { flush() }
        cur.append(ln)
    }
    flush()
    return out
}

// ---- cache ----
struct CachedChunk: Codable { let text: String; let vec: [Double] }
struct CachedFile: Codable { let mtime: Double; let chunks: [CachedChunk] }
let cachePath = cacheDir + "/vault-rag-cache-v3.json"   // v3 = MiniLM 384-dim
var cache: [String: CachedFile] = [:]
if let d = fmgr.contents(atPath: cachePath),
   let c = try? JSONDecoder().decode([String: CachedFile].self, from: d) { cache = c }

// ---- walk + build/refresh ----
guard let en = fmgr.enumerator(atPath: root) else { die("cannot read root: \(root)") }
var files: [String] = []
for case let rel as String in en where exts.contains((rel as NSString).pathExtension.lowercased()) {
    files.append(rel)
}
struct Hit { let score: Double; let rel: String; let text: String }
var dirty = false
var all: [(rel: String, text: String, vec: [Double])] = []
for rel in files {
    let abs = root + "/" + rel
    let mt = (try? fmgr.attributesOfItem(atPath: abs)[.modificationDate] as? Date)??.timeIntervalSince1970 ?? 0
    if let cf = cache[abs], cf.mtime == mt {
        for ch in cf.chunks { all.append((rel, ch.text, ch.vec)) }
        continue
    }
    guard let body = try? String(contentsOfFile: abs, encoding: .utf8) else { continue }
    var cfc: [CachedChunk] = []
    for ch in chunks(body) {
        let flat = ch.replacingOccurrences(of: "\n", with: " ")
        guard let v = embed(flat) else { continue }
        cfc.append(CachedChunk(text: ch, vec: v)); all.append((rel, ch, v))
    }
    cache[abs] = CachedFile(mtime: mt, chunks: cfc); dirty = true
}
if dirty, let d = try? JSONEncoder().encode(cache) { try? d.write(to: URL(fileURLWithPath: cachePath)) }

// ---- rank ----
guard let qv = embed(query) else { die("could not embed query") }
let ranked = all.map { Hit(score: cosine(qv, $0.vec), rel: $0.rel, text: $0.text) }
    .sorted { $0.score > $1.score }.prefix(top)

if asJSON {
    let arr = ranked.map { ["score": $0.score, "file": $0.rel, "text": $0.text] as [String: Any] }
    if let d = try? JSONSerialization.data(withJSONObject: arr, options: [.prettyPrinted]) {
        print(String(data: d, encoding: .utf8) ?? "[]")
    }
} else {
    for h in ranked { print(String(format: "[%.3f] %@", h.score, h.rel)); print(h.text); print("\n---\n") }
}
