#!/usr/bin/env python3
"""recburn-youtube — upload a RecBurn recording to YouTube. Pure Python stdlib, no pip.

This is the "upload" leg of the pipeline chain (Record → stop → Publish to YouTube). It takes a
file (or the latest recording's manifest), authorizes once via Google's OAuth installed-app
loopback flow, and does a resumable chunked upload via the YouTube Data API v3. It prints the
video URL on the last line so a Shortcut / App Intent can capture it.

ONE-TIME SETUP (Google's, not ours — we can't ship credentials):
  1. Google Cloud Console → create a project → enable "YouTube Data API v3".
  2. OAuth consent screen → External → add yourself as a Test user.
  3. Credentials → Create OAuth client ID → type "Desktop app". Download the JSON.
  4. Save it as  ~/.config/recburn/youtube_client.json  (or point RECBURN_YT_CLIENT at it).
The refresh token is cached at ~/.config/recburn/youtube_token.json after the first run.

USAGE:
  recburn-youtube --file ~/Downloads/rec-flat-subtitled.mov [--title "…"] [--description "…"]
                  [--privacy unlisted|private|public] [--tags a,b,c]
  recburn-youtube --latest         # upload the last finished recording (reads last.recburn.json)
  recburn-youtube --auth           # just run the OAuth flow and cache the token, then exit
"""
import argparse, json, os, sys, time, urllib.parse, urllib.request, urllib.error, webbrowser, http.server, threading, socket

CFG_DIR   = os.path.expanduser("~/.config/recburn")
CLIENT    = os.environ.get("RECBURN_YT_CLIENT", os.path.join(CFG_DIR, "youtube_client.json"))
TOKEN     = os.path.join(CFG_DIR, "youtube_token.json")
SCOPE     = "https://www.googleapis.com/auth/youtube.upload"
LAST_MANIFEST = os.path.expanduser("~/Library/Application Support/RecBurn/last.recburn.json")
CHUNK     = 8 * 1024 * 1024   # 8 MiB (must be a multiple of 256 KiB for resumable PUTs)


def die(msg):
    print("recburn-youtube: " + msg, file=sys.stderr)
    sys.exit(1)


def _client():
    if not os.path.exists(CLIENT):
        die("no OAuth client at %s — see the setup steps in this script's header." % CLIENT)
    d = json.load(open(CLIENT))
    d = d.get("installed") or d.get("web") or d
    if "client_id" not in d or "client_secret" not in d:
        die("client json missing client_id/client_secret")
    return d["client_id"], d["client_secret"]


def _post_form(url, fields):
    data = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(url, data=data, method="POST")
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    with urllib.request.urlopen(req) as r:
        return json.load(r)


def _authorize():
    """OAuth installed-app loopback flow → returns a token dict, cached to TOKEN."""
    cid, secret = _client()
    # bind an ephemeral loopback port
    s = socket.socket(); s.bind(("127.0.0.1", 0)); port = s.getsockname()[1]; s.close()
    redirect = "http://127.0.0.1:%d" % port
    auth_url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": cid, "redirect_uri": redirect, "response_type": "code",
        "scope": SCOPE, "access_type": "offline", "prompt": "consent"})
    code_box = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.urlparse(self.path).query
            code_box.update(urllib.parse.parse_qs(q))
            self.send_response(200); self.send_header("Content-Type", "text/html"); self.end_headers()
            self.wfile.write(b"<h2>RecBurn is authorized. You can close this tab.</h2>")
        def log_message(self, *a): pass

    httpd = http.server.HTTPServer(("127.0.0.1", port), Handler)
    print("recburn-youtube: opening browser for Google authorization…", file=sys.stderr)
    webbrowser.open(auth_url)
    threading.Thread(target=httpd.handle_request).start()
    for _ in range(300):
        if "code" in code_box: break
        time.sleep(1)
    httpd.server_close()
    if "code" not in code_box:
        die("authorization timed out (no code received)")
    tok = _post_form("https://oauth2.googleapis.com/token", {
        "code": code_box["code"][0], "client_id": cid, "client_secret": secret,
        "redirect_uri": redirect, "grant_type": "authorization_code"})
    tok["obtained"] = time.time()
    os.makedirs(CFG_DIR, exist_ok=True)
    json.dump(tok, open(TOKEN, "w"))
    os.chmod(TOKEN, 0o600)
    return tok


def _access_token():
    """Return a fresh access token, refreshing or running the full flow as needed."""
    if not os.path.exists(TOKEN):
        return _authorize()["access_token"]
    tok = json.load(open(TOKEN))
    # refresh if older than ~55 min
    if time.time() - tok.get("obtained", 0) < 3300 and tok.get("access_token"):
        return tok["access_token"]
    if not tok.get("refresh_token"):
        return _authorize()["access_token"]
    cid, secret = _client()
    try:
        new = _post_form("https://oauth2.googleapis.com/token", {
            "refresh_token": tok["refresh_token"], "client_id": cid,
            "client_secret": secret, "grant_type": "refresh_token"})
    except urllib.error.HTTPError:
        return _authorize()["access_token"]
    tok["access_token"] = new["access_token"]; tok["obtained"] = time.time()
    json.dump(tok, open(TOKEN, "w"))
    return tok["access_token"]


def _upload(path, meta, access):
    total = os.path.getsize(path)
    body = json.dumps(meta).encode()
    req = urllib.request.Request(
        "https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status",
        data=body, method="POST")
    req.add_header("Authorization", "Bearer " + access)
    req.add_header("Content-Type", "application/json; charset=UTF-8")
    req.add_header("X-Upload-Content-Type", "video/*")
    req.add_header("X-Upload-Content-Length", str(total))
    with urllib.request.urlopen(req) as r:
        session_url = r.headers["Location"]
    if not session_url:
        die("no resumable session URL returned")

    sent = 0
    with open(path, "rb") as f:
        while sent < total:
            chunk = f.read(CHUNK)
            end = sent + len(chunk) - 1
            put = urllib.request.Request(session_url, data=chunk, method="PUT")
            put.add_header("Content-Length", str(len(chunk)))
            put.add_header("Content-Range", "bytes %d-%d/%d" % (sent, end, total))
            try:
                with urllib.request.urlopen(put) as r:
                    payload = r.read()
                    print("recburn-youtube: upload complete (%d bytes)" % total, file=sys.stderr)
                    return json.loads(payload)
            except urllib.error.HTTPError as e:
                if e.code == 308:   # Resume Incomplete — expected between chunks
                    sent = end + 1
                    print("recburn-youtube: %d/%d bytes (%.0f%%)" % (sent, total, 100.0 * sent / total), file=sys.stderr)
                    continue
                die("upload HTTP %d: %s" % (e.code, e.read().decode(errors="replace")))
    die("upload ended without a final response")


def main():
    ap = argparse.ArgumentParser(description="Upload a RecBurn recording to YouTube.")
    ap.add_argument("--file"); ap.add_argument("--latest", action="store_true")
    ap.add_argument("--title"); ap.add_argument("--description", default="Recorded with RecBurn.")
    ap.add_argument("--privacy", default="unlisted", choices=["unlisted", "private", "public"])
    ap.add_argument("--tags", default=""); ap.add_argument("--auth", action="store_true")
    a = ap.parse_args()

    if a.auth:
        _authorize(); print("recburn-youtube: authorized + token cached.", file=sys.stderr); return

    path = a.file
    title = a.title
    if a.latest or not path:
        if not os.path.exists(LAST_MANIFEST):
            die("no --file and no last.recburn.json — record something first, or pass --file")
        m = json.load(open(LAST_MANIFEST))
        path = path or m.get("final")
        title = title or os.path.splitext(os.path.basename(m.get("final", "recording")))[0]
    if not path or not os.path.exists(path):
        die("file not found: %s" % path)
    title = title or os.path.splitext(os.path.basename(path))[0]

    meta = {"snippet": {"title": title, "description": a.description, "categoryId": "28",
                        "tags": [t for t in a.tags.split(",") if t]},
            "status": {"privacyStatus": a.privacy, "selfDeclaredMadeForKids": False}}
    access = _access_token()
    print("recburn-youtube: uploading %s (%s)…" % (os.path.basename(path), a.privacy), file=sys.stderr)
    res = _upload(path, meta, access)
    vid = res.get("id")
    if not vid:
        die("no video id in response: %s" % json.dumps(res)[:300])
    print("https://youtu.be/%s" % vid)   # last line = the URL (captured by the Publish intent)


if __name__ == "__main__":
    main()
