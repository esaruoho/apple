#!/bin/bash
# iphone-photo — thin wrapper that execs the in-bundle binary so Bundle.main
# resolves to Snapshot.app (which carries NSCameraUseContinuityCameraDeviceType
# and its own Camera TCC identity). Programmatic Continuity Camera still → file.
#
#   iphone-photo <out.(jpg|heic)> [--device <substr>] [--list] [--timeout S]
#
# FEATURE-CARD >> sensor-snapshot/snapshot.feature
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$REPO/sensor-snapshot/Snapshot.app/Contents/MacOS/iphone-photo"
if [[ ! -x "$BIN" ]]; then
  echo "Snapshot.app not built — running build.sh…" >&2
  bash "$REPO/sensor-snapshot/build.sh" >&2
fi
exec "$BIN" "$@"
