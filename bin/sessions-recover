#!/usr/bin/env python3
"""sessions-recover — recover live + lost Claude/Codex terminal sessions.

Reads Vibe Island's persisted session metadata and joins it with the current
process table. This gives you:

1. live iTerm-backed sessions that still exist (these are the wedged ones when
   iTerm2 is wedged),
2. stale sessions that existed before a crash / quit but no longer have a live
   process, and
3. live unmatched sessions whose process survives but which have no Vibe record.

Usage:
  sessions-recover
  sessions-recover --json
  sessions-recover --all
  sessions-recover --stale
  sessions-recover --verbose
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

META_PATH = Path.home() / "Library/Application Support/vibe-island/session-terminals.json"
RESUME_RE = re.compile(r"--resume\s+([0-9a-fA-F-]{8,})")


def detect_tool(cmd: str) -> str | None:
    first = (cmd.strip().split() or [""])[0]
    base = os.path.basename(first)
    if base in {"claude", "codex", "copilot"}:
        return base
    if first.endswith("/claude"):
        return "claude"
    if first.endswith("/codex"):
        return "codex"
    if first.endswith("/copilot"):
        return "copilot"
    return None


def load_meta() -> dict[str, dict]:
    if not META_PATH.exists():
        return {}
    try:
        data = json.loads(META_PATH.read_text())
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def cwd_of(pid: str) -> str:
    try:
        r = subprocess.run(
            ["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"],
            capture_output=True,
            text=True,
            timeout=8,
        )
    except Exception:
        return ""
    for line in r.stdout.splitlines():
        if line.startswith("n"):
            return line[1:]
    return ""


def live_sessions() -> list[dict]:
    try:
        r = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,tty=,stat=,etime=,command="],
            capture_output=True,
            text=True,
            timeout=8,
        )
    except Exception:
        return []

    out = []
    for line in r.stdout.splitlines():
        parts = line.strip().split(None, 5)
        if len(parts) < 6:
            continue
        pid, ppid, tty, stat, etime, cmd = parts
        if tty == "?":
            continue
        tool = detect_tool(cmd)
        if not tool:
            continue
        resume = None
        m2 = RESUME_RE.search(cmd)
        if m2:
            resume = m2.group(1)
        out.append(
            {
                "pid": pid,
                "ppid": ppid,
                "tty": tty,
                "stat": stat,
                "etime": etime,
                "tool": tool,
                "cmd": cmd,
                "resume": resume,
                "cwd": cwd_of(pid),
                "transport": "iterm" if tty.startswith("ttys") else "other",
            }
        )
    return out


def join_rows(meta: dict[str, dict], live: list[dict]) -> list[dict]:
    rows = []
    matched = set()

    for sess in live:
        entry = meta.get(sess["resume"], {}) if sess.get("resume") else {}
        if entry:
            matched.add(sess["resume"])
        rows.append(
            {
                "state": "live",
                "recovery": (
                    "wedged-live-matched"
                    if sess["transport"] == "iterm" and entry
                    else "wedged-live-unmatched"
                    if sess["transport"] == "iterm"
                    else "live-other"
                ),
                "tool": sess["tool"],
                "tty": sess["tty"],
                "pid": sess["pid"],
                "etime": sess["etime"],
                "cwd": sess["cwd"] or entry.get("cwd", ""),
                "resume": sess.get("resume"),
                "title": entry.get("customTitle"),
                "first": entry.get("firstUserMessage"),
                "last_seen_at": entry.get("lastSeenAt"),
                "bundle_id": entry.get("bundleIdentifier"),
                "iterm_session_id": entry.get("itermSessionId"),
                "cmd": sess["cmd"],
            }
        )

    for resume, entry in meta.items():
        bundle_id = entry.get("bundleIdentifier", "")
        if bundle_id != "com.googlecode.iterm2":
            continue
        if resume in matched:
            continue
        rows.append(
            {
                "state": "stale",
                "recovery": "post-crash-recoverable",
                "tool": "claude",
                "tty": None,
                "pid": None,
                "etime": None,
                "cwd": entry.get("cwd", ""),
                "resume": resume,
                "title": entry.get("customTitle"),
                "first": entry.get("firstUserMessage"),
                "last_seen_at": entry.get("lastSeenAt"),
                "bundle_id": bundle_id,
                "iterm_session_id": entry.get("itermSessionId"),
                "cmd": None,
            }
        )

    def sort_key(row: dict):
        rank = {"live": 0, "stale": 1}.get(row["state"], 2)
        title = row.get("title") or ""
        tty = row.get("tty") or ""
        cwd = row.get("cwd") or ""
        return (rank, tty, cwd, title)

    return sorted(rows, key=sort_key)


def filter_rows(rows: list[dict], show_all: bool, stale_only: bool) -> list[dict]:
    if stale_only:
        return [r for r in rows if r["state"] == "stale"]
    if show_all:
        return rows
    return [r for r in rows if r["transport_hint"] != "drop"]


def add_transport_hints(rows: list[dict]) -> list[dict]:
    for row in rows:
        if row["state"] == "live" and row["tty"] and str(row["tty"]).startswith("ttys"):
            row["transport_hint"] = "keep"
        elif row["state"] == "stale":
            row["transport_hint"] = "keep"
        else:
            row["transport_hint"] = "drop"
    return rows


def trunc(s: str | None, width: int) -> str:
    s = (s or "").replace("\n", " ").strip()
    if len(s) <= width:
        return s
    if width <= 1:
        return s[:width]
    return s[: width - 1] + "…"


def format_row(values: list[str], widths: list[int]) -> str:
    return " | ".join(v.ljust(w) for v, w in zip(values, widths))


def box_row(values: list[str], widths: list[int]) -> str:
    cells = [f" {v.ljust(w)} " for v, w in zip(values, widths)]
    return "│" + "│".join(cells) + "│"


def box_rule(left: str, mid: str, right: str, widths: list[int]) -> str:
    spans = ["─" * (w + 2) for w in widths]
    return left + mid.join(spans) + right


def render_table(rows: list[dict], verbose: bool = False) -> str:
    if not rows:
        return "No recoverable sessions found."
    live_matched = sum(1 for r in rows if r["recovery"] == "wedged-live-matched")
    live_unmatched = sum(1 for r in rows if r["recovery"] == "wedged-live-unmatched")
    stale = sum(1 for r in rows if r["state"] == "stale")
    headers = ["STATE", "KIND", "TTY", "PID", "CWD", "TITLE/FIRST", "RESUME"]
    table_rows = []
    for row in rows:
        title_or_first = row.get("title") or row.get("first") or ""
        table_rows.append(
            [
                row["state"],
                row["recovery"].replace("wedged-live-", "").replace("post-crash-", ""),
                row.get("tty") or "-",
                row.get("pid") or "-",
                row.get("cwd") or "?",
                trunc(title_or_first, 42),
                row.get("resume") or "-",
            ]
        )
    widths = [
        max(len(headers[i]), max(len(r[i]) for r in table_rows))
        for i in range(len(headers))
    ]
    lines = [
        f"summary: live-matched={live_matched} live-unmatched={live_unmatched} stale={stale}",
        box_rule("┌", "┬", "┐", widths),
        box_row(headers, widths),
        box_rule("├", "┼", "┤", widths),
    ]
    lines.extend(box_row(r, widths) for r in table_rows)
    lines.append(box_rule("└", "┴", "┘", widths))
    if verbose:
        lines.append("")
        lines.append("details:")
        for row in rows:
            lines.append(f"- {row['state']} {row['recovery']} {row.get('tty') or '-'} {row.get('cwd') or '?'}")
            if row.get("resume"):
                lines.append(f"  resume={row['resume']}")
            if row.get("title"):
                lines.append(f"  title={row['title']}")
            if row.get("first"):
                first = " ".join(str(row["first"]).split())
                lines.append(f"  first={first[:120]}")
            if row["state"] == "stale" and row.get("last_seen_at"):
                lines.append(f"  last-seen={row['last_seen_at']}")
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--json", action="store_true", help="emit JSON")
    ap.add_argument("--all", action="store_true", help="include non-iTerm live sessions too")
    ap.add_argument("--stale", action="store_true", help="show only lost/post-crash recoverable sessions")
    ap.add_argument("--verbose", action="store_true", help="show multi-line details too")
    args = ap.parse_args(argv)

    meta = load_meta()
    live = live_sessions()
    rows = add_transport_hints(join_rows(meta, live))
    rows = filter_rows(rows, show_all=args.all, stale_only=args.stale)

    if args.json:
        print(json.dumps({"meta_path": str(META_PATH), "rows": rows}, indent=2))
    else:
        print(render_table(rows, verbose=args.verbose))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
