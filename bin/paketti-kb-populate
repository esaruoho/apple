#!/usr/bin/env python3
"""paketti-kb-populate — ZERO-TOKEN knowledge-base filler.

Scans the Paketti XRNX codebase for every `add_keybinding` / `add_menu_entry` / `add_midi_mapping`
and fills the `<!-- AUTO:Scope -->` blocks in the knowledge base with the real, current feature
lists, grouped by keybinding scope (Sample Editor, Mixer, Pattern Editor, …). No LLM, no tokens —
pure source extraction, so the lists are always in sync with the code.

The KB (`paketti-kb.md`, Syncthing-shared) is YOURS to edit anywhere OUTSIDE the AUTO markers;
re-running this refreshes only the AUTO blocks and leaves your prose / Q&A untouched.

  paketti-kb-populate            # create the KB (first run) or refresh its AUTO blocks
  paketti-kb-populate --print    # print to stdout without writing
"""
import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

PAKETTI = Path("/Users/esaruoho/work/paketti")
HARNESS = PAKETTI / ".spine" / "harness.lua"
KB = Path.home() / "work" / "comms" / "queue" / "paketti-faq" / "paketti-kb.md"

# the scopes worth their own KB section, in a sensible order (Global last — it's the catch-all)
SCOPES = ["Sample Editor", "Sample Keyzones", "Sample Navigator", "Sample Mappings",
          "Instrument Box", "Mixer", "Pattern Editor", "Phrase Editor", "Pattern Sequencer",
          "Pattern Matrix", "DSP Chain", "Automation", "Global"]

AUTO_RE = re.compile(r"(<!-- AUTO:(.+?) -->)(.*?)(<!-- /AUTO -->)", re.S)


def run_harness():
    """Run paketti/.spine/harness.lua under luajit: it executes the Lua with a mocked renoise and
    captures EVERY add_keybinding/menu_entry/midi_mapping with FOR-LOOPS RESOLVED to their final
    names. A regex grep can't do this — it would miss the thousands generated in loops."""
    lj = shutil.which("luajit") or shutil.which("lua")
    if not lj or not HARNESS.exists():
        return None
    out = Path(tempfile.gettempdir()) / "paketti-kb-spine.json"
    try:
        subprocess.run([lj, str(HARNESS), str(PAKETTI), str(out)], timeout=300, check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return json.loads(out.read_text(encoding="utf-8"))
    except Exception:
        return None


def extract():
    """{scope: {feature}} keybindings + midi/menu leaf sets, with for-loops resolved via the harness."""
    d = run_harness()
    if not d or "names" not in d:
        sys.exit("paketti-kb-populate: harness failed — need `luajit` + paketti/.spine/harness.lua. "
                 "(Refusing to fall back to a regex grep: it MISSES for-loop-generated registrations, "
                 "undercounting by thousands.)")
    names = d["names"]
    kb, midi, menu = {}, set(), set()
    for n in names.get("keybinding", []):
        parts = [p.strip() for p in n.split(":")]
        kb.setdefault(parts[0] or "Global", set()).add(parts[-1])
    midi = {n.split(":")[-1].strip() for n in names.get("midi_mapping", [])}
    menu = {n.split(":")[-1].strip() for n in names.get("menu_entry", [])}
    return kb, midi, menu


def feature_lines(scope, kb, midi, menu):
    feats = sorted(kb.get(scope, set()))
    out = []
    for f in feats:
        flags = ["⌨"]
        if f in midi:
            flags.append("🎛")
        if f in menu:
            flags.append("☰")
        out.append(f"- **{f}** — {' · '.join(flags)}")
    return out or [f"_(no `{scope}:` keybindings found in the codebase)_"]


def section(scope, kb, midi, menu, with_todo=True):
    out = [f"## {scope}", ""]
    if with_todo:
        out += [f"<!-- TODO: write your curated notes / Q&A for {scope} here (this line is yours to edit) -->", ""]
    out += [f"<!-- AUTO:{scope} -->"]
    out += feature_lines(scope, kb, midi, menu)
    out += ["<!-- /AUTO -->", ""]
    return out


def build_skeleton(kb, midi, menu):
    total = sum(len(v) for v in kb.values())
    out = [
        "# Paketti Knowledge Base", "",
        "> Your editable knowledge base for Paketti. Write notes, Q&A, anything — anywhere",
        "> **outside** the `<!-- AUTO -->` blocks. Those blocks are filled **zero-token** from",
        "> the Paketti code by `paketti-kb-populate` (KeyBindings ⌨ · MidiMappings 🎛 ·",
        "> MenuEntries ☰) and are **overwritten on every run**, so don't hand-edit inside them.",
        ">",
        f"> Auto-extracted: **{total}** keybindings across **{len(kb)}** scopes. Re-run",
        "> `paketti-kb-populate` after a code change to refresh the lists; your prose is preserved.",
        "",
    ]
    for scope in SCOPES:
        out += section(scope, kb, midi, menu)
    # any scopes found in code but not in our list → append so nothing's lost
    for scope in sorted(kb):
        if scope not in SCOPES:
            out += section(scope, kb, midi, menu)
    return "\n".join(out).rstrip() + "\n"


def refresh(text, kb, midi, menu):
    def repl(m):
        scope = m.group(2).strip()
        body = "\n".join(feature_lines(scope, kb, midi, menu))
        return f"{m.group(1)}\n{body}\n{m.group(4)}"
    return AUTO_RE.sub(repl, text)


def main():
    kb, midi, menu = extract()
    if KB.exists() and AUTO_RE.search(KB.read_text(encoding="utf-8")):
        text = refresh(KB.read_text(encoding="utf-8"), kb, midi, menu)
        action = "refreshed AUTO blocks in"
    else:
        text = build_skeleton(kb, midi, menu)
        action = "created"
    if "--print" in sys.argv:
        sys.stdout.write(text)
        return 0
    KB.parent.mkdir(parents=True, exist_ok=True)
    KB.write_text(text, encoding="utf-8")
    total = sum(len(v) for v in kb.values())
    print(f"{action} {KB}")
    print(f"  {total} keybindings · {len(kb)} scopes · {len(midi)} midi · {len(menu)} menu (zero tokens)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
