#!/usr/bin/env python3
"""
tag-result-handler — close the tag-watcher loop.

When the Mac Mini worker finishes a job, the result lands in a Syncthing-
mirrored results folder (e.g. ~/work/comms/queue/ocr-results/). This script:

  1. Scans the results folder for completed jobs
  2. Looks up the original file via tag-watcher-map.json (basename match,
     trying timestamp-stripped variants since bbs-ocr-submit.sh prefixes
     YYYYMMDD-HHMMSS-)
  3. For OCR: replaces the in-archive image-only original with the _ocr.pdf
     version, parks the .txt sidecar next to it, archives the leftover
     .pdfws sidecar into a processed/ subfolder
  4. Swaps tags on the original file:
       needs-ocr      → removed
       ocr-queued     → removed
       ocr-complete:green added (plus primary-source if it was there)
  5. Moves processed result files into ocr-results/processed/ so we don't
     re-handle them

Currently wired only for `needs-ocr`. Whisp transcription completion is
detectable but doesn't replace the original file — the transcript is a
separate artifact. Stub remains for future extension.

Run modes
---------
  tag-result-handler             one-shot scan
  tag-result-handler --dry-run   print what would happen, don't move anything
  tag-result-handler --status    counts only
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
APPLE_BIN = HOME / "work" / "apple" / "bin"
TAG = APPLE_BIN / "tag"
COMMS = HOME / "work" / "comms" / "queue"
MAP_PATH = COMMS / "tag-watcher-map.json"
LOG_PATH = COMMS / "tag-result-handler.log"

OCR_RESULTS = COMMS / "ocr-results"
OCR_PROCESSED = OCR_RESULTS / "processed"
OCR_HEARTBEAT = COMMS / "ocr-heartbeat.json"

# The Mac Mini worker writes per-job .job files under worker-status/<subdir>/.
# This is the real talkback channel — pending/priority/processing/done/failed.
# Syncthing carries it back to this Mac so we can reflect Mini's state in tags.
WS_ROOT = COMMS / "worker-status"

ARCHIVE_ROOTS = [
    Path.home() / "work" / "merlib-dump",
]

# .job filenames look like "<jobnum>_<basename>.job"; submit also adds a
# "YYYYMMDD-HHMMSS-" prefix on the inbox copy. Both need stripping to recover
# the original archive basename.
JOB_PREFIX_RE = re.compile(r"^\d+_")

# Worker uses this suffix on the OCR'd PDF (the readable copy).
OCR_PDF_SUFFIX = "_ocr.pdf"

# Strip a leading YYYYMMDD-HHMMSS- prefix that bbs-ocr-submit.sh adds on submit.
TS_PREFIX_RE = re.compile(r"^\d{8}-\d{6}-")


def log(msg):
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOG_PATH.open("a") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}  {msg}\n")


def load_map():
    if not MAP_PATH.exists():
        return {}
    try:
        return json.loads(MAP_PATH.read_text())
    except Exception:
        return {}


def save_map(data):
    MAP_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = MAP_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True))
    tmp.replace(MAP_PATH)


def add_tag(path, spec):
    subprocess.run([str(TAG), "add", spec, str(path)],
                   capture_output=True, check=False)


def remove_tag(path, name):
    subprocess.run([str(TAG), "remove", name, str(path)],
                   capture_output=True, check=False)


_archive_index_cache = None


def archive_index():
    """basename → list of full paths under ARCHIVE_ROOTS. Cached per-run."""
    global _archive_index_cache
    if _archive_index_cache is not None:
        return _archive_index_cache
    idx = {}
    for root in ARCHIVE_ROOTS:
        if not root.is_dir():
            continue
        for p in root.rglob("*.pdf"):
            if p.is_file():
                idx.setdefault(p.name, []).append(p)
    _archive_index_cache = idx
    return idx


def resolve_basename(basename):
    """basename (no jobnum, no timestamp prefix) → archive Path or None.
    Prefers map.json, falls back to filesystem search."""
    # 1. Map.json direct or via timestamp-stripped variants
    mapping = load_map()
    for c in candidate_basenames(basename):
        if c in mapping:
            return Path(mapping[c]["original_path"])
    # 2. Filesystem search
    idx = archive_index()
    for c in candidate_basenames(basename):
        if c in idx and len(idx[c]) == 1:
            return idx[c][0]
        if c in idx and len(idx[c]) > 1:
            log(f"AMBIGUOUS {basename}: {len(idx[c])} matches in archive — skipping")
            return None
    return None


def job_basename(job_filename):
    """Strip '<jobnum>_' prefix and '.job' suffix and any timestamp prefix
    to recover the original-archive basename."""
    name = job_filename
    name = JOB_PREFIX_RE.sub("", name)
    if name.endswith(".job"):
        name = name[:-4]
    return name


def candidate_basenames(result_name):
    """Given e.g. '20260520-080123-SomeFile.pdf' return possible original basenames."""
    out = {result_name}
    stripped = TS_PREFIX_RE.sub("", result_name)
    if stripped != result_name:
        out.add(stripped)
    # Also strip trailing _ocr from the .pdf stem if present.
    if result_name.endswith(OCR_PDF_SUFFIX):
        body = result_name[: -len(OCR_PDF_SUFFIX)]
        out.add(body + ".pdf")
        stripped_body = TS_PREFIX_RE.sub("", body)
        out.add(stripped_body + ".pdf")
    return out


def find_original(result_name, mapping):
    """Return (original_path, map_key) or (None, None)."""
    for name in candidate_basenames(result_name):
        if name in mapping:
            return Path(mapping[name]["original_path"]), name
    # Loose match: the worker may have lowercased / re-encoded the name. Try
    # case-insensitive scan as last resort.
    lc = {k.lower(): k for k in mapping}
    for name in candidate_basenames(result_name):
        if name.lower() in lc:
            key = lc[name.lower()]
            return Path(mapping[key]["original_path"]), key
    return None, None


def gather_sidecars(result_pdf):
    """Return list of sidecar files (.txt, .pdfws) sharing the result_pdf stem (sans _ocr)."""
    body = result_pdf.name
    if body.endswith(OCR_PDF_SUFFIX):
        stem_with_dash = body[: -len(OCR_PDF_SUFFIX)]  # e.g. "Foo-"
    else:
        stem_with_dash = result_pdf.stem
    parent = result_pdf.parent
    sidecars = []
    # Worker writes "<stem>.txt" and "<stem>.pdfws" (note no _ocr suffix on these).
    for ext in (".txt", ".pdfws"):
        candidate = parent / f"{stem_with_dash}{ext}"
        if candidate.is_file():
            sidecars.append(candidate)
    return sidecars


def handle_ocr_result(result_pdf, mapping, dry_run=False):
    """Reconcile one *_ocr.pdf result with its original. Return True on success."""
    # Results carrying an ast_<id> prefix were submitted by the spine pipeline
    # (mediabank/bin/spine.py ocr-submit) and are filed by `spine ocr-harvest`
    # into mediabank/assets/<id>/. They are NOT this pipeline's to handle —
    # touching them would double-file and needlessly mutate merlib-dump. Skip.
    if re.search(r"ast_[0-9a-f]{16}", result_pdf.name):
        return None  # sentinel: spine-owned, not orphaned, not handled

    original, map_key = find_original(result_pdf.name, mapping)
    if original is None:
        # Map missing/empty — fall back to a filesystem search of the archive
        # by basename (resolve_basename has its own ambiguity guard). This is
        # the path that fires when tag-watcher-map.json was never written.
        original = resolve_basename(result_pdf.name)
        map_key = None
    if original is None:
        log(f"ORPHAN {result_pdf.name}: no map entry and not found in archive — leaving in results/")
        return False
    if not original.parent.exists():
        log(f"SKIP {result_pdf.name}: original folder gone: {original.parent}")
        return False

    dest_pdf = original.with_suffix(".pdf")  # same name as original
    dest_txt = original.with_suffix(".txt")
    sidecars = gather_sidecars(result_pdf)
    txt_sidecar = next((s for s in sidecars if s.suffix.lower() == ".txt"), None)

    if dry_run:
        print(f"[dry] {result_pdf}")
        print(f"      → replace {original}")
        if txt_sidecar:
            print(f"      → write   {dest_txt}  (from {txt_sidecar.name})")
        print(f"      → tags: -needs-ocr -ocr-queued +ocr-complete:green")
        return True

    OCR_PROCESSED.mkdir(parents=True, exist_ok=True)

    # Replace original PDF with OCR'd version
    shutil.copy2(result_pdf, dest_pdf)
    if txt_sidecar:
        shutil.copy2(txt_sidecar, dest_txt)

    # Swap tags on the now-OCR'd file
    remove_tag(dest_pdf, "needs-ocr")
    remove_tag(dest_pdf, "ocr-queued")
    remove_tag(dest_pdf, "ocr-processing")
    add_tag(dest_pdf, "ocr-complete:green")

    # Move processed result files out of the live results folder
    for src in [result_pdf] + sidecars:
        shutil.move(str(src), str(OCR_PROCESSED / src.name))

    # Drop the map entry — job is done
    mapping.pop(map_key, None)

    log(f"DONE  {original}  ← {result_pdf.name}")
    print(f"  ✓ {original}")
    return True


def heartbeat_current_job():
    """Return (basename, page, total_pages) the Mac Mini worker is processing now."""
    if not OCR_HEARTBEAT.is_file():
        return (None, None, None)
    try:
        data = json.loads(OCR_HEARTBEAT.read_text())
    except Exception:
        return (None, None, None)
    if data.get("status") != "processing":
        return (None, None, None)
    return (data.get("current_job"),
            data.get("current_page"),
            data.get("total_pages"))


def update_processing_state(mapping, dry_run=False):
    """If the Mac Mini heartbeat names a file we know about and we haven't yet
    flipped it to ocr-processing, do so now."""
    job, page, total = heartbeat_current_job()
    if not job:
        return 0
    matched_key = None
    for c in candidate_basenames(job):
        if c in mapping:
            matched_key = c
            break
    if matched_key is None:
        return 0
    entry = mapping[matched_key]
    if entry.get("state") == "processing":
        return 0
    original = Path(entry["original_path"])
    if not original.is_file():
        return 0
    progress = f"{page}/{total}" if page and total else "?"
    if dry_run:
        print(f"[dry] {original} → ocr-processing  ({progress})")
        return 1
    remove_tag(original, "ocr-queued")
    add_tag(original, "ocr-processing:blue")
    entry["state"] = "processing"
    entry["progress"] = progress
    log(f"PROC  {original}  ← heartbeat:{job}  page {progress}")
    print(f"  ⏳ {original}  (page {progress})")
    return 1


def parse_job_file(p):
    """Return dict from the YAML-ish .job file (one key:value per line)."""
    out = {}
    try:
        for line in p.read_text().splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                out.setdefault(k.strip(), v.strip())  # first occurrence wins
    except Exception:
        return out
    return out


def worker_status_sync(dry_run=False):
    """Read worker-status/<subdir>/*.job and stamp tags on the archive originals.

    State mapping:
      pending/  + priority/  → ocr-queued:yellow      (Mac Mini has the job, hasn't started)
      processing/            → ocr-processing:blue   (Mac Mini is OCRing now)
      done/    (no error:)   → leave for result-handler step 2 (result file owns this)
      done/    (with error:) → ocr-failed:orange
      failed/                → ocr-failed:orange
    """
    if not WS_ROOT.is_dir():
        return {}

    counts = {"queued": 0, "processing": 0, "failed": 0, "unresolved": 0}

    def stamp(p, *, queued=False, processing=False, failed=False):
        if dry_run:
            tags = []
            if queued: tags.append("ocr-queued")
            if processing: tags.append("ocr-processing")
            if failed: tags.append("ocr-failed")
            print(f"[dry] {p} → {','.join(tags)}")
            return
        if processing:
            remove_tag(p, "ocr-queued")
            add_tag(p, "ocr-processing:blue")
        elif queued:
            # Only stamp ocr-queued if not already ahead in the pipeline.
            subprocess.run([str(TAG), "list", str(p)], capture_output=True)
            add_tag(p, "ocr-queued:yellow")
        elif failed:
            remove_tag(p, "ocr-queued")
            remove_tag(p, "ocr-processing")
            add_tag(p, "ocr-failed:orange")

    for sub, kind in [("pending", "queued"), ("priority", "queued"),
                      ("processing", "processing"), ("failed", "failed")]:
        d = WS_ROOT / sub
        if not d.is_dir():
            continue
        for job in d.glob("*.job"):
            base = job_basename(job.name)
            original = resolve_basename(base)
            if original is None:
                counts["unresolved"] += 1
                continue
            stamp(original,
                  queued=(kind == "queued"),
                  processing=(kind == "processing"),
                  failed=(kind == "failed"))
            counts[kind] = counts.get(kind, 0) + 1

    # done/ with embedded error:
    done = WS_ROOT / "done"
    if done.is_dir():
        for job in done.glob("*.job"):
            data = parse_job_file(job)
            # parse_job_file keeps only first occurrence per key — a "done"
            # job that ultimately succeeded won't have error: line first.
            # Use raw text scan to catch any "error:" line.
            try:
                text = job.read_text()
            except Exception:
                continue
            if "error:" not in text:
                continue
            base = job_basename(job.name)
            original = resolve_basename(base)
            if original is None:
                counts["unresolved"] += 1
                continue
            stamp(original, failed=True)
            counts["failed"] = counts.get("failed", 0) + 1

    return counts


def cmd_run(dry_run=False):
    if not OCR_RESULTS.is_dir():
        sys.exit(f"no results dir: {OCR_RESULTS}")
    mapping = load_map()

    # Step 0: reflect Mac Mini's worker-status/ into local tags.
    ws_counts = worker_status_sync(dry_run=dry_run)
    if ws_counts:
        print(f"worker-status sync: queued={ws_counts.get('queued',0)} "
              f"processing={ws_counts.get('processing',0)} "
              f"failed={ws_counts.get('failed',0)} "
              f"unresolved={ws_counts.get('unresolved',0)}")

    # Step 1: heartbeat → flip ocr-queued to ocr-processing for the file
    # currently in flight on the Mac Mini.
    proc = update_processing_state(mapping, dry_run=dry_run)

    # Step 2: scan results/ for completed OCR jobs.
    pdfs = sorted(p for p in OCR_RESULTS.iterdir()
                  if p.is_file() and p.name.endswith(OCR_PDF_SUFFIX))
    handled = 0
    spine_owned = 0
    if pdfs:
        print(f"{len(pdfs)} OCR result(s) to reconcile")
        for p in pdfs:
            r = handle_ocr_result(p, mapping, dry_run=dry_run)
            if r is None:
                spine_owned += 1  # ast_<id> result — spine files these, skip
            elif r:
                handled += 1
    elif proc == 0:
        print("nothing to reconcile (no heartbeat match, no _ocr.pdf results)")

    if not dry_run and (handled or proc):
        save_map(mapping)
    if pdfs:
        ours = len(pdfs) - spine_owned
        print(f"reconciled: {handled}/{ours}  (skipped {spine_owned} spine-owned ast_ results)")


def cmd_status():
    if not OCR_RESULTS.is_dir():
        print(f"no results dir: {OCR_RESULTS}")
        return
    pdfs = [p for p in OCR_RESULTS.iterdir()
            if p.is_file() and p.name.endswith(OCR_PDF_SUFFIX)]
    processed = list(OCR_PROCESSED.glob("*")) if OCR_PROCESSED.is_dir() else []
    mapping = load_map()
    print(f"tag-result-handler status — {time.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  pending _ocr.pdf in results/  : {len(pdfs)}")
    print(f"  archived in processed/        : {len(processed)}")
    print(f"  map entries (in flight)       : {len(mapping)}")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help"):
        sys.stderr.write(__doc__)
        sys.exit(2)
    if argv and argv[0] == "--status":
        cmd_status()
        return
    if argv and argv[0] == "--dry-run":
        cmd_run(dry_run=True)
        return
    cmd_run()


if __name__ == "__main__":
    main()
