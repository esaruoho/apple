#!/usr/bin/env swift
// apple-lemma — Apple-native lemma extractor.
//
// Reads UTF-8 text on stdin and emits one JSON line per recognised word:
//   {"text":"running","lemma":"run","line":12}
//
// Uses NaturalLanguage.NLTagger with the .lemma scheme. On-device, 10.15+.
// Reduces inflected forms ("electricity / electric / electrical") to a
// common root, useful for cleaner vault-grep queries and concordance work.
//
// Usage:
//   echo "Tesla studied electric currents and electricity." | apple-lemma
//   apple-lemma --table < text                 # human-readable columns
//   apple-lemma --uniq  < text                 # unique lemmas + counts only
//   apple-lemma --map "electric,electricity" < text   # only show those roots

import Foundation
import NaturalLanguage

let args = CommandLine.arguments.dropFirst().map { String($0) }
let mode: String = args.first { ["--table","--uniq","--json"].contains($0) } ?? "--json"
let mapFilter: Set<String>? = {
    if let i = args.firstIndex(of: "--map"), i + 1 < args.count {
        return Set(args[i+1].lowercased().split(separator: ",").map { String($0) })
    }
    return nil
}()

let data = FileHandle.standardInput.readDataToEndOfFile()
guard let full = String(data: data, encoding: .utf8), !full.isEmpty else {
    FileHandle.standardError.write("apple-lemma: empty stdin\n".data(using:.utf8)!); exit(1)
}

let tagger = NLTagger(tagSchemes: [.lemma])
tagger.string = full
// .lemma needs a language hint; default to English unless detector overrides.
let recognizer = NLLanguageRecognizer()
recognizer.processString(full)
let lang = recognizer.dominantLanguage ?? .english
tagger.setLanguage(lang, range: full.startIndex..<full.endIndex)

// line numbers
var lineStarts: [String.Index] = [full.startIndex]
var ii = full.startIndex
while ii < full.endIndex {
    if full[ii] == "\n" { lineStarts.append(full.index(after: ii)) }
    ii = full.index(after: ii)
}
func lineFor(_ pos: String.Index) -> Int {
    var lo = 0, hi = lineStarts.count - 1, ans = 0
    while lo <= hi {
        let m = (lo+hi)/2
        if lineStarts[m] <= pos { ans = m; lo = m+1 } else { hi = m-1 }
    }
    return ans + 1
}

var counts: [String: Int] = [:]
var rows: [(text: String, lemma: String, line: Int)] = []

tagger.enumerateTags(in: full.startIndex..<full.endIndex,
                      unit: .word, scheme: .lemma,
                      options: [.omitWhitespace, .omitPunctuation]) { tag, range in
    guard let tag = tag else { return true }
    let lemma = tag.rawValue.lowercased()
    let text = String(full[range])
    if mapFilter != nil && !(mapFilter!.contains(lemma)) { return true }
    if lemma.count < 2 { return true }
    counts[lemma, default: 0] += 1
    rows.append((text: text, lemma: lemma, line: lineFor(range.lowerBound)))
    return true
}

if mode == "--uniq" {
    let sorted = counts.sorted { $0.value > $1.value }
    for (lemma, n) in sorted {
        let n5 = String(repeating: " ", count: max(0, 5 - String(n).count)) + String(n)
        print("\(n5)  \(lemma)")
    }
} else if mode == "--table" {
    for r in rows {
        let lnPad = String(repeating: " ", count: max(0, 4 - String(r.line).count)) + String(r.line)
        let textPad = (r.text + String(repeating: " ", count: 20)).prefix(20)
        print("L\(lnPad)  \(textPad) → \(r.lemma)")
    }
} else {
    for r in rows {
        let obj: [String: Any] = ["text": r.text, "lemma": r.lemma, "line": r.line]
        if let d = try? JSONSerialization.data(withJSONObject: obj, options:[.sortedKeys]),
           let s = String(data: d, encoding:.utf8) { print(s) }
    }
}
