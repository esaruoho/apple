#!/usr/bin/env python3
"""machine-card — emit this computer's Machine Card as JSON.

The Machine Card is the fleet's self-descriptor: a small, same-shaped record
every Mac publishes so any machine can introduce itself and advertise what it
can do — with zero LLM tokens. Four faces:

    identity  who am I            (hostname, computer name, user)
    shape     what kind of Mac    (chip, cores, RAM, GPU, SSD, macOS, AI fit)
    ports     how do I reach you  (reachability channels: queue, ssh, panel...)
    running   what's alive now    (load, mem, battery, thermal, queue depths)
    skills    what can I do        (~/.claude/skills + warm service heartbeats)

shape/ports/skills are SLOW to compute (system_profiler) but change rarely, so
they are cached to ~/.cache/apple/machine-card-shape.json. `running` is cheap
and always recomputed. That split is the whole efficiency win over apple-report,
which recomputes its 679-line dump on every call.

Public/private split (the repo's .gitignore doctrine applied to live machine
data): `--public` emits only the stable+public quadrant — safe to write to the
Syncthing queue for peers to read. Default (local) keeps serial, MACs, IPs,
security posture and exact load for this machine's own panel.

Usage:
    machine-card                 full card (local-only), JSON to stdout
    machine-card --public        green-quadrant subset (safe to publish)
    machine-card --cache         force-refresh the cached shape/ports/skills
    machine-card --publish       write --public card to the Syncthing queue
                                 as machine-card-<host>.json (for peers)
    machine-card --pretty        pretty-print

Apple-native: wraps `apple-report --json`, plus `pmset`, `ps`, `sysctl`,
`sw_vers`, `scutil`. Python stdlib only.
"""
from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
APPLE_REPORT = HERE / "apple-report"
SKILLS_DIR = Path.home() / ".claude" / "skills"
CACHE = Path.home() / ".cache" / "apple" / "machine-card-shape.json"
CACHE_TTL = 6 * 3600  # shape/ports/skills are stable; refresh at most every 6h

# Whitelabel config. machine-card and Fleet read the SAME file so the emitter
# and the renderer never disagree about where the queue is or what services
# exist. Resolution (first hit wins, falling back to the historical defaults so
# an unconfigured install behaves exactly as before):
#   1. env override   FLEET_QUEUE_DIR
#   2. config file     $FLEET_CONFIG, else ~/.config/fleet/config.json
#   3. default         ~/work/comms/queue  +  the built-in service registry below
# See fleet/config.example.json for the shape.

def _expand(p: str) -> Path:
    return Path(os.path.expanduser(os.path.expandvars(p)))

def _load_config() -> dict:
    cfg_path = os.environ.get("FLEET_CONFIG") or os.path.expanduser("~/.config/fleet/config.json")
    try:
        with open(cfg_path) as f:
            return json.load(f)
    except Exception:
        return {}

_CFG = _load_config()

if os.environ.get("FLEET_QUEUE_DIR"):
    QUEUE = _expand(os.environ["FLEET_QUEUE_DIR"])
elif _CFG.get("queue_dir"):
    QUEUE = _expand(_CFG["queue_dir"])
else:
    QUEUE = Path.home() / "work" / "comms" / "queue"

# Services whose presence is advertised as a routable skill. A warm heartbeat
# means "running and reachable right now"; an inbox means work can be routed
# to this machine by dropping a file into the Syncthing-mirrored queue dir.
# Override the whole list via config "services": [{name,heartbeat,inbox,verb},...].
_DEFAULT_SERVICES = {
    "ocr":           {"heartbeat": "ocr-heartbeat.json",          "inbox": "ocr-inbox",        "verb": "OCR a PDF or image"},
    "voicebox":      {"heartbeat": "voicebox-heartbeat.json",     "inbox": "voicebox-inbox",   "verb": "Text-to-speech"},
    "whisp":         {"heartbeat": "whisp-heartbeat.json",        "inbox": "pakettibot-inbox", "verb": "Transcribe audio / YouTube"},
    "pakettibot":    {"heartbeat": "pakettibot-heartbeat.json",   "inbox": "pakettibot-inbox", "verb": "Run a !pk command"},
    "merlib-mirror": {"heartbeat": "merlib-mirror-heartbeat.json", "inbox": None,              "verb": "Mirror a website"},
    "spine":         {"heartbeat": "spine-heartbeat.json",        "inbox": None,               "verb": "Spine orchestrator"},
    "repo-puller":   {"heartbeat": "repo-puller-heartbeat.json",  "inbox": None,               "verb": "Auto-pull tracked repos"},
}

def _services_from_config(cfg: dict):
    svc = cfg.get("services")
    if not isinstance(svc, list) or not svc:
        return None
    out = {}
    for s in svc:
        name = s.get("name")
        if not name:
            continue
        out[name] = {"heartbeat": s.get("heartbeat") or f"{name}-heartbeat.json",
                     "inbox": s.get("inbox"),
                     "verb": s.get("verb") or name}
    return out or None

SERVICES = _services_from_config(_CFG) or _DEFAULT_SERVICES
HEARTBEAT_WARM_SECS = 180  # a heartbeat older than this is "cold"


def sh(cmd: list[str], timeout: float = 8.0) -> str:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout
        ).stdout.strip()
    except Exception:
        return ""


# ───────────────────────── identity ─────────────────────────

_IDENTITY_CACHE: dict | None = None

# A Bonjour name-conflict storm can corrupt the machine's live identity: macOS
# appends a " (2)" collision suffix to ComputerName, and socket.gethostname()
# can return a garbled kernel hostname (seen 2026-06-16: "CloudciyMacMini",
# the "t" dropped). Both feed the card `id` (the Fleet dedup key) and the
# displayed name, so a single Mac split into two stale/fresh cards both titled
# "CloudcityMacMini (2)". Canonicalise to a stable name so the card is immune
# to that churn. Strip any trailing " (N)" collision suffix everywhere.
_SUFFIX_RE = re.compile(r"\s*\(\d+\)\s*$")


def _strip_suffix(name: str) -> str:
    return _SUFFIX_RE.sub("", name).strip()


def _canonical_name() -> str:
    """Stable machine name, immune to DHCP/Bonjour churn. First sane hit wins:
      1. fleet config  "id" / "name"      — explicit whitelabel override
      2. scutil ComputerName, " (N)" off  — admin-set friendly name
      3. scutil HostName, if actually set — admin-pinned, no DHCP fallback
      4. socket.gethostname(), suffix off — last resort (can be garbled)
    """
    cfg = _CFG.get("id") or _CFG.get("name")
    if cfg:
        return _strip_suffix(str(cfg))
    cn = _strip_suffix(sh(["scutil", "--get", "ComputerName"]))
    if cn:
        return cn
    hn = sh(["scutil", "--get", "HostName"])
    if hn and "not set" not in hn.lower():
        return _strip_suffix(hn.split(".")[0])
    return _strip_suffix(socket.gethostname().split(".")[0])


def identity() -> dict:
    # Memoised — scutil is a subprocess and identity is asked for repeatedly
    # (ownership checks, card id, tailscale port). Stable for the process life.
    global _IDENTITY_CACHE
    if _IDENTITY_CACHE is None:
        canonical = _canonical_name()
        raw_host = socket.gethostname().split(".")[0]
        raw_cname = sh(["scutil", "--get", "ComputerName"]) or raw_host
        _IDENTITY_CACHE = {
            # Canonical drives the card `id` (dedup key) AND the display name,
            # so churn never splits or mislabels a machine.
            "hostname": canonical,
            "computer_name": canonical,
            "local_hostname": sh(["scutil", "--get", "LocalHostName"]),
            "user": os.environ.get("USER", ""),
            "platform": "macOS",
        }
        # Keep the raw values for diagnostics when they differ from canonical
        # (a non-empty _raw_* is the fingerprint of a name-conflict storm).
        if raw_host != canonical:
            _IDENTITY_CACHE["hostname_raw"] = raw_host
        if _strip_suffix(raw_cname) != raw_cname or raw_cname != canonical:
            _IDENTITY_CACHE["computer_name_raw"] = raw_cname
    return _IDENTITY_CACHE


def _my_names() -> set[str]:
    ident = identity()
    return {n.lower() for n in (ident.get("hostname"), ident.get("computer_name"),
                                ident.get("local_hostname"), ident.get("hostname_raw"),
                                ident.get("computer_name_raw")) if n}


# ───────────────────────── shape (cached) ─────────────────────────

def _apple_report() -> dict:
    """Optional enrichment — only used for the AI fit block, only if present.
    The base shape is computed natively so this tool is portable to any Mac
    (the Mini) that doesn't have the apple repo cloned."""
    if not APPLE_REPORT.exists():
        return {}
    try:
        out = subprocess.run(
            [str(APPLE_REPORT), "--json"], capture_output=True, text=True, timeout=30
        ).stdout
        return json.loads(out)
    except Exception:
        return {}


def _sp(*datatypes: str) -> dict:
    """One system_profiler -json call for several datatypes."""
    try:
        out = subprocess.run(
            ["system_profiler", "-json", *datatypes],
            capture_output=True, text=True, timeout=30,
        ).stdout
        return json.loads(out)
    except Exception:
        return {}


def _io_ports() -> dict:
    """The full physical I/O-port face — cameras, audio in/out, USB, external
    storage, Thunderbolt — from `convey av card` (single source of truth, so this
    tool and `convey av card` never drift). Best-effort: if convey is absent the
    card is still valid, just without the extra port registers."""
    import shutil
    convey = shutil.which("convey") or str(Path.home() / "work" / "apple" / "bin" / "convey")
    try:
        out = subprocess.run([convey, "av", "card", "--json"],
                             capture_output=True, text=True, timeout=40)
        if out.returncode == 0 and out.stdout.strip():
            d = json.loads(out.stdout)
            return {k: d.get(k, []) for k in
                    ("cameras", "audio_inputs", "audio_outputs",
                     "usb", "external_storage", "thunderbolt")}
    except Exception:
        pass
    return {}


def _login_items() -> list:
    """The machine's GUI login items — what autostarts at login. This is FLEET
    STATE, not trivia: adding/removing a login item changes which services come
    back up on a peer after a reboot/logout (e.g. the Mini autostarts
    Cloudcity-Boot, the sole service launcher — so a stale-looking .app build date
    is NEVER a reason to think it shouldn't run). The card carries it so the fleet
    KNOWS each peer's autostart set and a change there is a visible fleet change.
    Best-effort: needs Automation permission for System Events; [] if denied."""
    out = sh(["osascript", "-e",
              'tell application "System Events" to get the name of every login item'],
             timeout=10)
    return [n.strip() for n in out.split(",") if n.strip()] if out else []


def compute_shape() -> dict:
    # ── Native, portable shape via system_profiler -json ──
    sp = _sp("SPHardwareDataType", "SPDisplaysDataType", "SPStorageDataType")
    hw = (sp.get("SPHardwareDataType") or [{}])[0]

    # number_processors looks like "proc 11:5:6" (total:perf:eff) or just "8".
    total = perf = eff = None
    np = str(hw.get("number_processors", "")).replace("proc", "").strip()
    if ":" in np:
        parts = [int(x) for x in np.split(":") if x.strip().isdigit()]
        if len(parts) == 3:
            total, perf, eff = parts
    elif np.isdigit():
        total = int(np)

    ram_gb = None
    pm = str(hw.get("physical_memory", "")).split()
    if pm and pm[0].replace(".", "").isdigit():
        ram_gb = int(float(pm[0]))

    # GPU + displays from SPDisplaysDataType.
    gpus = sp.get("SPDisplaysDataType") or []
    gpu0 = gpus[0] if gpus else {}
    displays = []
    for g in gpus:
        for d in g.get("spdisplays_ndrvs", []):
            displays.append({
                "name": d.get("_name"),
                "pixels": d.get("_spdisplays_pixels"),
                "resolution": d.get("_spdisplays_resolution") or d.get("spdisplays_resolution"),
            })

    # SSD: largest internal volume.
    ssd_gb = 0
    for v in sp.get("SPStorageDataType") or []:
        pd = v.get("physical_drive") or {}
        if pd.get("is_internal_disk") == "yes":
            ssd_gb = max(ssd_gb, round(v.get("size_in_bytes", 0) / 1e9))

    # macOS version/build from sw_vers (cheap, portable).
    macos_version = sh(["sw_vers", "-productVersion"])
    macos_build = sh(["sw_vers", "-buildVersion"])

    # ── Fallback via sysctl — works on EVERY macOS, incl. < 10.15 where
    #    `system_profiler -json` doesn't exist (Mojave Macs come back blank). ──
    chip = hw.get("chip_type") or hw.get("cpu_type") \
        or (sh(["sysctl", "-n", "machdep.cpu.brand_string"]) or None)
    model_id = hw.get("machine_model") or (sh(["sysctl", "-n", "hw.model"]) or None)
    model_name = hw.get("machine_name")
    if not model_name and model_id:
        pfx = "".join(ch for ch in model_id if ch.isalpha())
        model_name = {"MacBookPro": "MacBook Pro", "MacBookAir": "MacBook Air",
                      "MacBook": "MacBook", "Macmini": "Mac mini", "iMac": "iMac",
                      "MacPro": "Mac Pro", "iMacPro": "iMac Pro"}.get(pfx)
    if total is None:
        pc = sh(["sysctl", "-n", "hw.physicalcpu"])
        total = int(pc) if pc.isdigit() else None
    if ram_gb is None:
        ms = sh(["sysctl", "-n", "hw.memsize"])
        ram_gb = round(int(ms) / 1e9) if ms.isdigit() else None

    # ── Optional AI enrichment from apple-report (this Mac only) ──
    ai_src = _apple_report().get("ai", {})
    fit = {f"{c['params_billions']}b_{c['quant']}": c["fits"]
           for c in ai_src.get("headline_fit_checks", [])}

    # ── Full physical I/O-port face (convey av card) — every port, not just displays ──
    io = _io_ports()

    return {
        # ── stable + public (green quadrant) ──
        "chip": chip,
        "model_name": model_name,
        "model_identifier": model_id,
        "cores_total": total,
        "cores_perf": perf,
        "cores_efficiency": eff,
        "ram_gb": ram_gb,
        "gpu_name": gpu0.get("sppci_model"),
        "gpu_cores": gpu0.get("sppci_cores"),
        "ssd_gb": ssd_gb,
        "displays": displays,
        # what autostarts at login — fleet state (adding one is a fleet change)
        "login_items": _login_items(),
        # full I/O-port face (from `convey av card`) — the fleet knows every port
        "cameras": io.get("cameras", []),
        "audio_inputs": io.get("audio_inputs", []),
        "audio_outputs": io.get("audio_outputs", []),
        "usb": io.get("usb", []),
        "external_storage": io.get("external_storage", []),
        "thunderbolt": io.get("thunderbolt", []),
        "macos_version": macos_version or None,
        "macos_build": macos_build or None,
        "ai": {
            "neural_engine_tops": ai_src.get("neural_engine_tops"),
            "memory_bandwidth_gbs": ai_src.get("memory_bandwidth_gbs"),
            "max_model_b_q4": ai_src.get("max_model_b_q4"),
            "max_model_b_q8": ai_src.get("max_model_b_q8"),
            "tokens_per_sec": ai_src.get("estimated_tokens_per_sec", {}),
            "fits": fit,
        },
        # ── stable + private (stripped by --public) ──
        "_private": {
            "serial": hw.get("serial_number"),
            "model_number": hw.get("model_number"),
            "boot_rom": hw.get("boot_rom_version"),
        },
    }


# ───────────────────────── ports ─────────────────────────

def compute_ports() -> dict:
    """Reachability channels — how a peer can reach this machine.

    The practical, routable part of the 'ports' face. Physical I/O (Thunderbolt
    bus count etc.) is intentionally omitted to keep the card snappy; the chip
    + model identifier imply the physical layout, and routing only ever uses
    the channels below.
    """
    channels = []

    def add(name, kind, target, available, private=False):
        channels.append({"name": name, "kind": kind, "target": target,
                         "available": bool(available), "_private": private})

    add("syncthing-queue", "file-drop", str(QUEUE), QUEUE.is_dir())
    add("file-drop-bridge", "command", str(QUEUE / "pakettibot-inbox"),
        (QUEUE / "pakettibot-inbox").is_dir())
    add("panel", "http", "http://127.0.0.1", (HERE / "apple-panel").exists())
    add("imessage", "imessage", "self", (HERE / "imessage").exists())
    # Tailscale SSH — coarse availability (config alias or tailscale present).
    ts = bool(sh(["which", "tailscale"])) or (Path.home() / ".ssh" / "config").exists()
    add("tailscale-ssh", "ssh", identity()["hostname"], ts, private=True)

    return {"channels": channels}


# ───────────────────────── skills ─────────────────────────

def ts_to_epoch(ts) -> float | None:
    """Heartbeat `ts` fields come in three flavours across the fleet: integer
    seconds, integer milliseconds (the Node services), and ISO-8601 strings.
    Normalise all three to epoch seconds, or None if unparseable."""
    if ts is None:
        return None
    if isinstance(ts, (int, float)):
        return float(ts) / 1000.0 if ts > 1e12 else float(ts)
    if isinstance(ts, str):
        from datetime import datetime
        try:
            return datetime.fromisoformat(ts.strip().replace("Z", "+00:00")).timestamp()
        except Exception:
            return None
    return None


def heartbeat_age(name: str) -> float | None:
    """Seconds since this heartbeat's ts, or None if absent/unreadable."""
    p = QUEUE / name
    if not p.exists():
        return None
    try:
        epoch = ts_to_epoch(json.loads(p.read_text()).get("ts"))
        if epoch is not None:
            return max(0.0, time.time() - epoch)
    except Exception:
        pass
    # Fall back to file mtime.
    try:
        return max(0.0, time.time() - p.stat().st_mtime)
    except Exception:
        return None


def heartbeat_host(name: str) -> str | None:
    """The host that produced this heartbeat, or None if it doesn't say.
    Writers differ: whisp stamps `worker_host`; others should stamp `host`."""
    p = QUEUE / name
    if not p.exists():
        return None
    try:
        d = json.loads(p.read_text())
    except Exception:
        return None
    for k in ("host", "worker_host", "hostname"):
        v = d.get(k)
        if isinstance(v, str) and v.strip():
            return v.split(".")[0]
    return None


def owns_service(heartbeat: str) -> bool:
    """True if THIS machine produced the heartbeat. The queue dir is Syncthing-
    shared fleet-wide, so a fresh heartbeat alone does NOT mean the service runs
    here — without this check every Mac claims every peer's service (esarMBP was
    advertising the Mini's ocr/voicebox/whisp/pakettibot). Robust rule: the
    heartbeat's declared host must match one of my names. Legacy writers that
    don't stamp a host fall back to claimed, so the real owner never loses the
    skill mid-migration — the spurious peer claim clears the moment that writer
    starts stamping `host`."""
    declared = heartbeat_host(heartbeat)
    if declared is None:
        return True
    return declared.lower() in _my_names()


def compute_skills() -> list[dict]:
    skills: dict[str, dict] = {}

    # 1. Installed skills — capability is present (not necessarily running).
    if SKILLS_DIR.is_dir():
        for d in sorted(SKILLS_DIR.iterdir()):
            if not d.is_dir():
                continue
            if not any((d / n).exists() for n in ("SKILL.md", "skill.md")):
                continue
            skills[d.name] = {"name": d.name, "source": "skill", "warm": False,
                              "inbox": None, "verb": None, "age_s": None}

    # 2. Services — a warm heartbeat means running + reachable now. These carry
    #    the routable inbox ports. Only services THIS machine actually hosts
    #    (see owns_service) — a peer's synced heartbeat is not our skill.
    for name, meta in SERVICES.items():
        if not owns_service(meta["heartbeat"]):
            continue
        age = heartbeat_age(meta["heartbeat"])
        warm = age is not None and age <= HEARTBEAT_WARM_SECS
        entry = skills.get(name, {"name": name, "source": "service"})
        entry.update({
            "source": "service" if entry.get("source") != "skill" else "skill+service",
            "warm": warm,
            "inbox": meta["inbox"],
            "verb": meta["verb"],
            "age_s": round(age) if age is not None else None,
        })
        skills[name] = entry

    return sorted(skills.values(), key=lambda s: (not s["warm"], s["name"]))


def compute_activity() -> list[dict]:
    """Live, per-service job state for services THIS machine hosts — what the
    fleet is DOING right now, not just what it CAN do. Same heartbeats as skills,
    but carries the rich fields Fleet renders as a readout: status, current job,
    page x/y progress, ETA, queue depth. Only owned services (see owns_service),
    so a peer reading the synced card sees the owner's work attributed correctly."""
    acts: list[dict] = []
    for name, meta in SERVICES.items():
        if not owns_service(meta["heartbeat"]):
            continue
        p = QUEUE / meta["heartbeat"]
        if not p.exists():
            continue
        try:
            d = json.loads(p.read_text())
        except Exception:
            continue
        age = heartbeat_age(meta["heartbeat"])
        warm = age is not None and age <= HEARTBEAT_WARM_SECS
        rec: dict = {
            "service": name,
            "warm": warm,
            "age_s": round(age) if age is not None else None,
            "status": d.get("status"),
        }
        job = d.get("current_job") or d.get("current")
        if isinstance(job, str) and job:
            rec["current_job"] = job
        cur, tot = d.get("current_page"), d.get("total_pages")
        if isinstance(cur, int) and isinstance(tot, int) and tot > 0:
            rec["progress"] = {"cur": cur, "total": tot}
        if isinstance(d.get("eta_ms"), (int, float)):
            rec["eta_s"] = round(d["eta_ms"] / 1000)
        if isinstance(d.get("elapsed_ms"), (int, float)):
            rec["elapsed_s"] = round(d["elapsed_ms"] / 1000)
        q = d.get("queue")
        if isinstance(q, dict):
            qq = {k: q[k] for k in ("pending", "done", "failed")
                  if isinstance(q.get(k), int)}
            if qq:
                rec["queue"] = qq
        elif isinstance(d.get("pending"), int):
            # voicebox/pakettibot keep a bare top-level `pending` rather than a
            # queue object — surface it so an idle service still shows depth 0.
            rec["queue"] = {"pending": d["pending"]}
        if "gateway_ready" in d:
            rec["ready"] = bool(d.get("gateway_ready"))
        if isinstance(d.get("active_agents"), int):
            rec["agents"] = d["active_agents"]
        acts.append(rec)
    return sorted(acts, key=lambda a: (not a["warm"], a["service"]))


# ───────────────────────── running (cheap, always fresh) ─────────────────────────

def compute_running() -> dict:
    out: dict = {}

    # Load averages + uptime from `uptime`.
    up = sh(["uptime"])
    m = re.search(r"load averages?:\s*([\d.]+)[ ,]+([\d.]+)[ ,]+([\d.]+)", up)
    if m:
        out["load_avg"] = [float(m.group(i)) for i in (1, 2, 3)]
    m = re.search(r"up\s+(.+?),\s+\d+ user", up)
    if m:
        out["uptime"] = m.group(1).strip()

    # Physical cores for load%-per-core context.
    ncpu = sh(["sysctl", "-n", "hw.ncpu"])
    if ncpu.isdigit():
        out["ncpu"] = int(ncpu)
        if out.get("load_avg"):
            out["load_pct"] = round(100 * out["load_avg"][0] / int(ncpu))

    # Memory used (page stats → GB).
    vm = sh(["vm_stat"])
    pages = {}
    for line in vm.splitlines():
        mm = re.match(r'"?([\w ]+?)"?:\s+(\d+)', line.strip())
        if mm:
            pages[mm.group(1).strip().lower()] = int(mm.group(2))
    psize = 16384
    pm = re.search(r"page size of (\d+)", vm)
    if pm:
        psize = int(pm.group(1))
    used_pages = sum(pages.get(k, 0) for k in ("pages active", "pages wired down",
                                               "pages occupied by compressor"))
    if used_pages:
        out["mem_used_gb"] = round(used_pages * psize / 1e9, 1)

    # Battery.
    bat = sh(["pmset", "-g", "batt"])
    bm = re.search(r"(\d+)%", bat)
    if bm:
        out["battery_pct"] = int(bm.group(1))
    out["power_source"] = "AC" if "AC Power" in bat else ("battery" if bat else None)

    # Thermal pressure (throttle indicator from pmset).
    therm = sh(["pmset", "-g", "therm"])
    tm = re.search(r"CPU_Speed_Limit\s*=\s*(\d+)", therm)
    if tm:
        out["cpu_speed_limit_pct"] = int(tm.group(1))

    # Actual sensor temperatures (°C) — the "how hot is it" face. Reuses
    # bin/mac-temps (IOHIDEventSystemClient reader, no sudo); the Mini and
    # every peer publish this so Fleet can answer "how hot is the Mini?"
    # remotely. Non-fatal: a machine whose model exposes no HID temp sensors
    # (or where the one-time swiftc compile times out) simply omits the block.
    temps = sh([str(HERE / "mac-temps"), "--json"], timeout=20)
    if temps:
        try:
            td = json.loads(temps)
            if td.get("ok"):
                out["thermal"] = {
                    "headline_c": td.get("headline"),
                    "max_c": td.get("max"),
                    "avg_c": td.get("avg"),
                    "cpu_c": td.get("cpu"),
                    "gpu_c": td.get("gpu"),
                    "pressure": td.get("pressure"),
                    "sensor_count": td.get("count"),
                    "top_sensors": (td.get("sensors") or [])[:5],
                }
        except Exception:
            pass

    # Top 3 processes by CPU.
    ps = sh(["ps", "-Ao", "pcpu,comm", "-r"])
    top = []
    for line in ps.splitlines()[1:4]:
        parts = line.strip().split(None, 1)
        if len(parts) == 2:
            top.append({"cpu": float(parts[0]), "cmd": os.path.basename(parts[1])})
    if top:
        out["top"] = top

    # Queue depths from warm service heartbeats.
    queues = {}
    for name, meta in SERVICES.items():
        p = QUEUE / meta["heartbeat"]
        if p.exists():
            try:
                q = json.loads(p.read_text()).get("queue")
                if isinstance(q, dict):
                    queues[name] = q
            except Exception:
                pass
    if queues:
        out["queues"] = queues

    return out


# ───────────────────────── assembly + caching ─────────────────────────

def compute_panel_actions() -> list:
    """The Apple Panel registry this machine can run, as a fleet peer sees it.
    Lets Fleet render per-machine action cards and dispatch a run here. Empty
    list if the panel isn't present."""
    panel = HERE / "apple-panel"
    if not panel.exists():
        return []
    try:
        out = sh([str(panel), "--actions-json"], timeout=10)
        return json.loads(out) if out else []
    except Exception:
        return []


def load_or_build_shape(force: bool) -> dict:
    if not force and CACHE.exists():
        try:
            cached = json.loads(CACHE.read_text())
            if time.time() - cached.get("_cached_at", 0) < CACHE_TTL:
                return cached["data"]
        except Exception:
            pass
    data = {"shape": compute_shape(), "ports": compute_ports(),
            "skills": compute_skills()}
    # Don't persist a failed shape — if the probe came back chip-less (e.g. a
    # transient system_profiler hiccup), caching it would pin garbage for 6h.
    if data["shape"].get("chip"):
        try:
            CACHE.parent.mkdir(parents=True, exist_ok=True)
            CACHE.write_text(json.dumps({"_cached_at": time.time(), "data": data}))
        except Exception:
            pass
    return data


def build_card(force_cache: bool = False) -> dict:
    stable = load_or_build_shape(force_cache)
    now = time.time()
    return {
        "schema": "machine-card/1",
        "id": identity()["hostname"],
        "ts": int(now),
        "ts_iso": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
        "identity": identity(),
        "shape": stable["shape"],
        "ports": stable["ports"],
        "skills": stable["skills"],
        # Live, NOT cached with the slow shape data: the registry is cheap to read
        # (~0.2s) and must reflect the current panel, so every --publish emits it
        # fresh. Caching it for 6h is what made the Mini's card go actionless.
        "panel_actions": compute_panel_actions(),
        "activity": compute_activity(),
        "running": compute_running(),
    }


def strip_private(obj):
    """Recursively drop the private quadrant for the publishable card."""
    if isinstance(obj, dict):
        if obj.get("_private") is True:  # a channel flagged private
            return None
        return {k: strip_private(v) for k, v in obj.items()
                if k != "_private"}
    if isinstance(obj, list):
        return [x for x in (strip_private(v) for v in obj) if x is not None]
    return obj


def public_card(card: dict) -> dict:
    # Running telemetry — load, mem, uptime, top processes, thermal, queue
    # depths — is operational data, not identifying. A fleet peer needs to SEE
    # the other machine actually working, not just "up". The genuinely-private
    # fields (serial, MACs, IPs, security posture) live in _private quadrants
    # and are stripped by strip_private; running was never one of them. Keep it.
    return strip_private(card)


def main() -> int:
    args = set(sys.argv[1:])
    card = build_card(force_cache="--cache" in args)

    if "--public" in args or "--publish" in args:
        card = public_card(card)

    if "--publish" in args:
        if not QUEUE.is_dir():
            print(f"queue dir not found: {QUEUE}", file=sys.stderr)
            return 1
        dest = QUEUE / f"machine-card-{card['id']}.json"
        dest.write_text(json.dumps(card))
        print(f"published → {dest}")
        return 0

    indent = 2 if ("--pretty" in args or sys.stdout.isatty()) else None
    print(json.dumps(card, indent=indent))
    return 0


if __name__ == "__main__":
    sys.exit(main())
