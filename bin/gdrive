#!/usr/bin/env bash
# gdrive — submit a Google Drive download to PakettiBot from any terminal.
#
# Wraps the `!pk gdrive` Discord command using the Syncthing file-command
# bridge — NO SSH, NO Discord. Robust wins over brittle.
#
# Already have it? It just opens. If the URL's result folder already exists on
# this computer (Syncthing-mirrored from the Mini), gdrive opens that folder in
# Finder and does NOT re-download. Otherwise it drops a `gdrive <url>` command
# file into the Syncthing-shared pakettibot-inbox; the bot on the Mini picks it
# up within ~10s, queues a mirror-submit download, and writes a confirmation back
# to the outbox. The content lands in ~/work/comms/queue/gdrive-results/<label>/
# on both Mini and this laptop.
#
# Usage:
#   gdrive <drive.google.com URL> [<URL> ...]      open if present, else submit
#   gdrive <URL> --label <name>                    custom result folder name
#   gdrive <URL> --force                            re-download even if present
#   gdrive <URL> --no-open                          don't open; just report/submit
#   gdrive <URL> --ingest                           after fetch, hand each file to
#                                                   its Reconvey (convey ingest:
#                                                   PDF→OCR, audio/video→whisper, …)
#   gdrive --status                                show queue / results counts
#   gdrive --help                                  this help
#
# Config (file sets defaults, env overrides; nothing required):
#   $GDRIVE_CONFIG or ~/.config/gdrive/config   a shell file sourced if present
#   GDRIVE_INBOX    override drop folder   (default: ~/work/comms/queue/pakettibot-inbox)
#   GDRIVE_OUTBOX   override reply folder  (default: ~/work/comms/queue/pakettibot-outbox)
#   GDRIVE_RESULTS  override result folder (default: ~/work/comms/queue/gdrive-results)
#   GDRIVE_WAIT     seconds to wait for the bot's confirmation (default: 60; 0 = don't wait)
#   GDRIVE_DOWNLOAD_WAIT  seconds to wait for the download to LAND then open it (default: 1800)

set -euo pipefail

GDRIVE_CONFIG="${GDRIVE_CONFIG:-$HOME/.config/gdrive/config}"
# shellcheck disable=SC1090
[[ -f "$GDRIVE_CONFIG" ]] && source "$GDRIVE_CONFIG"

INBOX="${GDRIVE_INBOX:-$HOME/work/comms/queue/pakettibot-inbox}"
OUTBOX="${GDRIVE_OUTBOX:-$HOME/work/comms/queue/pakettibot-outbox}"
RESULTS="${GDRIVE_RESULTS:-$HOME/work/comms/queue/gdrive-results}"
WAIT="${GDRIVE_WAIT:-60}"

log() { echo "[gdrive] $*" >&2; }
die() { echo "[gdrive] ERROR: $*" >&2; exit 1; }

usage() {
  sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

case "${1:-}" in
  ""|-h|--help) usage 0 ;;
  --status)
    pending=$(find "$INBOX" -maxdepth 1 -type f \( -name '*.txt' -o -name '*.cmd' \) 2>/dev/null | wc -l | tr -d ' ')
    replies=$(find "$OUTBOX" -maxdepth 1 -type f -name '*.out.txt' 2>/dev/null | wc -l | tr -d ' ')
    got=$(find "$RESULTS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    echo "inbox   : $INBOX  ($pending command(s) awaiting bot)"
    echo "outbox  : $OUTBOX  ($replies reply file(s))"
    echo "results : $RESULTS  ($got downloaded folder(s))"
    hb="$HOME/work/comms/queue/pakettibot-heartbeat.json"
    if [[ -f "$hb" ]]; then
      age=$(( $(date +%s) - $(stat -f %m "$hb" 2>/dev/null || echo 0) ))
      echo "bot     : heartbeat ${age}s ago"
    else
      echo "bot     : no heartbeat file (is the Mini up?)"
    fi
    exit 0
    ;;
esac

# Pull the Drive id out of a folder / file / open?id= URL.
gdrive_id() {
  local u="$1" id=""
  case "$u" in
    *drive.google.com/drive/folders/*) id="${u#*drive/folders/}" ;;
    *drive.google.com/file/d/*)        id="${u#*file/d/}"; id="${id%%/*}" ;;
    *[?\&]id=*)                        id="${u#*id=}" ;;
  esac
  id="${id%%[?&/]*}"                    # strip query/path tail
  printf '%s' "$id"
}

# True if a result dir holds at least one real downloaded file (ignoring the
# worker's bookkeeping: _failed_downloads.txt, *.log, *.part, .DS_Store, SOURCE.txt).
has_content() {
  local dir="$1"
  [[ -d "$dir" ]] || return 1
  find "$dir" -type f \
    ! -name '_failed_downloads.txt' ! -name '*.log' ! -name '*.part' \
    ! -name '.DS_Store' ! -name 'SOURCE.txt' ! -name '_mirror.log' \
    2>/dev/null | grep -q .
}

# Parse: collect URLs, pass through a --label <name> flag verbatim.
label=""
force=0
no_open=0
ingest=0
urls=()
extra=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --label)
      [[ -n "${2:-}" ]] || die "--label needs a name"
      label="$2"; extra+=(--label "$2"); shift 2 ;;
    --force|-f) force=1; shift ;;
    --no-open)  no_open=1; shift ;;
    --ingest)   ingest=1; shift ;;
    http://*|https://*)
      urls+=("$1"); shift ;;
    *)
      die "unexpected argument: $1  (URLs must start with http(s)://)" ;;
  esac
done

# Convey ingestion: after a fetch lands, hand each file to its Reconvey (flip+run
# by format). The files must be present locally (open/already-have path); a brand-
# new download arrives async, so re-run with --ingest once synced, or point
# `convey ingest --watch` at the result dir.
CONVEY_BIN="${CONVEY_BIN:-$HOME/work/convey/bin/convey}"
maybe_ingest() {  # $1 = result dir
  [[ "$ingest" == "1" ]] || return 0
  [[ -x "$CONVEY_BIN" ]] || { log "convey not found ($CONVEY_BIN) — skipping ingest"; return 0; }
  log "ingesting (Reconvey by format): $1"
  "$CONVEY_BIN" ingest "$1" || log "ingest reported issues (see above)"
}

[[ ${#urls[@]} -ge 1 ]] || die "no URL given. usage: gdrive <drive.google.com URL> [--label <name>]"

for u in "${urls[@]}"; do
  [[ "$u" == *drive.google.com* ]] || die "not a Google Drive URL: $u  (gdrive only handles drive.google.com links)"
done

# Already have it? Open the local copy and drop it from the submit list.
# (--force skips this; --label dirs are checked under that name.)
pending=()
if [[ "$force" == "0" ]]; then
  for u in "${urls[@]}"; do
    id="$(gdrive_id "$u")"
    dir="$RESULTS/${label:-gdrive-$id}"
    if has_content "$dir"; then
      log "already on this computer: $dir"
      if [[ "$no_open" == "0" ]]; then
        open "$dir" && log "opened in Finder."
      fi
      maybe_ingest "$dir"
    else
      pending+=("$u")
    fi
  done
else
  pending=("${urls[@]}")
fi

# Nothing left to fetch → we opened what we had; done.
if [[ ${#pending[@]} -eq 0 ]]; then
  exit 0
fi
urls=("${pending[@]}")

[[ -d "$INBOX" ]] || die "inbox not found: $INBOX  (is the comms Syncthing share present?)"

# Build the command line the bot will parse, exactly as if typed after !pk.
# `${arr[*]:-}` guards against bash 3.2 (macOS default) treating an empty
# array as an unbound variable under `set -u`.
cmd="gdrive ${urls[*]:-} ${extra[*]:-}"
cmd="$(printf '%s' "$cmd" | sed 's/[[:space:]]*$//')"   # trim trailing space

stem="gdrive-$(date +%Y%m%d-%H%M%S)-$$"
dest="$INBOX/$stem.txt"

# Atomic drop so Syncthing/the bot never see a half-written file.
printf '%s\n' "$cmd" > "$dest.tmp"
mv "$dest.tmp" "$dest"
log "submitted: $cmd"
log "drop      : $dest"

if [[ "$WAIT" == "0" ]]; then
  log "not waiting (GDRIVE_WAIT=0). Confirmation will appear at $OUTBOX/$stem.out.txt"
  log "Download lands in: $RESULTS/${label:-<gdrive-id>}/"
  exit 0
fi

reply="$OUTBOX/$stem.out.txt"
log "waiting up to ${WAIT}s for the bot's confirmation…"
deadline=$(( $(date +%s) + WAIT ))
while [[ $(date +%s) -lt $deadline ]]; do
  if [[ -f "$reply" ]]; then
    echo "----- bot reply -----"
    cat "$reply"
    echo "---------------------"
    break
  fi
  sleep 2
done
[[ -f "$reply" ]] || log "no confirmation within ${WAIT}s (bot busy / Mini asleep) — still waiting for the download."

# Open-when-done (DEFAULT): the download runs async on the Mini; wait for it to
# land via Syncthing, then open it — so `gdrive <url>` ends with the folder on
# screen whether you already had it or just fetched it. Suppress with --no-open.
if [[ "$no_open" == "1" ]]; then
  log "Download lands in: $RESULTS/${label:-<gdrive-id>}/ (Syncthing-mirrored). (--no-open)"
  exit 0
fi
dlwait="${GDRIVE_DOWNLOAD_WAIT:-1800}"
log "waiting up to ${dlwait}s for the download to land, then opening…"
ddl=$(( $(date +%s) + dlwait ))
for u in "${urls[@]}"; do
  id="$(gdrive_id "$u")"
  dir="$RESULTS/${label:-gdrive-$id}"
  opened=0
  while [[ $(date +%s) -lt $ddl ]]; do
    if has_content "$dir"; then
      log "downloaded: $dir"
      open "$dir" && log "opened in Finder."
      [[ "$ingest" == "1" ]] && maybe_ingest "$dir"
      opened=1
      break
    fi
    sleep 5
  done
  [[ "$opened" == "1" ]] || log "not landed within ${dlwait}s: $dir (re-run \`gdrive <url>\` later to open)"
done
exit 0
