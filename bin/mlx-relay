#!/usr/bin/env python3
"""mlx-relay — relay an MLX discussion's answer to Claude, in the repo.

Talk to the free local MLX brain (`mlx <name>` in Converse, or `mlx-here`); when
it drafts something useful, hand it to Claude to judge or to implement:

    mlx-relay <name>                  Claude grades MLX's last answer vs the real code
    mlx-relay <name> --apply          Claude implements it (may edit files; git diff after)
    mlx-relay <name> --copy           put a Claude-ready prompt on the clipboard
    mlx-relay <name> -n 3             relay the last 3 exchanges (default 1)
    mlx-relay <name> --all            relay the whole discussion
    mlx-relay <name> [--apply] note…  add a steering note for Claude
    mlx-relay --list                  list relayable mlx discussions

<name> is the discussion you opened with `mlx <name>` (the mlx-<slug> session).
With no name, the most-recent mlx discussion is used. The repo Claude runs in is
the one that discussion was armed for, so Claude has its skill + can edit it.

Apple-native: python3 stdlib only. Reuses bin/relay_core.py (shared with fm-chat /relay).
"""
import json
import os
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import relay_core

FM_STORE = Path.home() / ".cache" / "fm-converse"


def slugify(s: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-").lower() or "chat"


def store_for(name: str) -> Path | None:
    """Resolve a discussion name to its fm-converse store file."""
    cands = []
    if name:
        slug = slugify(name)
        cands = [f"mlx-{slug}", slug, name]
    for c in cands:
        p = FM_STORE / f"{c}.json"
        if p.exists():
            return p
    return None


def newest_mlx() -> Path | None:
    if not FM_STORE.is_dir():
        return None
    files = [p for p in FM_STORE.glob("mlx-*.json")]
    if not files:
        files = list(FM_STORE.glob("*.json"))
    return max(files, key=lambda p: p.stat().st_mtime) if files else None


def list_discussions():
    if not FM_STORE.is_dir():
        print("(no mlx discussions yet)"); return
    rows = []
    for p in sorted(FM_STORE.glob("mlx-*.json")):
        try:
            s = json.loads(p.read_text())
        except Exception:
            continue
        turns = len(s.get("turns", [])) // 2
        repo = s.get("arm_cwd") or s.get("cwd") or ""
        rows.append((p.stat().st_mtime, p.stem, turns, repo))
    if not rows:
        print("(no mlx discussions yet)"); return
    for _, stem, turns, repo in sorted(rows, reverse=True):
        name = stem[4:] if stem.startswith("mlx-") else stem
        print(f"  {name:28} {turns:2} exchange(s)   {repo}")


def last_turns(state: dict, n: int, want_all: bool):
    """Return [(role,text)...] for the last n exchanges (user+assistant pairs),
    or the whole transcript with --all. Always ends on an assistant (MLX) turn."""
    turns = [tuple(t) for t in state.get("turns", [])]
    if not turns:
        return []
    if want_all:
        return turns
    # keep the last n assistant turns and the user turn preceding each
    keep = []
    count = 0
    i = len(turns) - 1
    while i >= 0 and count < n:
        if turns[i][0] == "assistant":
            block = [turns[i]]
            if i - 1 >= 0 and turns[i - 1][0] == "user":
                block.insert(0, turns[i - 1])
                i -= 1
            keep[:0] = block
            count += 1
        i -= 1
    return keep or turns[-2:]


def main():
    args = sys.argv[1:]
    mode = "critique"
    n = 1
    want_all = False
    name = None
    note_words = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-h", "--help"):
            sys.stdout.write(__doc__); return 0
        elif a == "--list":
            list_discussions(); return 0
        elif a == "--apply":
            mode = "apply"; i += 1
        elif a in ("--critique", "--review"):
            mode = "critique"; i += 1
        elif a == "--copy":
            mode = "copy"; i += 1
        elif a == "--all":
            want_all = True; i += 1
        elif a == "-n":
            n = max(1, int(args[i + 1])); i += 2
        elif a.startswith("-"):
            sys.exit(f"mlx-relay: unknown flag {a} (see --help)")
        elif name is None:
            name = a; i += 1
        else:
            note_words.append(a); i += 1

    store = store_for(name) if name else newest_mlx()
    if not store:
        sys.exit(f"mlx-relay: no discussion {('named ' + name) if name else 'found'}. "
                 f"Try `mlx-relay --list`.")
    state = json.loads(store.read_text())
    repo = state.get("arm_cwd") or state.get("cwd") or os.getcwd()
    turns = last_turns(state, n, want_all)
    if not turns:
        sys.exit(f"mlx-relay: discussion '{store.stem}' has no turns yet.")

    print(f"mlx-relay: {store.stem[4:] if store.stem.startswith('mlx-') else store.stem} "
          f"· {len([t for t in turns if t[0]=='assistant'])} MLX answer(s) · mode={mode}")
    return relay_core.relay(turns, repo, mode=mode, note=" ".join(note_words))


if __name__ == "__main__":
    sys.exit(main())
