#!/usr/bin/env python3
"""fm-converse — one-shot, STATEFUL sender to Apple's on-device LLM on the Mini.

Same transport as fm-submit (Syncthing → fm-worker → FoundationModels → back),
but it REMEMBERS. Each call replays the prior dialogue so the (stateless) worker
sees the whole conversation — so Converse's Cmd-1 becomes a real conversation,
not a series of unrelated one-shots.

Memory is keyed to the CURRENT Converse session by default: the newest dir under
~/work/converse/sessions/. Start a new Converse session → fresh conversation.
Override with --session NAME. History lives in ~/.cache/fm-converse/<key>.json.

If the prompt is a path to a file (txt/md/rtf/pdf/image/…), the file is converted
to text via `file-to-text` (Apple-native; Vision OCR for PDFs/images) and sent as
the turn — so "drag a file in, select it, Cmd-1" just works.

    fm-converse "your message"        send (remembers prior turns)
    echo text | fm-converse -          message from stdin
    fm-converse --session NAME "..."   pick the memory bucket explicitly
    fm-converse --system "..." "..."   set/replace the system instruction
    fm-converse --reset                forget this session's conversation
    fm-converse --history              print the running transcript
    fm-converse --timeout 90 "..."     how long to wait (default 120s)
    fm-converse --flubuild "..."       send to the flubuild remote brain

Apple-native: python3 stdlib only. Delegates the round-trip to fm-submit.
"""
import json
import os
import re
import subprocess
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent

# ── Markdown rendering — shared with fm-mlx & friends ─────────────────────────
# The FM model speaks Markdown (**bold**, # headings, - bullets, `code`). Turning
# that into ANSI (terminal) or plain text (piped/spoken) used to live inline here;
# it now lives once in fm_render so every fm-* tool renders identically. DRY.
sys.path.insert(0, str(HERE))
from fm_render import emit_reply  # noqa: E402  (md_to_ansi/md_to_plain also live there)

SESSIONS = Path.home() / "work" / "converse" / "sessions"
STORE = Path.home() / ".cache" / "fm-converse"
# FoundationModels' window is 4096 tokens TOTAL (input + room for the answer).
# At ~3 chars/token that's ~12k chars for everything, so prior-dialogue replay
# must stay small or a trivial question overflows the model. Budget conservatively
# and leave headroom for the new turn + the generated reply.
REPLAY_BUDGET = 6000      # chars of prior dialogue to replay (~1.5k tokens)
FILE_CAP = 5000           # chars of an attachment to keep per turn
MAX_INPUT_CHARS = 9000    # hard ceiling on the assembled prompt sent to fm-submit
ARM_IDENTITY_VERSION = 4  # bump when the generated skill instructions change


def _safe_key(key: str) -> str:
    return "".join(c if c.isalnum() or c in "-_." else "_" for c in key)


def current_session_key() -> str:
    """The Converse session you're in right now = newest sessions/ dir."""
    try:
        dirs = [d for d in SESSIONS.iterdir() if d.is_dir()]
        if dirs:
            return max(dirs, key=lambda d: d.stat().st_mtime).name
    except OSError:
        pass
    return "default"


def store_path(key: str) -> Path:
    STORE.mkdir(parents=True, exist_ok=True)
    return STORE / f"{_safe_key(key)}.json"


def load(key: str) -> dict:
    p = store_path(key)
    if p.exists():
        try:
            return json.loads(p.read_text())
        except Exception:
            pass
    return {"system": "", "turns": []}


def save(key: str, state: dict):
    store_path(key).write_text(json.dumps(state, ensure_ascii=False))


def activate_armed_skill(armer, cwd: str):
    """Keep per-turn retrieval in the session's selected corpus after system caching."""
    return armer.activate_skill(cwd)


def maybe_file_to_text(prompt: str) -> tuple[str, str | None]:
    """If `prompt` is a path to a real file, return (extracted_text, filename).
    Else (prompt, None)."""
    s = prompt.strip()
    if not s or "\n" in s:
        return prompt, None
    if s.startswith("file://"):
        from urllib.parse import urlparse, unquote
        s = unquote(urlparse(s).path)
    s = s.strip("'\"")
    p = Path(s).expanduser()
    if not p.is_file():
        return prompt, None
    try:
        out = subprocess.run([str(HERE / "file-to-text"), str(p)],
                             capture_output=True, text=True, timeout=180)
    except Exception:
        return prompt, None
    if out.returncode != 0 or not out.stdout.strip():
        return prompt, None
    text = out.stdout
    if len(text) > FILE_CAP:
        text = text[:FILE_CAP] + f"\n\n[…truncated; {len(out.stdout)} chars total]"
    return text, p.name


def build_replay(turns: list, new_user: str) -> str:
    """Replay recent dialogue as one prompt ending on the new turn."""
    lines = []
    # walk newest→oldest, keep within the char budget, then restore order
    kept, total = [], 0
    for role, text in reversed(turns):
        tag = "User" if role == "user" else "Assistant"
        chunk = f"{tag}: {text}"
        if total + len(chunk) > REPLAY_BUDGET:
            break
        kept.append(chunk)
        total += len(chunk)
    lines = list(reversed(kept))
    lines.append(f"User: {new_user}")
    lines.append("Assistant:")
    return "\n".join(lines)


# ── Converse livefile capture + Scaff push ───────────────────────────────────
# FEATURE-CARD >> features/fm-converse.feature
def _iso_now() -> str:
    return datetime.now().astimezone().isoformat(timespec="milliseconds")


def _read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    events = []
    for line in path.read_text(errors="replace").splitlines():
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except Exception:
            continue
        if isinstance(obj, dict):
            events.append(obj)
    return events


def _next_event_number(events: list[dict]) -> int:
    max_seen = 0
    for event in events:
        m = re.match(r"^evt_(\d+)$", str(event.get("id", "")))
        if m:
            max_seen = max(max_seen, int(m.group(1)))
    return max_seen + 1


def _write_jsonl(path: Path, obj: dict):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(obj, ensure_ascii=False, sort_keys=True) + "\n")


def _capture_session_dir(key: str) -> Path:
    return SESSIONS / _safe_key(key)


def _ensure_capture_manifest(session_dir: Path, key: str, context_path: str, source: str):
    session_dir.mkdir(parents=True, exist_ok=True)
    (session_dir / "chunks").mkdir(exist_ok=True)
    manifest = session_dir / "manifest.json"
    if manifest.exists():
        return
    manifest.write_text(json.dumps({
        "session_id": session_dir.name,
        "session_key": key,
        "doctrine": "envoy-livefile-v1",
        "event_log": "livefile.jsonl",
        "created_by": "fm-converse",
        "source": source,
        "context_path": context_path,
        "started_at": _iso_now(),
    }, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


def _recent_app_already_owns_turn(events: list[dict], raw_prompt: str, user_turn: str) -> bool:
    needles = {raw_prompt.strip(), user_turn.strip()}
    needles.discard("")
    if not needles:
        return False
    # Converse.app logs talk.heard before it invokes fm-converse. If we see that
    # just-authored user turn, the app owns the livefile and will log the answer.
    for event in events[-40:]:
        if event.get("type") == "talk.heard" and str(event.get("body", "")).strip() in needles:
            return True
    return False


def _brain_capture(use_mlx: bool, use_flubuild: bool) -> tuple[str, str]:
    if use_flubuild:
        return "flubuild", FLUBUILD_MODEL
    if use_mlx:
        return "mlx", MLX_MODEL
    return "foundationmodels", "Apple FoundationModels"


def _append_capture_turn(key: str,
                         state: dict,
                         raw_prompt: str,
                         user_turn: str,
                         reply: str,
                         use_mlx: bool,
                         filename: str | None,
                         use_flubuild: bool = False) -> tuple[bool, Path]:
    if os.environ.get("FM_CONVERSE_CAPTURE", "1") == "0":
        return False, _capture_session_dir(key)

    session_dir = _capture_session_dir(key)
    livefile = session_dir / "livefile.jsonl"
    events = _read_jsonl(livefile)
    if _recent_app_already_owns_turn(events, raw_prompt, user_turn):
        return False, session_dir

    context_path = os.path.realpath(state.get("arm_cwd") or state.get("cwd") or os.getcwd())
    _ensure_capture_manifest(session_dir, key, context_path, "fm-converse")

    events = _read_jsonl(livefile)
    counter = _next_event_number(events)
    if not events:
        _write_jsonl(livefile, {
            "id": f"evt_{counter:06d}",
            "type": "session.created",
            "t": _iso_now(),
            "actor": "fm-converse",
            "body": session_dir.name,
            "session_id": session_dir.name,
            "doctrine": "envoy-livefile-v1",
        })
        counter += 1

    request_id = f"req_{uuid.uuid4().hex[:12]}"
    agent_type, model = _brain_capture(use_mlx, use_flubuild)
    _write_jsonl(livefile, {
        "id": f"evt_{counter:06d}",
        "type": "talk.heard",
        "t": _iso_now(),
        "actor": "local-user",
        "source": "fm-converse",
        "body": user_turn,
        "raw_prompt": raw_prompt,
        "filename": filename or "",
        "request_id": request_id,
        "agent": "fm-converse",
        "agent_type": agent_type,
        "model": model,
        "agent_cwd": context_path,
    })
    _write_jsonl(livefile, {
        "id": f"evt_{counter + 1:06d}",
        "type": "agent.responded",
        "t": _iso_now(),
        "actor": "fm-converse",
        "source": "agent",
        "body": reply,
        "instruction": user_turn,
        "request_id": request_id,
        "agent": "fm-converse",
        "agent_type": agent_type,
        "model": model,
        "status": "ok",
        "output_chars": len(reply),
        "agent_cwd": context_path,
    })
    return True, session_dir


def _publish_capture_session(session_dir: Path, state: dict):
    context_path = os.path.realpath(state.get("arm_cwd") or state.get("cwd") or os.getcwd())
    context_name = Path(context_path).name or "fm-converse"
    cmd = [
        str(HERE / "converse-publish"), str(session_dir),
        "--context", context_name,
        "--context-path", context_path,
        "--quiet",
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    except Exception as e:
        if os.environ.get("FM_CONVERSE_CAPTURE_DEBUG") == "1":
            sys.stderr.write(f"fm-converse: publish failed: {e}\n")
        return
    if proc.returncode != 0 and os.environ.get("FM_CONVERSE_CAPTURE_DEBUG") == "1":
        err = (proc.stderr or proc.stdout).strip()
        sys.stderr.write(f"fm-converse: publish failed: {err}\n")


# ── MLX brain port (the Mini's mlx_lm.server, OpenAI-compatible, over Tailscale) ──
# Unlike fm-submit (one flat prompt to FoundationModels), the MLX server takes a real
# messages[] array — so multi-turn is native: we just hand it the whole dialogue.
MLX_HOST = os.environ.get("FM_MLX_HOST", "http://cloudcitymacmini.taild55c11.ts.net:8080")
MLX_MODEL = os.environ.get("FM_MLX_MODEL", "mlx-community/Qwen3-4B-Instruct-2507-8bit")
MLX_RESOLVE_IP = os.environ.get("FM_MLX_RESOLVE_IP", "100.117.30.102")
MLX_SSH_HOST = os.environ.get("FM_MLX_SSH_HOST", "100.117.30.102")
MLX_PREFER_SSH = os.environ.get("FM_MLX_PREFER_SSH", "1") != "0"
MLX_BUDGET = int(os.environ.get("FM_MLX_BUDGET", "4000"))
# SHARED-BRAIN-ROUTING v1
# REPORT-CARD >> ~/work/convey/features/shared-brain-routing.feature
sys.path.insert(0, str(Path.home()/"work/convey"))
from convey import brain_routes
from convey.brain_routes import (FLUBUILD_SSH_HOST, FLUBUILD_MODEL,
                                 FLUBUILD_BUDGET, FLUBUILD_MAX_TOKENS)



def _parse_mlx_response(raw: str):
    d = json.loads(raw)
    return d["choices"][0]["message"]["content"].strip()


def _call_mlx_via_ssh(body: bytes, timeout_s: float):
    if not MLX_SSH_HOST:
        return "", "SSH fallback disabled (FM_MLX_SSH_HOST is empty)"
    script = r'''
import sys, urllib.request
body = sys.stdin.buffer.read()
req = urllib.request.Request("http://127.0.0.1:8080/v1/chat/completions",
    data=body, headers={"Content-Type": "application/json"}, method="POST")
with urllib.request.urlopen(req, timeout=float(sys.argv[1])) as r:
    sys.stdout.buffer.write(r.read())
'''
    try:
        proc = subprocess.run(["ssh", MLX_SSH_HOST, "python3", "-c", script, str(timeout_s)],
                              input=body, capture_output=True, timeout=timeout_s + 10)
    except subprocess.TimeoutExpired:
        return "", f"MLX SSH fallback timed out after {timeout_s + 10:.0f}s (ssh host {MLX_SSH_HOST})"
    if proc.returncode != 0:
        err = proc.stderr.decode(errors="replace").strip()
        return "", f"MLX SSH fallback failed rc={proc.returncode}: {err or 'no stderr'}"
    raw = proc.stdout.decode(errors="replace")
    try:
        return _parse_mlx_response(raw), None
    except Exception as e:
        return "", f"MLX SSH fallback returned an unreadable response: {e}; body={raw[:500]}"


def call_mlx(turns, system, user_turn, timeout):
    """POST the conversation to the Mini's MLX server; return (reply, error_message)."""
    import socket
    from urllib.parse import urlparse
    import urllib.request, urllib.error
    msgs = []
    if system:
        msgs.append({"role": "system", "content": system})
    kept, budget = [], MLX_BUDGET           # keep the most-recent turns that fit the budget
    for role, text in reversed(turns):
        budget -= len(text)
        if budget < 0:
            break
        kept.append({"role": role, "content": text})
    msgs.extend(reversed(kept))
    if os.environ.get("FM_MLX_NO_THINK", "1") != "0" and "/no_think" not in user_turn:
        user_turn = user_turn.rstrip() + "\n/no_think"
    msgs.append({"role": "user", "content": user_turn})
    # The MLX server (mlx_lm.server) defaults to max_tokens=512 → long answers get
    # chopped MID-WORD (finish_reason "length"). Raise it so a full structured reply
    # comes back. Override with FM_MLX_MAX_TOKENS.
    max_tokens = int(os.environ.get("FM_MLX_MAX_TOKENS", "512"))
    body = json.dumps({
        "model": MLX_MODEL,
        "messages": msgs,
        "max_tokens": max_tokens,
    }).encode()
    # The MLX server runs single-concurrency, so a request that arrives while it's
    # busy (or mid-restart) returns 502/503. Retry transient failures with backoff
    # rather than failing the turn. Genuine "server down" still surfaces after retries.
    import time as _t
    last = "unknown"
    timeout_s = float(timeout)
    started = _t.time()
    parsed = urlparse(MLX_HOST)
    resolve_host = parsed.hostname or ""
    original_getaddrinfo = socket.getaddrinfo

    if MLX_PREFER_SSH:
        reply, ssh_err = _call_mlx_via_ssh(body, timeout_s)
        if reply:
            return reply, None
        last = f"SSH preferred path failed: {ssh_err}"

    def getaddrinfo(host, port, *args, **kwargs):
        if MLX_RESOLVE_IP and host == resolve_host:
            return original_getaddrinfo(MLX_RESOLVE_IP, port, *args, **kwargs)
        return original_getaddrinfo(host, port, *args, **kwargs)

    for attempt in range(4):
        req = urllib.request.Request(MLX_HOST + "/v1/chat/completions", data=body,
                                     headers={"Content-Type": "application/json"}, method="POST")
        try:
            if MLX_RESOLVE_IP:
                socket.getaddrinfo = getaddrinfo
            with urllib.request.urlopen(req, timeout=timeout_s) as r:
                return _parse_mlx_response(r.read().decode()), None
        except (TimeoutError, socket.timeout) as e:
            elapsed = _t.time() - started
            return "", (f"MLX request timed out after {elapsed:.0f}s "
                        f"(per-request timeout {timeout_s:.0f}s, attempt {attempt + 1}/4, "
                        f"host {MLX_HOST}). The Mini accepted no complete reply before the deadline.")
        except urllib.error.HTTPError as e:
            last = f"HTTP {e.code}"
            if e.code in (429, 500, 502, 503, 504) and attempt < 3:
                _t.sleep(2 + 3 * attempt)      # server busy (single-concurrency) — wait + retry
                continue
            return "", f"MLX server error ({last}) — is mlx_lm.server up on the Mini? try `fm-mlx hello`"
        except urllib.error.URLError as e:
            last = str(getattr(e, "reason", e))
            if isinstance(getattr(e, "reason", None), socket.timeout):
                elapsed = _t.time() - started
                return "", (f"MLX request timed out after {elapsed:.0f}s "
                            f"(per-request timeout {timeout_s:.0f}s, attempt {attempt + 1}/4, "
                            f"host {MLX_HOST}). The Mini accepted no complete reply before the deadline.")
            if attempt == 0:
                reply, ssh_err = _call_mlx_via_ssh(body, timeout_s)
                if reply:
                    return reply, None
                last = f"{last}; SSH fallback: {ssh_err}"
            if attempt < 3:
                _t.sleep(2 + 3 * attempt)
                continue
            return "", f"MLX server unreachable ({last}) — is mlx_lm.server up on the Mini? try `fm-mlx hello`"
        except Exception as e:
            return "", f"MLX error: {e}"
        finally:
            socket.getaddrinfo = original_getaddrinfo
    return "", f"MLX server unreachable after retries ({last})"


def _parse_flubuild_response(raw: str):
    d = json.loads(raw)
    answer = d["choices"][0]["message"]["content"].strip()
    note = d.get("fm_context_note")
    return answer + ("\n\n*" + note + "*" if note else "")


def call_flubuild(turns, system, user_turn, timeout):
    """POST the conversation to the flubuild remote brain; return (reply, error_message)."""
    import shlex
    msgs = []
    if system:
        msgs.append({"role": "system", "content": system})
    kept, budget = [], FLUBUILD_BUDGET
    for role, text in reversed(turns):
        budget -= len(text)
        if budget < 0:
            break
        kept.append({"role": role, "content": text})
    msgs.extend(reversed(kept))
    msgs.append({"role": "user", "content": user_turn})
    try:
        text, _model = brain_routes.call_flubuild(
            msgs, host=FLUBUILD_SSH_HOST, model=FLUBUILD_MODEL,
            max_tokens=FLUBUILD_MAX_TOKENS, timeout=timeout)
        return text, None
    except brain_routes.BrainRouteError as exc:
        return "", str(exc)


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return 0

    session = None
    system_override = None
    timeout = "120"
    do_reset = False
    do_history = False
    use_mlx = False
    use_flubuild = False
    arm_skill = False        # --apple: arm the skill governing arm_cwd
    arm_cwd = None           # --cwd DIR
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--session":
            session = args[i + 1]; i += 2
        elif a == "--system":
            system_override = args[i + 1]; i += 2
        elif a == "--timeout":
            timeout = args[i + 1]; i += 2
        elif a == "--reset":
            do_reset = True; i += 1
        elif a == "--history":
            do_history = True; i += 1
        elif a == "--mlx":
            use_mlx = True; i += 1
        elif a == "--flubuild":
            use_flubuild = True; use_mlx = False; i += 1
        elif a == "--apple":
            arm_skill = True; i += 1
        elif a == "--cwd":
            arm_cwd = args[i + 1]; i += 2
        elif a == "-":
            rest.append(sys.stdin.read()); i += 1
        else:
            rest.append(a); i += 1

    key = session or current_session_key()
    state = load(key)
    # Record the folder this chat lives in (where from), so the `sessions` picker
    # can show it. First write wins — a chat keeps the folder it started in even
    # if you later resume it from elsewhere.
    if not state.get("cwd"):
        state["cwd"] = os.path.realpath(os.getcwd())

    # Per-session token cap (set by persona sessions for snappy spoken replies).
    if state.get("max_tokens") and not os.environ.get("FM_MLX_MAX_TOKENS"):
        os.environ["FM_MLX_MAX_TOKENS"] = str(state["max_tokens"])

    # --apple: arm the skill governing the chat's folder (identity from its SKILL.md
    # + per-turn retrieval from its docs). STICKY: arm_cwd is persisted into the
    # session state, so every later turn — incl. Converse's plain `fm-converse --mlx`
    # ⌘3 call, and any resume — self-arms with no flag. Reuses bin/arm_apple.py.
    # NOTE: keep this block in sync — it has been clobbered by concurrent edits before.
    arm_cwd_final = None
    arm_state_changed = False
    if arm_skill:
        arm_cwd_final = arm_cwd or state.get("arm_cwd") or state.get("cwd") or os.getcwd()
        previous_arm_cwd = state.get("arm_cwd") or ""
        if previous_arm_cwd and os.path.realpath(previous_arm_cwd) == os.path.realpath(arm_cwd_final):
            pass
        else:
            state["system"] = ""
            state["turns"] = []
        if state.get("arm_cwd") != arm_cwd_final:
            arm_state_changed = True
        if state.get("cwd") != arm_cwd_final:
            arm_state_changed = True
        state["arm_cwd"] = arm_cwd_final
        state["cwd"] = arm_cwd_final
    elif state.get("arm_cwd"):
        arm_cwd_final = state["arm_cwd"]
    armer = None
    if arm_cwd_final:
        try:
            import arm_apple as armer  # bin/arm_apple.py (sys.path has HERE)
        except Exception as e:
            sys.stderr.write(f"fm-converse: could not arm skill: {e}\n")
            armer = None
        if armer is not None:
            # `system` is cached, so build_system() may not run on this turn. Activation
            # must still happen before augment_prompt(), whose retrieval corpus comes
            # from arm_apple._ACTIVE rather than the cached system text.
            activate_armed_skill(armer, arm_cwd_final)
            # Build the (heavy) grounded system ONCE and CACHE it. Rebuilding the
            # full archive-retrieval system on every turn is what made armed personas
            # take 35s+ and time out. The cached identity stays armed; per-turn live
            # retrieval still happens below via armer.augment_prompt. Force a rebuild
            # with FM_REARM=1 (or --reset).
            identity_stale = state.get("arm_identity_version") != ARM_IDENTITY_VERSION
            if (not state.get("system")
                    or identity_stale
                    or os.environ.get("FM_REARM") == "1"):
                if identity_stale:
                    state["turns"] = []
                state["system"] = armer.build_system(arm_cwd_final, extra=system_override or "")
                state["arm_identity_version"] = ARM_IDENTITY_VERSION
                save(key, state)
            elif arm_state_changed:
                save(key, state)
    elif system_override is not None:
        state["system"] = system_override
        save(key, state)

    if do_reset:
        reset_state = {"system": "", "turns": [], "cwd": state.get("cwd", "")}
        if state.get("arm_cwd"):
            reset_state["arm_cwd"] = state["arm_cwd"]
        save(key, reset_state)
        print(f"— conversation '{key}' cleared —")
        return 0
    if do_history:
        for role, text in state["turns"]:
            print(f"{role}: {text}")
        return 0

    prompt = " ".join(rest).strip()
    if not prompt:
        prompt = sys.stdin.read().strip()
    if not prompt:
        sys.stderr.write("fm-converse: no message (pass text, pipe stdin, or use -)\n")
        return 2

    # If the message is a file path, swap in the file's text.
    sent_text, filename = maybe_file_to_text(prompt)
    user_turn = sent_text
    if filename:
        # Neutral framing: a small model reflexively refuses "read this file",
        # so we just present the text inline as the thing to work with.
        user_turn = (f"Here is some text (from {filename}) to help me with:\n\n"
                     f"{sent_text}\n\n"
                     f"Please summarize it and note anything important.")

    # When armed, prepend the turn with LIVE DATA + the skill-doc passages most
    # relevant to this question (build_system above already set _ACTIVE so this
    # retrieves from the governing skill's corpus). The query is the raw line.
    if armer is not None:
        user_turn = armer.augment_prompt(user_turn, prompt)

    def call_fm(replay_text: str):
        cmd = [str(HERE / "fm-submit"), "--timeout", timeout]
        if state.get("system"):
            cmd += ["--system", state["system"]]
        cmd.append(replay_text)
        return subprocess.run(cmd, capture_output=True, text=True)

    if use_flubuild:
        reply, flubuild_err = call_flubuild(state["turns"], state.get("system", ""), user_turn, timeout)
        if not reply:
            print(f"[flubuild] {flubuild_err or 'no reply'}")
            return 1
    elif use_mlx:
        # MLX brain: send the real multi-turn message history to the Mini's mlx_lm.server.
        reply, mlx_err = call_mlx(state["turns"], state.get("system", ""), user_turn, timeout)
        if not reply:
            print(f"[MLX-on-Mini] {mlx_err or 'no reply'}")
            return 1
    else:
        replay = build_replay(state["turns"], user_turn)
        # Hard ceiling: trim from the front (drop oldest dialogue) until it fits.
        if len(replay) > MAX_INPUT_CHARS:
            replay = build_replay([], user_turn)        # history doesn't fit → just the question

        proc = call_fm(replay)
        # Self-heal: if FM still rejects for context-window size, retry once with NO
        # history (just this turn). A trivial question must never fail because the
        # backlog grew too large.
        overflow_markers = ("exceededContextWindowSize", "exceeds the maximum", "context size")
        if proc.returncode != 0 and any(m in proc.stderr for m in overflow_markers):
            sys.stderr.write("fm-converse: context overflow — retrying without history\n")
            proc = call_fm(build_replay([], user_turn))

        reply = proc.stdout.strip()
        # the model sometimes echoes the "Assistant:" cue — strip it
        if reply.lower().startswith("assistant:"):
            reply = reply.split(":", 1)[1].strip()

        if proc.returncode != 0 or not reply:
            # surface fm-submit's stderr (guardrail / timeout / worker-down) as the reply
            err = proc.stderr.strip().splitlines()
            msg = err[-1] if err else "no reply (is fm-worker running? `fm-submit --status`)"
            print(f"[FM-on-Mini] {msg}")
            return 1

    # Persist the turn. For files we keep the (capped) content so follow-up
    # questions about the file still have it in context; replay-budget clipping
    # drops the oldest turns once the conversation grows.
    state["turns"].append(["user", user_turn])
    state["turns"].append(["assistant", reply])
    save(key, state)

    did_capture, capture_dir = _append_capture_turn(
        key=key,
        state=state,
        raw_prompt=prompt,
        user_turn=user_turn,
        reply=reply,
        use_mlx=use_mlx,
        filename=filename,
        use_flubuild=use_flubuild,
    )
    if did_capture:
        _publish_capture_session(capture_dir, state)

    emit_reply(reply)

    if sys.stdout.isatty():
        friendly_session_path = str(capture_dir).replace(str(Path.home()), "~")
        sys.stderr.write(f"  [captured to {friendly_session_path}]\n")
        scaff_repo = Path(os.environ.get("FM_CONVERSE_SCAFF_REPO")
                          or os.environ.get("CONVERSE_SCAFF_REPO")
                          or str(Path.home() / "work" / "scaff")).expanduser()
        if (scaff_repo / "Package.swift").exists():
            friendly_scaff_path = str(scaff_repo / "ConverseInbox").replace(str(Path.home()), "~")
            sys.stderr.write(f"  [pushed to {friendly_scaff_path}]\n")

    return 0


if __name__ == "__main__":
    sys.exit(main())
