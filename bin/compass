#!/bin/bash
# compass — read the iPhone's Compass heading onto the Mac command line, and
# work out where EAST is, by SCREEN-OCR (not by any sensor API — the Mac has no
# magnetometer and Apple exposes no USB channel for iPhone heading data).
#
# Pipeline:  iphone-screen (CoreMediaIO frame of the phone screen)
#         →  vision-ocr   (Apple Vision, on-device, reads the degree readout)
#         →  parse + compute turn-to-East
#
# Prereqs: iPhone tethered + unlocked + trusted, and the Compass app OPEN and
# showing its digital degree readout (Settings ▸ Compass: large readout on).
#
#   compass                 # one reading, say where East is
#   compass --watch [S]     # re-read every S seconds (default 2) until Ctrl-C
#   compass --raw           # print the OCR text and exit (debugging)
#   compass --shot FILE     # OCR an existing screenshot instead of grabbing one
#
# FEATURE-CARD >> features/iphone-compass.feature
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
SHOT=""; WATCH=""; INTERVAL=2; RAW=""; OPEN=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --watch) WATCH=1; shift; [[ "${1:-}" =~ ^[0-9]+$ ]] && { INTERVAL="$1"; shift; } ;;
    --raw)   RAW=1; shift ;;
    --open)  OPEN=1; shift ;;
    --shot)  SHOT="${2:?--shot needs a file}"; shift 2 ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "compass: unknown arg $1" >&2; exit 2 ;;
  esac
done

# --open: launch the Compass app on the tethered iPhone via Xcode CoreDevice
# tooling (no custom app, no URL scheme). Needs a paired device + Xcode.
open_compass() {
  local id
  id="$(xcrun devicectl list devices 2>/dev/null \
        | grep -iE 'iphone' \
        | grep -oE '[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}' \
        | head -1)"
  if [[ -z "$id" ]]; then
    echo "compass: no paired iPhone found via devicectl." >&2; return 4
  fi
  xcrun devicectl device process launch --device "$id" com.apple.compass >/dev/null 2>&1 \
    && echo "compass: launched Compass on $id" >&2 \
    || { echo "compass: devicectl could not launch Compass (phone locked?)." >&2; return 4; }
}
[[ -n "$OPEN" ]] && open_compass

read_once() {
  local img="${1:-}"
  if [[ -z "$SHOT" ]]; then
    img="$(mktemp -t compass).jpg"
    if ! "$REPO/bin/iphone-screen" "$img" --timeout 20 >/dev/null 2>&1; then
      echo "compass: no iPhone screen available. Plug in + unlock the phone, trust this Mac, and open Compass." >&2
      return 3
    fi
  else
    img="$SHOT"
  fi
  local text; text="$("$REPO/bin/vision-ocr" "$img" --lang en 2>/dev/null || true)"
  [[ -z "$SHOT" ]] && rm -f "$img"
  if [[ -n "$RAW" ]]; then printf '%s\n' "$text"; return 0; fi
  printf '%s' "$text" | COMPASS_PARSE=1 python3 "$0.py"
}

if [[ -n "$WATCH" ]]; then
  echo "compass: watching every ${INTERVAL}s — Ctrl-C to stop" >&2
  while true; do read_once || true; sleep "$INTERVAL"; done
else
  read_once
fi
