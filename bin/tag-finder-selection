#!/usr/bin/env python3
"""
tag-finder-selection — tag whatever is selected in the front Finder window.

Modes:
  tag-finder-selection                 — prompt for tag spec, apply
  tag-finder-selection list            — show tags on each selected file
  tag-finder-selection clear           — strip all tags from each selected file
  tag-finder-selection --tag <spec>    — apply spec without prompting
                                         (spec is "Name" or "Name:color")
  tag-finder-selection trinity         — prompt for a trinity name and stamp a
                                         shared link-tag across every selected
                                         file (use when 2+ files belong together,
                                         e.g. conversation-md ↔ app ↔ skill)

Designed to be wired into menu-bar apps and Loupedeck buttons. Uses osascript
to query Finder for the current selection, dialog-prompts for the tag spec
when no --tag is given, then dispatches to `bin/tag`.
"""
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
TAG = HERE / "tag"


def osa(script):
    r = subprocess.run(["/usr/bin/osascript", "-e", script],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        sys.exit(1)
    return r.stdout.strip()


def get_finder_selection():
    """Return a list of POSIX paths currently selected in Finder."""
    script = '''
    tell application "Finder"
        set sel to selection
        if (count of sel) is 0 then return ""
        set out to ""
        repeat with i in sel
            set out to out & (POSIX path of (i as alias)) & linefeed
        end repeat
        return out
    end tell
    '''
    raw = osa(script)
    return [p for p in raw.splitlines() if p]


def prompt_for_spec():
    """Apple dialog asking the user for a tag spec."""
    script = '''
    tell application "System Events"
        activate
        set t to text returned of (display dialog "Tag spec — Name or Name:color (colors: gray green purple blue yellow red orange)" default answer "" with title "AppleToolbox — Tag")
        return t
    end tell
    '''
    return osa(script)


def notify(title, msg):
    subprocess.run(
        ["/usr/bin/osascript", "-e",
         f'display notification "{msg}" with title "{title}"'],
        capture_output=True, check=False,
    )


def main():
    args = sys.argv[1:]
    files = get_finder_selection()
    if not files:
        notify("Tag", "No Finder selection")
        sys.exit(1)

    if args and args[0] == "list":
        subprocess.run([str(TAG), "list"] + files)
        return
    if args and args[0] == "clear":
        subprocess.run([str(TAG), "clear"] + files)
        notify("Tag", f"cleared {len(files)} item(s)")
        return

    if args and args[0] == "trinity":
        if len(files) < 2:
            notify("Tag", "Trinity needs at least 2 files selected")
            sys.exit(1)
        script = ('tell application "System Events"\n'
                  '  activate\n'
                  '  set t to text returned of (display dialog '
                  '"Trinity name (e.g. tagging-tool-2026-05-21):" '
                  'default answer "" with title "AppleToolbox — Tag Trinity")\n'
                  '  return t\n'
                  'end tell')
        name = osa(script)
        if not name:
            sys.exit(0)
        subprocess.run([str(HERE / "tag-trinity"), name] + files, check=True)
        notify("Tag", f"trinity-{name} → {len(files)} item(s)")
        return

    spec = None
    if len(args) >= 2 and args[0] == "--tag":
        spec = args[1]
    else:
        spec = prompt_for_spec()
    if not spec:
        sys.exit(0)

    subprocess.run([str(TAG), "add", spec] + files, check=True)
    notify("Tag", f"{spec} → {len(files)} item(s)")


if __name__ == "__main__":
    main()
