#!/usr/bin/env bash
# apple-do — the SCRIPTABLE front door to the toolbox: pick a capability yourself,
# run it directly, get the answer. No FoundationModels, no LLM in the loop — the
# deterministic twin of `fm` (where the model picks the tool). Tab-completes and
# cycles the available capabilities (see apple-do-completion.sh).
#
#   apple-do                 list what it can do (name + one-line description)
#   apple-do <capability> …  run it
#   apple-do --complete      bare capability names, one per line (for completion)
#
# bash-3.2-safe: a case dispatch + a caps() registry, NO associative arrays.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

# ── registry: one line per capability  "name<TAB>description" ──
# This is the single source of truth for the list/completion. Keep names in sync
# with the case dispatch below.
caps() {
  printf '%s\n' \
"home	current temperature + humidity at home (HomePod sensor)" \
"address	your home address (Contacts me-card)" \
"directions	open Apple Maps with directions home — apple-do directions [walk|transit]" \
"findwife	open Find My on your wife (Olga) — \"find\" / \"where's my wife\"" \
"finddevices	open Find My on the Devices tab" \
"findphone	open Find My on your iPhone 16 Pro" \
"now	current date, time, weekday, timezone" \
"battery	battery level + charging state" \
"wifi	current Wi-Fi network" \
"clipboard	what's on the clipboard" \
"lock	lock the screen" \
"desktop	hide/show all Desktop icons — apple-do desktop [show]" \
"dock	hide the Dock (auto-hide) or show it — apple-do dock [show]" \
"dark	toggle dark / light mode" \
"sleep	put the display to sleep" \
"disk	disk space overview" \
"mute	toggle audio mute" \
"screenshot	screenshot to the clipboard" \
"eject	eject removable disks" \
"caffeinate	keep the Mac awake for an hour" \
"report	this Mac's hardware report" \
"mini	is the Mini/bridge reachable" \
"uptime	system uptime" \
"keywords	keywords from the clipboard text" \
"entities	named entities in the clipboard text" \
"sentiment	sentiment of the clipboard text" \
"fleet	live status of the Mini's workers (heartbeats)" \
"spotlight	find files by name via Spotlight — apple-do spotlight <query>" \
"search	semantic search of your notes (MiniLM, on the Mini) — apple-do search <query>" \
"ocr	extract text from a PDF/image (Vision) — apple-do ocr <file>"
}

if [ "${1:-}" = "--complete" ]; then caps | cut -f1; exit 0; fi
if [ $# -eq 0 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "--list" ]; then
  echo "apple-do — scriptable capabilities (no LLM). Press Tab to cycle:"
  caps | while IFS=$'\t' read -r n d; do printf '  %-11s %s\n' "$n" "$d"; done
  exit 0
fi

cap="$1"; shift
case "$cap" in
  home)   exec "$HERE/homepod-now" ;;
  address) exec "$HERE/me-address" ;;
  directions) exec "$HERE/maps-directions" "$@" ;;
  findwife)    exec "$HERE/find-my" people "Olga" ;;
  finddevices) exec "$HERE/find-my" devices ;;
  findphone)   exec "$HERE/find-my" devices "esaiPhone16Pro" ;;
  now)    date "+%A, %-d %B %Y, %H:%M %Z" ;;
  battery)
    pmset -g batt 2>/dev/null | grep -Eo '[0-9]+%; [a-z ]+' | head -1 || echo "battery info unavailable" ;;
  wifi)
    dev=$(networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi|AirPort/{getline; print $2; exit}')
    net=$(networksetup -getairportnetwork "${dev:-en0}" 2>/dev/null | sed 's/^Current Wi-Fi Network: //')
    [ -n "$net" ] && echo "$net" || echo "Wi-Fi network unavailable" ;;
  clipboard)
    c=$(pbpaste 2>/dev/null | head -c 800); [ -n "$c" ] && printf '%s\n' "$c" || echo "(clipboard is empty)" ;;
  lock)
    "/System/Library/CoreServices/Menu Extras/User.menu/Contents/Resources/CGSession" -suspend 2>/dev/null \
      && echo "Screen locked." || echo "lock: couldn't lock the screen." ;;
  desktop) exec "$HERE/desktop-icons" "$@" ;;
  dock)    exec "$HERE/dock-autohide" "$@" ;;
  dark)
    osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to not dark mode' 2>/dev/null
    m=$(osascript -e 'tell application "System Events" to tell appearance preferences to get dark mode' 2>/dev/null)
    [ "$m" = "true" ] && echo "Dark mode ON." || echo "Light mode ON." ;;
  sleep)  pmset displaysleepnow 2>/dev/null && echo "Display asleep." || echo "sleep: couldn't sleep the display." ;;
  disk)   exec "$HERE/disk-overview" ;;
  mute)
    osascript -e 'set volume output muted (not (output muted of (get volume settings)))' 2>/dev/null
    [ "$(osascript -e 'output muted of (get volume settings)' 2>/dev/null)" = "true" ] && echo "Muted." || echo "Unmuted." ;;
  screenshot) screencapture -c 2>/dev/null && echo "Screenshot copied to clipboard." || echo "screenshot: failed." ;;
  eject)
    osascript -e 'tell application "Finder" to eject (every disk whose ejectable is true)' 2>/dev/null \
      && echo "Ejected removable disks." || echo "eject: nothing ejectable." ;;
  caffeinate) nohup caffeinate -d -t 3600 >/dev/null 2>&1 & disown; echo "Staying awake for 1 hour." ;;
  report)  timeout 25 "$HERE/apple-report" 2>/dev/null | head -24 || echo "report unavailable" ;;
  mini)    timeout 15 "$HERE/bridge-doctor" 2>/dev/null | head -24 || echo "bridge check unavailable" ;;
  uptime)  uptime ;;
  keywords)  pbpaste 2>/dev/null | "$HERE/apple-keywords" 2>/dev/null | head -15 || echo "(nothing on the clipboard)" ;;
  entities)  pbpaste 2>/dev/null | "$HERE/apple-ner" 2>/dev/null | head -15 || echo "(nothing on the clipboard)" ;;
  sentiment) pbpaste 2>/dev/null | "$HERE/apple-sentiment" 2>/dev/null | head -10 || echo "(nothing on the clipboard)" ;;
  fleet)
    q="$HOME/work/comms/queue"; nowS=$(date +%s)
    for hb in "$q"/*-heartbeat.json; do
      [ -f "$hb" ] || continue
      name=$(basename "$hb" -heartbeat.json)
      age=$(( nowS - $(stat -f %m "$hb" 2>/dev/null || echo "$nowS") ))
      flag="ok"; [ "$age" -gt 180 ] && flag="STALE"
      printf '  %-26s %4ds ago  %s\n' "$name" "$age" "$flag"
    done | sort ;;
  spotlight)
    [ $# -gt 0 ] || { echo "usage: apple-do spotlight <query>"; exit 2; }
    mdfind -name "$*" 2>/dev/null | head -20 ;;
  search)
    [ $# -gt 0 ] || { echo "usage: apple-do search <query>"; exit 2; }
    # vault-rag's CoreML model lives on the Mini → run it there over SSH.
    ssh -o ConnectTimeout=6 cloudcity \
      "/Users/esaruoho/work/apple/bin/vault-rag \"$*\" --root /Users/esaruoho/work/apple/wiki --top 4" 2>/dev/null \
      || echo "apple-do: couldn't reach the Mini for semantic search." ;;
  ocr)
    [ $# -gt 0 ] || { echo "usage: apple-do ocr <file>"; exit 2; }
    exec "$HERE/vision-ocr" "$@" ;;
  *)
    echo "apple-do: unknown capability '$cap'"; echo "try: $(caps | cut -f1 | paste -sd' ' -)"; exit 2 ;;
esac
