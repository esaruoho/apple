#!/bin/bash
# recburnclick — `recburn`, plus a live click counter burned into the video.
#
# Everything recburn does — screen + system audio + MICROPHONE + webcam circle, then on
# stop flatten (YouTube-ready) + transcribe + burn subtitles — and on top of that a
# "CLICKS: n" badge composited into every frame. The number starts at 0 when recording
# starts and goes up on every left / right / middle mouse-down, so a demo video carries
# its own click count instead of you narrating it.
#
# It is recburn's settings, plus clicks. Nothing is taken away: --mic, --pip and --burn
# all still apply, because this simply chains to recburn.
#
# Usage:
#   recburnclick                        # the full screencast + click counter
#   recburnclick --clicks-corner br     # move the badge (tl default | tr | bl | br)
#   recburnclick --clicks-label TAPS    # relabel it
#   recburnclick --no-pip               # drop the webcam, keep mic + subtitles + clicks
#   recburnclick --app Renoise          # only that app's audio, still counting clicks
#
# The count needs NO Accessibility permission and installs no event tap: macOS already
# tallies mouse-downs per session (CGEventSource.counterForEventType), so the recorder
# just reads that number and subtracts its start-of-recording baseline.
#
# FEATURE-CARD >> features/recburnclick.feature

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$DIR/recburn" --clicks "$@"
