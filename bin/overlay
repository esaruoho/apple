#!/usr/bin/env python3
"""overlay — drive the spatial overlay canvas from the terminal.

The agent-facing half of Overlay.app (overlay/Overlay.swift). Python stdlib only —
no Homebrew, no pip — so anything on this Mac, or any Fleet peer with a shell, can
inspect and steer the overlay without a compile step.

P0 verbs:
    overlay open            launch Overlay.app (no-op if already running)
    overlay quit            quit it
    overlay status          is it running, how many marks, where the store is
    overlay dump [--json]   print the marks currently mirrored to disk
    overlay reveal          open the store folder in Finder

P1 verbs — the agent side:
    overlay post <kind> --rel X,Y,W,H [--text T] [--color #RRGGBB] [--ttl T] [--actor A]
    overlay post <kind> --rect X,Y,W,H          absolute pixels instead of 0..1
    overlay post <kind> --at X,Y                a single point (label / sticker)
    overlay post --stdin                        read one object, or an array, as JSON
    overlay kinds                               what can be posted
    overlay clear [--actor A]                   remove all marks, or one actor's
    overlay draw                                toggle draw mode
    overlay imagine [--prompt "..."]            generate a picture from the last
                                                region and draw it INTO the box
    overlay ask [--question "..."]              crop the LAST shape you drew,
                                                OCR it, ask a model, and post
                                                the answer at that region

Examples:
    overlay post box   --rel 0.1,0.2,0.3,0.1 --actor agent:fm --ttl ephemeral
    overlay post arrow --rect 400,300,200,150 --color '#FF3B30'
    overlay post callout --rel 0.5,0.5,0.1,0.1 --text "this is the stuck process"
    echo '[{"kind":"spotlight","rel":{"x":.3,"y":.3,"w":.4,"h":.3}}]' | overlay post --stdin

Coordinates are AppKit's: origin bottom-left, y grows upward. `--rel` is 0..1 of the
screen and is what an agent should prefer — it needs to know nothing about pixels.

Plan: wiki/operations/spatial-overlay-plan.md
"""

import json
import os
import subprocess
import sys
import time
import uuid

HOME = os.path.expanduser("~")
ROOT = os.path.join(HOME, ".overlay")
STORE = os.path.join(ROOT, "store")
SESSION = os.path.join(STORE, "session.json")
APP = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                   "overlay", "Overlay.app")
BUNDLE_ID = "com.esaruoho.overlay"


def running():
    """True if Overlay.app is up. pgrep -x matches the executable name exactly, so a
    stray `vim Overlay.swift` can't be mistaken for the app."""
    return subprocess.run(["/usr/bin/pgrep", "-x", "Overlay"],
                          capture_output=True).returncode == 0


def load():
    try:
        with open(SESSION) as fh:
            return json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


def cmd_open():
    if running():
        print("Overlay is already running.")
        return 0
    if not os.path.isdir(APP):
        print(f"Overlay.app not built yet — run {os.path.dirname(APP)}/build.sh",
              file=sys.stderr)
        return 1
    subprocess.run(["/usr/bin/open", APP], check=True)
    print("Overlay launched — ⌃⌥⌘D toggles draw mode.")
    return 0


def cmd_quit():
    if not running():
        print("Overlay is not running.")
        return 0
    # osascript 'quit app id' rather than kill: it lets the app finish its final
    # persist() instead of losing the last stroke.
    subprocess.run(["/usr/bin/osascript", "-e",
                    f'quit app id "{BUNDLE_ID}"'], capture_output=True)
    print("Overlay quit.")
    return 0


def cmd_status():
    marks = load()
    print(f"running   {'yes' if running() else 'no'}")
    print(f"app       {APP}")
    print(f"store     {SESSION}")
    print(f"marks     {len(marks)}")
    rejected = [f for f in os.listdir(INBOX)] if os.path.isdir(INBOX) else []
    bad = [f for f in rejected if f.endswith(".bad")]
    queued = [f for f in rejected if f.endswith(".json")]
    if queued:
        print(f"queued    {len(queued)} (not yet consumed — is Overlay running?)")
    if bad:
        print(f"rejected  {len(bad)} in {INBOX} (see the .error.txt beside each)")
    if marks:
        actors = {}
        for m in marks:
            actors[m.get("actor", "?")] = actors.get(m.get("actor", "?"), 0) + 1
        for actor, n in sorted(actors.items()):
            print(f"            {n:>4}  {actor}")
    return 0


def cmd_dump(as_json):
    marks = load()
    if as_json:
        print(json.dumps(marks, indent=2, sort_keys=True))
        return 0
    if not marks:
        print("(no marks)")
        return 0
    for m in marks:
        pts = m.get("points", [])
        # Swift encodes CGPoint as a two-element ARRAY, not {"x":..,"y":..}. Accept
        # both so a hand-written store file also dumps.
        def xy(p):
            if isinstance(p, dict):
                return p.get("x", 0), p.get("y", 0)
            return (p[0], p[1]) if len(p) >= 2 else (0, 0)
        pairs = [xy(p) for p in pts] or [(0, 0)]
        xs = [a for a, _ in pairs]
        ys = [b for _, b in pairs]
        box = f"{min(xs):.0f},{min(ys):.0f} {max(xs)-min(xs):.0f}x{max(ys)-min(ys):.0f}"
        print(f"{m.get('kind','?'):<8} {m.get('actor','?'):<12} "
              f"{len(pts):>4}pts  {m.get('colorHex','')}  "
              f"w{m.get('width','')}  [{box}]  {m.get('lifetime','')}"
              + (f"  \u201c{m['text']}\u201d" if m.get("text") else ""))
    return 0


def cmd_reveal():
    os.makedirs(STORE, exist_ok=True)
    subprocess.run(["/usr/bin/open", STORE])
    return 0


# ───────────────────────────── P1: the agent side ─────────────────────────────

INBOX = os.path.join(ROOT, "inbox")
KINDS = ["ink", "line", "arrow", "box", "highlight", "spotlight",
         "label", "callout", "sticker"]


def cmd_kinds():
    """The vocabulary, with what each kind's geometry means."""
    meanings = {
        "ink":       "a freehand polyline (--stdin points)",
        "line":      "tail -> head, no arrowhead",
        "arrow":     "tail -> head, arrowhead at the head",
        "box":       "an outlined rectangle",
        "highlight": "a translucent marker rectangle",
        "spotlight": "dim everything OUTSIDE the rectangle",
        "label":     "a text chip at a point            (needs --text)",
        "callout":   "a text chip with a leader line    (needs --text)",
        "sticker":   "text/emoji drawn large at a point (needs --text)",
    }
    for k in KINDS:
        print(f"  {k:<10} {meanings[k]}")
    print("\nttl: ephemeral (5s) | session | space | window | persistent")
    print("     posted objects default to 'session' so an agent cannot litter forever")
    return 0


def _numbers(flag, value, count):
    parts = [p for p in value.replace(" ", "").split(",") if p]
    if len(parts) != count:
        raise SystemExit(f"{flag} needs {count} comma-separated numbers, got {len(parts)}")
    try:
        return [float(p) for p in parts]
    except ValueError:
        raise SystemExit(f"{flag} must be numeric: {value}")


def _flag(argv, name, default=None):
    """Read `--name value`. Kept hand-rolled rather than argparse so the verb-first
    shape (`overlay post box --rel ...`) stays natural."""
    if name in argv:
        i = argv.index(name)
        if i + 1 >= len(argv):
            raise SystemExit(f"{name} needs a value")
        return argv[i + 1]
    return default


def deliver(payload):
    """Write one inbox file. The name is unique and the write is atomic (write to a
    dot-file, then rename) so the watcher can never read a half-written request."""
    os.makedirs(INBOX, exist_ok=True)
    stamp = f"{time.time():.6f}-{uuid.uuid4().hex[:8]}"
    final = os.path.join(INBOX, f"{stamp}.json")
    temp = os.path.join(INBOX, f".{stamp}.tmp")
    with open(temp, "w") as fh:
        json.dump(payload, fh, indent=2)
    os.rename(temp, final)
    return final


def report(path, timeout=2.0):
    """Wait briefly for the app's verdict. A consumed file means it went on screen; a
    .error.txt beside it means it was rejected and why."""
    if not running():
        print(f"queued {os.path.basename(path)} — Overlay is not running "
              f"(start it with: overlay open)")
        return 0
    err, bad = path + ".error.txt", path + ".bad"
    deadline = time.time() + timeout
    while time.time() < deadline:
        # Rejection is checked FIRST and again after the file vanishes: the app
        # writes the reason before renaming the request away, so "the file is gone"
        # alone does not mean it succeeded.
        if os.path.exists(err) or os.path.exists(bad):
            reason = "rejected"
            if os.path.exists(err):
                with open(err) as fh:
                    reason = f"rejected: {fh.read().strip()}"
            print(reason, file=sys.stderr)
            return 1
        if not os.path.exists(path):
            print("posted.")
            return 0
        time.sleep(0.05)
    print(f"queued {os.path.basename(path)} (no verdict within {timeout}s)")
    return 0


def cmd_post(argv):
    if "--stdin" in argv:
        try:
            payload = json.load(sys.stdin)
        except json.JSONDecodeError as e:
            print(f"stdin is not valid JSON: {e}", file=sys.stderr)
            return 2
        return report(deliver(payload))

    if len(argv) < 3 or argv[2].startswith("--"):
        print(f"usage: overlay post <kind> --rel|--rect X,Y,W,H | --at X,Y [...]\n"
              f"kinds: {', '.join(KINDS)}", file=sys.stderr)
        return 2

    kind = argv[2]
    if kind not in KINDS:
        print(f"unknown kind '{kind}' — expected one of {', '.join(KINDS)}",
              file=sys.stderr)
        return 2

    obj = {"kind": kind}
    if (v := _flag(argv, "--rel")):
        x, y, w, h = _numbers("--rel", v, 4)
        obj["rel"] = {"x": x, "y": y, "w": w, "h": h}
    elif (v := _flag(argv, "--rect")):
        obj["rect"] = _numbers("--rect", v, 4)
    elif (v := _flag(argv, "--at")):
        obj["at"] = _numbers("--at", v, 2)
    else:
        print("no geometry: give --rel, --rect or --at", file=sys.stderr)
        return 2

    for flag, key in (("--text", "text"), ("--color", "color"),
                      ("--actor", "actor"), ("--ttl", "ttl"),
                      ("--display", "display")):
        if (v := _flag(argv, flag)) is not None:
            obj[key] = v
    if (v := _flag(argv, "--width")) is not None:
        obj["width"] = float(v)

    return report(deliver(obj))


def control(name, payload=""):
    """Post a distributed notification via AppleScript-ObjC — the skill's tier-1
    default. No pip, no PyObjC, no socket."""
    script = f'''
    use framework "Foundation"
    current application's NSDistributedNotificationCenter's defaultCenter()'s ¬
        postNotificationName:"{name}" object:"{payload}" userInfo:(missing value) ¬
        deliverImmediately:true
    '''
    result = subprocess.run(["/usr/bin/osascript", "-e", script],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
    return result.returncode


def cmd_clear(argv):
    if not running():
        print("Overlay is not running.")
        return 0
    actor = _flag(argv, "--actor", "") or ""
    rc = control("com.esaruoho.overlay.clear", actor)
    print(f"cleared {actor or 'all marks'}.")
    return rc


def cmd_ask(argv):
    """Ask a model about the LAST thing drawn: crop that region of the screen, OCR it
    on-device, send it to the model, post the answer back as a callout at the region."""
    if not running():
        print("Overlay is not running.", file=sys.stderr)
        return 1
    if not load():
        print("nothing drawn yet — enter draw mode and drag a square around "
              "something first, then ask.", file=sys.stderr)
        return 1
    question = _flag(argv, "--question", "") or ""
    rc = control("com.esaruoho.overlay.ask", question)
    print("asking\u2026 blue callout = thinking, green = answered.")
    return rc


def cmd_chat():
    """Open the typing field, anchored to the last region."""
    if not running():
        print("Overlay is not running.", file=sys.stderr)
        return 1
    rc = control("com.esaruoho.overlay.chat")
    print("chat open \u2014 type a question, \u23ce sends, esc cancels.")
    return rc


def cmd_imagine(argv):
    """Generate a picture from the last selected region and drop it INTO that box."""
    if not running():
        print("Overlay is not running.", file=sys.stderr)
        return 1
    prompt = _flag(argv, "--prompt", "") or ""
    rc = control("com.esaruoho.overlay.imagine", prompt)
    print("imagining\u2026 Image Playground takes a while; the picture lands in the box.")
    return rc


def cmd_draw():
    if not running():
        print("Overlay is not running.", file=sys.stderr)
        return 1
    return control("com.esaruoho.overlay.draw")


def main(argv):
    verb = argv[1] if len(argv) > 1 else "status"
    if verb in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if verb == "open":
        return cmd_open()
    if verb == "quit":
        return cmd_quit()
    if verb == "status":
        return cmd_status()
    if verb == "dump":
        return cmd_dump("--json" in argv)
    if verb == "reveal":
        return cmd_reveal()
    if verb == "post":
        return cmd_post(argv)
    if verb == "kinds":
        return cmd_kinds()
    if verb == "clear":
        return cmd_clear(argv)
    if verb == "draw":
        return cmd_draw()
    if verb == "ask":
        return cmd_ask(argv)
    if verb == "imagine":
        return cmd_imagine(argv)
    if verb == "chat":
        return cmd_chat()
    print(f"unknown verb: {verb}\n", file=sys.stderr)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
