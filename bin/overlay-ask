#!/usr/bin/env python3
"""overlay-ask — the point of the overlay.

Takes a PNG crop of the screen region a human circled and returns ONE line of answer,
which Overlay.app renders as a callout pointing back at that region.

    overlay-ask <crop.png> [--question "what is wrong here?"] [--raw]

The chain, all Apple-native, no Homebrew, no pip, nothing leaves the LAN:

    crop.png
       │
       ├─ bin/vision-ocr      Apple Vision, Neural Engine, on THIS Mac.
       │                      Turns the pixels into text. For a whiteboard, a
       │                      terminal, an error dialog or a form, this is most of
       │                      the meaning.
       │
       └─ bin/fm-submit       Apple FoundationModels, on the Mini over Syncthing
                              (macOS 26 only, this laptop is 15.x). Reads the text
                              and answers the question.

If the model is unreachable the OCR itself is the answer — degraded, but still
useful, and it says so rather than pretending.

Exit 0 with the answer on stdout. Anything on stderr is diagnostics.
"""

import os
import subprocess
import sys
import shlex
import time

BIN = os.path.dirname(os.path.realpath(__file__))
DEFAULT_QUESTION = "What is this, and is anything wrong with it?"
# 4000 characters of OCR made the Mini chew for a minute and then return
# nothing. A highlighted passage is the thing being asked about, not a corpus.
OCR_LIMIT = 1200
TIMEOUT_OCR = 45
# Short on purpose. The model lives on the Mini across Syncthing, and when that
# transport is blocked (classically: this laptop under Syncthing's minDiskFree
# guard) a long timeout turns "no answer" into a two-minute hang with a "thinking…"
# bubble stuck on screen. Fail fast, say why, show the OCR.
TIMEOUT_MODEL = 60
# The direct path is fast or it is broken; there is no slow-but-fine case.
TIMEOUT_SSH = 30
HEALTH = os.path.expanduser("~/work/comms/queue/fm-health.json")
HEARTBEAT = os.path.expanduser("~/work/comms/queue/fm-worker-heartbeat.json")
STALE_AFTER = 120       # seconds; the worker beats every few seconds when alive


def run(argv, timeout, stdin_text=None):
    """Run a tool, return (ok, output). Never raises — a broken link in the chain
    must degrade to a readable message, not a traceback on the user's screen."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True,
                           timeout=timeout, input=stdin_text)
        out = (p.stdout or "").strip()
        if p.returncode != 0:
            return False, (p.stderr or out or f"exit {p.returncode}").strip()
        return True, out
    except subprocess.TimeoutExpired:
        return False, f"timed out after {timeout}s"
    except FileNotFoundError:
        return False, f"{argv[0]} not found"
    except Exception as e:                                  # noqa: BLE001
        return False, str(e)


def ocr(png):
    ok, text = run([os.path.join(BIN, "vision-ocr"), png], TIMEOUT_OCR)
    if not ok:
        print(f"overlay-ask: OCR failed: {text}", file=sys.stderr)
        return ""
    return text.strip()


def classify(png, floor=0.25, keep=6):
    """What the region LOOKS like, via Vision's image classifier.

    OCR alone answers "what does it say", which is the wrong question for a
    whiteboard, a diagram or a photo — exactly the case this whole overlay exists
    for. Apple's on-device FoundationModels is text-only and cannot see a picture,
    so classification labels are how a drawing gets described to it at all. Shallow
    compared to a real vision-language model, but on-device, instant, and honest."""
    ok, out = run([os.path.join(BIN, "vision-ocr"), "--classify", png], TIMEOUT_OCR)
    if not ok:
        return []
    labels = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 2:
            continue
        try:
            score = float(parts[1])
        except ValueError:
            continue
        if score >= floor:
            labels.append(f"{parts[0]} ({score:.2f})")
    return labels[:keep]


def model_reachable():
    """Is the Mini's FoundationModels worker actually going to answer?

    Checked BEFORE submitting, because the failure is common and silent: the
    heartbeat is a Syncthing-mirrored file, so a stale one means either the worker
    stopped or the transport is blocked. Either way, submitting would just hang.
    Returns (ok, reason)."""
    try:
        age = time.time() - os.path.getmtime(HEARTBEAT)
    except OSError:
        return False, "no FM worker heartbeat on this machine"
    if age > STALE_AFTER:
        return False, (f"FM worker heartbeat is {int(age)}s stale — the Mini or the "
                       f"Syncthing bridge is down (try: bridge-doctor)")
    return True, ""


def ask_model(question, seen, looks):
    """Ask the on-device model on whichever node has FoundationModels.

    fm-submit routes to the Mini over Syncthing, so this works from the laptop even
    though the laptop itself is too old for FoundationModels."""
    # Plain language, and NO mention of tools, functions or readings. The previous
    # version said "do not mention tools", which is itself tool-talk: the model
    # answered with literal tool_call JSON on Esa's screen. You cannot tell a model
    # not to think about an elephant.
    seen_block = seen[:OCR_LIMIT] if seen else ""
    if seen_block:
        prompt = (f"Text on a screen:\n\n{seen_block}\n\n"
                  f"{question}\n\n"
                  "Answer in one plain English sentence. No lists, no JSON, no code, "
                  "no explanation of how you decided.")
    else:
        prompt = (f"A picture that looks like: {', '.join(looks)}.\n\n"
                  f"{question}\n\n"
                  "Answer in one plain English sentence.")

    # A system instruction is what actually stops FoundationModels emitting
    # tool_call JSON. Putting "do not mention tools" in the user prompt made it
    # WORSE — the model answered with literal function syntax on screen.
    def clean(text):
        """Strip the model's scaffolding: bracketed preambles, hallucinated tool
        calls, "Sure, here's:" openers, wrapping quotes."""
        import re
        text = re.sub(r"^\s*\[[^\]]{0,200}\]\s*", "", text)
        text = re.sub(r"tool_call\s*:.*", " ", text, flags=re.S)
        text = re.sub(r"^\s*(sure|certainly|here'?s?[^:]{0,40}):\s*", "", text,
                      flags=re.I)
        return " ".join(text.strip().strip('"').strip().split())

    def is_machinery(text):
        """Would this look like junk on screen? Then it is not an answer, and the
        OCR text is shown instead — worse to print function syntax than plain text."""
        if not text or len(text) < 3:
            return True
        lowered = text.lower()
        if "tool_call" in lowered or '"function"' in lowered or '"args"' in lowered:
            return True
        if text.lstrip().startswith(("{", "[")):
            return True
        letters = sum(c.isalpha() or c.isspace() for c in text)
        return letters / max(1, len(text)) < 0.7

    system = ("You are a plain-text assistant. Reply with one short English "
              "sentence. Never output JSON, tool calls, function names or braces.")

    # Transport order matters more than anything else here.
    #
    # fm-submit goes through the Syncthing queue, which is excellent for deploys and
    # unbounded for a question: measured at 50s+ and frequently no answer at all,
    # because the reply file waits behind whatever else is syncing. A direct SSH call
    # to the same model on the same Mini answers in ~5s. Interactive work gets the
    # direct path; the queue stays as the fallback for when SSH is unreachable.
    #
    # Bounded, BatchMode, absolute path, never backgrounded — the conditions the
    # cloudcity rule sets for using SSH at all.
    began = time.time()
    ok, out = run(["/usr/bin/ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
                   "cloudcity", f"/Users/esaruoho/work/apple/bin/fm --system {shlex.quote(system)} "
                                f"{shlex.quote(prompt)}"], TIMEOUT_SSH)
    print(f"overlay-ask: ssh fm took {time.time() - began:.1f}s ok={ok}", file=sys.stderr)
    if ok and out:
        answer = clean(out)
        if not is_machinery(answer):
            return answer

    # Only fall back to the queue if it is actually alive; otherwise this is a
    # guaranteed 60-second wait for nothing.
    fresh, why = model_reachable()
    if not fresh:
        print(f"overlay-ask: skipping the queue — {why}", file=sys.stderr)
        return ""

    for tool in ("fm-submit", "fm"):
        path = os.path.join(BIN, tool)
        if not os.path.exists(path):
            continue
        began = time.time()
        ok, out = run([path, "--system", system, prompt], TIMEOUT_MODEL)
        print(f"overlay-ask: {tool} took {time.time() - began:.1f}s ok={ok} "
              f"chars_in={len(prompt)}", file=sys.stderr)
        if ok and out:
            answer = clean(out)
            if not is_machinery(answer):
                return answer
            print(f"overlay-ask: {tool} returned machinery, not an answer: "
                  f"{out[:120]}", file=sys.stderr)
        print(f"overlay-ask: {tool} unavailable: {out}", file=sys.stderr)
    return ""


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0

    png = argv[1]
    if not os.path.exists(png):
        print(f"no such crop: {png}", file=sys.stderr)
        return 2

    question = DEFAULT_QUESTION
    if "--question" in argv:
        i = argv.index("--question")
        if i + 1 < len(argv):
            question = argv[i + 1]

    seen = ocr(png)
    looks = classify(png)
    if "--raw" in argv:
        print(seen)
        if looks:
            print("\nlooks like: " + ", ".join(looks))
        return 0

    if not seen and not looks:
        print("Nothing readable and nothing recognisable in that region.")
        return 0

    # The heartbeat describes the SYNCTHING queue, and SSH does not use it. Gating
    # on it meant a lagging file share disabled the fast direct path too — the
    # model was up and answering in 4s, and we never called it.
    answer = ask_model(question, seen, looks)
    _, why = model_reachable()
    if answer:
        print(answer)
    else:
        # Degrade honestly — but CONTENT FIRST. The callout is one short line, and a
        # long diagnostic prefix ate the whole thing: Esa saw the excuse and none of
        # what was actually read. The reason is a short tag at the end instead, and
        # the full explanation goes to stderr for whoever is debugging.
        print(f"overlay-ask: {why}", file=sys.stderr)
        tag = "no model reachable" if why else "model gave no answer"
        if seen:
            print(" ".join(seen.split())[:120] + f"  ⟨{tag}⟩")
        else:
            print("looks like: " + ", ".join(looks[:4]) + f"  ⟨{tag}⟩")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
