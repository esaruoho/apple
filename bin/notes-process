#!/usr/bin/env python3
"""notes-process — #process hashtag in Apple Notes → Cloudcity LLM reply, APPEND-ONLY.

Report card: features/notes-process.feature

Type   hello world #process   in a note (a real orange Notes tag, or plain text).
On the next pass:
  1. that line's text (minus the tag) is sent VERBATIM to the LLM
     (default `notes-brain`: Flubuild Qwen → MLX Qwen → Apple FM; override --llm).
     A line that is only the tag sends the whole note text above it.
  2. the reply (markdown) is added as RICH TEXT, never by rewriting the note:
       a) APPEND via the Shortcut named --shortcut (default "notes-process-append",
          actions: Get Dictionary from Input → Make Rich Text from Markdown →
          Find Notes (Name is title) → Append to Note) — only when the note's
          title is unique, so it cannot append to the wrong note;
       b) otherwise a NEW linked note "Re: <title>" via bin/notes-new.
  3. the reply ends with a "#done" line, and the tag occurrence is logged in a
     ledger keyed by the tag object's own identifier → it never fires twice.
     The reply is sanitised so it can never contain the trigger tag.

Never: `set body` on an existing note, keystrokes, or writes to NoteStore.sqlite
(it is opened READ-ONLY, mode=ro, to find real hashtag objects).

Usage:
  notes-process --once [--dry-run]
  notes-process --watch 60        (on the Mini: run under Cloudcity-Boot, never nohup)
  notes-process --tag '#ask' --done-tag '#answered' --once
"""
import argparse, datetime, hashlib, json, os, re, shlex, sqlite3, subprocess, sys, tempfile, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
STATE = Path(os.environ.get('NOTES_PROCESS_HOME', Path.home() / '.local/share/notes-process'))
DB = Path.home() / 'Library/Group Containers/group.com.apple.notes/NoteStore.sqlite'
OBJ = '￼'  # how an inline object (tag) appears in Notes' plaintext
HASHTAG_UTI = 'com.apple.notes.inlinetextattachment.hashtag'


def log(m):
    print(f'[{datetime.datetime.now():%H:%M:%S}] {m}', flush=True)


def tag_re(tag):
    return re.compile(re.escape(tag) + r'(?![\w-])', re.IGNORECASE)


# ---------- discovery (read-only) ----------
def db():
    return sqlite3.connect(f'file:{DB}?mode=ro', uri=True, timeout=5)


def find_occurrences(tag):
    """Each tag occurrence → dict(key, pk, title, folder, locked, kind). Real tag objects
    are keyed by their own ZIDENTIFIER; plain-text tags by (note, line) later."""
    out = []
    with db() as c:
        store = c.execute('select Z_UUID from Z_METADATA').fetchone()[0]
        q = '''select a.ZIDENTIFIER, n.Z_PK, n.ZTITLE1, f.ZTITLE2, f.ZFOLDERTYPE,
                      coalesce(n.ZISPASSWORDPROTECTED,0)
               from ZICCLOUDSYNCINGOBJECT a
               join ZICCLOUDSYNCINGOBJECT n on n.Z_PK = a.ZNOTE1
               left join ZICCLOUDSYNCINGOBJECT f on f.Z_PK = n.ZFOLDER
               where a.ZTYPEUTI1 = ? and lower(a.ZALTTEXT) = lower(?)
                 and coalesce(a.ZMARKEDFORDELETION,0) = 0
                 and coalesce(n.ZMARKEDFORDELETION,0) = 0'''
        for ident, pk, title, folder, ftype, locked in c.execute(q, (HASHTAG_UTI, tag)):
            out.append(dict(key=f'tag:{ident}', pk=pk, title=title or '', folder=folder or '',
                            trash=(ftype == 1), locked=bool(locked), kind='tag',
                            nid=f'x-coredata://{store}/ICNote/p{pk}'))
    return out


def title_count(title):
    with db() as c:
        return c.execute('''select count(*) from ZICCLOUDSYNCINGOBJECT
                            where ZTITLE1 = ? and coalesce(ZMARKEDFORDELETION,0)=0''',
                         (title,)).fetchone()[0]


def osa(script, *args, timeout=60):
    r = subprocess.run(['osascript', '-', *args], input=script, capture_output=True,
                       text=True, timeout=timeout)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip())
    return r.stdout.rstrip('\n')


INFO = '''on run argv
  tell application "Notes"
    set n to note id (item 1 of argv)
    return ((((current date) - (modification date of n)) as integer) as text) & (ASCII character 31) & (plaintext of n)
  end tell
end run'''

PLAINTEXT_FIND = '''on run argv
  set out to ""
  tell application "Notes"
    repeat with n in (every note whose plaintext contains (item 1 of argv))
      set out to out & (id of n) & linefeed
    end repeat
  end tell
  return out
end run'''


# ---------- prompt extraction (pure, tested) ----------
def prompts_for(plain, tag, kind):
    """Lines that carry the trigger. kind='tag' → line holds the object char U+FFFC;
    kind='text' → line holds the literal tag. Returns [(line, prompt)]."""
    lines = plain.splitlines()
    rx = tag_re(tag)
    hit = (lambda l: OBJ in l) if kind == 'tag' else (lambda l: bool(rx.search(l)))
    out = []
    for i, line in enumerate(lines):
        if not hit(line):
            continue
        stripped = rx.sub('', line).replace(OBJ, '').strip()
        prompt = stripped or '\n'.join(l.replace(OBJ, '') for l in lines[1:i]
                                       if not hit(l)).strip()
        if prompt:
            out.append((line.strip(), prompt))
    return out


def sanitize(reply, tag):
    return tag_re(tag).sub(lambda m: '#⁠' + m.group(0)[1:], reply)


def reply_markdown(reply, llm_name, done_tag):
    stamp = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    return f'\n---\n\n**🤖 {llm_name} · {stamp}**\n\n{reply.strip()}\n\n{done_tag}\n'


# ---------- ledger ----------
def ledger():
    p = STATE / 'ledger.jsonl'
    return {json.loads(l)['key'] for l in p.read_text().splitlines() if l.strip()} if p.exists() else set()


def ledger_add(rec):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / 'ledger.jsonl', 'a') as f:
        f.write(json.dumps(rec, ensure_ascii=False) + '\n')


# ---------- LLM + writers ----------
def call_llm(cmd, prompt, timeout, context=''):
    argv = shlex.split(cmd)
    if context and Path(argv[0]).name in ('fmremote', 'notes-brain'):  # verbatim prompt; earlier note text as context
        argv[1:1] = ['--system', 'Earlier in this note (context for the question):\n' + context[-6000:]]
    r = subprocess.run(argv, input=prompt, capture_output=True, text=True,
                       timeout=timeout, cwd=str(HERE.parent))
    if r.returncode != 0 or not r.stdout.strip():
        raise RuntimeError(f'llm failed rc={r.returncode}: {r.stderr.strip()[-300:]}')
    route = next((l[6:] for l in r.stderr.splitlines() if l.startswith('route=')), '')
    return r.stdout.strip(), route


def shortcut_installed(name):
    if not name:
        return False
    r = subprocess.run(['shortcuts', 'list'], capture_output=True, text=True, timeout=30)
    return name in r.stdout.splitlines()


def append_via_shortcut(name, title, md):
    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False, encoding='utf-8') as f:
        json.dump({'title': title, 'markdown': md}, f, ensure_ascii=False)
    try:  # a dialog means the Shortcut is broken; never let it hang the loop
        r = subprocess.run(['shortcuts', 'run', name, '--input-path', f.name],
                           capture_output=True, text=True, timeout=45)
    finally:
        os.unlink(f.name)
    if r.returncode != 0:
        raise RuntimeError(f'shortcut failed: {r.stderr.strip()[-300:]}')


def reply_title(title, tag='#process', done_tag='#done'):
    """One clean thread title: 'Re: <root>' — never 'Re: Re:', never carrying the tags."""
    t = title
    while t.lower().startswith('re: '):
        t = t[4:]
    t = tag_re(tag).sub('', t)
    t = tag_re(done_tag).sub('', t)
    return 'Re: ' + (' '.join(t.split()) or 'note')


def linked_note(title, md, account, folder):
    r = subprocess.run([str(HERE / 'notes-new'), '--title', reply_title(title), '--account', account,
                        '--folder', folder, '-'], input=md, capture_output=True, text=True,
                       timeout=90)
    if r.returncode != 0:
        raise RuntimeError(f'notes-new failed: {r.stderr.strip()}')
    return r.stdout.strip()


# ---------- pass ----------
def handle(occ, a, seen, use_shortcut):
    label = f'"{occ["title"]}" [{occ["folder"]}]'
    if occ.get('trash'):
        return log(f'skip {label}: Recently Deleted')
    if occ.get('locked'):
        return log(f'skip {label}: password-protected')
    age, plain = osa(INFO, occ['nid']).split('\x1f', 1)
    if int(age) < a.settle:
        return log(f'wait {label}: edited {age}s ago (< {a.settle}s)')
    found = prompts_for(plain, a.tag, occ['kind'])
    if occ['kind'] == 'text':
        found = [(l, p) for l, p in found
                 if f'text:{occ["nid"]}:{hashlib.sha256(l.encode()).hexdigest()[:16]}' not in seen]
    if not found:
        return log(f'skip {label}: no trigger line found')
    line, prompt = found[0]
    key = occ['key'] if occ['kind'] == 'tag' else \
        f'text:{occ["nid"]}:{hashlib.sha256(line.encode()).hexdigest()[:16]}'
    if key in seen:
        return
    unique = title_count(occ['title']) == 1
    how = 'append (Shortcut)' if (use_shortcut and unique) else 'linked note "Re: …"'
    if a.dry_run:
        return log(f'DRY {label}: send {prompt!r} → {how}')
    log(f'send {label}: {prompt[:80]!r}')
    lines = plain.replace(OBJ, '').splitlines()
    idx = next((i for i, l in enumerate(plain.splitlines()) if l.strip() == line), len(lines))
    context = '\n'.join(lines[:idx]).strip()
    if prompt in context:
        context = ''
    reply, route = call_llm(a.llm, prompt, a.llm_timeout, context)
    reply = sanitize(reply, a.tag)
    md = reply_markdown(reply, f'{a.label} · {route.split("/")[-1]}' if route else a.label, a.done_tag)
    if use_shortcut and unique:
        append_via_shortcut(a.shortcut, occ['title'], md)
        header = next(l for l in md.splitlines() if l.startswith('**🤖')).strip('* ')  # "🤖 label · stamp"
        after = osa(INFO, occ['nid']).split('\x1f', 1)[1]
        where = 'appended in note' if header in after else 'APPEND NOT VERIFIED (logged, not retried)'
    else:
        if use_shortcut and not unique:
            log(f'note title not unique → linked note instead of append')
        where = 'linked note ' + linked_note(occ['title'], md, a.reply_account, a.reply_folder)
    seen.add(key)
    ledger_add({'key': key, 'note': occ['nid'], 'title': occ['title'], 'line': line,
                'at': datetime.datetime.now().isoformat(timespec='seconds'), 'where': where})
    log(f'done {label}: {where}')


def one_pass(a):
    seen = ledger()
    occs = [o for o in find_occurrences(a.tag) if o['key'] not in seen]
    if a.plain_text:
        ids = [i for i in osa(PLAINTEXT_FIND, a.tag, timeout=120).splitlines() if i.strip()]
        occs += [dict(key=None, nid=i, kind='text', title=osa(
            'on run argv\ntell application "Notes" to return name of note id (item 1 of argv)\nend run', i),
            folder='') for i in ids]
    if not occs:
        return log(f'nothing new for {a.tag}')
    use_shortcut = shortcut_installed(a.shortcut)
    if not use_shortcut:
        log(f'Shortcut "{a.shortcut}" not installed → replies go to linked notes')
    for o in occs:
        try:
            handle(o, a, seen, use_shortcut)
        except Exception as e:
            log(f'error {o.get("title")}: {e}')


def main():
    ap = argparse.ArgumentParser(description='#process tag in Notes → LLM reply, append-only.')
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument('--once', action='store_true')
    g.add_argument('--watch', type=int, metavar='SECONDS')
    ap.add_argument('--tag', default='#process')
    ap.add_argument('--done-tag', default='#done')
    ap.add_argument('--llm', default=f'{HERE}/notes-brain')
    ap.add_argument('--llm-timeout', type=int, default=240)
    # OFF by default (2026-11-08): the generated Shortcut's Find Notes → Append to Note binding
    # does not carry over, so Shortcuts shows a "which note?" picker of ALL notes. Unacceptable.
    # Only pass --shortcut once an append is proven dialog-free.
    ap.add_argument('--shortcut', default='')
    ap.add_argument('--label', default='Cloudcity')
    ap.add_argument('--reply-account', default='iCloud')
    ap.add_argument('--reply-folder', default='Notes')
    ap.add_argument('--plain-text', action='store_true',
                    help='also catch the tag typed as plain text (not an orange tag)')
    ap.add_argument('--settle', type=int, default=15)
    ap.add_argument('--dry-run', action='store_true')
    a = ap.parse_args()
    if not a.tag.startswith('#') or tag_re(a.tag).search(a.done_tag):
        sys.exit('tag must start with # and the done tag must not contain it')
    if a.watch is not None and a.watch < 30:
        sys.exit('--watch must be >= 30 seconds')
    if a.once:
        return one_pass(a)
    while True:
        one_pass(a)
        time.sleep(a.watch)


if __name__ == '__main__':
    main()
