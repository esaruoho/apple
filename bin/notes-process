#!/usr/bin/env python3
"""notes-process — #process hashtag in Apple Notes → Cloudcity LLM reply, APPEND-ONLY.

Report card: features/notes-process.feature

Type   hello world #process   in a note (a real orange Notes tag, or plain text).
On the next pass:
  1. the complete stored note text and on-Mini Apple Vision image OCR/classification
     are saved under a unique Processing ID, then sent to notes-brain.
     The first paragraph is preserved, even when Notes treats it as the title.
  2. the reply (markdown) is added as RICH TEXT, never by rewriting the note:
       a) APPEND via the Shortcut named --shortcut (default "notes-process-append",
          actions: Get Dictionary from Input → Make Rich Text from Markdown →
          Find Notes (Name is title) → Append to Note) — only when the note's
          title is unique, so it cannot append to the wrong note;
       b) otherwise a NEW linked note "Re: <title>" via bin/notes-new.
  3. the reply includes the Processing ID and the complete original text, then
     ends with a "#done" line, and the tag occurrence is logged in a
     ledger keyed by the tag object's own identifier → it never fires twice.
     The reply is sanitised so it can never contain the trigger tag.

Never: `set body` on an existing note, keystrokes, or writes to NoteStore.sqlite
(it is opened READ-ONLY, mode=ro, to find real hashtag objects).

Usage:
  notes-process --once [--dry-run]
  notes-process --watch 60        (on the Mini: run under Cloudcity-Boot, never nohup)
  notes-process --tag '#ask' --done-tag '#answered' --once
"""
import argparse, datetime, fcntl, hashlib, json, os, re, shlex, sqlite3, subprocess, sys, tempfile, time
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import notes_input

HERE = Path(__file__).resolve().parent
STATE = Path(os.environ.get('NOTES_PROCESS_HOME', Path.home() / '.local/share/notes-process'))
DB = Path.home() / 'Library/Group Containers/group.com.apple.notes/NoteStore.sqlite'
OBJ = '￼'  # how an inline object (tag) appears in Notes' plaintext
HASHTAG_UTI = 'com.apple.notes.inlinetextattachment.hashtag'


def log(m):
    print(f'[{datetime.datetime.now():%H:%M:%S}] {m}', flush=True)


def tag_re(tag):
    return re.compile(re.escape(tag) + r'(?![\w-])', re.IGNORECASE)


# ---------- discovery (read-only) ----------
def db():
    return sqlite3.connect(f'file:{DB}?mode=ro', uri=True, timeout=5)


def find_occurrences(tag):
    """Each tag occurrence → dict(key, pk, title, folder, locked, kind). Real tag objects
    are keyed by their own ZIDENTIFIER; plain-text tags by (note, line) later."""
    out = []
    with db() as c:
        store = c.execute('select Z_UUID from Z_METADATA').fetchone()[0]
        q = '''select a.ZIDENTIFIER, n.Z_PK, n.ZTITLE1, f.ZTITLE2, f.ZFOLDERTYPE,
                      coalesce(n.ZISPASSWORDPROTECTED,0)
               from ZICCLOUDSYNCINGOBJECT a
               join ZICCLOUDSYNCINGOBJECT n on n.Z_PK = a.ZNOTE1
               left join ZICCLOUDSYNCINGOBJECT f on f.Z_PK = n.ZFOLDER
               where a.ZTYPEUTI1 = ? and lower(a.ZALTTEXT) = lower(?)
                 and coalesce(a.ZMARKEDFORDELETION,0) = 0
                 and coalesce(n.ZMARKEDFORDELETION,0) = 0'''
        for ident, pk, title, folder, ftype, locked in c.execute(q, (HASHTAG_UTI, tag)):
            out.append(dict(key=f'tag:{ident}', pk=pk, title=title or '', folder=folder or '',
                            trash=(ftype == 1), locked=bool(locked), kind='tag',
                            nid=f'x-coredata://{store}/ICNote/p{pk}'))
    return out


def title_count(title):
    with db() as c:
        return c.execute('''select count(*) from ZICCLOUDSYNCINGOBJECT
                            where ZTITLE1 = ? and coalesce(ZMARKEDFORDELETION,0)=0''',
                         (title,)).fetchone()[0]


NOTES_TIMEOUTS = 0  # consecutive osascript timeouts → heal_notes() after 2


def notes_pids():
    r = subprocess.run(['pgrep', '-x', 'Notes'], capture_output=True, text=True)
    return [int(p) for p in r.stdout.split()]


def heal_notes(force=False, quiet=False):
    """Keep Notes.app answering, unattended (2026-11-09: Mini Notes wedged 16 days at 76% CPU).
    Not running → start it in the background (-g: no window pops forward).
    force (2 timeouts in a row) → quit it, force-kill if it won't, restart in the background.
    Safe: notes live in iCloud/NoteStore; quitting Notes loses nothing."""
    pids = notes_pids()
    if force and pids:
        log(f'{"iCloud refresh" if quiet else "Notes not answering"} → restarting Notes (pids {pids})')
        for pid in pids:
            subprocess.run(['kill', '-TERM', str(pid)])
        for _ in range(10):
            if not notes_pids():
                break
            time.sleep(1)
        for pid in notes_pids():
            subprocess.run(['kill', '-KILL', str(pid)])
        pids = []
    if not pids:
        subprocess.run(['open', '-g', '-a', 'Notes'])
        time.sleep(4 if quiet else 8)
        if not quiet:
            log('Notes started in the background')


def osa(script, *args, timeout=25):
    global NOTES_TIMEOUTS
    try:
        r = subprocess.run(['osascript', '-', *args], input=script, capture_output=True,
                           text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        NOTES_TIMEOUTS += 1
        if NOTES_TIMEOUTS >= 2:
            NOTES_TIMEOUTS = 0
            heal_notes(force=True)
        raise
    NOTES_TIMEOUTS = 0
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip())
    return r.stdout.rstrip('\n')


INFO = '''on run argv
  tell application "Notes"
    set n to note id (item 1 of argv)
    return ((((current date) - (modification date of n)) as integer) as text) & (ASCII character 31) & (plaintext of n)
  end tell
end run'''

PLAINTEXT_FIND = '''on run argv
  set out to ""
  tell application "Notes"
    repeat with n in (every note whose plaintext contains (item 1 of argv))
      set out to out & (id of n) & linefeed
    end repeat
  end tell
  return out
end run'''


def _latex():
    import importlib.machinery, importlib.util
    ldr = importlib.machinery.SourceFileLoader('latex2unicode', str(HERE / 'latex2unicode'))
    m = importlib.util.module_from_spec(importlib.util.spec_from_loader('latex2unicode', ldr))
    ldr.exec_module(m)
    return m


def sanitize(reply, tag):
    # Notes can't render TeX (2026-11-11: \\frac / \\mathcal showed raw) → Unicode math first.
    try:
        reply = _latex().convert(reply)
    except Exception as e:
        log(f'latex2unicode failed (reply kept raw): {e}')
    return tag_re(tag).sub(lambda m: '#⁠' + m.group(0)[1:], reply)


def reply_markdown(reply, llm_name, done_tag):
    stamp = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    return f'\n---\n\n**🤖 {llm_name} · {stamp}**\n\n{reply.strip()}\n\n{done_tag}\n'


# ---------- ledger ----------
# REPORT-CARD >> features/notes-process.feature
_LEDGER_WARNED = set()


def ledger():
    p = STATE / 'ledger.jsonl'
    try:
        with p.open('rb') as f:
            fcntl.flock(f, fcntl.LOCK_SH)
            data = f.read()
    except FileNotFoundError:
        return set()
    seen, damaged = set(), []
    # JSONL uses LF only. str.splitlines() also splits U+2028/U+2029/NEL
    # inside perfectly valid JSON strings (e.g. pasted Notes titles).
    for n, raw in enumerate(data.split(b'\n'), 1):
        if not raw.strip():
            continue
        try:
            rec = json.loads(raw)
            if not isinstance(rec, dict) or not isinstance(rec.get('key'), str) or not rec['key']:
                raise ValueError('record needs a nonempty string key')
            seen.add(rec['key'])
        except (ValueError, UnicodeError):
            damaged.append(n)
            # Our writer puts key first. Preserve a complete key even if later
            # fields were torn, so an already answered note isn't replayed.
            prefix = re.match(rb'\s*\{\s*"key"\s*:\s*', raw)
            if prefix:
                try:
                    key, end = json.JSONDecoder().raw_decode(raw[prefix.end():].decode('utf-8', errors='replace'))
                    rest = raw[prefix.end():].decode('utf-8', errors='replace')[end:].lstrip()
                    if isinstance(key, str) and key and rest.startswith((',', '}')):
                        seen.add(key)
                except ValueError:
                    pass
    if damaged:
        digest = hashlib.sha256(data).hexdigest()
        backup = STATE / f'ledger.corrupt-{digest}.bin'
        try:
            with backup.open('xb') as f:
                f.write(data)
        except FileExistsError:
            pass
        if digest not in _LEDGER_WARNED:
            log(f'ledger: damaged records at lines {damaged}; original preserved at {backup}; continuing with {len(seen)} keys')
            _LEDGER_WARNED.add(digest)
    return seen


class Deferred(Exception):
    """The brain is throttled (429). The note waits DEFER_SECONDS and is retried, never thin-answered."""


DEFER_SECONDS = int(os.environ.get('NOTES_DEFER_SECONDS', '3600'))


def deferred():
    """{tag key: retry-at epoch} for notes parked by a 429 (STATE/deferred.json)."""
    try:
        return json.loads((STATE / 'deferred.json').read_text())
    except (OSError, ValueError):
        return {}


def set_deferred(key, until=None):
    d = deferred()
    if until is None:
        d.pop(key, None)
    else:
        d[key] = until
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / 'deferred.json.tmp'
    tmp.write_text(json.dumps(d, indent=1))
    tmp.replace(STATE / 'deferred.json')


def ledger_add(rec):
    STATE.mkdir(parents=True, exist_ok=True)
    # Shared by #process and #consensus. Lock readers/writers against partial
    # reads and concurrent appends; terminate a torn tail before the next row.
    with open(STATE / 'ledger.jsonl', 'a+b') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0, os.SEEK_END)
        if f.tell():
            f.seek(-1, os.SEEK_END)
            if f.read(1) != b'\n':
                f.write(b'\n')
        f.write((json.dumps(rec, ensure_ascii=True) + '\n').encode('utf-8'))
        f.flush()
        os.fsync(f.fileno())


# ---------- LLM + writers ----------
def call_llm(cmd, prompt, timeout, context='', audit_dir=None):
    argv = shlex.split(cmd)
    if context and Path(argv[0]).name in ('fmremote', 'notes-brain'):  # verbatim prompt; earlier note text as context
        argv[1:1] = ['--system', 'Earlier in this note (context for the question):\n' + context]
    env = os.environ.copy()
    attempt = None
    if audit_dir:
        attempt = Path(audit_dir) / ('model-%03d' % (len(list(Path(audit_dir).glob('model-*'))) + 1))
        attempt.mkdir()
        env['NOTES_PROCESS_AUDIT_DIR'] = str(attempt)
        notes_input.save_json(attempt / 'request.json', dict(argv=argv, stdin=prompt, timeout=timeout))
        (attempt / 'prompt.txt').write_text(prompt, encoding='utf-8')
    try:
        r = subprocess.run(argv, input=prompt, capture_output=True, text=True,
                           timeout=timeout, cwd=str(HERE.parent), env=env)
    except Exception as e:
        if attempt:
            notes_input.save_json(attempt / 'error.json', dict(error=str(e), type=type(e).__name__))
        raise
    if attempt:
        notes_input.save_json(attempt / 'response.json', dict(stdout=r.stdout, stderr=r.stderr, returncode=r.returncode))
    if r.returncode == 75:
        raise Deferred(r.stderr.strip()[-300:] or 'all FreeLLMAPI routes throttled')
    if r.returncode != 0 or not r.stdout.strip():
        raise RuntimeError(f'llm failed rc={r.returncode}: {r.stderr.strip()[-300:]}')
    route = next((l[6:] for l in r.stderr.splitlines() if l.startswith('route=')), '')
    return r.stdout.strip(), route


def shortcut_installed(name):
    if not name:
        return False
    r = subprocess.run(['shortcuts', 'list'], capture_output=True, text=True, timeout=30)
    return name in r.stdout.splitlines()


def append_via_shortcut(name, title, md):
    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False, encoding='utf-8') as f:
        json.dump({'title': title, 'markdown': md}, f, ensure_ascii=False)
    try:  # a dialog means the Shortcut is broken; never let it hang the loop
        r = subprocess.run(['shortcuts', 'run', name, '--input-path', f.name],
                           capture_output=True, text=True, timeout=45)
    finally:
        os.unlink(f.name)
    if r.returncode != 0:
        raise RuntimeError(f'shortcut failed: {r.stderr.strip()[-300:]}')


def reply_title(title, tag='#process', done_tag='#done'):
    """One clean thread title: 'Re: <root>' — never 'Re: Re:', never carrying the tags."""
    t = title
    while t.lower().startswith('re: '):
        t = t[4:]
    t = tag_re(tag).sub('', t)
    t = tag_re(done_tag).sub('', t)
    return 'Re: ' + (' '.join(t.split()) or 'note')


def linked_note(title, md, account, folder):
    r = subprocess.run([str(HERE / 'notes-new'), '--title', reply_title(title), '--account', account,
                        '--folder', folder, '-'], input=md, capture_output=True, text=True,
                       timeout=90)
    if r.returncode != 0:
        raise RuntimeError(f'notes-new failed: {r.stderr.strip()}')
    return r.stdout.strip()


# ---------- pass ----------
def handle(occ, a, seen, use_shortcut):
    label = f'"{occ["title"]}" [{occ["folder"]}]'
    if occ.get('trash') or occ.get('locked'):
        return log(f'skip {label}: deleted or locked')
    with db() as c:
        source = notes_input.snapshot(c, occ['nid'], DB.parent)
    if source['age'] < a.settle:
        return log(f'wait {label}: recently edited')
    if occ['kind'] == 'text' and not tag_re(a.tag).search(source['text']):
        return
    key = occ['key'] or f'text:{occ["nid"]}:{hashlib.sha256(source["text"].encode()).hexdigest()[:16]}'
    if key in seen:
        return
    if a.dry_run:
        return log(f'DRY {label}: {len(source["text"])} source chars, {len(source["attachments"])} attachments')
    run = notes_input.start_run(STATE, source, a.tag, key)
    status = dict(id=run.name, note_id=occ['nid'], key=key, tag=a.tag)
    record = dict(key=key, note=occ['nid'], title=occ['title'], run_id=run.name)
    delivery_started = False
    try:
        vision = notes_input.vision_images(source, run)
        prompt = notes_input.make_prompt(source['text'], a.tag, vision)
        (run / 'prompt.txt').write_text(prompt, encoding='utf-8')
        notes_input.save_json(run / 'status.json', dict(status, state='request_ready'))
        # Claim only after the complete input is durably saved, before model/delivery side effects.
        seen.add(key)
        ledger_add(dict(record, at=datetime.datetime.now().isoformat(timespec='seconds'), where='claimed'))
        log(f'{run.name}: send {label}: {len(prompt)} chars, {len(vision)} attachments')
        notes_input.save_json(run / 'status.json', dict(status, state='generating'))
        if a.samples > 1:
            reply, route = consensus_reply(a, prompt, '', occ, audit_dir=run)
        else:
            reply, route = call_llm(a.llm, prompt, a.llm_timeout, audit_dir=run)
        (run / 'reply.raw.txt').write_text(reply, encoding='utf-8')
        reply = sanitize(reply, a.tag)
        md = reply_markdown(reply, f'{a.label} · {route.split("/")[-1]}' if route else a.label, a.done_tag)
        source_text = tag_re(a.tag).sub('', source['text']).strip()
        md = (f'**Processing ID: {run.name}**\n\n'
              f'## Source note\n\n' + '\n'.join('> ' + l for l in source_text.split('\n'))
              + '\n' + md)
        (run / 'reply.md').write_text(md, encoding='utf-8')
        notes_input.save_json(run / 'status.json', dict(status, state='delivering', route=route))
        delivery_started = True
        if use_shortcut and title_count(occ['title']) == 1:
            append_via_shortcut(a.shortcut, occ['title'], md)
            after = osa(INFO, occ['nid']).split('\x1f', 1)[1]
            where = 'appended in note' if run.name in after else 'APPEND NOT VERIFIED (logged, not retried)'
        else:
            where = 'linked note ' + linked_note(occ['title'], md, a.reply_account, a.reply_folder)
        ledger_add(dict(record, at=datetime.datetime.now().isoformat(timespec='seconds'), where=where))
        notes_input.save_json(run / 'status.json', dict(status, state='delivered' if not where.startswith('APPEND NOT') else 'delivery_uncertain', route=route, where=where))
        log(f'{run.name}: {where}')
    except Exception as e:
        notes_input.save_json(run / 'status.json', dict(status, state='deferred' if isinstance(e, Deferred) else 'delivery_uncertain' if delivery_started else 'failed', error=str(e), error_type=type(e).__name__))
        log(f'{run.name}: failed; saved at {run}: {e}')
        raise


def consensus_reply(a, prompt, context, occ, audit_dir=None):
    """--samples N: ask the same question N times, align the answers (bin/notes-variants),
    reply with the MASTER consensus. All N answers + branches are kept on disk."""
    import importlib.machinery, importlib.util
    ldr = importlib.machinery.SourceFileLoader('notes_variants', str(HERE / 'notes-variants'))
    nv = importlib.util.module_from_spec(importlib.util.spec_from_loader('notes_variants', ldr))
    ldr.exec_module(nv)
    vs, route = [], ''
    for i in range(a.samples):
        try:
            r, route = call_llm(a.llm, prompt, a.llm_timeout, context, audit_dir=audit_dir)
            vs.append(dict(pk=i, at=datetime.datetime.now().isoformat(timespec='seconds'), text=r))
            log(f'  sample {i + 1}/{a.samples} ok')
        except Exception as e:
            log(f'  sample {i + 1}/{a.samples} failed: {e}')
    if len(vs) < 2:
        raise RuntimeError(f'only {len(vs)} samples succeeded')
    slug = re.sub(r'[^a-z0-9]+', '-', prompt.lower())[:50].strip('-') or 'note'
    out = Path(a.consensus_dir).expanduser() / f'{datetime.datetime.now():%Y%m%d-%H%M%S}-{slug}'
    master = nv.run(vs, out, prompt[:80], quorum=a.quorum)
    body = '\n'.join(l for l in master.splitlines()[2:])  # drop "# MASTER" heading
    return (f'**Consensus of {len(vs)} answers** (claims ≥{a.quorum:.0%} of answers; `[k/N]` = support)\n'
            f'{body}\n\nAll {len(vs)} answers + BRANCHES.md + FAMILIES.md: `{out}`'), route


LAST_REFRESH = time.time()


def one_pass(a):
    global LAST_REFRESH
    # A backgrounded Notes on the Mini is slow to pull iCloud changes (2026-11-09: a note sat
    # unsynced >2 min; a restart synced it in 4s). Relaunch it every --refresh seconds.
    if a.refresh and time.time() - LAST_REFRESH >= a.refresh:
        LAST_REFRESH = time.time()
        heal_notes(force=True, quiet=True)
    if (STATE / 'STOP').exists():
        return log(f'STOP file present ({STATE}/STOP) — not processing')
    seen = ledger()
    due = {k for k, t in deferred().items() if t <= time.time()}
    seen -= due  # a deferred note was claimed; once its hour is up it is handled again
    occs = [o for o in find_occurrences(a.tag) if o['key'] not in seen]
    if a.reprocess:
        import uuid
        occs = [dict(o, key='manual:' + uuid.uuid4().hex, defer_key=o['key']) for o in find_occurrences(a.tag) if o['nid'] == a.reprocess]
        if not occs:
            raise ValueError('no matching tagged note for --reprocess')
    if a.plain_text:
        ids = [i for i in osa(PLAINTEXT_FIND, a.tag, timeout=120).splitlines() if i.strip()]
        occs += [dict(key=None, nid=i, kind='text', title=osa(
            'on run argv\ntell application "Notes" to return name of note id (item 1 of argv)\nend run', i),
            folder='') for i in ids]
    if not occs:
        return log(f'nothing new for {a.tag}')
    heal_notes()  # start Notes in the background if it isn't running
    use_shortcut = shortcut_installed(a.shortcut)
    if not use_shortcut:
        log(f'Shortcut "{a.shortcut}" not installed → replies go to linked notes')
    errors = 0
    for o in occs:
        dkey = o.get('defer_key') or o.get('key')
        try:
            handle(o, a, seen, use_shortcut)
            if dkey:
                set_deferred(dkey)  # answered: drop any parked retry
        except Deferred as e:
            if dkey:
                set_deferred(dkey, time.time() + DEFER_SECONDS)
            log(f'deferred {o.get("title")}: brain throttled (429) — retrying in {DEFER_SECONDS // 60} min')
        except Exception as e:
            errors += 1
            log(f'error {o.get("title")}: {e}')
    return 1 if errors else 0


def main():
    ap = argparse.ArgumentParser(description='#process tag in Notes → LLM reply, append-only.')
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument('--once', action='store_true')
    g.add_argument('--watch', type=int, metavar='SECONDS')
    g.add_argument('--show-run', metavar='ID', help='print saved status and exact model input for a processing ID')
    ap.add_argument('--tag', default='#process')
    ap.add_argument('--done-tag', default='#done')
    ap.add_argument('--llm', default='')
    ap.add_argument('--llm-timeout', type=int, default=0)
    # OFF by default (2026-11-08): the generated Shortcut's Find Notes → Append to Note binding
    # does not carry over, so Shortcuts shows a "which note?" picker of ALL notes. Unacceptable.
    # Only pass --shortcut once an append is proven dialog-free.
    ap.add_argument('--shortcut', default='')
    ap.add_argument('--label', default='Cloudcity')
    ap.add_argument('--reply-account', default='iCloud')
    ap.add_argument('--reply-folder', default='Notes')
    ap.add_argument('--plain-text', action='store_true',
                    help='also catch the tag typed as plain text (not an orange tag)')
    ap.add_argument('--settle', type=int, default=5)
    ap.add_argument('--refresh', type=int, default=0,
                    help='optional Notes refresh interval; default off to avoid interrupting reply delivery')
    ap.add_argument('--samples', type=int, default=1,
                    help='ask N times and reply with the consensus (bin/notes-variants); e.g. --tag "#consensus" --samples 25')
    ap.add_argument('--quorum', type=float, default=0.3, help='--samples: fraction of answers a claim needs')
    ap.add_argument('--consensus-dir', default=str(HERE.parent / 'analysis/notes-variants/consensus'))
    ap.add_argument('--dry-run', action='store_true')
    ap.add_argument('--reprocess', metavar='NOTE_ID', help='deliberately create one new audited reply for this note (--once only)')
    a = ap.parse_args()
    # #process = conversation WITH the voices (bin/notes-voices → mail's fm_research, ledger-grounded).
    # Other tags (#consensus: 25 samples) keep the single fast notes-brain. Esa 2026-11-17.
    voices = a.tag.lower() == '#process' and a.samples <= 1
    a.llm = a.llm or f"{HERE}/{'notes-voices' if voices else 'notes-brain'}"
    a.llm_timeout = a.llm_timeout or (900 if voices else 240)
    if a.show_run:
        if not re.fullmatch(r'NP-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}', a.show_run):
            ap.error('invalid processing ID')
        run = notes_input.runs_root(STATE) / a.show_run
        print((run / 'status.json').read_text())
        if (run / 'prompt.txt').exists():
            print((run / 'prompt.txt').read_text())
        return
    if not a.tag.startswith('#') or tag_re(a.tag).search(a.done_tag):
        sys.exit('tag must start with # and the done tag must not contain it')
    if a.watch is not None and a.watch < 10:
        sys.exit('--watch must be >= 10 seconds')  # discovery is one cheap read-only SQLite query
    if a.reprocess and not a.once:
        ap.error('--reprocess requires --once')
    if a.once:
        return sys.exit(one_pass(a) or 0)
    while True:
        try:
            one_pass(a)
        except Exception as e:
            log(f'pass failed ({type(e).__name__}): {e}; retrying in {a.watch}s')
        time.sleep(a.watch)


if __name__ == '__main__':
    main()
