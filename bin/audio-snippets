#!/bin/bash
# audio-snippets — capture N short clips from every audio input device (or every
# channel with --per-channel). Audio twin of the camera snapshot. Runs the
# in-bundle binary so it carries the bundle's Microphone TCC identity.
#
#   audio-snippets <outdir> [--per-channel] [--device <substr>]
#                  [--count 5] [--len 3] [--gap 3.75] [--list]
#
# FEATURE-CARD >> sensor-snapshot/snapshot.feature
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$REPO/sensor-snapshot/Snapshot.app/Contents/MacOS/audio-snippets"
if [[ ! -x "$BIN" ]]; then
  echo "Snapshot.app not built — running build.sh…" >&2
  bash "$REPO/sensor-snapshot/build.sh" >&2
fi
exec "$BIN" "$@"
