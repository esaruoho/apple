#!/usr/bin/env bash
# maps-directions — open Apple Maps with a route to your OTHER anchor.
# Clever both ways: me-location deduces WHERE YOU ARE from the LAN fingerprint, and
#   - daddr (destination) = the current place's commute partner (at Workspace → Home,
#     at Home → Workspace). Falls back to your home address (me-address) when the
#     current place is unknown or has no partner — so "directions home" still works.
#   - saddr (origin)      = the current place (a desktop Mac has no GPS to fill it).
# Transport mode auto-detected from the phrase ("walk"/"transit"/… → flag), default drive.
#
# Reuses the Apple Maps directions params proven in ~/work/ray-graph
# (js/dashboard/dashboard-ui.js getDirectionsUrl): dirflg w=walking d=driving r=transit.
# Apple-native: `open` on a maps:// URL → launches Maps.app (not the browser).
# python3 stdlib for URL-encoding.
#
# FEATURE-CARD >> features/directions-home.feature
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
urlenc() { printf '%s' "$1" | python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.stdin.read().strip()))'; }

phrase="${*:-}"
case "$phrase" in
  *walk*|*foot*)          flg=w; mode=walking ;;
  *transit*|*bus*|*train*|*public*) flg=r; mode=transit ;;
  *)                      flg=d; mode=driving ;;
esac

# Destination (daddr): the commute partner of where we are. Empty → fall back to home.
dst="$("$HERE/me-location" --to 2>/dev/null)"
dstname="$("$HERE/me-location" --to-name 2>/dev/null)"
if [ -z "$dst" ]; then
  dst="$("$HERE/me-address" 2>/dev/null | grep -vi 'door' | paste -sd ', ' -)"
  dstname="home"
  case "$dst" in
    ""|*"Make This My Card"*|*"couldn't read"*|*"no postal"*|*"returned nothing"*|*"no contact matched"*)
      echo "maps-directions: couldn't get a destination (try: apple-do address)."; exit 1 ;;
  esac
fi

# Source (saddr): a desktop Mac has no GPS, so Maps can't fill "current location".
# Pin the deduced current place as the origin; if unknown, omit saddr (Maps decides).
saddr_q=""; from=""
src="$("$HERE/me-location" 2>/dev/null)"
if [ -n "$src" ]; then
  saddr_q="&saddr=$(urlenc "$src")"
  srcname="$("$HERE/me-location" --name 2>/dev/null)"
  from="${srcname:-$src} → "
fi

# maps:// is the scheme Maps.app owns — opens the app directly, not the browser
# (https://maps.apple.com/ is a web URL the default browser claims). Same query params.
url="maps://?daddr=$(urlenc "$dst")${saddr_q}&dirflg=${flg}"
if open "$url" 2>/dev/null; then
  echo "Opening directions in Maps ($mode): ${from}${dstname} — $dst"
else
  echo "maps-directions: couldn't open Maps for $url"; exit 1
fi
