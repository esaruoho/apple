#!/usr/bin/env python3
"""
wav — pick an app with the arrow keys, press Enter, get a .wav of its audio.

The point: you should never have to know an app's name-vs-bundle-id, and you should
never find out afterwards that you recorded ten seconds of silence. This lists every
app CoreAudio knows about, marks the ones ACTUALLY OUTPUTTING AUDIO RIGHT NOW with a
green ●, refreshes ~2x/sec, and records the one you pick.

    wav                     pick from the live list, Enter records open-ended
    wav --seconds 20        Enter records exactly 20s (stop early any time)
    wav --out ~/Music/grabs where the .wav lands (default: the current folder)
    wav --after 5           5s countdown after the app is raised, so you can hit play
    wav --no-activate       do NOT bring the picked app to the front
    wav --then "Ableton"    after recording, open the .wav in that app
    wav --then finder       after recording, reveal it in Finder
    wav --then none         just leave the file

"First, then": pick the source app, then pick where the finished .wav goes — so
"record Renoise to Ableton Live" is one gesture. Skip the second screen entirely
by passing --then. A silent grab is never handed onward.

Every combo you pick is REMEMBERED. Next time, press space for the last one, or
1-9 for an earlier one — no arrowing, no second screen. And the same combos are
reachable with no UI at all, which is what a MIDI button needs:

    wav --last                      repeat the most recent combo
    wav --recent 2                  repeat the 2nd remembered combo
    wav --list-recent               show them with their numbers
    wav --stop                      end an open-ended capture (2nd MIDI button)
    wav --app "Schism" --then "Live" --seconds 30 --out ~/Music/grabs
                                    fully explicit, never opens the UI

Pressing Enter brings the picked app to the FRONT, then starts the tap — you picked
it because you want to play something in it, so it lands under your hands.

While recording, the meter line shows the level AND counts down the time remaining.
Stop whenever you like with Enter, Esc, q or Ctrl-C — with no --seconds it simply
records until you do.

Keys:
    ↑/↓ or k/j    move            Enter    record the highlighted app
    a             all system audio (not one app)
    p             show only apps currently playing  (toggle)
    +/-           duration ±5s (0 = open-ended, stop with Enter/Esc/q/Ctrl-C)
    q / Esc       quit

Under the hood it just runs the Apple-native recorder:
    app-audio-record --app <bundle-id> [--seconds N] --out <folder>
ScreenCaptureKit taps that one process. Nothing is rerouted, nothing is installed,
the app keeps playing to your speakers exactly as before.

Apple-native: stdlib only. No Homebrew, no pip.

FEATURE-CARD >> features/app-audio-record.feature
"""
import curses
import json
import os
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
RECORDER = os.path.join(HERE, "app-audio-record")

CONFIG_DIR = os.path.expanduser("~/.config/wav")
HISTORY = os.path.join(CONFIG_DIR, "recent.json")
PIDFILE = os.path.join(CONFIG_DIR, "current.pid")
MAX_RECENT = 9


# ─── remembered combos ────────────────────────────────────────────────────────
# "Schism Tracker → Live" and "Schism Tracker → Renoise" are the two things Esa
# actually does, over and over. Remember them so the second time is one keypress
# (space), and so a MIDI button can fire one with no UI at all (--last / --recent N).

def load_recent():
    try:
        with open(HISTORY) as f:
            rows = json.load(f)
        return rows if isinstance(rows, list) else []
    except Exception:
        return []


def save_recent(entry):
    """Most-recent-first, deduped on (source, destination). Never let a bad write
    kill a finished recording — the .wav is the product, history is a convenience."""
    try:
        rows = [r for r in load_recent()
                if not (r.get("bundleID") == entry.get("bundleID")
                        and r.get("all") == entry.get("all")
                        and (r.get("then") or {}).get("name") == (entry.get("then") or {}).get("name"))]
        rows.insert(0, entry)
        os.makedirs(CONFIG_DIR, exist_ok=True)
        tmp = HISTORY + ".tmp"
        with open(tmp, "w") as f:
            json.dump(rows[:MAX_RECENT], f, indent=2)
        os.replace(tmp, HISTORY)
    except Exception as e:
        print(f"(couldn't save to recents: {e})", file=sys.stderr)


def recent_label(r):
    src = "all system audio" if r.get("all") else r.get("name", "?")
    dst = (r.get("then") or {}).get("name", "nothing")
    dur = fmt_dur(r.get("seconds", 0))
    return f"{src} → {dst}   [{dur}]"

def audio_procs(show_all=False):
    """CoreAudio's process list via the recorder (playing-first, already sorted).

    Default view = real apps (NSRunningApplication activation policy .regular) plus
    anything currently making sound. That keeps audiomxd / assistantd / avconferenced
    and friends out of the list without maintaining a blacklist of daemon names.
    --all-procs shows every audio client, plumbing included.
    """
    try:
        out = subprocess.run([RECORDER, "--list-audio"], capture_output=True,
                             text=True, timeout=10).stdout
        rows = json.loads(out) if out.strip() else []
    except Exception:
        return []
    if show_all:
        return rows
    return [r for r in rows if r.get("isApp") or r.get("playing")]


def fmt_dur(seconds):
    return "open-ended" if not seconds else f"{seconds}s"


# ─── "first, then" ────────────────────────────────────────────────────────────
# A recording is rarely the end of the thought. "record Renoise TO Ableton Live" is
# one gesture: tap the source, then hand the .wav to the destination. The THEN step
# is picked up front (so the whole thing is one decision), and it only fires if the
# grab actually contains sound — handing a silent file to Live is worse than nothing.

def open_apps():
    """Real, running apps that could plausibly receive a .wav — for the THEN list."""
    seen, out = set(), []
    for r in audio_procs():
        bid = r.get("bundleID") or ""
        if r.get("isApp") and bid and bid not in seen:
            seen.add(bid)
            out.append({"name": r["name"], "bundleID": bid})
    return sorted(out, key=lambda r: r["name"].lower())


def then_choices():
    return ([{"kind": "none", "name": "Nothing — just leave the file", "bundleID": ""},
             {"kind": "finder", "name": "Finder — reveal it", "bundleID": ""}]
            + [{"kind": "app", **a} for a in open_apps()])


def resolve_then(spec):
    """--then finder | none | <app name or bundle id substring> → a choice dict."""
    if not spec:
        return None
    s = spec.strip().lower()
    if s in ("none", "no", "off"):
        return {"kind": "none", "name": "nothing", "bundleID": ""}
    if s == "finder":
        return {"kind": "finder", "name": "Finder", "bundleID": ""}
    for a in open_apps():
        if s in a["name"].lower() or s in a["bundleID"].lower():
            return {"kind": "app", **a}
    # Not running (or the list was unreadable) — still usable. A dotted string is a
    # bundle id for `open -b`; anything else is an app NAME for `open -a`, which is what
    # someone typing --then "Ableton Live 12 Suite" means.
    if "." in spec:
        return {"kind": "app", "name": spec, "bundleID": spec}
    return {"kind": "app", "name": spec, "bundleID": "", "appName": spec}


def run_then(choice, path):
    """Hand the finished .wav to the destination."""
    if not choice or choice["kind"] == "none":
        return
    if choice["kind"] == "finder":
        subprocess.run(["/usr/bin/open", "-R", path], capture_output=True)
        print(f"→ revealed in Finder: {path}")
        return
    flag, target = ("-b", choice["bundleID"]) if choice.get("bundleID") else ("-a", choice.get("appName", choice["name"]))
    r = subprocess.run(["/usr/bin/open", flag, target, path],
                       capture_output=True, text=True)
    if r.returncode == 0:
        print(f"→ opened in {choice['name']}: {os.path.basename(path)}")
    else:
        # Most likely an app that refuses `open <file>` (some hosts only accept drags).
        # Don't pretend it worked — say so and fall back to revealing the file.
        print(f"→ {choice['name']} would not open it ({r.stderr.strip() or 'no reason given'}); "
              f"revealing in Finder instead", file=sys.stderr)
        subprocess.run(["/usr/bin/open", "-R", path], capture_output=True)


def safe_add(stdscr, y, x, text, width, attr=0):
    """Every curses write is best-effort.

    Writing to the last cell of the last line, or on a terminal that disagrees about
    its own size, raises curses.error — which must never take down the picker. Same
    hardening bin/sessions already does.
    """
    if width <= 0:
        return
    try:
        stdscr.addnstr(y, x, text, width, attr)
    except curses.error:
        pass


def picker(stdscr, seconds, outdir, show_all, after=0, then_spec=None):
    try:
        curses.curs_set(0)  # TERM=ansi and friends can't hide the cursor; 3.14 raises on ERR
    except curses.error:
        pass
    stdscr.keypad(True)                 # so KEY_UP/KEY_DOWN arrive as keys, not escape soup
    stdscr.timeout(500)                 # redraw ~2x/sec so ● markers stay live
    colors = False
    try:
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)     # playing marker
        curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)  # selection
        curses.init_pair(3, curses.COLOR_YELLOW, -1)    # header/help
        colors = True
    except curses.error:
        pass

    def pair(n):
        return curses.color_pair(n) if colors else 0

    def choose_then(source_name):
        """Screen 2 of the 'first, then': where does the finished .wav go?"""
        items = then_choices()
        # Default to the first non-Finder app that isn't the source — for "record Renoise
        # to Ableton Live" the destination is, by definition, some OTHER app.
        tsel = next((i for i, it in enumerate(items)
                     if it["kind"] == "app" and it["name"] != source_name), 1)
        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            safe_add(stdscr, 0, 0,
                     f" first: record {source_name}   …then: send the .wav where?".ljust(w - 1),
                     w - 1, pair(3) | curses.A_BOLD)
            safe_add(stdscr, 1, 0, " ↑↓ move · Enter confirm · Esc back".ljust(w - 1),
                     w - 1, curses.A_DIM)
            for i, it in enumerate(items[:max(1, h - 4)]):
                safe_add(stdscr, 3 + i, 0, f"   {it['name']}".ljust(w - 1), w - 1,
                         pair(2) if i == tsel else 0)
            try:
                stdscr.refresh()
            except curses.error:
                pass
            k = stdscr.getch()
            if k == -1:
                continue
            if k == 27:                       # Esc → back to the source list
                return None
            if k in (curses.KEY_UP, ord("k")):
                tsel = max(0, tsel - 1)
            elif k in (curses.KEY_DOWN, ord("j")):
                tsel = min(len(items) - 1, tsel + 1)
            elif k in (curses.KEY_ENTER, 10, 13):
                return items[tsel]

    sel = 0
    playing_only = False
    rows = audio_procs(show_all)
    recents = load_recent()

    while True:
        shown = [r for r in rows if r["playing"]] if playing_only else rows
        if not shown:
            shown = rows
        sel = max(0, min(sel, len(shown) - 1)) if shown else 0

        stdscr.erase()
        h, w = stdscr.getmaxyx()
        cd = f" · {after}s countdown" if after else ""
        head = (f" wav — pick an app, Enter raises it + records   "
                f"[{fmt_dur(seconds)}{cd}]  → {outdir or 'current folder'}")
        safe_add(stdscr, 0, 0, head.ljust(w - 1), w - 1, pair(3) | curses.A_BOLD)
        legend = (" ● = making sound right now    ↑↓ move · Enter record · a all-audio · "
                  "p playing-only · +/- duration · q quit")
        safe_add(stdscr, 1, 0, legend.ljust(w - 1), w - 1, curses.A_DIM)

        # Recents first: the whole point is that the SECOND time is one keypress.
        top = 3
        if recents:
            safe_add(stdscr, 2, 0, " again:".ljust(w - 1), w - 1, pair(3))
            for i, r in enumerate(recents[:MAX_RECENT]):
                key = "space" if i == 0 else str(i + 1)
                safe_add(stdscr, top + i, 0,
                         f"   [{key}]  {recent_label(r)}".ljust(w - 1), w - 1, pair(1))
            top += len(recents[:MAX_RECENT]) + 1
            safe_add(stdscr, top - 1, 0, " or pick a source:".ljust(w - 1), w - 1, pair(3))
        room = max(1, h - top - 1)
        first = max(0, min(sel - room // 2, max(0, len(shown) - room)))
        for i, r in enumerate(shown[first:first + room]):
            y = top + i
            idx = first + i
            mark = "●" if r["playing"] else " "
            line = f"  {mark}  {r['name']}"
            pad = max(1, 34 - len(line))
            line = f"{line}{' ' * pad}{r['bundleID']}"
            attr = pair(2) if idx == sel else 0
            safe_add(stdscr, y, 0, line.ljust(w - 1), w - 1, attr)
            if r["playing"] and idx != sel:
                safe_add(stdscr, y, 2, "●", 1, pair(1) | curses.A_BOLD)
        if not shown:
            safe_add(stdscr, top, 2, "nothing to show — is CoreAudio reporting? (macOS 14.4+)", w - 1)
        try:
            stdscr.refresh()
        except curses.error:
            pass

        try:
            key = stdscr.getch()
        except KeyboardInterrupt:
            return None
        if key == -1:
            rows = audio_procs(show_all)     # timeout tick → refresh the ● markers
            continue
        if key in (ord("q"), 27):
            return None
        if key == ord(" ") and recents:
            return dict(recents[0], repeat=True)
        if ord("1") <= key <= ord("9") and recents:
            idx = key - ord("1")
            if idx < len(recents):
                return dict(recents[idx], repeat=True)
        if key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            sel = min(len(shown) - 1, sel + 1) if shown else 0
        elif key in (ord("p"),):
            playing_only = not playing_only
            sel = 0
        elif key in (ord("+"), ord("=")):
            seconds += 5
        elif key in (ord("-"), ord("_")):
            seconds = max(0, seconds - 5)
        elif key in (ord("a"),):
            then = then_spec if then_spec is not None else choose_then("all system audio")
            if then is None:
                continue                      # Esc on screen 2 → back to the source list
            return {"all": True, "seconds": seconds, "after": after, "then": then}
        elif key in (curses.KEY_ENTER, 10, 13):
            if shown:
                r = shown[sel]
                then = then_spec if then_spec is not None else choose_then(r["name"])
                if then is None:
                    continue
                return {"bundleID": r["bundleID"], "name": r["name"],
                        "seconds": seconds, "after": after, "then": then}


def stop_running():
    """End an in-progress capture — the second MIDI button. SIGINT is exactly what
    Ctrl-C sends, so the recorder finalises the .wav on its normal path."""
    try:
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
    except Exception:
        print("nothing recording", file=sys.stderr)
        return 1
    try:
        os.kill(pid, 2)   # SIGINT
        print(f"■ stopped (pid {pid})")
        return 0
    except ProcessLookupError:
        print("nothing recording (stale pidfile)", file=sys.stderr)
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        return 1


def do_record(choice, outdir, activate):
    """Run one source→then recording. Shared by the picker, --last and --app, so a MIDI
    button and a keypress take exactly the same path."""
    # Bring the picked app to the front BEFORE recording starts. You picked it because
    # you want to play something in it — so put it under your hands. `open -b` activates
    # a running app (and launches it if it somehow died between the list and the Enter).
    # This is a user-requested activation, not simulated keystrokes: nothing is typed into
    # whatever was frontmost. --no-activate opts out (e.g. capturing a background app you
    # deliberately do not want raised).
    if activate and not choice.get("all") and choice.get("bundleID"):
        # Raising the app takes focus off this terminal, so an open-ended capture would
        # leave you unable to Ctrl-C without clicking back. Say so once, up front.
        if not choice.get("seconds"):
            print(f"↑ raising {choice.get('name', choice['bundleID'])} — recording until you stop it "
                  f"(click back to this terminal, then Enter / Esc / q / Ctrl-C)")
        subprocess.run(["/usr/bin/open", "-b", choice["bundleID"]],
                       capture_output=True, timeout=10)
        time.sleep(0.5)     # let the window actually come forward before the tap opens

    # Out of curses, into the real recorder — so its live level meter is what you watch.
    cmd = [RECORDER]
    cmd += ["--all"] if choice.get("all") else ["--app", choice["bundleID"]]
    if choice["seconds"]:
        cmd += ["--seconds", str(choice["seconds"])]
    if choice.get("after"):
        cmd += ["--after", str(choice["after"])]
    if outdir:
        cmd += ["--out", outdir]

    # Typed handoff instead of scraping the recorder's "✓ …" line: it writes the finished
    # path (and whether the grab was silent) as JSON, and the THEN step reads that.
    then = choice.get("then")
    manifest = None
    if then and then.get("kind") != "none":
        manifest = os.path.join(tempfile.gettempdir(), f"wav-{os.getpid()}.json")
        cmd += ["--manifest", manifest]

    # Remember it, so next time is one keypress (space) or one MIDI note (--last).
    save_recent({"bundleID": choice.get("bundleID", ""), "name": choice.get("name", ""),
                 "all": bool(choice.get("all")), "seconds": choice.get("seconds", 0),
                 "after": choice.get("after", 0), "then": then, "outdir": outdir})

    # Publish the recorder's pid so `wav --stop` (a second MIDI button) can end an
    # open-ended capture without a terminal in the loop.
    proc = subprocess.Popen(cmd)
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(PIDFILE, "w") as f:
            f.write(str(proc.pid))
    except Exception:
        pass
    rc = proc.wait()
    try:
        os.unlink(PIDFILE)
    except OSError:
        pass

    if manifest and os.path.exists(manifest):
        try:
            with open(manifest) as f:
                info = json.load(f)
        except Exception:
            info = {}
        os.unlink(manifest)
        path = info.get("path")
        if path and os.path.exists(path):
            # Never hand a silent file onward — opening 20s of nothing in Live is worse
            # than not opening anything, because it looks like it worked.
            if info.get("silent"):
                print(f"→ not sending to {then['name']}: the grab was silent", file=sys.stderr)
            else:
                run_then(then, path)
    return rc


def main():
    args = sys.argv[1:]
    seconds, outdir, show_all, activate, after = 0, "", False, True, 0
    then_spec = None
    repeat = 0          # --last / --recent N: fire a remembered combo, no UI
    app_spec = None     # --app <name>: name the source outright, no UI
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--seconds", "-t") and i + 1 < len(args):
            i += 1; seconds = int(float(args[i]))
        elif a in ("--after", "--delay") and i + 1 < len(args):
            i += 1; after = int(float(args[i]))
        elif a in ("--out", "-o") and i + 1 < len(args):
            i += 1; outdir = os.path.expanduser(args[i])
        elif a == "--then" and i + 1 < len(args):
            i += 1; then_spec = args[i]
        elif a == "--no-activate":
            activate = False
        elif a == "--all-procs":
            show_all = True
        elif a in ("--last", "--again"):
            repeat = 1
        elif a == "--recent" and i + 1 < len(args):
            i += 1; repeat = int(args[i])
        elif a in ("--app", "--source") and i + 1 < len(args):
            i += 1; app_spec = args[i]
        elif a == "--stop":
            return stop_running()
        elif a == "--list-recent":
            rows = load_recent()
            if not rows:
                print("no remembered combos yet — run wav once and pick a source + destination")
            for n, r in enumerate(rows, 1):
                print(f"  [{'space' if n == 1 else n}]  {recent_label(r)}")
            return 0
        elif a in ("--help", "-h"):
            print(__doc__); return 0
        else:
            print(f"unknown argument {a} — try --help", file=sys.stderr); return 1
        i += 1

    if not os.path.exists(RECORDER):
        print(f"error: recorder not found at {RECORDER}", file=sys.stderr)
        print("build it: swiftc -O -o bin/app-audio-record bin/app-audio-record.swift \\",
              file=sys.stderr)
        print("            -framework ScreenCaptureKit -framework AVFoundation \\", file=sys.stderr)
        print("            -framework CoreMedia -framework CoreAudio -framework AppKit", file=sys.stderr)
        return 1

    # ── no-UI paths, for MIDI buttons and shell scripts ──────────────────────
    if repeat:
        rows = load_recent()
        if not rows:
            print("no remembered combos yet — run wav once and pick a source + destination",
                  file=sys.stderr)
            return 1
        if repeat > len(rows):
            print(f"only {len(rows)} remembered combo(s) — see wav --list-recent", file=sys.stderr)
            return 1
        choice = dict(rows[repeat - 1])
        # Explicit flags still win over what was remembered.
        if seconds:
            choice["seconds"] = seconds
        if then_spec is not None:
            choice["then"] = resolve_then(then_spec)
        print(f"⟳ {recent_label(choice)}")
        return do_record(choice, outdir or choice.get("outdir", ""), activate)

    if app_spec:
        src = None
        for r in audio_procs(show_all):
            if (app_spec.lower() in (r.get("name") or "").lower()
                    or app_spec.lower() in (r.get("bundleID") or "").lower()):
                src = r
                break
        if not src:
            print(f"no running app matches \"{app_spec}\" — try wav --list-recent or run wav",
                  file=sys.stderr)
            return 1
        choice = {"bundleID": src["bundleID"], "name": src["name"], "seconds": seconds,
                  "after": after, "then": resolve_then(then_spec) or {"kind": "none", "name": "nothing"}}
        # A repeated combo brings its remembered folder with it (same as --last), unless
    # an explicit --out overrides. Picking fresh keeps whatever --out said.
    return do_record(choice, outdir or (choice.get("outdir", "") if choice.get("repeat") else ""),
                     activate)

    try:
        choice = curses.wrapper(picker, seconds, outdir, show_all, after,
                                resolve_then(then_spec))
    except KeyboardInterrupt:
        return 130
    if not choice:
        return 0

    # A repeated combo brings its remembered folder with it (same as --last), unless
    # an explicit --out overrides. Picking fresh keeps whatever --out said.
    return do_record(choice, outdir or (choice.get("outdir", "") if choice.get("repeat") else ""),
                     activate)


if __name__ == "__main__":
    sys.exit(main())
