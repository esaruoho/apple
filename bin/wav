#!/usr/bin/env python3
"""
wav — pick an app with the arrow keys, press Enter, get a .wav of its audio.

The point: you should never have to know an app's name-vs-bundle-id, and you should
never find out afterwards that you recorded ten seconds of silence. This lists every
app CoreAudio knows about, marks the ones ACTUALLY OUTPUTTING AUDIO RIGHT NOW with a
green ●, refreshes ~2x/sec, and records the one you pick.

    wav                     pick from the live list, Enter records
    wav --seconds 20        Enter records exactly 20s (default: Ctrl-C to stop)
    wav --out ~/Music/grabs where the .wav lands (default: the current folder)
    wav --after 5           5s countdown after the app is raised, so you can hit play
    wav --no-activate       do NOT bring the picked app to the front

Pressing Enter brings the picked app to the FRONT, then starts the tap — you picked
it because you want to play something in it, so it lands under your hands.

Keys:
    ↑/↓ or k/j    move            Enter    record the highlighted app
    a             all system audio (not one app)
    p             show only apps currently playing  (toggle)
    +/-           duration ±5s (0 = until Ctrl-C)
    q / Esc       quit

Under the hood it just runs the Apple-native recorder:
    app-audio-record --app <bundle-id> [--seconds N] --out <folder>
ScreenCaptureKit taps that one process. Nothing is rerouted, nothing is installed,
the app keeps playing to your speakers exactly as before.

Apple-native: stdlib only. No Homebrew, no pip.

FEATURE-CARD >> features/app-audio-record.feature
"""
import curses
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
RECORDER = os.path.join(HERE, "app-audio-record")

def audio_procs(show_all=False):
    """CoreAudio's process list via the recorder (playing-first, already sorted).

    Default view = real apps (NSRunningApplication activation policy .regular) plus
    anything currently making sound. That keeps audiomxd / assistantd / avconferenced
    and friends out of the list without maintaining a blacklist of daemon names.
    --all-procs shows every audio client, plumbing included.
    """
    try:
        out = subprocess.run([RECORDER, "--list-audio"], capture_output=True,
                             text=True, timeout=10).stdout
        rows = json.loads(out) if out.strip() else []
    except Exception:
        return []
    if show_all:
        return rows
    return [r for r in rows if r.get("isApp") or r.get("playing")]


def fmt_dur(seconds):
    return "until Ctrl-C" if not seconds else f"{seconds}s"


def safe_add(stdscr, y, x, text, width, attr=0):
    """Every curses write is best-effort.

    Writing to the last cell of the last line, or on a terminal that disagrees about
    its own size, raises curses.error — which must never take down the picker. Same
    hardening bin/sessions already does.
    """
    if width <= 0:
        return
    try:
        stdscr.addnstr(y, x, text, width, attr)
    except curses.error:
        pass


def picker(stdscr, seconds, outdir, show_all, after=0):
    try:
        curses.curs_set(0)  # TERM=ansi and friends can't hide the cursor; 3.14 raises on ERR
    except curses.error:
        pass
    stdscr.keypad(True)                 # so KEY_UP/KEY_DOWN arrive as keys, not escape soup
    stdscr.timeout(500)                 # redraw ~2x/sec so ● markers stay live
    colors = False
    try:
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)     # playing marker
        curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)  # selection
        curses.init_pair(3, curses.COLOR_YELLOW, -1)    # header/help
        colors = True
    except curses.error:
        pass

    def pair(n):
        return curses.color_pair(n) if colors else 0

    sel = 0
    playing_only = False
    rows = audio_procs(show_all)

    while True:
        shown = [r for r in rows if r["playing"]] if playing_only else rows
        if not shown:
            shown = rows
        sel = max(0, min(sel, len(shown) - 1)) if shown else 0

        stdscr.erase()
        h, w = stdscr.getmaxyx()
        cd = f" · {after}s countdown" if after else ""
        head = (f" wav — pick an app, Enter raises it + records   "
                f"[{fmt_dur(seconds)}{cd}]  → {outdir or 'current folder'}")
        safe_add(stdscr, 0, 0, head.ljust(w - 1), w - 1, pair(3) | curses.A_BOLD)
        legend = " ● = making sound right now    ↑↓ move · Enter record · a all-audio · p playing-only · +/- duration · q quit"
        safe_add(stdscr, 1, 0, legend.ljust(w - 1), w - 1, curses.A_DIM)

        top = 3
        room = max(1, h - top - 1)
        first = max(0, min(sel - room // 2, max(0, len(shown) - room)))
        for i, r in enumerate(shown[first:first + room]):
            y = top + i
            idx = first + i
            mark = "●" if r["playing"] else " "
            line = f"  {mark}  {r['name']}"
            pad = max(1, 34 - len(line))
            line = f"{line}{' ' * pad}{r['bundleID']}"
            attr = pair(2) if idx == sel else 0
            safe_add(stdscr, y, 0, line.ljust(w - 1), w - 1, attr)
            if r["playing"] and idx != sel:
                safe_add(stdscr, y, 2, "●", 1, pair(1) | curses.A_BOLD)
        if not shown:
            safe_add(stdscr, top, 2, "nothing to show — is CoreAudio reporting? (macOS 14.4+)", w - 1)
        try:
            stdscr.refresh()
        except curses.error:
            pass

        try:
            key = stdscr.getch()
        except KeyboardInterrupt:
            return None
        if key == -1:
            rows = audio_procs(show_all)     # timeout tick → refresh the ● markers
            continue
        if key in (ord("q"), 27):
            return None
        if key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            sel = min(len(shown) - 1, sel + 1) if shown else 0
        elif key in (ord("p"),):
            playing_only = not playing_only
            sel = 0
        elif key in (ord("+"), ord("=")):
            seconds += 5
        elif key in (ord("-"), ord("_")):
            seconds = max(0, seconds - 5)
        elif key in (ord("a"),):
            return {"all": True, "seconds": seconds, "after": after}
        elif key in (curses.KEY_ENTER, 10, 13):
            if shown:
                r = shown[sel]
                return {"bundleID": r["bundleID"], "name": r["name"],
                        "seconds": seconds, "after": after}


def main():
    args = sys.argv[1:]
    seconds, outdir, show_all, activate, after = 0, "", False, True, 0
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--seconds", "-t") and i + 1 < len(args):
            i += 1; seconds = int(float(args[i]))
        elif a in ("--after", "--delay") and i + 1 < len(args):
            i += 1; after = int(float(args[i]))
        elif a in ("--out", "-o") and i + 1 < len(args):
            i += 1; outdir = os.path.expanduser(args[i])
        elif a == "--no-activate":
            activate = False
        elif a == "--all-procs":
            show_all = True
        elif a in ("--help", "-h"):
            print(__doc__); return 0
        else:
            print(f"unknown argument {a} — try --help", file=sys.stderr); return 1
        i += 1

    if not os.path.exists(RECORDER):
        print(f"error: recorder not found at {RECORDER}", file=sys.stderr)
        print("build it: swiftc -O -o bin/app-audio-record bin/app-audio-record.swift \\",
              file=sys.stderr)
        print("            -framework ScreenCaptureKit -framework AVFoundation \\", file=sys.stderr)
        print("            -framework CoreMedia -framework CoreAudio -framework AppKit", file=sys.stderr)
        return 1

    try:
        choice = curses.wrapper(picker, seconds, outdir, show_all, after)
    except KeyboardInterrupt:
        return 130
    if not choice:
        return 0

    # Bring the picked app to the front BEFORE recording starts. You picked it because
    # you want to play something in it — so put it under your hands. `open -b` activates
    # a running app (and launches it if it somehow died between the list and the Enter).
    # This is a user-requested activation, not simulated keystrokes: nothing is typed into
    # whatever was frontmost. --no-activate opts out (e.g. capturing a background app you
    # deliberately do not want raised).
    if activate and not choice.get("all") and choice.get("bundleID"):
        # Raising the app takes focus off this terminal, so an open-ended capture would
        # leave you unable to Ctrl-C without clicking back. Say so once, up front.
        if not choice.get("seconds"):
            print(f"↑ raising {choice.get('name', choice['bundleID'])} — recording until Ctrl-C "
                  f"(click back to this terminal to stop, or use --seconds N)")
        subprocess.run(["/usr/bin/open", "-b", choice["bundleID"]],
                       capture_output=True, timeout=10)
        time.sleep(0.5)     # let the window actually come forward before the tap opens

    # Out of curses, into the real recorder — so its live level meter is what you watch.
    cmd = [RECORDER]
    cmd += ["--all"] if choice.get("all") else ["--app", choice["bundleID"]]
    if choice["seconds"]:
        cmd += ["--seconds", str(choice["seconds"])]
    if choice.get("after"):
        cmd += ["--after", str(choice["after"])]
    if outdir:
        cmd += ["--out", outdir]
    return subprocess.call(cmd)


if __name__ == "__main__":
    sys.exit(main())
