#!/usr/bin/env bash
# apple-energy — read macOS energy/power data from the command line.
#
# The Activity Monitor "Energy" tab is just a front-end over Apple-shipped CLIs
# (powermetrics, top, system_profiler, pmset). This wraps them into one tool.
# No Homebrew, no deps — powermetrics + top + system_profiler + python3 stdlib.
#
# macOS keeps NO queryable historical per-app energy store (Activity Monitor's
# "Avg Energy Impact" is a rolling in-memory window that isn't exposed). So
# "top apps over time" must be RECORDED by sampling powermetrics + aggregated —
# which is exactly what `watch` does.
#
# READ verbs (telemetry):
#   apple-energy now [N]                  no-sudo snapshot: top N apps by energy impact
#   apple-energy watch [mins] [secs]      sample powermetrics over <mins>, rank apps (sudo)
#   apple-energy power [N]                system CPU/GPU/package watts (sudo)
#   apple-energy heat [N]                 heat = watts: package power + thermal pressure
#                                         + throttle + fans (sudo where available)
#   apple-energy adapter                  power adapter wattage + battery state (no sudo)
#   apple-energy claude                   list running Claude Code sessions: version,
#                                         outdated?, readable age, CPU, TERM, TTY, project
# ACT verbs (mutating — you asked for these):
#   apple-energy jump <pid|tty|ver|proj>  focus that Claude session's terminal window/tab
#   apple-energy install-jump             register aejump:// so `claude` TTYs are Cmd-clickable
#   apple-energy kill <name|pid>          SIGTERM a hog now (may respawn if launchd-kept)
#   apple-energy off <name> [--yes]       stop + DISABLE a launchd job so it stays dead
#   apple-energy help                     this help
#
# Energy Impact is a relative unit — the SAME metric Activity Monitor shows.
# `power`/`heat` report actual watts (mW): on a chip, watts drawn == heat produced.
#
# FEATURE-CARD >> features/apple-energy.feature

set -euo pipefail

PROG=$(basename "$0")

# Resolve our own dir (through symlinks) so the python heredocs can import the
# shared helper `_apple_energy.py` that lives beside this script.
_SRC="${BASH_SOURCE[0]:-$0}"
while [ -h "$_SRC" ]; do
  _D="$(cd -P "$(dirname "$_SRC")" && pwd)"
  _SRC="$(readlink "$_SRC")"
  [[ "$_SRC" != /* ]] && _SRC="$_D/$_SRC"
done
export APPLE_ENERGY_BIN="$(cd -P "$(dirname "$_SRC")" && pwd)"

die() { echo "$PROG: $*" >&2; exit 1; }

usage() {
  sed -n '/^# READ verbs/,/^# FEATURE-CARD/p' "$0" | grep -v '^# FEATURE-CARD' | sed 's/^# \{0,1\}//'
}

# ---- sudo helper ---------------------------------------------------------
# powermetrics requires root. Re-run under sudo if we aren't already.
need_sudo() {
  if [[ $EUID -ne 0 ]]; then
    echo "→ powermetrics needs root; you'll be prompted for sudo." >&2
    SUDO=(sudo)
  else
    SUDO=()
  fi
}

# ---- now: no-sudo snapshot via top's power column ------------------------
# top's POWER column == per-process energy impact. First listing reads 0.0
# (needs a delta), so take TWO listings and print only the second.
cmd_now() {
  local n="${1:-15}"
  echo "Top $n processes by energy impact (snapshot, no sudo)"
  echo "Energy Impact = relative units, same metric as Activity Monitor."
  echo
  # top truncates its COMMAND column to ~16 chars and a bare name ("Python",
  # "claude") says nothing. Pull PID+power from top's SECOND listing (first
  # reads 0.0 — no delta), then annotate each: claude → version+project+terminal,
  # python/node → its script + parent, everything else → full untruncated name.
  APPLE_ENERGY_N="$n" python3 <<'PY'
import os, sys, subprocess
sys.path.insert(0, os.environ["APPLE_ENERGY_BIN"])
import _apple_energy as ae
n = int(os.environ.get("APPLE_ENERGY_N", "15"))
# keep top's (truncated) command so a process that exits before the ps snapshot
# still shows a name ("… · ended") instead of a bare "?".
top = subprocess.run(
    ["top", "-l", "2", "-s", "1", "-n", str(n), "-o", "power", "-stats", "pid,command,power"],
    capture_output=True, text=True).stdout.splitlines()
hdrs = [i for i, l in enumerate(top) if l.strip().startswith("PID")]
rows = []
if hdrs:
    for l in top[hdrs[-1] + 1:]:
        parts = l.split()
        if len(parts) >= 3 and parts[0].isdigit():
            rows.append((parts[0], " ".join(parts[1:-1]), parts[-1]))  # pid, topcmd, power
info, args = ae.proc_maps()
sm = ae.session_map(info)   # pid -> (session name, confident) for claude rows
links = sys.stdout.isatty()
table_rows = []
for pid, topcmd, power in rows[:n]:
    proc, detail = ae.describe(pid, info, args, sm, links, topcmd)
    table_rows.append([pid, proc, detail, power])
print(ae.render_table(["PID", "Process", "What it is", "Power"], table_rows,
                      ["l", "l", "l", "r"]))
iterm = os.environ.get("TERM_PROGRAM") == "iTerm.app"
handler = os.path.exists(os.path.expanduser("~/Applications/AppleEnergyJump.app"))
print(ae.action_footer(links, iterm, handler))
print("Full Claude session list: apple-energy claude")
PY
}

# ---- watch: sample powermetrics over a window, aggregate per process -----
cmd_watch() {
  local mins="${1:-2}" secs="${2:-5}"
  [[ "$mins" =~ ^[0-9]+$ && "$secs" =~ ^[0-9]+$ ]] || die "mins/secs must be integers"
  (( mins > 0 && secs > 0 )) || die "mins/secs must be > 0"

  local interval_ms=$(( secs * 1000 ))
  local count=$(( mins * 60 / secs ))
  (( count > 0 )) || count=1

  need_sudo
  echo "Sampling energy impact every ${secs}s for ${mins}min ($count samples)…" >&2
  echo "Ranked top consumers print when the window completes. Ctrl-C to stop early." >&2
  echo >&2

  local raw
  raw=$(mktemp -t apple-energy) || die "mktemp failed"
  trap 'rm -f "$raw"' RETURN

  "${SUDO[@]}" powermetrics --samplers tasks --show-process-energy \
      -f plist -i "$interval_ms" -n "$count" 2>/dev/null > "$raw"

  APPLE_ENERGY_RAW="$raw" python3 <<'PY'
import os, plistlib
raw = open(os.environ["APPLE_ENERGY_RAW"], "rb").read()
docs = [d for d in raw.split(b"\x00") if d.strip()]
agg, last_pid, samples = {}, {}, 0
for d in docs:
    try:
        pl = plistlib.loads(d)
    except Exception:
        continue
    tasks = pl.get("tasks") or []
    if not tasks:
        continue
    samples += 1
    for t in tasks:
        name = t.get("name", "?")
        ei = t.get("energy_impact")
        if ei is None:
            ei = t.get("energy_impact_per_s", 0.0)
        agg[name] = agg.get(name, 0.0) + float(ei or 0.0)
        last_pid[name] = t.get("pid", "")
if samples == 0:
    print("No energy data captured (no samples parsed).")
    raise SystemExit(0)
rows = sorted(agg.items(), key=lambda kv: kv[1], reverse=True)[:20]
total = sum(agg.values()) or 1.0
print("Energy impact over %d sample(s) — ranked (relative units, = Activity Monitor metric)\n" % samples)
print("%-28s%8s%12s%11s%7s" % ("PROCESS", "PID", "TOTAL", "AVG/smp", "%"))
print("-" * 66)
for name, tot in rows:
    print("%-28s%8s%12.1f%11.2f%6.1f%%" % (name[:27], str(last_pid.get(name, "")), tot, tot/samples, 100*tot/total))
PY
}

# ---- power: system watts (CPU/GPU/package) -------------------------------
cmd_power() {
  local n="${1:-5}"
  need_sudo
  echo "System power draw, ${n} samples @1s (CPU / GPU / package, in mW)" >&2
  echo >&2
  "${SUDO[@]}" powermetrics --samplers cpu_power,gpu_power -i 1000 -n "$n" 2>/dev/null \
    | grep -Ei 'power|frequency' | grep -Ei 'mW|MHz|Watts' || true
}

# ---- adapter: power source / adapter / battery (no sudo) -----------------
cmd_adapter() {
  echo "Power adapter + battery:"
  system_profiler SPPowerDataType 2>/dev/null \
    | grep -Ei 'AC Charger|Connected:|Wattage|Charging:|State of Charge|Cycle Count|Condition|Fully Charged|Charge Remaining|Full Charge Capacity' \
    | sed 's/^[[:space:]]*/  /'
  echo
  echo "Current source (pmset):"
  pmset -g batt | sed 's/^/  /'
}

# ---- claude: enumerate running Claude Code sessions ----------------------
# Claude Code installs each version as a binary NAMED after its version
# (~/.local/share/claude/versions/2.1.197), so `top` shows "2.1.193" etc. This
# resolves every running instance's real version (via lsof txt), its project
# (cwd), age, CPU, and TTY, and flags any not on the current symlinked version.
cmd_claude() {
  python3 <<'PY'
import os, sys, subprocess
sys.path.insert(0, os.environ["APPLE_ENERGY_BIN"])
import _apple_energy as ae
cur = ae.current_version()
info, _ = ae.proc_maps()
sm = ae.session_map(info)
links = sys.stdout.isatty()      # only emit clickable TTYs to a real terminal
iterm = os.environ.get("TERM_PROGRAM") == "iTerm.app"   # OSC 8 clicks: iTerm2 only
handler = os.path.exists(os.path.expanduser("~/Applications/AppleEnergyJump.app"))
print("Running Claude Code sessions (current installed version: %s)\n" % cur)
headers = ["PID", "Version", "", "Age", "%CPU", "Term", "TTY", "Project", "Session name"]
table_rows = []
total = old = 0
for p in ae.claude_pids():
    cpu = subprocess.run(["ps", "-p", p, "-o", "%cpu="],
                         capture_output=True, text=True).stdout.strip()
    if not cpu or p not in info:
        continue
    r = ae.claude_row(p, info)
    flag = "OLD" if r["old"] else "ok"
    name, conf = sm.get(p, ("", False))
    if name and not conf:
        name = "~" + name           # ~ = inferred (start-times didn't match; e.g. resumed)
    total += 1
    old += 1 if r["old"] else 0
    proj = os.path.basename(r["cwd"].rstrip("/")) or r["cwd"]
    tty = ae.hyperlink("aejump://%s" % p, r["tty"]) if links else r["tty"]
    table_rows.append([p, r["ver"], flag, r["age"], cpu + "%",
                       r["term"], tty, proj[:22], (name or "?")[:44]])
aligns = ["l", "l", "l", "l", "r", "l", "l", "l", "l"]
print(ae.render_table(headers, table_rows, aligns))
print()
print("%d session(s), %d on an OLD version. Restart an OLD one to pick up %s." % (total, old, cur))
print(ae.action_footer(links, iterm, handler))
PY
}

# ---- _resolve: machine-readable "TERM<TAB>/dev/ttyNNN" for a pid (used by the applet) ----
cmd_resolve() {
  [[ $# -ge 1 ]] || die "usage: apple-energy _resolve <pid>"
  APPLE_ENERGY_TARGET="$1" python3 <<'PY'
import os, sys
sys.path.insert(0, os.environ["APPLE_ENERGY_BIN"])
import _apple_energy as ae
pid = os.environ["APPLE_ENERGY_TARGET"]
info, _ = ae.proc_maps()
if pid not in info:
    sys.exit(1)
r = ae.claude_row(pid, info)
tty = r["tty"]
dev = tty if tty.startswith("/dev/") else "/dev/" + tty
print("%s\t%s" % (r["term"], dev))
PY
}

# ---- install-jump: register the aejump:// URL scheme so TTYs are Cmd-clickable ----
# The applet's `on open location` sends the AppleEvent to iTerm2/Terminal DIRECTLY
# (not via a nested osascript) so macOS can attribute it to the app and show the
# one-time Automation prompt — burying the tell in shell→python→osascript caused a
# silent -1743 "not authorised" with no prompt.
cmd_install_jump() {
  local app="$HOME/Applications/AppleEnergyJump.app"
  local bin="$APPLE_ENERGY_BIN/apple-energy"
  local tmp; tmp="$(mktemp -t aejump)".applescript
  cat > "$tmp" <<'APPLESCRIPT'
on logline(msg)
	do shell script "mkdir -p $HOME/.local/state/apple-energy; echo " & quoted form of ((do shell script "date '+%H:%M:%S'") & " " & msg) & " >> $HOME/.local/state/apple-energy/jump.log"
end logline

on open location this_URL
	logline("FIRED " & this_URL)
	set AppleScript's text item delimiters to "//"
	set _pid to last text item of this_URL
	set AppleScript's text item delimiters to ""
	try
		set _res to (do shell script "__BIN__ _resolve " & quoted form of _pid)
	on error
		logline("resolve-failed (pid gone?) " & _pid)
		return
	end try
	set AppleScript's text item delimiters to tab
	set _term to text item 1 of _res
	set _tty to text item 2 of _res
	set AppleScript's text item delimiters to ""
	set _status to "notfound"
	try
		if _term is "iTerm2" then
			tell application "iTerm2"
				repeat with w in windows
					repeat with t in tabs of w
						repeat with s in sessions of t
							if tty of s is _tty then
								select s
								select t
								select w
								activate
								set _status to "ok"
							end if
						end repeat
					end repeat
				end repeat
			end tell
		else if _term is "Terminal" then
			tell application "Terminal"
				repeat with w in windows
					repeat with tb in tabs of w
						if tty of tb is _tty then
							set selected of tb to true
							set frontmost of w to true
							activate
							set _status to "ok"
						end if
					end repeat
				end repeat
			end tell
		end if
	on error e
		set _status to "ERR " & e
	end try
	do shell script "mkdir -p $HOME/.local/state/apple-energy; echo " & quoted form of (_pid & " " & _term & " " & _tty & " :: " & _status) & " >> $HOME/.local/state/apple-energy/jump.log"
end open location
APPLESCRIPT
  sed -i '' "s|__BIN__|$bin|g" "$tmp"
  mkdir -p "$HOME/Applications"
  rm -rf "$app"
  osacompile -o "$app" "$tmp" || die "osacompile failed"
  rm -f "$tmp"
  local plist="$app/Contents/Info.plist"
  local bundleid="com.esaruoho.apple-energy-jump"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $bundleid" "$plist" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string $bundleid" "$plist" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes array" "$plist" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes:0:CFBundleURLName string com.esaruoho.apple-energy.jump" "$plist" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes:0:CFBundleURLSchemes array" "$plist" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string aejump" "$plist" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Add :NSAppleEventsUsageDescription string Focuses the terminal tab of a Claude session." "$plist" 2>/dev/null || true
  # NOT LSUIElement: a foreground app makes the one-time Automation prompt frontmost/unmissable.
  codesign --force --deep -s - "$app" 2>/dev/null || true   # ad-hoc: stable TCC identity
  tccutil reset AppleEvents "$bundleid" 2>/dev/null || true # clear any stale deny → fresh prompt
  local LSR=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  [[ -x "$LSR" ]] && "$LSR" -f "$app" 2>/dev/null || true
  echo "✓ Installed $app and registered aejump:."
  echo "  In iTerm2, Cmd-click a TTY in 'apple-energy claude'. The FIRST click pops a"
  echo "  one-time 'AppleEnergyJump wants to control iTerm2' prompt — click OK, then it jumps."
}

# ---- jump: bring a claude session's terminal window/tab to the front --------
# Uses the terminal app's OWN AppleScript verbs (select tab / activate) — NOT
# System Events keystrokes — so it's proper window management, not a UI hijack.
# You asked for it: it deliberately focuses the target window.
cmd_jump() {
  [[ $# -ge 1 ]] || die "usage: apple-energy jump <pid|tty|version|project-substring>"
  APPLE_ENERGY_TARGET="$*" python3 <<'PY'
import os, sys, subprocess
sys.path.insert(0, os.environ["APPLE_ENERGY_BIN"])
import _apple_energy as ae
target = os.environ["APPLE_ENERGY_TARGET"].strip().lower()
info, _ = ae.proc_maps()
sm = ae.session_map(info)
matches = []
for p in ae.claude_pids():
    if p not in info:
        continue
    r = ae.claude_row(p, info)
    r["name"] = sm.get(p, ("", False))[0]
    tty = r["tty"].lower()
    hay = " ".join([p, r["ver"], r["cwd"], tty, r["term"], r["name"]]).lower()
    if target == p or target == tty or ("ttys" + target) == tty or target in hay:
        matches.append(r)
if not matches:
    print("No claude session matches '%s'. Try `apple-energy claude` to see them." % target)
    sys.exit(1)
if len(matches) > 1:
    print("Ambiguous — '%s' matches %d sessions:" % (target, len(matches)))
    for r in matches:
        print("  pid %s  %s  %s  %s %s  %s  «%s»"
              % (r["pid"], r["ver"], r["age"], r["term"], r["tty"], r["cwd"], r.get("name", "")))
    print("Re-run with a unique PID, tty, or name.")
    sys.exit(1)
r = matches[0]
tty = r["tty"]
dev = tty if tty.startswith("/dev/") else "/dev/" + tty
app = r["term"]
if app == "iTerm2":
    scpt = '''
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if tty of s is "%s" then
          select s
          select t
          select w
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell
return "notfound"''' % dev
elif app == "Terminal":
    scpt = '''
tell application "Terminal"
  repeat with w in windows
    repeat with t in tabs of w
      if tty of t is "%s" then
        set selected of t to true
        set frontmost of w to true
        activate
        return "ok"
      end if
    end repeat
  end repeat
end tell
return "notfound"''' % dev
else:
    print("Session pid %s is on '%s' (%s) — jump only scripts iTerm2/Terminal." % (r["pid"], app, tty))
    sys.exit(1)
out = subprocess.run(["osascript", "-e", scpt], capture_output=True, text=True)
res = (out.stdout or "").strip()
if res == "ok":
    print("→ jumped to %s: claude %s in %s (%s %s)" % (app, r["ver"], r["cwd"], app, tty))
else:
    print("Could not focus %s %s (%s). stderr: %s" % (app, tty, res, out.stderr.strip()))
    sys.exit(1)
PY
}

# ---- heat: watts ARE heat + thermal pressure + throttle + fans -----------
# On a chip essentially 100% of electrical power is dissipated as heat, so the
# package power in watts IS the heat-generation rate. Temperature is what results
# when that heat outruns the cooling. Apple Silicon doesn't expose a clean CPU
# die temp, so we report the drivers: watts, thermal pressure, throttle, fans.
cmd_heat() {
  local n="${1:-1}"
  echo "Heat = watts. A chip turns ~100% of the power it draws into heat, so the"
  echo "package power below IS the heat being generated right now. Higher %CPU →"
  echo "more watts → more heat → fans spin up, then the OS throttles (Speed Limit<100)."
  echo
  echo "Throttle / thermal state (pmset -g therm, no sudo):"
  pmset -g therm 2>/dev/null | sed 's/^/  /'
  echo
  need_sudo
  echo "Package power + thermal pressure + fans (powermetrics, $n sample @1s):" >&2
  echo >&2
  "${SUDO[@]}" powermetrics --samplers cpu_power,thermal,smc -i 1000 -n "$n" 2>/dev/null \
    | grep -Ei 'Power:|pressure|Fan|temperature|die temp|Combined Power' \
    | grep -viE 'idle|GPU HW active frequency' \
    | sed 's/^/  /' \
    || echo "  (no powermetrics data — sudo may have been declined)"
}

# ---- kill: SIGTERM a hog right now ---------------------------------------
# Critical processes are refused so a fat-fingered name can't take down the box.
CRITICAL_RE='^(kernel_task|launchd|WindowServer|loginwindow|coreaudiod|mds|mds_stores|systemstats|logind|opendirectoryd|configd|powerd)$'
cmd_kill() {
  [[ $# -ge 1 ]] || die "usage: apple-energy kill <name|pid> [<name|pid> …]"
  local pids=() t
  for t in "$@"; do
    if [[ "$t" =~ ^[0-9]+$ ]]; then
      pids+=("$t")
    else
      while read -r p; do [[ -n "$p" ]] && pids+=("$p"); done < <(pgrep -i "$t" 2>/dev/null || true)
    fi
  done
  [[ ${#pids[@]} -gt 0 ]] || { echo "No running process matched."; return 0; }
  local killed=0
  for p in "${pids[@]}"; do
    [[ "$p" == "$$" ]] && continue
    local comm; comm=$(ps -p "$p" -o comm= 2>/dev/null | xargs basename 2>/dev/null || true)
    [[ -z "$comm" ]] && continue
    if (( p < 50 )) || [[ "$comm" =~ $CRITICAL_RE ]]; then
      echo "  ⚠︎ refusing to kill $p ($comm) — critical/system process"
      continue
    fi
    if kill -TERM "$p" 2>/dev/null; then
      echo "  ✗ killed $p ($comm)"
      killed=$((killed+1))
    else
      echo "  ⚠︎ could not kill $p ($comm) — may need sudo (system-owned)"
    fi
  done
  echo
  echo "$killed process(es) terminated. If it comes back, it's launchd-kept →"
  echo "use: apple-energy off <name>   (stops it AND keeps it off)."
}

# ---- off: stop + disable a launchd job so it stays dead -------------------
cmd_off() {
  local yes=0 q=""
  local a
  for a in "$@"; do case "$a" in --yes|-y) yes=1 ;; *) q="$a" ;; esac; done
  [[ -n "$q" ]] || die "usage: apple-energy off <name> [--yes]"

  local plan
  plan=$(APPLE_ENERGY_Q="$q" python3 <<'PY'
import os, glob, subprocess
q = os.environ["APPLE_ENERGY_Q"].lower()
uid = str(os.getuid())
dirs = [
    (os.path.expanduser("~/Library/LaunchAgents"), "gui/%s" % uid),
    ("/Library/LaunchAgents", "gui/%s" % uid),
    ("/Library/LaunchDaemons", "system"),
]
def pb(path, key):
    try:
        return subprocess.check_output(
            ["/usr/libexec/PlistBuddy", "-c", "Print :%s" % key, path],
            stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        return ""
seen = set()
for d, domain in dirs:
    for p in sorted(glob.glob(os.path.join(d, "*.plist"))):
        label = pb(p, "Label") or os.path.splitext(os.path.basename(p))[0]
        prog = pb(p, "Program") or pb(p, "ProgramArguments:0")
        hay = " ".join([os.path.basename(p), label, os.path.basename(prog)]).lower()
        if q in hay:
            k = (domain, label)
            if k in seen:
                continue
            seen.add(k)
            print("\t".join([domain, label, prog, p]))
PY
)
  if [[ -z "$plan" ]]; then
    echo "No launchd job matches '$q'."
    echo "(For a one-shot stop of a running process, use: apple-energy kill $q)"
    return 0
  fi

  echo "Matched launchd job(s) for '$q':"
  echo
  printf '%s\n' "$plan" | while IFS=$'\t' read -r domain label prog path; do
    echo "  • $label   [$domain]"
    echo "      program: ${prog:-?}"
    echo "      plist:   $path"
  done
  echo

  if [[ $yes -eq 0 ]]; then
    echo "Dry run — nothing changed. To STOP now and keep it off across logins:"
    echo "    apple-energy off $q --yes"
    return 0
  fi

  printf '%s\n' "$plan" | while IFS=$'\t' read -r domain label prog path; do
    local SUDO2=(); [[ "$domain" == system* && $EUID -ne 0 ]] && SUDO2=(sudo)
    echo "→ stopping + disabling $label ($domain)…"
    "${SUDO2[@]}" launchctl bootout "$domain/$label" 2>/dev/null || true
    "${SUDO2[@]}" launchctl disable "$domain/$label" 2>/dev/null || true
    echo "    undo: ${SUDO2[*]:+sudo }launchctl enable $domain/$label  (then log out/in)"
  done
  pkill -i "$q" 2>/dev/null || true
  echo
  echo "Done. Verify with: apple-energy now"
}

# ---- dispatch ------------------------------------------------------------
case "${1:-help}" in
  now)      shift; cmd_now "$@" ;;
  watch)    shift; cmd_watch "$@" ;;
  power)    shift; cmd_power "$@" ;;
  heat)     shift; cmd_heat "$@" ;;
  adapter)  shift; cmd_adapter "$@" ;;
  claude)   shift; cmd_claude "$@" ;;
  jump)         shift; cmd_jump "$@" ;;
  _resolve)     shift; cmd_resolve "$@" ;;
  install-jump) shift; cmd_install_jump "$@" ;;
  kill)     shift; cmd_kill "$@" ;;
  off)      shift; cmd_off "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command '${1}'. Try '$PROG help'." ;;
esac
