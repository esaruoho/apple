#!/usr/bin/env swift
// apple-intent — natural language → an Apple-skill action, via on-device ML
// embeddings. The NON-TAHOE twin of `fm`'s tool-routing: NO FoundationModels,
// no LLM, no Mini required to DECIDE. It embeds what you type with Apple's
// NLEmbedding (built into every Mac since macOS 10.15), cosine-matches it
// against the `apple-do` capability registry, and runs the closest one.
//
//   apple-intent "how warm is it at home"      → runs:  apple-do home
//   apple-intent "what time is it"              → runs:  apple-do now
//   apple-intent "find my notes about asobjc"   → runs:  apple-do search "find my notes about asobjc"
//   apple-intent --dry-run "is the mini busy"   → prints the match, runs nothing
//   apple-intent --top 3 "..."                  → show the ranked matches + scores
//
// Why embeddings and not keywords: "how warm is it indoors" has no word in common
// with "temperature/humidity" yet maps to `home`. Meaning, not string overlap.
//
// Apple-native: NaturalLanguage only. No Homebrew, no pip, no network to match.
import Foundation
import NaturalLanguage

struct Intent { let action: String; let needsArg: Bool; let desc: String; let examples: [String] }

// The catalog is the ONE shared file shared/intents.json — also read by AppleBar
// for live suggestions. Add an intent there (+ a case in apple-do); both pick it up.
func loadCatalog() -> [Intent] {
    let dir = URL(fileURLWithPath: CommandLine.arguments[0]).resolvingSymlinksInPath().deletingLastPathComponent()
    let path = dir.deletingLastPathComponent().appendingPathComponent("shared/intents.json")
    guard let data = try? Data(contentsOf: path),
          let obj = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
          let arr = obj["intents"] as? [[String: Any]] else {
        FileHandle.standardError.write("apple-intent: can't read \(path.path)\n".data(using: .utf8)!)
        return []
    }
    return arr.compactMap { d in
        guard let a = d["action"] as? String, let ex = d["examples"] as? [String] else { return nil }
        return Intent(action: a, needsArg: (d["needsArg"] as? Bool) ?? false,
                      desc: (d["desc"] as? String) ?? a, examples: ex)
    }
}
let CATALOG = loadCatalog()

// ── args ──
var args = Array(CommandLine.arguments.dropFirst())
let dryRun = args.contains("--dry-run"); args.removeAll { $0 == "--dry-run" }
let showJSON = args.contains("--json"); args.removeAll { $0 == "--json" }
let speak = args.contains("--speak"); args.removeAll { $0 == "--speak" }   // LLM rephrase via FM (Mini)
let rawOut = args.contains("--raw"); args.removeAll { $0 == "--raw" }       // skip the whitelabel template
func opt(_ n: String) -> String? {
    guard let i = args.firstIndex(of: n), i + 1 < args.count else { return nil }
    let v = args[i + 1]; args.remove(at: i + 1); args.remove(at: i); return v
}
let topN = max(1, Int(opt("--top") ?? "1") ?? 1)
let threshold = Double(opt("--threshold") ?? "0.45") ?? 0.45
let forcedAction = opt("--action")   // AppleBar passes this for the suggestion you picked
let query = args.joined(separator: " ").trimmingCharacters(in: .whitespaces)

func die(_ s: String, _ code: Int32 = 1) -> Never {
    FileHandle.standardError.write((s + "\n").data(using: .utf8)!); exit(code)
}
guard !query.isEmpty else {
    die("usage: apple-intent [--dry-run] [--top N] [--threshold X] [? <question>] \"what you want\"", 2)
}

let scriptDir = URL(fileURLWithPath: CommandLine.arguments[0]).resolvingSymlinksInPath().deletingLastPathComponent().path
let learnedPath = (ProcessInfo.processInfo.environment["HOME"] ?? NSHomeDirectory()) + "/.config/apple-bar/learned.feature"

// ── converse mode: talk to the on-device LLM on the Mini ──
// Triggers (all answer via fm-submit):
//   "? <question>"        → answer grounded in your LEARNED rules (learned.feature)
//   "chat <question>"     → general chat, no rules context
//   "converse <question>" → same as chat
// The bar logs every run as a Gherkin scenario into learned.feature, so "?" can read
// that accumulated corpus back. This is the escape hatch for anything the router
// can't place.
let lowerQ = query.lowercased()
var converseQuestion: String? = nil
var converseWithRules = false
if query.hasPrefix("?") {
    converseQuestion = String(query.dropFirst()).trimmingCharacters(in: .whitespaces); converseWithRules = true
} else if lowerQ == "chat" || lowerQ == "converse" {
    converseQuestion = ""
} else if lowerQ.hasPrefix("chat ") {
    converseQuestion = String(query.dropFirst(5)).trimmingCharacters(in: .whitespaces)
} else if lowerQ.hasPrefix("converse ") {
    converseQuestion = String(query.dropFirst(9)).trimmingCharacters(in: .whitespaces)
} else {
    // Conversational openers → general chat (NOT a capability/notes search). Keep this
    // list in sync with AppleBar.isConverse(). "talk to me about chess" must talk, not search.
    let openers = ["talk to me about ", "tell me about ", "talk about ",
                   "let's talk about ", "lets talk about ", "let's chat about ", "what do you think about "]
    // Keep the FULL natural sentence as the question ("talk to me about chess"), not just
    // the tail ("chess") — the LLM expounds instead of asking "what's your question?".
    if openers.contains(where: { lowerQ.hasPrefix($0) }) { converseQuestion = query }
}
if let q = converseQuestion {
    if q.isEmpty && !converseWithRules {
        print("Type:  chat <your question>   (or  ? <question about your saved rules>)"); exit(0)
    }
    var prompt: String
    if converseWithRules {
        var context = ""
        if let d = FileManager.default.contents(atPath: learnedPath), let s = String(data: d, encoding: .utf8) {
            context = String(s.suffix(3000))
        }
        prompt = q.isEmpty
            ? "Summarise concisely what these saved rules say:\n\n\(context)"
            : "Answer concisely, using these saved rules as context. Add no facts not supported by them or general knowledge.\n\nSAVED RULES:\n\(context)\n\nQUESTION: \(q)"
    } else {
        prompt = "Answer concisely and helpfully.\n\nQUESTION: \(q)"
    }
    // fm-submit (one-shot, on-device LLM on the Mini). fm-converse would add stateful
    // memory but currently hangs; swap it back here once that's fixed.
    let fmPath = scriptDir + "/fm-submit"
    guard FileManager.default.isExecutableFile(atPath: fmPath) else { die("fm-submit not found at \(fmPath)") }
    let r = runCapture(fmPath, ["--wait", prompt], mergeErr: false)
    let said = r.out.trimmingCharacters(in: .whitespaces)
    // Every real FoundationModels answer is banked — a durable, browsable record of
    // what the on-device model has told you, so it can be recalled (and one day fed
    // back as context, the way "?" reads learned.feature). Saved on success only.
    if r.code == 0 && !said.isEmpty {
        saveToKnowledgebank(question: q.isEmpty ? "(summarise my saved rules)" : q,
                            mode: converseWithRules ? "ask" : "chat", answer: said)
    }
    print(said.isEmpty ? "(no answer from the model)" : said)
    // "chat"/"talk to me" should TALK: speak the answer back in Zoe (like `convey talk`).
    // Detached so it keeps speaking after this process exits — AppleBar waits for our
    // exit before showing the result, so a blocking `say` would freeze the panel until
    // speech ended. Opt out with FM_CHAT_SPEAK=0 (e.g. headless/piped callers).
    if r.code == 0 && !said.isEmpty && ProcessInfo.processInfo.environment["FM_CHAT_SPEAK"] != "0" {
        speakDetached(said)
    }
    exit(r.code)
}

// Speak text via Apple-native `say` (Zoe (Premium) by default), without waiting —
// the process is reparented to launchd when we exit and keeps talking.
func speakDetached(_ text: String) {
    let p = Process()
    p.executableURL = URL(fileURLWithPath: "/usr/bin/say")
    var args: [String] = []
    if let v = zoeVoice() { args += ["-v", v] }
    args.append(text)
    p.arguments = args
    // CRITICAL: give say its OWN null stdio. If it inherits our stdout pipe, a parent
    // that reads with readDataToEndOfFile() blocks until say finishes (the pipe's write
    // end stays open while say talks) — which would hide the answer until speech ended.
    p.standardInput = FileHandle.nullDevice
    p.standardOutput = FileHandle.nullDevice
    p.standardError = FileHandle.nullDevice
    try? p.run()   // intentionally NOT waitUntilExit — detach and let it speak
}

// Zoe (Premium) if installed (Apple's best built-in voice), else the system default;
// CONVEY_VOICE overrides. Mirrors convey's _default_say_voice so talk/chat sound alike.
func zoeVoice() -> String? {
    if let v = ProcessInfo.processInfo.environment["CONVEY_VOICE"], !v.isEmpty { return v }
    let r = runCapture("/usr/bin/say", ["-v", "?"])
    return r.out.contains("Zoe (Premium)") ? "Zoe (Premium)" : nil
}

// ── FoundationModels knowledgebank ──────────────────────────────────────────
// Append-only markdown bank of every chat/ask answer the on-device model gives.
// Lives beside learned.feature in ~/.config/apple-bar/; override with FM_KNOWLEDGEBANK.
// FEATURE-CARD >> features/fm-knowledgebank.feature
func saveToKnowledgebank(question: String, mode: String, answer: String) {
    let home = ProcessInfo.processInfo.environment["HOME"] ?? NSHomeDirectory()
    let path = ProcessInfo.processInfo.environment["FM_KNOWLEDGEBANK"]
        ?? home + "/.config/apple-bar/foundationmodels-knowledgebank.md"
    let dir = (path as NSString).deletingLastPathComponent
    try? FileManager.default.createDirectory(atPath: dir, withIntermediateDirectories: true)
    if !FileManager.default.fileExists(atPath: path) {
        let head = "# FoundationModels Knowledgebank\n\n"
            + "Every `chat`/`?` answer from the on-device model (fm-submit → the Mini), "
            + "appended for recall.\n\n"
        try? head.write(toFile: path, atomically: true, encoding: .utf8)
    }
    let df = DateFormatter(); df.dateFormat = "yyyy-MM-dd HH:mm:ss"
    let stamp = df.string(from: Date())
    let entry = "## \(stamp) · \(mode)\n\n**Q:** \(question)\n\n\(answer)\n\n---\n\n"
    if let fh = FileHandle(forWritingAtPath: path) {
        fh.seekToEndOfFile()
        if let d = entry.data(using: .utf8) { fh.write(d) }
        try? fh.close()
    }
}

struct Scored { let intent: Intent; let score: Double; let via: String }
var scored: [Scored] = []
let top: Scored

if let fa = forcedAction {
    // AppleBar picked this suggestion explicitly — no embedding needed.
    guard let intent = CATALOG.first(where: { $0.action == fa }) else { die("apple-intent: unknown action '\(fa)'") }
    top = Scored(intent: intent, score: 1.0, via: "(picked)")
} else {
    guard let emb = NLEmbedding.sentenceEmbedding(for: .english) else {
        die("no on-device sentence-embedding model (needs macOS 10.15+).")
    }
    func vec(_ s: String) -> [Double]? { emb.vector(for: s.lowercased()) }
    func cosine(_ a: [Double], _ b: [Double]) -> Double {
        var d = 0.0, na = 0.0, nb = 0.0
        for i in 0..<a.count { d += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i] }
        return (na == 0 || nb == 0) ? 0 : d / (sqrt(na) * sqrt(nb))
    }
    guard let qv = vec(query) else { die("couldn't embed the query (try different words).") }
    for intent in CATALOG {
        var best = -1.0, bestVia = ""
        for ex in intent.examples {
            guard let ev = vec(ex) else { continue }
            let c = cosine(qv, ev)
            if c > best { best = c; bestVia = ex }
        }
        scored.append(Scored(intent: intent, score: best, via: bestVia))
    }
    scored.sort { $0.score > $1.score }

    if showJSON {
        let arr = scored.prefix(topN).map {
            "{\"action\":\"\($0.intent.action)\",\"score\":\(String(format: "%.4f", $0.score)),\"via\":\"\($0.via)\"}"
        }
        print("[\(arr.joined(separator: ","))]"); exit(0)
    }
    guard let first = scored.first else { die("no match.") }
    if first.score < threshold {
        print("apple-intent: not confident which action fits \"\(query)\" (best \(String(format: "%.2f", first.score))).")
        print("did you mean one of:")
        for s in scored.prefix(3) {
            print(String(format: "  %-10s %.2f  — %@", (s.intent.action as NSString).utf8String!, s.score, s.intent.desc))
        }
        exit(3)
    }
    top = first
}

// Report the match (always), then run it (unless --dry-run).
if topN > 1 || dryRun {
    print("match: \(top.intent.action)  (\(String(format: "%.2f", top.score)))  — \(top.intent.desc)")
    if topN > 1 {
        for s in scored.dropFirst().prefix(topN - 1) {
            print(String(format: "   alt: %-10s %.2f  — %@", (s.intent.action as NSString).utf8String!, s.score, s.intent.desc))
        }
    }
}
if dryRun {
    if top.intent.needsArg { print("would run: apple-do \(top.intent.action) \"\(query)\"") }
    else { print("would run: apple-do \(top.intent.action)") }
    exit(0)
}

// Run it via apple-do (same dir as this script). Arg actions get the full query
// — apple-do's own tool decides what to do with it (search/ocr take it whole).
let here = URL(fileURLWithPath: CommandLine.arguments[0]).resolvingSymlinksInPath().deletingLastPathComponent().path
let doPath = here + "/apple-do"
guard FileManager.default.isExecutableFile(atPath: doPath) else { die("apple-do not found next to apple-intent at \(doPath)") }

func runCapture(_ path: String, _ a: [String], mergeErr: Bool = true) -> (out: String, code: Int32) {
    let p = Process()
    p.executableURL = URL(fileURLWithPath: path)
    p.arguments = a
    var env = ProcessInfo.processInfo.environment
    env["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:" + (env["PATH"] ?? "")
    p.environment = env
    let pipe = Pipe(); p.standardOutput = pipe
    // fm-submit draws a progress spinner on stderr; capture stdout only there so
    // the answer comes back clean. apple-do merges stderr so its errors surface.
    p.standardError = mergeErr ? pipe : FileHandle.nullDevice
    do { try p.run() } catch { return ("couldn't run \(path): \(error.localizedDescription)", 1) }
    let d = pipe.fileHandleForReading.readDataToEndOfFile()
    p.waitUntilExit()
    return (String(data: d, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines) ?? "", p.terminationStatus)
}

let doArgs = top.intent.needsArg ? [top.intent.action, query] : [top.intent.action]
let result = runCapture(doPath, doArgs)
let raw = result.out

// ── whitelabel: turn the raw tool output into a human line ──
// Mechanism (field extraction) lives here; the WORDING lives in an editable
// config the user owns. Missing config → defaults written on first run.
func loadTemplates() -> [String: String] {
    let defaults: [String: String] = [
        "home": "It's {tempC}°C at home, {humid}% humidity ({age}).",
        "address": "{raw}",
        "directions": "{raw}",
        "now": "{raw}", "fleet": "{raw}", "spotlight": "{raw}", "search": "{raw}", "ocr": "{raw}",
    ]
    let cfgDir = (ProcessInfo.processInfo.environment["HOME"] ?? "") + "/.config/apple-intent"
    let cfgPath = cfgDir + "/reports.json"
    if let d = FileManager.default.contents(atPath: cfgPath),
       let obj = try? JSONSerialization.jsonObject(with: d) as? [String: String] {
        return defaults.merging(obj) { _, user in user }   // user overrides win
    }
    // write the defaults so the user has something to edit (the whitelabel surface)
    try? FileManager.default.createDirectory(atPath: cfgDir, withIntermediateDirectories: true)
    if let d = try? JSONSerialization.data(withJSONObject: defaults, options: [.prettyPrinted, .sortedKeys]) {
        try? d.write(to: URL(fileURLWithPath: cfgPath))
    }
    return defaults
}

func firstMatch(_ s: String, _ pattern: String) -> String? {
    guard let re = try? NSRegularExpression(pattern: pattern) else { return nil }
    let ns = s as NSString
    guard let m = re.firstMatch(in: s, range: NSRange(location: 0, length: ns.length)), m.numberOfRanges > 1
    else { return nil }
    return ns.substring(with: m.range(at: 1))
}

func humanize(action: String, raw: String, template: String) -> String {
    var fields: [String: String] = ["raw": raw]
    if action == "home" {
        if let t = firstMatch(raw, "([0-9]+(?:\\.[0-9]+)?)\\s*°C") { fields["tempC"] = t }
        if let h = firstMatch(raw, "([0-9]+(?:\\.[0-9]+)?)\\s*%") { fields["humid"] = h }
        if let a = firstMatch(raw, "\\(([^)]*ago)\\)") { fields["age"] = a }
        // if extraction missed anything the template needs, fall back to raw
        for key in ["tempC", "humid", "age"] where template.contains("{\(key)}") && fields[key] == nil {
            return raw
        }
    }
    var out = template
    for (k, v) in fields { out = out.replacingOccurrences(of: "{\(k)}", with: v) }
    return out
}

var human = raw
if !rawOut {
    let templates = loadTemplates()
    if let t = templates[top.intent.action], !t.isEmpty {
        human = humanize(action: top.intent.action, raw: raw, template: t)
    }
}

// ── optional LLM toggle: rephrase the human line via FM on the Mini ──
if speak, !human.isEmpty {
    let fmPath = here + "/fm-submit"
    if FileManager.default.isExecutableFile(atPath: fmPath) {
        let prompt = "Rephrase this device reading as one short, friendly, natural sentence. "
                   + "Keep every number exactly as given. Add no new facts, omit nothing:\n\n\(human)"
        let r = runCapture(fmPath, ["--wait", prompt], mergeErr: false)
        let said = r.out.trimmingCharacters(in: .whitespacesAndNewlines)
        if r.code == 0, !said.isEmpty, said.lowercased() != "null" { human = said }
        // else: keep the template line (graceful fallback if the Mini is unreachable)
    }
}

// ── learn: append this interaction as a Gherkin scenario ──
// The bar generates content as you use it; learned.feature is the growing,
// fm-converse-able rules corpus (the "? <question>" path reads it back).
func appendLearned(action: String, query: String, result: String) {
    let dir = (ProcessInfo.processInfo.environment["HOME"] ?? NSHomeDirectory()) + "/.config/apple-bar"
    let path = dir + "/learned.feature"
    try? FileManager.default.createDirectory(atPath: dir, withIntermediateDirectories: true)
    let oneLine = result.replacingOccurrences(of: "\n", with: " / ")
    let safeQ = query.replacingOccurrences(of: "\"", with: "'")
    var out = ""
    if !FileManager.default.fileExists(atPath: path) {
        out += "Feature: AppleBar learned rules\n"
        out += "  Auto-generated — one scenario per command-bar use. fm-converse-able via \"? <question>\".\n\n"
    }
    out += "  Scenario: \(safeQ)\n    When I ask \"\(safeQ)\"\n    Then action=\(action) → \(oneLine)\n\n"
    guard let data = out.data(using: .utf8) else { return }
    if let h = try? FileHandle(forWritingTo: URL(fileURLWithPath: path)) {
        h.seekToEndOfFile(); h.write(data); try? h.close()
    } else {
        try? data.write(to: URL(fileURLWithPath: path))
    }
}
appendLearned(action: top.intent.action, query: query, result: human)

print(human)
exit(result.code)
