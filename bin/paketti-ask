#!/usr/bin/env python3
"""paketti-ask — ask a Paketti question; get a VETTED answer instantly, or a live draft.

The "are we sure?" gate:
  • semantic-match the question against the VETTED vault (on-device NLEmbedding).
  • strong match  → serve the trusted, human-certified answer instantly (no model call).
  • weak  match   → draft a fresh answer live (paketti+renoise MLX), flag it UNVETTED,
                    and queue it for rating (paketti-faq-rate).

    paketti-ask "does paketti have a system for changing pattern length?"
    paketti-ask --threshold 0.7 "..."     # tighten/loosen the match gate
"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import paketti_faq as F  # noqa: E402

BOLD, GREEN, DIM, CYAN, YELLOW, RESET = (
    "\033[1m", "\033[32m", "\033[2m", "\033[36m", "\033[33m", "\033[0m")
THRESHOLD = 0.62   # cosine above this = "we're sure it's the same question"


def _render(answer: str):
    try:
        from fm_render import md_to_ansi
        return md_to_ansi(answer) if sys.stdout.isatty() else answer
    except Exception:
        return answer


def main() -> int:
    args = sys.argv[1:]
    thr = THRESHOLD
    discord = "--discord" in args   # clean markdown for the Discord bot: no ANSI, no chrome
    if discord:
        args.remove("--discord")
    if "--threshold" in args:
        i = args.index("--threshold"); thr = float(args[i + 1]); del args[i:i + 2]
    question = " ".join(args).strip()
    if not question:
        print("usage: paketti-ask \"your paketti question\"")
        return 2

    # Ground-truth list-queries ("all midimappings for mixer") answer straight from the function
    # index — no model, every item provably exists. Runs BEFORE the vault/LLM so it can't bullshit.
    fq = F.function_query(question)
    if fq is not None:
        print(fq if discord else _render(fq))
        return 0

    entries = F.load()
    match, score = F.best_match(question, entries, vetted_only=True)

    # ── Discord mode: just the answer + a one-line provenance tag (plain markdown) ──
    if discord:
        if match and score >= thr:
            cites = f"\n\n_cites: {', '.join(match['citations'])}_" if match.get("citations") else ""
            print(f"✅ **Vetted answer** _(certified)_\n\n{match['a']}{cites}")
            return 0
        # Authoritative changelog description (verbatim, no LLM, no invention) before the model path.
        ca = F.changelog_answer(question)
        if ca is not None:
            print(f"📖 **From the changelog** _(Esa's own words — authoritative)_\n\n{ca}")
            return 0
        # Real feature, but no authoritative description → say so honestly, never invent.
        ud = F.feature_undocumented_answer(question)
        if ud is not None:
            print(f"🟡 **Not documented yet** _(reply to teach me)_\n\n{ud}")
            return 0
        ans = F.generate_answer(question)
        if not ans:
            print("⚠️ I couldn't draft an answer right now (the on-device brain didn't respond).")
            return 1
        e = F.new_entry(question, ans)
        F.add(e)
        print(f"🟡 **Draft — unverified** _(from the repo, not yet certified)_\n\n{ans}")
        return 0

    if match and score >= thr:
        # "did the user ask for this? are we sure? — yes. here's the info."
        print(f"{GREEN}✓ vetted answer{RESET} {DIM}(match {score:.2f} ≥ {thr:.2f} · "
              f"certified · id {match['id']}){RESET}")
        print(f"{DIM}matched: {match['q']}{RESET}\n")
        print(_render(match["a"]))
        if match.get("citations"):
            print(f"\n{DIM}cites: {', '.join(match['citations'])}{RESET}")
        return 0

    ca = F.changelog_answer(question)
    if ca is not None:
        print(f"{GREEN}📖 from the changelog{RESET} {DIM}(Esa's own words — authoritative){RESET}\n")
        print(_render(ca))
        return 0

    ud = F.feature_undocumented_answer(question)
    if ud is not None:
        print(f"{YELLOW}🟡 not documented yet{RESET} {DIM}(reply to teach me){RESET}\n")
        print(_render(ud))
        return 0

    # Not sure → live draft, flagged + queued.
    near = f" (closest vetted: {score:.2f} — below {thr:.2f})" if match else " (vault empty)"
    print(f"{YELLOW}⚠ not in the vetted vault{near} — drafting a fresh answer "
          f"(UNVETTED){RESET}\n")
    ans = F.generate_answer(question)
    if not ans:
        print(f"{YELLOW}  (MLX gave no answer — is the Mini's MLX server up?){RESET}")
        return 1
    print(_render(ans))
    e = F.new_entry(question, ans)
    F.add(e)
    print(f"\n{DIM}↳ queued as unvetted (id {e['id']}). Certify it with `paketti-faq-rate` "
          f"so next time it's instant + trusted.{RESET}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
