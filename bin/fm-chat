#!/usr/bin/env python3
"""fm-chat — live conversation with Apple's on-device LLM running on the Mini.

You type, it goes over Syncthing to fm-worker on the Mac Mini (macOS 26 / Tahoe),
FoundationModels generates, and the reply appears here with a live timer — no FM
needed on this machine, no network, no per-token cost.

Conversation context is kept on THIS side: each turn replays the dialogue so far
to the (otherwise stateless) worker, so the model remembers what you said. Short
test chats stay well inside the model's ~65k-token window.

    fm-chat                      start chatting
    fm-chat --system "..."        open with a system instruction (a persona/role)

In-chat commands:
    /reset        forget the conversation so far
    /system TEXT  set/replace the system instruction
    /history      print the running transcript
    /exit /quit   leave (Ctrl-D also works)

Apple-native: python3 stdlib only.
"""

import hashlib
import json
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
QUEUE = Path.home() / "work" / "comms" / "queue"
INBOX = QUEUE / "fm-inbox"
OUTBOX = QUEUE / "fm-outbox"
HEARTBEAT = QUEUE / "fm-worker-heartbeat.json"

BOLD = "\033[1m"; DIM = "\033[2m"; CYAN = "\033[36m"; GREEN = "\033[32m"
YELLOW = "\033[33m"; RESET = "\033[0m"


def nudge(path: Path):
    try:
        subprocess.run([str(HERE / "syncthing-nudge"), str(path)],
                       capture_output=True, timeout=8)
    except Exception:
        pass


def render(history, user_line: str) -> str:
    """Replay the dialogue so far as a single prompt ending with the new turn.
    The system instruction is sent separately (the worker passes it to fm --system)."""
    parts = []
    for role, text in history:
        tag = "User" if role == "user" else "Assistant"
        parts.append(f"{tag}: {text}")
    parts.append(f"User: {user_line}")
    parts.append("Assistant:")
    return "\n".join(parts)


def ask(prompt: str, system: str, timeout: float = 180.0):
    """Submit one prompt, poll the outbox with a live timer, return (result, round_trip)."""
    INBOX.mkdir(parents=True, exist_ok=True)
    h = hashlib.sha1((prompt + str(time.time())).encode()).hexdigest()[:8]
    job_id = f"chat-{time.strftime('%H%M%S')}-{h}"
    spec = {"id": job_id, "prompt": prompt, "system": system,
            "submitted_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "submitter_host": socket.gethostname().split(".")[0]}
    tmp = INBOX / f".{job_id}.tmp"
    final = INBOX / f"{job_id}.json"
    tmp.write_text(json.dumps(spec, ensure_ascii=False))
    tmp.replace(final)
    nudge(final)

    result_path = OUTBOX / f"{job_id}.json"
    t0 = time.time()
    spin = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    i = 0
    while time.time() - t0 < timeout:
        if result_path.exists():
            try:
                res = json.loads(result_path.read_text())
                sys.stdout.write("\r" + " " * 40 + "\r")
                return res, time.time() - t0
            except Exception:
                pass
        i += 1
        sys.stdout.write(f"\r{DIM}  {spin[i % len(spin)]} thinking… {time.time()-t0:4.1f}s{RESET}")
        sys.stdout.flush()
        nudge(OUTBOX)
        time.sleep(0.8)
    sys.stdout.write("\r" + " " * 40 + "\r")
    return None, time.time() - t0


def worker_alive() -> str:
    if not HEARTBEAT.exists():
        return "no heartbeat yet"
    try:
        d = json.loads(HEARTBEAT.read_text())
        age = time.time() - d.get("ts", 0)
        return f"{d.get('host','?')}, {age:.0f}s ago" + (" ⚠ STALE" if age > 120 else "")
    except Exception:
        return "unreadable"


def main() -> int:
    args = sys.argv[1:]
    system = ""
    if args and args[0] in ("-h", "--help"):
        print(__doc__); return 0
    if len(args) >= 2 and args[0] == "--system":
        system = args[1]

    print(f"{BOLD}fm-chat{RESET} — Apple FoundationModels on the Mini  "
          f"{DIM}(worker: {worker_alive()}){RESET}")
    print(f"{DIM}commands: /reset  /system TEXT  /history  /exit{RESET}")
    if system:
        print(f"{DIM}system: {system}{RESET}")
    print()

    history = []   # list of (role, text)
    while True:
        try:
            line = input(f"{CYAN}{BOLD}you ›{RESET} ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nbye.")
            return 0
        if not line:
            continue
        if line in ("/exit", "/quit"):
            print("bye.")
            return 0
        if line == "/reset":
            history = []
            print(f"{DIM}— conversation cleared —{RESET}")
            continue
        if line == "/history":
            for role, text in history:
                who = f"{CYAN}you{RESET}" if role == "user" else f"{GREEN}fm{RESET}"
                print(f"{who}: {text}")
            continue
        if line.startswith("/system"):
            system = line[len("/system"):].strip()
            print(f"{DIM}— system set: {system or '(cleared)'} —{RESET}")
            continue

        prompt = render(history, line)
        res, rt = ask(prompt, system)
        if res is None:
            print(f"{YELLOW}  (timed out after {rt:.0f}s — is fm-worker running on the Mini? "
                  f"`fm-submit --status`){RESET}")
            continue
        if not res.get("ok"):
            print(f"{YELLOW}  fm error: {res.get('err','unknown')}{RESET}")
            continue
        answer = res.get("out", "").strip()
        # the model may echo a leading "Assistant:" from the cue — strip it
        if answer.lower().startswith("assistant:"):
            answer = answer.split(":", 1)[1].strip()
        print(f"{GREEN}{BOLD}fm  ›{RESET} {answer}")
        mm = res.get("model_ms", 0) / 1000
        print(f"{DIM}     [{res.get('host','?')} · model {mm:.1f}s · round-trip {rt:.1f}s]{RESET}\n")
        history.append(("user", line))
        history.append(("assistant", answer))


if __name__ == "__main__":
    sys.exit(main())
