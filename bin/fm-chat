#!/usr/bin/env python3
"""fm-chat — live conversation with Apple's on-device LLM running on the Mini.

You type, it goes over Syncthing to fm-worker on the Mac Mini (macOS 26 / Tahoe),
FoundationModels generates, and the reply appears here with a live timer — no FM
needed on this machine, no network, no per-token cost.

Conversation context is kept on THIS side: each turn replays the dialogue so far
to the (otherwise stateless) worker, so the model remembers what you said. Short
test chats stay well inside the model's ~65k-token window.

    fm-chat                      start chatting
    fm-chat --system "..."        open with a system instruction (a persona/role)

In-chat commands:
    /reset        forget the conversation so far
    /system TEXT  set/replace the system instruction
    /history      print the running transcript
    /exit /quit   leave (Ctrl-D also works)

Apple-native: python3 stdlib only.
"""

import hashlib
import json
import os
import socket
import subprocess
import sys
import time
import uuid as uuidlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
QUEUE = Path.home() / "work" / "comms" / "queue"
INBOX = QUEUE / "fm-inbox"
OUTBOX = QUEUE / "fm-outbox"
HEARTBEAT = QUEUE / "fm-worker-heartbeat.json"

# Persisted sessions so the `sessions` TUI can list + resume an fm-chat.
SESS_DIR = Path.home() / ".fm-chat" / "sessions"


def _spath(uid):
    return SESS_DIR / f"{uid}.jsonl"


def new_session(cwd, system):
    # Don't touch disk yet — the file is written on the FIRST real turn, so
    # opening fm-chat and quitting without chatting leaves no empty session.
    uid = uuidlib.uuid4().hex[:16]
    meta = {"type": "session_meta", "uuid": uid, "cwd": os.path.realpath(cwd),
            "created": time.time(), "system": system or ""}
    return uid, meta


def load_session(uid):
    meta, history = None, []
    try:
        for line in _spath(uid).read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("type") == "session_meta":
                meta = d
            elif d.get("type") == "message":
                history.append((d["role"], d["content"]))
    except FileNotFoundError:
        sys.exit(f"fm-chat: no session {uid}")
    if not meta:
        sys.exit(f"fm-chat: {uid} missing session_meta")
    return meta, history


def append_turn(meta, role, content):
    uid = meta["uuid"]
    path = _spath(uid)
    if not path.exists():                  # lazily create with the meta header
        SESS_DIR.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(meta) + "\n")
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps({"type": "message", "role": role,
                            "content": content, "ts": time.time()}) + "\n")


def list_sessions(folder):
    resolved = os.path.realpath(folder)
    if not SESS_DIR.is_dir():
        print("(no fm-chat sessions yet)"); return
    rows = []
    for p in SESS_DIR.glob("*.jsonl"):
        try:
            meta, hist = load_session(p.stem)
        except SystemExit:
            continue
        if os.path.realpath(meta["cwd"]) != resolved:
            continue
        first = next((c for r, c in hist if r == "user"), "(empty)")
        rows.append((meta["created"], meta["uuid"], len(hist) // 2, first[:60]))
    for created, uid, ex, first in sorted(rows, reverse=True):
        print(f"  {uid}  {ex:3} exch  {first}")
    if not rows:
        print(f"(no fm-chat sessions for {resolved})")

BOLD = "\033[1m"; DIM = "\033[2m"; CYAN = "\033[36m"; GREEN = "\033[32m"
YELLOW = "\033[33m"; RESET = "\033[0m"


def nudge(path: Path):
    try:
        subprocess.run([str(HERE / "syncthing-nudge"), str(path)],
                       capture_output=True, timeout=8)
    except Exception:
        pass


def render(history, user_line: str) -> str:
    """Replay the dialogue so far as a single prompt ending with the new turn.
    The system instruction is sent separately (the worker passes it to fm --system)."""
    parts = []
    for role, text in history:
        tag = "User" if role == "user" else "Assistant"
        parts.append(f"{tag}: {text}")
    parts.append(f"User: {user_line}")
    parts.append("Assistant:")
    return "\n".join(parts)


def ask(prompt: str, system: str, timeout: float = 180.0):
    """Submit one prompt, poll the outbox with a live timer, return (result, round_trip)."""
    INBOX.mkdir(parents=True, exist_ok=True)
    h = hashlib.sha1((prompt + str(time.time())).encode()).hexdigest()[:8]
    job_id = f"chat-{time.strftime('%H%M%S')}-{h}"
    spec = {"id": job_id, "prompt": prompt, "system": system,
            "submitted_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "submitter_host": socket.gethostname().split(".")[0]}
    tmp = INBOX / f".{job_id}.tmp"
    final = INBOX / f"{job_id}.json"
    tmp.write_text(json.dumps(spec, ensure_ascii=False))
    tmp.replace(final)
    nudge(final)

    result_path = OUTBOX / f"{job_id}.json"
    t0 = time.time()
    spin = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    i = 0
    while time.time() - t0 < timeout:
        if result_path.exists():
            try:
                res = json.loads(result_path.read_text())
                sys.stdout.write("\r" + " " * 40 + "\r")
                return res, time.time() - t0
            except Exception:
                pass
        i += 1
        sys.stdout.write(f"\r{DIM}  {spin[i % len(spin)]} thinking… {time.time()-t0:4.1f}s{RESET}")
        sys.stdout.flush()
        nudge(OUTBOX)
        time.sleep(0.8)
    sys.stdout.write("\r" + " " * 40 + "\r")
    return None, time.time() - t0


def humanize_err(err: str) -> str:
    e = (err or "").strip()
    if "guardrail" in e.lower() or "unsafe content" in e.lower():
        return ("Apple's on-device safety guardrail blocked this (it's aggressive). "
                "Rephrase and try again.")
    while e.lower().startswith("fm error:"):
        e = e[len("fm error:"):].strip()
    return e or "unknown"


def worker_alive() -> str:
    if not HEARTBEAT.exists():
        return "no heartbeat yet"
    try:
        d = json.loads(HEARTBEAT.read_text())
        age = time.time() - d.get("ts", 0)
        return f"{d.get('host','?')}, {age:.0f}s ago" + (" ⚠ STALE" if age > 120 else "")
    except Exception:
        return "unreadable"


def _pop(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            v = args[i + 1]; del args[i:i + 2]; return v
    return None


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__); return 0

    do_list = "--list" in args
    if do_list:
        args.remove("--list")
    resume = _pop(args, "--resume")
    cwd = _pop(args, "--cwd") or os.getcwd()
    system = _pop(args, "--system") or ""

    if do_list:
        list_sessions(cwd); return 0

    if resume:
        uid, meta = resume, None
        meta, history = load_session(resume)
        system = meta.get("system", "")
        cwd = meta.get("cwd", cwd)
    else:
        uid, meta = new_session(cwd, system)
        history = []

    print(f"{BOLD}fm-chat{RESET} — Apple FoundationModels on the Mini  "
          f"{DIM}(worker: {worker_alive()}){RESET}")
    print(f"{DIM}session {uid} · {os.path.basename(cwd)} · "
          f"resume later: fm-chat --resume {uid}{RESET}")
    print(f"{DIM}commands: /reset  /system TEXT  /history  /exit{RESET}")
    if system:
        print(f"{DIM}system: {system}{RESET}")
    if history:
        print(f"{DIM}— replaying {len(history)//2} prior exchanges —{RESET}")
        for role, text in history:
            who = f"{CYAN}you{RESET}" if role == "user" else f"{GREEN}fm{RESET}"
            print(f"{who} › {text}")
    print()

    while True:
        try:
            line = input(f"{CYAN}{BOLD}you ›{RESET} ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nbye.")
            return 0
        if not line:
            continue
        if line in ("/exit", "/quit"):
            print("bye.")
            return 0
        if line == "/reset":
            history = []
            print(f"{DIM}— conversation cleared —{RESET}")
            continue
        if line == "/history":
            for role, text in history:
                who = f"{CYAN}you{RESET}" if role == "user" else f"{GREEN}fm{RESET}"
                print(f"{who}: {text}")
            continue
        if line.startswith("/system"):
            system = line[len("/system"):].strip()
            print(f"{DIM}— system set: {system or '(cleared)'} —{RESET}")
            continue

        prompt = render(history, line)
        res, rt = ask(prompt, system)
        if res is None:
            print(f"{YELLOW}  (timed out after {rt:.0f}s — is fm-worker running on the Mini? "
                  f"`fm-submit --status`){RESET}")
            continue
        if not res.get("ok"):
            print(f"{YELLOW}  ⚠ {humanize_err(res.get('err',''))}{RESET}\n")
            continue
        answer = res.get("out", "").strip()
        # the model may echo a leading "Assistant:" from the cue — strip it
        if answer.lower().startswith("assistant:"):
            answer = answer.split(":", 1)[1].strip()
        print(f"{GREEN}{BOLD}fm  ›{RESET} {answer}")
        mm = res.get("model_ms", 0) / 1000
        print(f"{DIM}     [{res.get('host','?')} · model {mm:.1f}s · round-trip {rt:.1f}s]{RESET}\n")
        history.append(("user", line))
        history.append(("assistant", answer))
        append_turn(meta, "user", line)           # persist → resumable in `sessions`
        append_turn(meta, "assistant", answer)


if __name__ == "__main__":
    sys.exit(main())
