#!/usr/bin/env python3
"""paketti-functions-view — render the Paketti function index as a SEARCHABLE, collapsible
mindmap page (self-contained HTML, no deps) so you can SEE all the functions + their triad.

  paketti-functions-view [out.html]      # default /tmp/paketti-functions.html
"""
import html
import json
import sys
from pathlib import Path

INDEX = Path("/Users/esaruoho/work/paketti/docs/paketti-functions.json")
OUT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/tmp/paketti-functions.html")


def main():
    idx = json.loads(INDEX.read_text(encoding="utf-8"))
    areas = sorted(idx.items(), key=lambda kv: -len(kv[1]))
    nfunc = sum(len(v) for v in idx.values())
    nkb = sum(len(f["kb"]) for v in idx.values() for f in v)
    nmi = sum(len(f["midi"]) for v in idx.values() for f in v)
    nme = sum(len(f["menu"]) for v in idx.values() for f in v)

    blocks = []
    for area, fns in areas:
        ck = sum(1 for f in fns if f["kb"]); cm = sum(1 for f in fns if f["midi"]); ce = sum(1 for f in fns if f["menu"])
        rows = []
        for f in sorted(fns, key=lambda f: f["function"].lower()):
            def door(names, glyph):
                if not names:
                    return f'<span class="off">{glyph}</span>'
                tip = html.escape(" · ".join(names))
                return f'<span class="on" title="{tip}">{glyph}</span>'
            rows.append(
                f'<div class="fn" data-t="{html.escape(f["function"].lower())}">'
                f'<span class="nm">{html.escape(f["function"])}</span>'
                f'{door(f["kb"],"⌨")}{door(f["midi"],"🎛")}{door(f["menu"],"☰")}</div>')
        blocks.append(
            f'<details class="area"><summary>{html.escape(area)} '
            f'<b>{len(fns)}</b> <span class="c">⌨{ck} 🎛{cm} ☰{ce}</span></summary>'
            f'<div class="fns">{"".join(rows)}</div></details>')

    doc = f"""<!doctype html><meta charset=utf-8><title>Paketti functions</title>
<style>
 body{{background:#0d0d10;color:#ddd;font:14px/1.5 -apple-system,sans-serif;margin:0;padding:20px;max-width:980px;margin:auto}}
 h1{{font-weight:600;margin:0 0 4px}} .sub{{color:#888;margin-bottom:14px}}
 #q{{width:100%;box-sizing:border-box;padding:10px 12px;font-size:15px;background:#16161c;border:1px solid #333;border-radius:8px;color:#fff;position:sticky;top:10px}}
 details.area{{background:#15151b;border:1px solid #24242c;border-radius:8px;margin:8px 0}}
 summary{{cursor:pointer;padding:10px 12px;font-size:15px;user-select:none}}
 summary b{{color:#fff}} .c{{color:#666;font-size:12px;margin-left:6px}}
 .fns{{padding:2px 12px 10px}}
 .fn{{display:flex;align-items:center;gap:6px;padding:3px 0;border-top:1px solid #1c1c22}}
 .nm{{flex:1}} .on{{opacity:1}} .off{{opacity:.12}}
 .on[title]{{cursor:help}}
 mark{{background:#4338ca;color:#fff}}
</style>
<body>
<h1>Paketti — every function</h1>
<div class=sub><b style="color:#fff">{nfunc:,}</b> functions · {nkb:,} keybindings ⌨ · {nmi:,} midimappings 🎛 · {nme:,} menu entries ☰ · hover a glyph for the exact names</div>
<input id=q placeholder="filter… (e.g. mixer, slice, phrase, volume)" autofocus>
<div id=list>{"".join(blocks)}</div>
<script>
 const q=document.getElementById('q'), areas=[...document.querySelectorAll('details.area')];
 q.oninput=()=>{{const t=q.value.trim().toLowerCase();
   areas.forEach(a=>{{let any=false;
     a.querySelectorAll('.fn').forEach(fn=>{{const m=!t||fn.dataset.t.includes(t);fn.style.display=m?'':'none';if(m)any=true;}});
     a.style.display=any?'':'none'; a.open=!!t&&any;}});}};
</script>
</body>"""
    OUT.write_text(doc, encoding="utf-8")
    print(f"wrote {OUT}  ({nfunc:,} functions, {len(idx)} areas)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
