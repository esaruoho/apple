#!/usr/bin/env python3
"""swiftgen — free, local SwiftUI app scaffolder + best-practices assistant.

Chat → a working SwiftUI app skeleton, generated by FREE models via the freellmapi gateway
(nemotron by default, gemini for harder asks), GUIDED BY Apple's own SwiftUI best-practice skill
(read PRIVATELY at runtime from ~/work/apple/references/xcode27-agent-skills — never embedded, so
this script carries no Apple pre-release content). $0 in the billing sense (free tier / on-device).

  swiftgen "a to-do app with add, delete, and a done toggle" [--out DIR] [--name AppName]
           [--model auto|nemotron-3-super-120b|gemini-2.5-flash] [--build] [--review FILE]

Modes:
  (default)   scaffold a new SwiftUI app into DIR (a Swift Package that `swift build` type-checks)
  --review F  best-practices review of an existing Swift file against Apple's guidance (no scaffold)
"""
import sys, os, re, json, time, urllib.request, urllib.error, subprocess
from pathlib import Path

HOST=os.environ.get("FM_FREE_HOST","http://cloudcitymacmini:3001/v1")
KEY_FILE=Path.home()/".fm-free.key"
APPLE_SKILLS=Path.home()/"work"/"apple"/"references"/"xcode27-agent-skills"
DEFAULT_MODEL=os.environ.get("SWIFTGEN_MODEL","nemotron-3-super-120b")
BIG_MODEL="gemini-2.5-flash"

def key():
    k=os.environ.get("FM_FREE_KEY","") or (KEY_FILE.read_text().strip() if KEY_FILE.exists() else "")
    if not k: sys.exit("swiftgen: no freellmapi key (~/.fm-free.key)")
    return k

def call(model, system, user, max_tokens=6000):
    body=json.dumps({"model":model,"messages":[{"role":"system","content":system},
                     {"role":"user","content":user}],"max_tokens":max_tokens,"temperature":0.3}).encode()
    for attempt in range(5):
        req=urllib.request.Request(HOST.rstrip('/')+"/chat/completions", data=body, method="POST",
            headers={"Authorization":f"Bearer {key()}","Content-Type":"application/json"})
        try:
            with urllib.request.urlopen(req, timeout=240) as r: d=json.load(r)
            return d["choices"][0]["message"]["content"], d.get("model",model)
        except urllib.error.HTTPError as e:
            if e.code==429 and attempt<4: print(f"  rate-limited, waiting 40s…",flush=True); time.sleep(40); continue
            raise

def apple_lens(topic_hint=""):
    """Load Apple's SwiftUI best-practice guidance PRIVATELY (if present) as the system lens. Caps size."""
    if not APPLE_SKILLS.exists(): return ""
    parts=[]
    for sk in ("swiftui-specialist","swiftui-whats-new-27"):
        sm=APPLE_SKILLS/sk/"SKILL.md"
        if sm.exists(): parts.append(sm.read_text(errors="ignore"))
        refs=APPLE_SKILLS/sk/"references"
        if refs.exists():
            for rf in sorted(refs.glob("*.md")):
                parts.append(f"[{sk}/{rf.name}]\n"+rf.read_text(errors="ignore"))
    blob="\n\n".join(parts)
    return blob[:60000]   # gemini/nemotron both hold this comfortably

FILEFMT=("Output each file as EXACTLY this (no JSON, no markdown fences — raw code between the markers, so "
  "quotes/backslashes need no escaping):\n>>>>FILE: <relative/path>\n<full file content>\n<<<<END\n"
  "After all files, optionally one line: NOTES: <1-2 lines what to do next>.")

# We own Package.swift (deterministic): a SwiftUI @main App as an SPM executable needs -parse-as-library
# and NO main.swift, or it fails to compile. The model only writes the Swift SOURCES.
PACKAGE_TMPL=('// swift-tools-version:6.0\nimport PackageDescription\nlet package = Package(\n'
  '  name: "{name}",\n  platforms: [.macOS(.v14)],\n'
  '  targets: [ .executableTarget(name: "{name}", path: "Sources/{name}",\n'
  '             swiftSettings: [.unsafeFlags(["-parse-as-library"])]) ]\n)\n')

SCAFFOLD_SYS=("You are a senior SwiftUI engineer scaffolding a NEW SwiftUI app. Follow the APPLE SWIFTUI "
  "GUIDANCE provided (it supersedes prior knowledge): prefer @Observable over ObservableObject, correct "
  "@State/@Binding, stable ForEach identity, @MainActor + Equatable on models, avoid soft-deprecated APIs "
  "(no NavigationView — use NavigationStack). Generate ONLY the Swift SOURCE files under Sources/<AppName>/: "
  "the @main App entry (a `struct <AppName>: App`), a ContentView, and an @Observable model. Do NOT write "
  "Package.swift and do NOT write a main.swift — the build harness provides Package.swift. Small, correct, "
  "idiomatic. Do NOT invent APIs — if unsure, use the plainest correct one.\n\n"+FILEFMT)

REVIEW_SYS=("You are reviewing SwiftUI code against APPLE'S OWN best-practice guidance (provided; it supersedes "
  "prior knowledge). List concrete issues: soft-deprecated APIs, @State/@Observable/@Binding misuse, unstable "
  "ForEach identity, @Entry closure/class pitfalls, localization. For each: the problem, the fix, and which "
  "Apple reference it comes from. Be specific; cite line snippets. If it's already good, say so.")

MENUBAR_SYS=("You are a senior macOS engineer scaffolding a menu-bar-only SwiftUI app. Use SwiftUI's "
  "`MenuBarExtra` scene (macOS 13+) as the ONLY scene — NO WindowGroup. The @main App has `var body: some "
  "Scene { MenuBarExtra(...) { <menu content> } }`. Put recording/logic in an `@MainActor @Observable final "
  "class` controller owned via `@State`. For ON/OFF menu items use `Toggle(\"Title\", isOn: binding)` (renders a "
  "native checkmark) and for a one-of-N choice use `Picker` (native radio checkmark) — NEVER use "
  "Button+Label(systemImage:) for state, it shows no checkmark in a macOS menu. "
  "For shelling out to a tool, use `Foundation.Process` (executableURL "
  "= URL(fileURLWithPath:), arguments:[...]); to stop, keep the Process and call `.interrupt()` (SIGINT). Use "
  "`FileManager.default.urls(for:.downloadsDirectory,...)` for ~/Downloads. Menu items are Buttons; disable "
  "with `.disabled(...)`. Follow the APPLE SWIFTUI GUIDANCE if provided. Generate ONLY Swift sources under "
  "Sources/<AppName>/ (the @main App + the controller). No Package.swift, no main.swift, no Info.plist.\n\n"+FILEFMT)

def bundle_app(out, name):
    """Wrap the built SPM binary into a real menu-bar .app (Info.plist LSUIElement=true → no dock icon)."""
    binp=out/".build"/"debug"/name
    if not binp.exists(): print(f"[swiftgen] no built binary at {binp}"); return None
    app=out/f"{name}.app"; macos=app/"Contents"/"MacOS"; macos.mkdir(parents=True, exist_ok=True)
    import shutil as _sh; _sh.copy2(binp, macos/name)
    (app/"Contents"/"Info.plist").write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
        '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict>\n'
        f'  <key>CFBundleExecutable</key><string>{name}</string>\n'
        f'  <key>CFBundleIdentifier</key><string>com.esaruoho.{name.lower()}</string>\n'
        f'  <key>CFBundleName</key><string>{name}</string>\n'
        '  <key>CFBundlePackageType</key><string>APPL</string>\n'
        '  <key>CFBundleShortVersionString</key><string>0.1</string>\n'
        '  <key>LSMinimumSystemVersion</key><string>14.0</string>\n'
        '  <key>LSUIElement</key><true/>\n</dict></plist>\n')
    print(f"[swiftgen] bundled → {app}  (menu-bar app, LSUIElement)")
    return app

FIX_SYS=("You are fixing SwiftUI/Swift COMPILE errors. Given the current files and the `swift build` output, "
  "output the FULL corrected content of every file you change, using the file format below. Fix the ACTUAL "
  "errors the compiler reports; do not invent APIs (use the plainest correct one). Follow the Apple SwiftUI "
  "guidance if provided.\n\n"+FILEFMT)

def assert_scaffold(out, name):
    """Own the SPM scaffold deterministically: correct Package.swift (-parse-as-library) + no main.swift."""
    for junk in ("Package.swift","main.swift",f"Sources/{name}/main.swift"):
        jp=out/junk
        if jp.exists():
            try: jp.unlink()
            except Exception: pass
    (out/"Package.swift").write_text(PACKAGE_TMPL.format(name=name))

def build_and_fix(out, fix_model, lens, name, max_iters=3):
    """swift build → feed errors back to the model → rewrite broken files → rebuild, until green."""
    for it in range(max_iters+1):
        assert_scaffold(out, name)   # the fixer must never re-break Package.swift / add main.swift
        r=subprocess.run(["swift","build"], cwd=str(out), capture_output=True, text=True)
        if r.returncode==0:
            print(f"[swiftgen] ✅ build OK (after {it} fix pass{'' if it==1 else 'es'})"); return True
        errs=(r.stdout+r.stderr)
        if it==max_iters:
            print(f"[swiftgen] ❌ still failing after {it} fix passes. Last errors:\n{errs[-1200:]}"); return False
        print(f"[swiftgen] build failed → fix pass {it+1}/{max_iters} (via {fix_model})…", flush=True)
        cur=[{"path":str(p.relative_to(out)),"content":p.read_text(errors='ignore')} for p in sorted(out.rglob('*.swift'))]
        user=((f"APPLE SWIFTUI GUIDANCE:\n{lens[:18000]}\n\n" if lens else "")+
              f"`swift build` errors:\n{errs[-4000:]}\n\nCURRENT FILES:\n{json.dumps(cur)[:42000]}")
        text,used=call(fix_model, FIX_SYS, user, 6000)
        obj=parse_files(text)
        if not obj or not obj.get("files"): print("  (fixer returned no manifest — stopping)"); return False
        for fdef in obj["files"]:
            p=out/fdef["path"]; p.parent.mkdir(parents=True, exist_ok=True); p.write_text(fdef.get("content",""))
            print(f"    fixed {fdef['path']}")
    return False

def parse_files(text):
    """Parse the delimited file format (robust to code with quotes/backslashes)."""
    files=[]
    for m in re.finditer(r'>>>>\s*FILE:\s*(.+?)[ \t]*\n(.*?)\n<<<<\s*END', text, re.S):
        path=m.group(1).strip().strip('`"')
        if path: files.append({"path":path,"content":m.group(2)})
    if not files: return None
    nm=re.search(r'(?m)^\s*NOTES:\s*(.+)$', text)
    return {"files":files, "notes": (nm.group(1).strip() if nm else "")}

def choose_model(desc, override):
    if override and override!="auto": return override
    # escalate to gemini for harder asks (long/feature-heavy descriptions)
    hard = len(desc)>240 or len(re.findall(r'\b(and|,|with|plus|also)\b', desc.lower()))>=4
    return BIG_MODEL if hard else DEFAULT_MODEL

def main():
    a=sys.argv[1:]
    if not a: sys.exit(__doc__)
    if a[0]=="--review":
        f=Path(a[1]); code=f.read_text(errors="ignore")
        model=a[a.index("--model")+1] if "--model" in a else BIG_MODEL
        ans,used=call(model, REVIEW_SYS+"\n\nAPPLE SWIFTUI GUIDANCE:\n"+apple_lens(), f"REVIEW THIS FILE ({f.name}):\n\n"+code, 4000)
        print(f"# swiftgen review of {f.name}  (via {used})\n\n{ans}"); return
    desc=a[0]
    out=Path(a[a.index("--out")+1]).expanduser() if "--out" in a else Path.home()/"Desktop"/"swiftgen-app"
    name=a[a.index("--name")+1] if "--name" in a else "ScaffoldApp"
    kind=a[a.index("--kind")+1] if "--kind" in a else "app"
    model=choose_model(desc, a[a.index("--model")+1] if "--model" in a else None)
    if kind=="menubar" and "--model" not in a: model=BIG_MODEL   # menu-bar logic is fiddly → gemini
    lens=apple_lens(desc)
    print(f"[swiftgen] '{desc[:55]}' → {out}  (kind={kind}, model {model}{' · Apple-guided' if lens else ''})", flush=True)
    user=(f"App name: {name}\nApp description: {desc}\n\nAPPLE SWIFTUI GUIDANCE (authoritative):\n{lens}"
          if lens else f"App name: {name}\nApp description: {desc}")
    text,used=call(model, MENUBAR_SYS if kind=="menubar" else SCAFFOLD_SYS, user)
    obj=parse_files(text)
    if not obj or not obj.get("files"):
        sys.exit(f"swiftgen: model did not return a valid file manifest (via {used}). Raw head:\n{text[:400]}")
    out.mkdir(parents=True, exist_ok=True)
    written=[]
    for fdef in obj["files"]:
        if Path(fdef["path"]).name in ("Package.swift","main.swift"): continue   # we own these
        p=out/fdef["path"]; p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(fdef.get("content","")); written.append(fdef["path"])
    assert_scaffold(out, name)   # write our correct Package.swift, strip any stray main.swift
    print(f"[swiftgen] wrote {len(written)} files (via {used}):")
    for w in written: print(f"    {w}")
    if obj.get("notes"): print(f"[swiftgen] notes: {obj['notes']}")
    if "--build" in a:
        # Fixes escalate to gemini (more reliable at code than nemotron), regardless of the gen model.
        fix_model=a[a.index("--fix-model")+1] if "--fix-model" in a else BIG_MODEL
        iters=int(a[a.index("--fix")+1]) if "--fix" in a else 3
        print(f"[swiftgen] building + auto-fixing (up to {iters} passes, fixer={fix_model})…", flush=True)
        ok=build_and_fix(out, fix_model, lens, name, max_iters=iters)
        if ok and kind=="menubar":
            app=bundle_app(out, name)
            if app and "--run" in a:
                subprocess.run(["open", str(app)]); print(f"[swiftgen] launched {app.name} — look in the menu bar.")
    print(f"\nOpen in Xcode:  open {out}")

if __name__=="__main__": main()
