#!/usr/bin/env python3
"""swiftgen — free, local SwiftUI app scaffolder + best-practices assistant.

Chat → a working SwiftUI app skeleton, generated by FREE models via the freellmapi gateway
(nemotron by default, gemini for harder asks), GUIDED BY Apple's own SwiftUI best-practice skill
(read PRIVATELY at runtime from ~/work/apple/references/xcode27-agent-skills — never embedded, so
this script carries no Apple pre-release content). $0 in the billing sense (free tier / on-device).

  swiftgen "a to-do app with add, delete, and a done toggle" [--out DIR] [--name AppName]
           [--model auto|nemotron-3-super-120b|gemini-2.5-flash] [--build] [--review FILE]

Modes:
  (default)   scaffold a new SwiftUI app into DIR (a Swift Package that `swift build` type-checks)
  --review F  best-practices review of an existing Swift file against Apple's guidance (no scaffold)
"""
import sys, os, re, json, time, urllib.request, urllib.error, subprocess
from pathlib import Path

HOST=os.environ.get("FM_FREE_HOST","http://cloudcitymacmini:3001/v1")
KEY_FILE=Path.home()/".fm-free.key"
APPLE_SKILLS=Path.home()/"work"/"apple"/"references"/"xcode27-agent-skills"
DEFAULT_MODEL=os.environ.get("SWIFTGEN_MODEL","nemotron-3-super-120b")
BIG_MODEL="gemini-2.5-flash"

def key():
    k=os.environ.get("FM_FREE_KEY","") or (KEY_FILE.read_text().strip() if KEY_FILE.exists() else "")
    if not k: sys.exit("swiftgen: no freellmapi key (~/.fm-free.key)")
    return k

def call(model, system, user, max_tokens=6000):
    body=json.dumps({"model":model,"messages":[{"role":"system","content":system},
                     {"role":"user","content":user}],"max_tokens":max_tokens,"temperature":0.3}).encode()
    for attempt in range(5):
        req=urllib.request.Request(HOST.rstrip('/')+"/chat/completions", data=body, method="POST",
            headers={"Authorization":f"Bearer {key()}","Content-Type":"application/json"})
        try:
            with urllib.request.urlopen(req, timeout=240) as r: d=json.load(r)
            return d["choices"][0]["message"]["content"], d.get("model",model)
        except urllib.error.HTTPError as e:
            if e.code==429 and attempt<4: print(f"  rate-limited, waiting 40s…",flush=True); time.sleep(40); continue
            raise

def apple_lens(topic_hint=""):
    """Load Apple's SwiftUI best-practice guidance PRIVATELY (if present) as the system lens. Caps size."""
    if not APPLE_SKILLS.exists(): return ""
    parts=[]
    for sk in ("swiftui-specialist","swiftui-whats-new-27"):
        sm=APPLE_SKILLS/sk/"SKILL.md"
        if sm.exists(): parts.append(sm.read_text(errors="ignore"))
        refs=APPLE_SKILLS/sk/"references"
        if refs.exists():
            for rf in sorted(refs.glob("*.md")):
                parts.append(f"[{sk}/{rf.name}]\n"+rf.read_text(errors="ignore"))
    blob="\n\n".join(parts)
    return blob[:60000]   # gemini/nemotron both hold this comfortably

SCAFFOLD_SYS=("You are a senior SwiftUI engineer scaffolding a NEW SwiftUI app. Follow the APPLE SWIFTUI "
  "GUIDANCE provided (it supersedes prior knowledge): prefer @Observable over ObservableObject, correct "
  "@State/@Binding, stable ForEach identity, @MainActor + Equatable on models, avoid soft-deprecated APIs "
  "(no NavigationView — use NavigationStack). Output ONLY a JSON object, no prose, no markdown fences:\n"
  '{"files":[{"path":"Sources/<App>/File.swift","content":"..."}], "notes":"1-3 lines: what to do next"}\n'
  "Include: the @main App entry, a ContentView, an @Observable model, and a Package.swift that builds an "
  "executable target with the swift-tools SwiftUI setup. Keep it small, correct, idiomatic. Do NOT invent "
  "APIs — if unsure of an exact API, use the plainest correct one.")

REVIEW_SYS=("You are reviewing SwiftUI code against APPLE'S OWN best-practice guidance (provided; it supersedes "
  "prior knowledge). List concrete issues: soft-deprecated APIs, @State/@Observable/@Binding misuse, unstable "
  "ForEach identity, @Entry closure/class pitfalls, localization. For each: the problem, the fix, and which "
  "Apple reference it comes from. Be specific; cite line snippets. If it's already good, say so.")

def parse_files(text):
    m=re.search(r'\{.*"files".*\}', text, re.S)
    if not m: return None
    try: return json.loads(m.group(0))
    except Exception:
        # tolerate trailing junk: trim to last closing brace
        s=m.group(0)
        for i in range(len(s),0,-1):
            if s[i-1]=='}':
                try: return json.loads(s[:i])
                except Exception: continue
        return None

def choose_model(desc, override):
    if override and override!="auto": return override
    # escalate to gemini for harder asks (long/feature-heavy descriptions)
    hard = len(desc)>240 or len(re.findall(r'\b(and|,|with|plus|also)\b', desc.lower()))>=4
    return BIG_MODEL if hard else DEFAULT_MODEL

def main():
    a=sys.argv[1:]
    if not a: sys.exit(__doc__)
    if a[0]=="--review":
        f=Path(a[1]); code=f.read_text(errors="ignore")
        model=a[a.index("--model")+1] if "--model" in a else BIG_MODEL
        ans,used=call(model, REVIEW_SYS+"\n\nAPPLE SWIFTUI GUIDANCE:\n"+apple_lens(), f"REVIEW THIS FILE ({f.name}):\n\n"+code, 4000)
        print(f"# swiftgen review of {f.name}  (via {used})\n\n{ans}"); return
    desc=a[0]
    out=Path(a[a.index("--out")+1]).expanduser() if "--out" in a else Path.home()/"Desktop"/"swiftgen-app"
    name=a[a.index("--name")+1] if "--name" in a else "ScaffoldApp"
    model=choose_model(desc, a[a.index("--model")+1] if "--model" in a else None)
    lens=apple_lens(desc)
    print(f"[swiftgen] '{desc[:60]}' → {out}  (model {model}{' · Apple-guided' if lens else ' · NO apple lens'})", flush=True)
    user=(f"App name: {name}\nApp description: {desc}\n\nAPPLE SWIFTUI GUIDANCE (authoritative):\n{lens}"
          if lens else f"App name: {name}\nApp description: {desc}")
    text,used=call(model, SCAFFOLD_SYS, user)
    obj=parse_files(text)
    if not obj or not obj.get("files"):
        sys.exit(f"swiftgen: model did not return a valid file manifest (via {used}). Raw head:\n{text[:400]}")
    out.mkdir(parents=True, exist_ok=True)
    written=[]
    for fdef in obj["files"]:
        p=out/fdef["path"]; p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(fdef.get("content","")); written.append(fdef["path"])
    print(f"[swiftgen] wrote {len(written)} files (via {used}):")
    for w in written: print(f"    {w}")
    if obj.get("notes"): print(f"[swiftgen] notes: {obj['notes']}")
    if "--build" in a:
        print("[swiftgen] swift build …", flush=True)
        r=subprocess.run(["swift","build"], cwd=out, capture_output=True, text=True)
        print((r.stdout+r.stderr)[-1500:])
        print(f"[swiftgen] build {'OK ✓' if r.returncode==0 else 'FAILED — iterate: swiftgen --review the offending file'}")
    print(f"\nOpen in Xcode:  open {out}")

if __name__=="__main__": main()
