#!/bin/bash
# live-arrows — start/stop/status the hover-gated arrow-key tap for Live's Clip Envelopes.
#
#   live-arrows start [--verbose]   run it in the background
#   live-arrows stop                stop it (arrow keys return to normal immediately)
#   live-arrows status              is it running?
#   live-arrows log                 tail the verbose log
#   live-arrows build               recompile from live-envelope-arrows.swift
#
# Safety note: if this process dies, hangs, or is killed, macOS drops the event tap
# and arrow keys behave normally again. There is no state to clean up.
set -uo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$BIN_DIR/live-envelope-arrows"
SRC="$BIN_DIR/live-envelope-arrows.swift"
PIDFILE="/tmp/live-envelope-arrows.pid"
LOGFILE="/tmp/live-envelope-arrows.log"

running_pid() {
    [ -f "$PIDFILE" ] || return 1
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "${pid:-}" ] || return 1
    # Confirm the pid is actually our binary and not a recycled number.
    ps -p "$pid" -o command= 2>/dev/null | grep -q "live-envelope-arrows" || return 1
    echo "$pid"
}

case "${1:-status}" in
build)
    swiftc -O -o "$BIN" "$SRC" && echo "built $BIN"
    ;;
start)
    if pid="$(running_pid)"; then
        echo "already running (pid $pid)"
        exit 0
    fi
    [ -x "$BIN" ] || { echo "not built yet — run: live-arrows build" >&2; exit 1; }
    shift || true
    # Detached, output to the log so a crash leaves evidence behind.
    nohup "$BIN" "$@" >> "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if pid="$(running_pid)"; then
        echo "started (pid $pid), log: $LOGFILE"
    else
        echo "failed to start — last lines of $LOGFILE:" >&2
        tail -5 "$LOGFILE" >&2
        exit 1
    fi
    ;;
stop)
    if pid="$(running_pid)"; then
        kill "$pid" && rm -f "$PIDFILE" && echo "stopped (pid $pid) — arrow keys back to normal"
    else
        echo "not running"
    fi
    ;;
restart)
    "$0" stop >/dev/null 2>&1
    shift || true
    "$0" start "$@"
    ;;
status)
    if pid="$(running_pid)"; then
        echo "running (pid $pid)"
        ps -p "$pid" -o pid,etime,command | tail -1
    else
        echo "not running"
    fi
    ;;
log)
    tail -f "$LOGFILE"
    ;;
*)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
