#!/bin/bash
# iphone-latest — grab the NEWEST photo off the USB-cabled iPhone, convert it
# to JPEG, put it on the clipboard (image + file), print the .jpg path.
#
#   iphone-latest            → ~/Pictures/iPhone-Latest/<name>.jpg, ⌘V-ready
#   iphone-latest --no-clip  → just fetch + convert, print path
#   iphone-latest --open     → also reveal in Quick Look
#   iphone-latest --watch    → keep running; every NEW photo → jpg + clipboard,
#                              one path per line on stdout (iPhoneLatest.app live refresh)
#
# Then: ⌘V / Ctrl-V into Claude Code, or drag the file into the Terminal.
# Pipeline: bin/iphone-import --latest (ImageCaptureCore) → sips → NSPasteboard.
# FEATURE-CARD >> features/iphone-latest.feature
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$HOME/Pictures/iPhone-Latest"
CLIP=1; OPEN=0; WATCH=0
for a in "$@"; do case "$a" in
  --watch) WATCH=1 ;; --no-clip) CLIP=0 ;; --open) OPEN=1 ;;
  -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
  *) echo "unknown arg: $a" >&2; exit 2 ;;
esac; done

mkdir -p "$OUT"
TMP="$(mktemp -d -t iphone-latest)"
cleanup() { pkill -f "iphone-import --watch $TMP" 2>/dev/null || true; rm -rf "$TMP" "$TMP.out"; }
trap cleanup EXIT; trap 'exit 0' TERM INT
process() {  # $1 = imported source file → sets JPG
SRC="$1"

BASE="$(basename "${SRC%.*}")"
JPG="$OUT/$BASE.jpg"
case "$(echo "${SRC##*.}" | tr '[:upper:]' '[:lower:]')" in
  jpg|jpeg) /bin/cp "$SRC" "$JPG" ;;
  *) sips -s format jpeg -s formatOptions 85 "$SRC" --out "$JPG" >/dev/null ;;
esac

if [[ "$CLIP" -eq 1 ]]; then
  osascript >/dev/null <<APPLESCRIPT
use framework "Foundation"
use framework "AppKit"
set img to current application's NSImage's alloc()'s initWithContentsOfFile:"$JPG"
set u to current application's NSURL's fileURLWithPath:"$JPG"
set pb to current application's NSPasteboard's generalPasteboard()
pb's clearContents()
pb's writeObjects:{img, u}
APPLESCRIPT
  echo "✅ $(basename "$JPG") on clipboard — ⌘V into Claude, or drag the file." >&2
fi
}

if [[ "$WATCH" -eq 1 ]]; then
  # ONE long-lived session: iOS streams new photos in over it (reopening kills the stream).
  PARENT=$PPID
  while kill -0 "$PARENT" 2>/dev/null; do   # die with the app, never orphan
    exec 3< <("$REPO/bin/iphone-import" --watch --initial "$TMP" 2>>"$HOME/Library/Logs/iphone-latest.log")
    while IFS= read -r SRC <&3; do
      [[ -f "$SRC" ]] || continue
      process "$SRC"; echo "$JPG"; rm -f "$SRC"
      kill -0 "$PARENT" 2>/dev/null || exit 0
    done
    sleep 3   # session dropped (unplug/lock) → reconnect
  done
  exit 0
fi
SRC="$("$REPO/bin/iphone-import" --latest "$TMP" | tail -1)"
[[ -n "$SRC" && -f "$SRC" ]] || { echo "❌ no photo (iPhone cabled + unlocked + Trusted?)" >&2; exit 1; }
process "$SRC"
[[ "$OPEN" -eq 1 ]] && qlmanage -p "$JPG" >/dev/null 2>&1 &
echo "$JPG"
