#!/usr/bin/env python3
"""fm-submit — send a single prompt to Apple's on-device LLM on the Mini, get the answer back.

Drops a job into ~/work/comms/queue/fm-inbox/ which Syncthing mirrors to the Mac
Mini, where fm-worker runs it through FoundationModels and writes the answer to
fm-outbox/, which Syncthing carries back here. macOS 26 (Tahoe) lives on the Mini;
this works from any machine on the fleet, no FM required locally.

Usage:
    fm-submit "your prompt"               submit and wait for the reply (default)
    echo text | fm-submit -               prompt from stdin
    fm-submit --system "..." "prompt"      set a system instruction
    fm-submit --no-wait "prompt"           fire-and-forget (just queue it)
    fm-submit --id slug "prompt"           name the job (else timestamp+hash)
    fm-submit --status                     show queue depth + worker heartbeat
    fm-submit --status --json              same, machine-readable (for tooling)
    fm-submit --timeout 60 "prompt"        how long to wait for the answer (default 120s)

For an interactive conversation, use `fm-chat`.
Apple-native: python3 stdlib only.
"""

import hashlib
import json
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
QUEUE = Path.home() / "work" / "comms" / "queue"
INBOX = QUEUE / "fm-inbox"
OUTBOX = QUEUE / "fm-outbox"
HEARTBEAT = QUEUE / "fm-worker-heartbeat.json"


def nudge(path: Path):
    try:
        subprocess.run([str(HERE / "syncthing-nudge"), str(path)],
                       capture_output=True, timeout=8)
    except Exception:
        pass


def submit(prompt: str, system: str, job_id: str) -> Path:
    INBOX.mkdir(parents=True, exist_ok=True)
    spec = {"id": job_id, "prompt": prompt, "system": system,
            "submitted_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "submitter_host": socket.gethostname().split(".")[0]}
    tmp = INBOX / f".{job_id}.tmp"
    final = INBOX / f"{job_id}.json"
    tmp.write_text(json.dumps(spec, ensure_ascii=False))
    tmp.replace(final)   # atomic
    nudge(final)
    return final


def wait_for(job_id: str, timeout: float):
    """Poll the outbox; return the parsed result dict, or None on timeout.
    Returns (result, round_trip_seconds)."""
    result_path = OUTBOX / f"{job_id}.json"
    t0 = time.time()
    spin = "|/-\\"
    i = 0
    while time.time() - t0 < timeout:
        if result_path.exists():
            try:
                return json.loads(result_path.read_text()), time.time() - t0
            except Exception:
                pass  # mid-write; try again
        i += 1
        sys.stderr.write(f"\r  waiting {spin[i % 4]} {time.time() - t0:4.1f}s")
        sys.stderr.flush()
        nudge(OUTBOX)   # pull the result folder forward
        time.sleep(1.0)
    sys.stderr.write("\r" + " " * 24 + "\r")
    return None, time.time() - t0


def humanize_err(err: str) -> str:
    e = (err or "").strip()
    if "guardrail" in e.lower() or "unsafe content" in e.lower():
        return ("Apple's on-device safety guardrail blocked this prompt or its "
                "reply (the FoundationModels guardrail is aggressive). Rephrase and retry.")
    # strip the doubled 'fm error:' the Swift CLI already prepends
    while e.lower().startswith("fm error:"):
        e = e[len("fm error:"):].strip()
    return e or "unknown"


def is_guardrail(err: str) -> bool:
    e = (err or "").lower()
    return "guardrail" in e or "unsafe content" in e


# A copular generalization characterizing a GROUP ("the Finnish people are right into
# kombucha") is the empirically-confirmed false-positive that trips Apple's guardrail —
# the same content as a neutral interrogative sails through. We can't use an LLM to reword
# (FM is the only local model and it refuses to READ the blocked text; Claude costs
# tokens), so the neutraliser is pure deterministic text surgery — no model, no tokens.
_GROUP_GEN = re.compile(
    r'\bthe\s+([A-Za-z]+)\s+(?:people\s+)?are\s+'
    r'(?:really\s+|right\s+|very\s+|so\s+|super\s+|totally\s+)?'
    r'(?:into|keen on|fond of|big on|crazy about|obsessed with|all about|mad for)\s+'
    r'(.+?)\s*(?:[.?!,;]|$)', re.IGNORECASE)  # stop at clause end / comma / string end

_STOP = set((
    "a an the is are am was were be been being of to in on for with at by from and or but "
    "if then so as that this these those it its do does did you i we they he she them his "
    "her their our your my me us why what how when where who which right really very super "
    "totally into about think thinks thought people not no yes can could would should will "
    "just like love loves want need get got there here explain please tell give show").split())


def neutralize(prompt: str):
    """Deterministically rewrite a guardrail-tripping prompt into a guardrail-safe one.
    No LLM, no tokens. Returns the rewrite, or None if nothing useful can be made.
    ONLY called after the original was already guardrail-blocked."""
    # 1) Targeted: a copular generalization about a group → a neutral "popular among" form.
    m = _GROUP_GEN.search(prompt)
    if m:
        group = m.group(1).strip()
        topic = m.group(2).strip().rstrip(".?!").strip()
        among = group if group.lower().endswith("s") else group + " people"  # Finns / Finnish people
        if topic:
            return f"Why is {topic} popular among {among}?"
    # 2) Fallback: drop the framing entirely, keep content words → a neutral topic query.
    #    Lossy, but it always yields something the guardrail accepts (an answer beats a wall).
    seen, topic = set(), []
    for w in re.findall(r"[A-Za-z][A-Za-z'-]+", prompt):
        k = w.lower()
        if k in _STOP or len(w) < 3 or k in seen:
            continue
        seen.add(k); topic.append(w)
    if not topic:
        return None
    return "Tell me about " + " ".join(topic[:8]) + "."


STALE_AFTER = 120.0  # a heartbeat older than this means the worker is not alive


def probe() -> dict:
    """Read the worker's true state from the queue — the source of truth that
    Syncthing mirrors here. No SSH, no asking: the answer is on disk."""
    pend = len(list(INBOX.glob("*.json"))) if INBOX.is_dir() else 0
    done = len(list(OUTBOX.glob("*.json"))) if OUTBOX.is_dir() else 0
    state = {"inbox_queued": pend, "outbox_answers": done,
             "worker_host": None, "heartbeat_age_s": None, "worker_alive": False}
    if HEARTBEAT.exists():
        try:
            hb = json.loads(HEARTBEAT.read_text())
            age = time.time() - hb.get("ts", 0)
            state["worker_host"] = hb.get("host", "?")
            state["heartbeat_age_s"] = round(age, 0)
            state["worker_alive"] = age <= STALE_AFTER
        except Exception:
            pass
    return state


def status(as_json: bool = False):
    st = probe()
    if as_json:
        print(json.dumps(st))
        return
    print(f"inbox:  {INBOX}  ({st['inbox_queued']} queued)")
    print(f"outbox: {OUTBOX}  ({st['outbox_answers']} answers)")
    if st["heartbeat_age_s"] is not None:
        print(f"worker: {st['worker_host']}, last heartbeat {st['heartbeat_age_s']:.0f}s ago"
              + ("  ✓" if st["worker_alive"] else "  ⚠ stale"))
    else:
        print("worker: no heartbeat yet (fm-worker not running on the Mini?)")


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if args else 2
    if args[0] == "--status":
        status(as_json="--json" in args)
        return 0

    system = ""
    job_id = None
    wait = True
    timeout = 120.0
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--system":
            system = args[i + 1]; i += 2
        elif a == "--id":
            job_id = args[i + 1]; i += 2
        elif a == "--timeout":
            timeout = float(args[i + 1]); i += 2
        elif a == "--no-wait":
            wait = False; i += 1
        elif a == "-":
            rest.append(sys.stdin.read()); i += 1
        else:
            rest.append(a); i += 1

    prompt = " ".join(rest).strip()
    if not prompt:
        prompt = sys.stdin.read().strip()
    if not prompt:
        sys.stderr.write("fm-submit: no prompt (pass text, pipe stdin, or use -)\n")
        return 2

    if not job_id:
        h = hashlib.sha1(prompt.encode()).hexdigest()[:8]
        job_id = f"{time.strftime('%Y%m%d-%H%M%S')}-{h}"

    submit(prompt, system, job_id)
    if not wait:
        print(f"queued: {job_id}")
        return 0

    result, rt = wait_for(job_id, timeout)
    if result is None:
        # Don't ask a question we can answer: probe the worker's true state and say it.
        st = probe()
        age = st.get("heartbeat_age_s")
        host = st.get("worker_host") or "the worker"
        if age is None:
            why = f"no heartbeat from {host} has ever reached this machine — it's down, or the sync between us has never run"
        elif not st.get("worker_alive"):
            why = (f"haven't heard from {host} in {age:.0f}s — it's either down, OR the Syncthing "
                   f"channel carrying its heartbeats here is stalled (can't tell which from this side)")
        else:
            why = f"{host}'s fm-worker is alive ({age:.0f}s heartbeat) but didn't finish — busy or blocked"
        sys.stderr.write(f"timed out after {rt:.0f}s — {why}. "
                         f"Job {job_id} stays queued and runs when the worker is back.\n")
        return 1
    if not result.get("ok"):
        err = result.get("err", "")
        # Auto-rephrase + retry ONCE on a guardrail block: ask FM to reword the question
        # neutrally, then re-send the reworded version (the guardrail over-blocks benign
        # prompts, and a neutral rewording usually passes). The reworded question is shown
        # so the answer is transparent. Only the original send retries — no loop.
        if is_guardrail(err):
            rw = neutralize(prompt)
            if rw and rw.lower() != prompt.lower():
                sys.stderr.write("  ↻ guardrail blocked it — retrying a neutral rephrasing…\n")
                submit(rw, system, job_id + "-rw")
                r2, rt2 = wait_for(job_id + "-rw", timeout)
                if r2 and r2.get("ok"):
                    print(f"_(reworded past the guardrail: {rw})_\n\n{r2.get('out', '')}")
                    sys.stderr.write(f"  [reworded · {r2.get('host', '?')} · round-trip {rt2:.1f}s]\n")
                    return 0
        sys.stderr.write(f"fm: {humanize_err(err)}\n")
        return 1
    print(result.get("out", ""))
    model_ms = result.get("model_ms", 0)
    sys.stderr.write(f"  [{result.get('host', '?')} · model {model_ms/1000:.1f}s · "
                     f"round-trip {rt:.1f}s]\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
