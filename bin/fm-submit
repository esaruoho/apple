#!/usr/bin/env python3
"""fm-submit — send a single prompt to Apple's on-device LLM on the Mini, get the answer back.

Drops a job into ~/work/comms/queue/fm-inbox/ which Syncthing mirrors to the Mac
Mini, where fm-worker runs it through FoundationModels and writes the answer to
fm-outbox/, which Syncthing carries back here. macOS 26 (Tahoe) lives on the Mini;
this works from any machine on the fleet, no FM required locally.

Usage:
    fm-submit "your prompt"               submit and wait for the reply (default)
    echo text | fm-submit -               prompt from stdin
    fm-submit --system "..." "prompt"      set a system instruction
    fm-submit --no-wait "prompt"           fire-and-forget (just queue it)
    fm-submit --id slug "prompt"           name the job (else timestamp+hash)
    fm-submit --status                     show queue depth + worker heartbeat
    fm-submit --status --json              same, machine-readable (for tooling)
    fm-submit --timeout 60 "prompt"        how long to wait for the answer (default 120s)

For an interactive conversation, use `fm-chat`.
Apple-native: python3 stdlib only.
"""

import hashlib
import json
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import fm_render

QUEUE = Path.home() / "work" / "comms" / "queue"
INBOX = QUEUE / "fm-inbox"
OUTBOX = QUEUE / "fm-outbox"
HEARTBEAT = QUEUE / "fm-worker-heartbeat.json"


def nudge(path: Path):
    try:
        subprocess.run([str(HERE / "syncthing-nudge"), str(path)],
                       capture_output=True, timeout=8)
    except Exception:
        pass


def submit(prompt: str, system: str, job_id: str) -> Path:
    INBOX.mkdir(parents=True, exist_ok=True)
    spec = {"id": job_id, "prompt": prompt, "system": system,
            "submitted_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "submitter_host": socket.gethostname().split(".")[0]}
    tmp = INBOX / f".{job_id}.tmp"
    final = INBOX / f"{job_id}.json"
    tmp.write_text(json.dumps(spec, ensure_ascii=False))
    tmp.replace(final)   # atomic
    nudge(final)
    return final


def wait_for(job_id: str, timeout: float):
    """Poll the outbox; return the parsed result dict, or None on timeout.
    Returns (result, round_trip_seconds)."""
    result_path = OUTBOX / f"{job_id}.json"
    t0 = time.time()
    spin = "|/-\\"
    i = 0
    while time.time() - t0 < timeout:
        if result_path.exists():
            try:
                res = json.loads(result_path.read_text())
                sys.stderr.write("\r" + " " * 40 + "\r")
                sys.stderr.flush()
                return res, time.time() - t0
            except Exception:
                pass  # mid-write; try again
        i += 1
        sys.stderr.write(f"\r  waiting {spin[i % 4]} {time.time() - t0:4.1f}s")
        sys.stderr.flush()
        nudge(OUTBOX)   # pull the result folder forward
        time.sleep(1.0)
    sys.stderr.write("\r" + " " * 24 + "\r")
    return None, time.time() - t0


def humanize_err(err: str) -> str:
    e = (err or "").strip()
    if "guardrail" in e.lower() or "unsafe content" in e.lower():
        return ("Apple's on-device safety guardrail blocked this prompt or its "
                "reply (the FoundationModels guardrail is aggressive). Rephrase and retry.")
    # strip the doubled 'fm error:' the Swift CLI already prepends
    while e.lower().startswith("fm error:"):
        e = e[len("fm error:"):].strip()
    return e or "unknown"


def is_guardrail(err: str) -> bool:
    e = (err or "").lower()
    return "guardrail" in e or "unsafe content" in e


# A copular generalization characterizing a GROUP ("the Finnish people are right into
# kombucha") is the empirically-confirmed false-positive that trips Apple's guardrail —
# the same content as a neutral interrogative sails through. We can't use an LLM to reword
# (FM is the only local model and it refuses to READ the blocked text; Claude costs
# tokens), so the neutraliser is pure deterministic text surgery — no model, no tokens.
_GROUP_GEN = re.compile(
    r'\bthe\s+([A-Za-z]+)\s+(?:people\s+)?are\s+'
    r'(?:really\s+|right\s+|very\s+|so\s+|super\s+|totally\s+)?'
    r'(?:into|keen on|fond of|big on|crazy about|obsessed with|all about|mad for)\s+'
    r'(.+?)\s*(?:[.?!,;]|$)', re.IGNORECASE)  # stop at clause end / comma / string end

_STOP = set((
    "a an the is are am was were be been being of to in on for with at by from and or but "
    "if then so as that this these those it its do does did you i we they he she them his "
    "her their our your my me us why what how when where who which right really very super "
    "totally into about think thinks thought people not no yes can could would should will "
    "just like love loves want need get got there here explain please tell give show").split())


def _topic_query(prompt: str):
    """Drop the framing, keep content words → a neutral topic query. Lossy but the guardrail
    always accepts it (an answer beats a wall)."""
    seen, topic = set(), []
    for w in re.findall(r"[A-Za-z][A-Za-z'-]+", prompt):
        k = w.lower()
        if k in _STOP or len(w) < 3 or k in seen:
            continue
        seen.add(k); topic.append(w)
    return ("Tell me about " + " ".join(topic[:8]) + ".") if topic else None


def neutralize_candidates(prompt: str):
    """Ordered guardrail-safe rephrasings to try, best first — no LLM, no tokens. ONLY used
    after the original was blocked OR the model soft-refused. The caller tries each until one
    yields a real (non-refusal) answer."""
    cands = []
    # 1) Targeted: a copular generalization about a group → a neutral "popular among" form.
    m = _GROUP_GEN.search(prompt)
    if m:
        group = m.group(1).strip()
        topic = m.group(2).strip().rstrip(".?!").strip()
        among = group if group.lower().endswith("s") else group + " people"  # Finns / Finnish people
        if topic:
            cands.append(f"Why is {topic} popular among {among}?")
    # 2) Fallback: a neutral topic query built from the content words.
    tq = _topic_query(prompt)
    if tq:
        cands.append(tq)
    # de-dup, drop any equal to the original
    out = []
    for c in cands:
        if c and c.lower() != prompt.lower() and c not in out:
            out.append(c)
    return out


# Soft refusal = the model returned OK but the *content* declines ("I'm sorry, I can't
# assist…"). Distinct from the guardrail ERROR. Conservative: match refusal openers, or a
# short reply containing a refusal phrase — so long genuine answers aren't misread.
_REFUSAL_OPENERS = (
    "i'm sorry, but i can", "i'm sorry, i can", "i am sorry, but i can", "sorry, i can",
    "i can't assist", "i cannot assist", "i can't help with", "i cannot help with",
    "i can't comply", "i'm unable to", "i am unable to", "i won't be able to")
_REFUSAL_PHRASES = ("can't assist", "cannot assist", "can't help with", "cannot help with",
                    "unable to assist", "unable to help", "can't comply")


def looks_refused(text: str) -> bool:
    t = (text or "").strip().lower()
    if not t:
        return True
    if any(t.startswith(o) for o in _REFUSAL_OPENERS):
        return True
    return len(t) < 200 and any(p in t for p in _REFUSAL_PHRASES)


STALE_AFTER = 120.0  # a heartbeat older than this means the worker is not alive


def probe() -> dict:
    """Read the worker's true state from the queue — the source of truth that
    Syncthing mirrors here. No SSH, no asking: the answer is on disk."""
    pend = len(list(INBOX.glob("*.json"))) if INBOX.is_dir() else 0
    done = len(list(OUTBOX.glob("*.json"))) if OUTBOX.is_dir() else 0
    state = {"inbox_queued": pend, "outbox_answers": done,
             "worker_host": None, "heartbeat_age_s": None, "worker_alive": False}
    if HEARTBEAT.exists():
        try:
            hb = json.loads(HEARTBEAT.read_text())
            age = time.time() - hb.get("ts", 0)
            state["worker_host"] = hb.get("host", "?")
            state["heartbeat_age_s"] = round(age, 0)
            state["worker_alive"] = age <= STALE_AFTER
        except Exception:
            pass
    return state


def status(as_json: bool = False):
    st = probe()
    if as_json:
        print(json.dumps(st))
        return
    print(f"inbox:  {INBOX}  ({st['inbox_queued']} queued)")
    print(f"outbox: {OUTBOX}  ({st['outbox_answers']} answers)")
    if st["heartbeat_age_s"] is not None:
        print(f"worker: {st['worker_host']}, last heartbeat {st['heartbeat_age_s']:.0f}s ago"
              + ("  ✓" if st["worker_alive"] else "  ⚠ stale"))
    else:
        print("worker: no heartbeat yet (fm-worker not running on the Mini?)")


def save_to_knowledgebank(question: str, answer: str) -> str:
    """Append the question and answer to the FoundationModels knowledgebank.
    Returns the user-friendly string path (using ~ for home folder)."""
    import os
    path_str = os.environ.get("FM_KNOWLEDGEBANK")
    if not path_str:
        path_str = str(Path.home() / ".config" / "apple-bar" / "foundationmodels-knowledgebank.md")
    path = Path(path_str)
    
    # ensure parent directories exist
    path.parent.mkdir(parents=True, exist_ok=True)
    
    # write header if empty/new
    if not path.exists() or path.stat().st_size == 0:
        header = (
            "# FoundationModels Knowledgebank\n\n"
            "Every `chat`/`?` answer from the on-device model (fm-submit → the Mini), "
            "appended for recall.\n\n"
        )
        path.write_text(header, encoding="utf-8")
        
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    entry = f"## {stamp} · submit\n\n**Q:** {question}\n\n{answer}\n\n---\n\n"
    
    with path.open("a", encoding="utf-8") as f:
        f.write(entry)
        
    return path.as_posix().replace(Path.home().as_posix(), "~")


def save_local_note(question: str, answer: str, model_name: str) -> str:
    """Save the question and answer to a local standalone Markdown file in the current workspace.
    Returns the user-friendly string path of the written file."""
    # 1. Determine destination directory
    cwd = Path.cwd()
    dest_dir = cwd
    
    kb_entities = cwd / "kb" / "graph" / "entities"
    converse_dir = cwd / "Converse"
    
    if kb_entities.is_dir():
        dest_dir = kb_entities
    elif converse_dir.is_dir():
        dest_dir = converse_dir
        
    # 2. Generate slugified filename
    # limit to first 60 chars of slug
    raw_slug = re.sub(r"[^a-zA-Z0-9]+", "-", question.strip().lower()).strip("-")
    slug = raw_slug[:60].strip("-") or "untitled"
    
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    filename = f"{timestamp}-{slug}.md"
    filepath = dest_dir / filename
    
    # 3. Build beautifully formatted Markdown with YAML frontmatter
    stamp_iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    title = question[:80].strip() + ("..." if len(question) > 80 else "")
    
    frontmatter = (
        "---\n"
        f"type: fm-submit\n"
        f"title: {json.dumps(title, ensure_ascii=False)}\n"
        f"prompt: {json.dumps(question, ensure_ascii=False)}\n"
        f"date: {json.dumps(stamp_iso)}\n"
        f"model: {json.dumps(model_name)}\n"
        "---\n\n"
        f"# {title}\n\n"
        f"**Q:** {question}\n\n"
        f"{answer}\n"
    )
    
    filepath.write_text(frontmatter, encoding="utf-8")
    
    # Return user-friendly path (relative if inside current directory, otherwise replace home with ~)
    try:
        rel = filepath.relative_to(cwd)
        return f"./{rel}"
    except ValueError:
        return filepath.as_posix().replace(Path.home().as_posix(), "~")


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if args else 2
    if args[0] == "--status":
        status(as_json="--json" in args)
        return 0

    system = ""
    job_id = None
    wait = True
    timeout = 120.0
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--system":
            system = args[i + 1]; i += 2
        elif a == "--id":
            job_id = args[i + 1]; i += 2
        elif a == "--timeout":
            timeout = float(args[i + 1]); i += 2
        elif a == "--no-wait":
            wait = False; i += 1
        elif a == "-":
            rest.append(sys.stdin.read()); i += 1
        else:
            rest.append(a); i += 1

    prompt = " ".join(rest).strip()
    if not prompt:
        prompt = sys.stdin.read().strip()
    if not prompt:
        sys.stderr.write("fm-submit: no prompt (pass text, pipe stdin, or use -)\n")
        return 2

    if not job_id:
        h = hashlib.sha1(prompt.encode()).hexdigest()[:8]
        job_id = f"{time.strftime('%Y%m%d-%H%M%S')}-{h}"

    submit(prompt, system, job_id)
    if not wait:
        print(f"queued: {job_id}")
        return 0

    result, rt = wait_for(job_id, timeout)
    if result is None:
        # Don't ask a question we can answer: probe the worker's true state and say it.
        st = probe()
        age = st.get("heartbeat_age_s")
        host = st.get("worker_host") or "the worker"
        if age is None:
            why = f"no heartbeat from {host} has ever reached this machine — it's down, or the sync between us has never run"
        elif not st.get("worker_alive"):
            why = (f"haven't heard from {host} in {age:.0f}s — it's either down, OR the Syncthing "
                   f"channel carrying its heartbeats here is stalled (can't tell which from this side)")
        else:
            why = f"{host}'s fm-worker is alive ({age:.0f}s heartbeat) but didn't finish — busy or blocked"
        sys.stderr.write(f"timed out after {rt:.0f}s — {why}. "
                         f"Job {job_id} stays queued and runs when the worker is back.\n")
        return 1
    ok = result.get("ok")
    out = result.get("out", "") if ok else ""
    blocked = (not ok) and is_guardrail(result.get("err", ""))
    refused = ok and looks_refused(out)

    # Happy path: a real answer to the original prompt.
    if ok and not refused:
        fm_render.emit_reply(out)
        model_name = result.get("model", "FoundationModels")
        sys.stderr.write(f"  [{result.get('host', '?')} · {model_name} · model {result.get('model_ms', 0)/1000:.1f}s · "
                         f"round-trip {rt:.1f}s]\n")
        local_path = save_local_note(prompt, out, model_name)
        kb_path = save_to_knowledgebank(prompt, out)
        sys.stderr.write(f"  [stored to {local_path}]\n")
        sys.stderr.write(f"  [banked to {kb_path}]\n")
        return 0

    # Recover from a guardrail BLOCK or a soft REFUSAL by deterministically rephrasing —
    # no LLM, no tokens. Try each candidate (targeted form, then topic query) until one
    # yields a real, non-refusal answer. The rephrasing is shown, so it's transparent.
    if blocked or refused:
        reason = "guardrail blocked it" if blocked else "the model declined"
        for i, rw in enumerate(neutralize_candidates(prompt), 1):
            sys.stderr.write(f"  ↻ {reason} — retrying a neutral rephrasing…\n")
            jid = f"{job_id}-rw{i}"
            submit(rw, system, jid)
            r2, rt2 = wait_for(jid, timeout)
            if r2 and r2.get("ok") and not looks_refused(r2.get("out", "")):
                ans_text = r2.get('out', '')
                fm_render.emit_reply(f"*(reworded past the guardrail: {rw})*\n\n{ans_text}")
                model_name = r2.get("model", "FoundationModels")
                sys.stderr.write(f"  [reworded · {r2.get('host', '?')} · {model_name} · round-trip {rt2:.1f}s]\n")
                local_path = save_local_note(prompt, ans_text, model_name)
                kb_path = save_to_knowledgebank(prompt, ans_text)
                sys.stderr.write(f"  [stored to {local_path}]\n")
                sys.stderr.write(f"  [banked to {kb_path}]\n")
                return 0
            reason = "still declined" if (r2 and r2.get("ok")) else "still blocked"

    # Nothing recovered: surface the truth.
    if not ok:
        sys.stderr.write(f"fm: {humanize_err(result.get('err', ''))}\n")
        return 1
    fm_render.emit_reply(out)   # model declined and the neutral rephrasings did too — show its words
    sys.stderr.write("  [model declined; neutral rephrasings also declined]\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
