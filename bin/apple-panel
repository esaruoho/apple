#!/usr/bin/env python3
"""apple-panel — a local "what can I do" control panel for the Apple skill.

Opens a web page in your browser where every capability is a card with a real
button. Click it, the tool RUNS on this Mac, and the output renders right there
on the page. Not docs you copy-paste — automated buttons.

A browser file:// page can't run shell commands (sandbox). So this is a tiny
local HTTP server (python3 stdlib only — no Homebrew, no pip) bound to
127.0.0.1. It only ever runs commands from the curated ACTIONS registry below,
and arguments are passed as discrete argv elements (never through a shell), so
there is no command-injection surface.

Usage:
    apple-panel                 start server, open the panel in your browser
    apple-panel --port 9000     pick a port (default 8787)
    apple-panel --no-open       don't auto-open the browser
    apple-panel --print         just print the URL and registry, don't serve

Stop it with Ctrl-C, or the "Stop server" button on the page.
"""

import json
import os
import re
import socket
import subprocess
import sys
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BIN = os.path.dirname(os.path.realpath(__file__))
PY = sys.executable
ANSI = re.compile(r"\x1b\[[0-9;]*m")  # bounded, no backtracking

# ───────────────────────── the registry — the ONLY runnable actions ─────────────────────────
# kind: "safe" = read-only / no side effects;  "action" = does something / writes.
# cmd:  argv list. "{BIN}" -> bin dir, "PYTHON" -> this python, "{arg}" -> user input.
# arg:  None, or a placeholder string that shows in an input box next to the button.

ACTIONS = [
