ACTION_BY_ID = {a["id"]: a for a in ACTIONS}


def build_argv(action, arg):
    """Turn a registry entry + optional user arg into a concrete argv list (no shell)."""
    argv = []
    needs_arg = any("{arg}" in tok for tok in action["cmd"])
    arg = (arg or "").strip().replace("\n", " ").replace("\r", " ")[:512]
    if needs_arg and not arg:
        return None, "This action needs an argument."
    for tok in action["cmd"]:
        if tok == "PYTHON":
            argv.append(PY)
        elif tok == "{arg}":
            argv.append(arg)
        else:
            argv.append(tok.replace("{BIN}", BIN))
    # arg supplied but no placeholder -> append it
    if arg and not needs_arg:
        argv.append(arg)
    return argv, None


def run_action(action, arg):
    argv, err = build_argv(action, arg)
    if err:
        return {"ok": False, "rc": None, "out": "", "err": err, "cmd": ""}
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=120, cwd=os.path.dirname(BIN))
        out = ANSI.sub("", p.stdout or "")
        errt = ANSI.sub("", p.stderr or "")
        return {"ok": p.returncode == 0, "rc": p.returncode, "out": out, "err": errt,
                "cmd": " ".join(argv)}
    except subprocess.TimeoutExpired:
        return {"ok": False, "rc": None, "out": "", "err": "Timed out after 120 s.",
                "cmd": " ".join(argv)}
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "rc": None, "out": "", "err": str(e), "cmd": " ".join(argv)}


