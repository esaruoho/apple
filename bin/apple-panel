<script>
const ACTIONS = __ACTIONS__;
const groups = {};
ACTIONS.forEach(a => { (groups[a.group] ||= []).push(a); });
const root = document.getElementById('groups');
for (const [g, items] of Object.entries(groups)) {
  const h = document.createElement('h2'); h.textContent = g; root.appendChild(h);
  const grid = document.createElement('div'); grid.className = 'grid';
  items.forEach(a => grid.appendChild(card(a)));
  root.appendChild(grid);
}
function card(a) {
  const el = document.createElement('div'); el.className = 'card';
  const isAct = a.kind === 'action';
  el.innerHTML = `<div class="row" style="justify-content:space-between">
      <h3>${esc(a.label)}</h3>
      <span class="kind ${isAct?'act':''}">${isAct?'🟠 changes':'🟢 read-only'}</span></div>
    <p>${esc(a.desc)}</p>`;
  const row = document.createElement('div'); row.className = 'row';
  let input = null;
  if (a.arg) { input = document.createElement('input'); input.type='text';
    input.placeholder = a.arg; row.appendChild(input); }
  const btn = document.createElement('button'); btn.className = 'run' + (isAct?' act':'');
  btn.textContent = 'Run';
  const out = document.createElement('pre'); out.className = 'out';
  btn.onclick = () => fire(a, input, btn, out);
  row.appendChild(btn); el.appendChild(row); el.appendChild(out);
  return el;
}
async function fire(a, input, btn, out) {
  btn.disabled = true; const old = btn.textContent; btn.textContent = 'Running…';
  out.className = 'out show'; out.textContent = 'working…';
  try {
    const r = await fetch('/run', {method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({id: a.id, arg: input ? input.value : ''})});
    const d = await r.json();
    out.className = 'out show ' + (d.ok ? 'ok' : 'bad');
    let body = (d.out || '') + (d.err ? ('\\n' + d.err) : '');
    if (!body.trim()) body = d.ok ? '(done — no output)' : '(failed — no output)';
    out.textContent = body.trim();
    if (d.cmd) { const c = document.createElement('div'); c.className='cmd';
      c.textContent = '$ ' + d.cmd; out.after(c);
      setTimeout(()=>{ if(c.nextSibling && c.nextSibling.className==='cmd') c.remove(); },0); }
  } catch (e) { out.className='out show bad'; out.textContent = 'request failed: ' + e; }
  btn.disabled = false; btn.textContent = old;
}
function stopServer(){ fetch('/shutdown',{method:'POST'}).finally(()=>{
  document.body.innerHTML='<main><p class="note">Server stopped. You can close this tab.</p></main>';});}
function esc(s){ return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

// ── live system dashboard ──
function gb(n){ n=Number(n)||0; const u=['B','KB','MB','GB','TB']; let i=0;
  while(n>=1024&&i<u.length-1){n/=1024;i++;} return (i?n.toFixed(1):n.toFixed(0))+' '+u[i]; }
function upt(s){ s=Number(s)||0; const d=Math.floor(s/86400); s%=86400;
  const h=Math.floor(s/3600); const m=Math.floor((s%3600)/60);
  return (d?d+'d ':'')+h+'h '+m+'m'; }
function col(pct,warn,crit){ return pct>=crit?'#ff453a':(pct>=warn?'#ff9f0a':'#30d158'); }
function gauge(key,label,val,sub,pct,color,note,concern){
  return `<div class="gauge clk${concern?' concern':''}${SEL===key?' sel':''}" data-k="${key}">
    <div class="glabel">${label}</div>
    <div class="gval">${val}<span class="gsub">${sub||''}</span></div>
    <div class="track"><div class="fill" style="width:${Math.min(pct,100)}%;background:${color}"></div></div>
    <div class="gnote">${esc(note||'')}</div></div>`;
}
let LAST=null, SEL=null;
function renderStats(d){
  if(d.error){ document.getElementById('model').textContent='stats error: '+d.error; return; }
  LAST=d;
  const h=d.host,c=d.cpu,m=d.memory,b=d.battery,t=d.thermal;
  document.getElementById('model').textContent = h.model;
  document.getElementById('specs').textContent =
    `${h.chip} · ${h.cores_total} cores (${h.cores_p}P+${h.cores_e}E) · macOS ${h.macos}`;
  document.getElementById('uptime').textContent = 'up ' + upt(h.uptime_sec);

  const cpuPct = Math.round((c.load_per_core||0)*100);
  let g = gauge('cpu','CPU', cpuPct+'%', ' busy', cpuPct, col(cpuPct,70,90),
                `load ${c.load1} · ${c.ncpu} cores`, cpuPct>=90);
  const mp = m.pressure==='Critical'?95:(m.pressure==='Warning'?80:m.pct_used);
  g += gauge('memory','Memory', m.pct_used+'%', '', mp, col(mp,75,90),
             `${gb(m.used)} / ${gb(m.total)} · ${m.pressure}`, m.pressure!=='Normal');
  if(b.present){
    const temp=b.temp_c||0;
    g += gauge('battery','Battery', b.percent+'%', ' '+temp+'°C', b.percent, col(temp,38,42),
               `${b.state} (${b.source}) · ${b.cycle_count} cyc · health ${b.health_pct}%`, temp>=42);
  }
  // Thermal = real die temperature in °C (no-sudo HID sensors), pressure as a note
  const tc=t.temp_c;
  if(tc!=null){
    g += gauge('thermal','Thermal', Math.round(tc)+'°C', '', Math.min(tc,110),
               col(tc,80,95), `${t.pressure} · ${t.sensor_count} sensors · limit ${t.speed_limit_pct||100}%`,
               tc>=95);
  } else {
    g += gauge('thermal','Thermal', t.pressure, '', 100-(t.speed_limit_pct||100), col(100-(t.speed_limit_pct||100),1,40),
               `CPU speed limit ${t.speed_limit_pct||100}% · (temps: click Fans button)`, false);
  }
  document.getElementById('gauges').innerHTML = g;
  if(SEL) drill(SEL);  // keep an open drill-in fresh on each tick

  document.getElementById('disk').innerHTML = (d.disk||[]).map(v=>
    `<div class="mini"><span class="nm">${esc(v.name)}</span>
      <span class="tk"><div style="width:${v.pct_used}%;background:${col(v.pct_used,80,93)}"></div></span>
      <span class="mono">${v.pct_used}%</span></div>`).join('') || '—';
  document.getElementById('procs').innerHTML = (d.top_procs||[]).slice(0,5).map(p=>
    `<div class="mini"><span class="nm">${esc(p.name)}</span>
      <span class="mono">${p.cpu.toFixed(0)}%</span></div>`).join('') || '—';
  const n=d.network;
  document.getElementById('net').innerHTML =
    `<div class="mini"><span class="nm">interface</span><span class="mono">${esc(n.interface||'—')}</span></div>
     <div class="mini"><span class="nm">IP</span><span class="mono">${esc(n.ip||'—')}</span></div>`
     + (n.ssid?`<div class="mini"><span class="nm">Wi-Fi</span><span class="mono">${esc(n.ssid)}</span></div>`:'')
     + (n.router?`<div class="mini"><span class="nm">router</span><span class="mono">${esc(n.router)}</span></div>`:'');
}
// click any gauge → investigate it (the panel knows what to study per metric)
document.getElementById('gauges').addEventListener('click', e => {
  const card = e.target.closest('.gauge'); if(!card) return;
  const k = card.dataset.k;
  SEL = (SEL===k) ? null : k;       // toggle
  document.querySelectorAll('.gauge').forEach(x=>x.classList.toggle('sel', x.dataset.k===SEL));
  drill(SEL);
});
function vbox(cls,html){ return `<p class="verdict ${cls}">${html}</p>`; }
function rows(list){ return list.map(r=>
  `<div class="mini"><span class="nm">${esc(r.l)}</span><span class="mono">${esc(r.v)}</span></div>`).join(''); }
function drill(key){
  const box=document.getElementById('detail'); if(!key||!LAST){ box.innerHTML=''; return; }
  const d=LAST, m=d.memory, t=d.thermal, c=d.cpu, b=d.battery;
  let html='';
  if(key==='memory'){
    const swU=m.swap?m.swap.used:0, swT=m.swap?m.swap.total:0;
    let cls='ok', v;
    if(m.pressure==='Critical'){ cls='crit';
      v=`<b>Critical memory pressure.</b> macOS is struggling — ${gb(swU)} swapped to disk. Quit the largest apps below.`; }
    else if(m.pressure==='Warning'){ cls='warn';
      v=`<b>Memory pressure: Warning.</b> ${m.pct_used}% used and <b>${gb(swU)}</b> pushed to swap${swT?` of ${gb(swT)}`:''}, ${gb(m.compressed)} compressed. RAM is the bottleneck — closing a couple of the heavy apps below will help.`; }
    else { v=`Memory is healthy — ${m.pct_used}% used, ${gb(m.free)} free, ${gb(swU)} swap.`; }
    html=`<div class="dbox"><h4>Memory — what's going on</h4>${vbox(cls,v)}
      ${rows([
        {l:'Used / total',v:`${gb(m.used)} / ${gb(m.total)}`},
        {l:'Free',v:gb(m.free)}, {l:'Wired (can\'t be paged out)',v:gb(m.wired)},
        {l:'Compressed',v:gb(m.compressed)},
        {l:'Swap used',v:`${gb(swU)}${swT?` / ${gb(swT)}`:''}`},
      ])}
      <div class="glabel" style="margin-top:10px">Largest processes (resident)</div>
      ${rows((m.top||[]).slice(0,5).map(p=>({l:p.name,v:gb(p.bytes)})))}</div>`;
  } else if(key==='thermal'){
    const tc=t.temp_c;
    let cls = tc==null?'':(tc>=95?'crit':(tc>=80?'warn':'ok'));
    let v = tc==null ? 'No live die-temp sensor read yet — use the "Fans & die temps" button for a powermetrics reading.'
      : (tc>=95?`<b>Running hot: ${Math.round(tc)}°C.</b> Expect fans up / throttling.`
        : tc>=80?`<b>Warm: ${Math.round(tc)}°C</b> under load — normal for sustained work.`
        : `Cool — hottest die sensor ${Math.round(tc)}°C, average ${Math.round(t.temp_avg_c)}°C. CPU speed limit ${t.speed_limit_pct||100}% (no throttling).`);
    html=`<div class="dbox"><h4>Thermal — ${t.sensor_count} live sensors (no password)</h4>${vbox(cls,v)}
      <div class="glabel">Hottest sensors</div>
      ${rows((t.sensors||[]).slice(0,8).map(s=>({l:s.name,v:s.c+'°C'})))}
      <p class="detailhint">Fan RPM needs root — use the 🟠 “Fans &amp; die temps” button below.</p></div>`;
  } else if(key==='cpu'){
    const pc=Math.round((c.load_per_core||0)*100);
    let cls=pc>=90?'crit':(pc>=70?'warn':'ok');
    html=`<div class="dbox"><h4>CPU — top consumers</h4>
      ${vbox(cls,`Load ${c.load1} across ${c.ncpu} cores (~${pc}% per core). Biggest users right now:`)}
      ${rows((d.top_procs||[]).slice(0,6).map(p=>({l:p.name,v:p.cpu.toFixed(0)+'%'})))}</div>`;
  } else if(key==='battery'){
    let cls=(b.temp_c>=42)?'warn':'ok';
    html=`<div class="dbox"><h4>Battery</h4>
      ${vbox(cls,`${b.percent}% · ${b.state} (${b.source}) · ${b.temp_c}°C`)}
      ${rows([{l:'Health',v:b.health_pct+'%'},{l:'Cycle count',v:b.cycle_count},
        {l:'Temperature',v:b.temp_c+'°C'},{l:'Voltage',v:b.voltage_v+' V'},
        {l:'Design capacity',v:b.design_capacity+' mAh'}])}</div>`;
  }
  box.innerHTML=html;
}
let firstStat=true;
async function tick(){
  if(!firstStat && !document.getElementById('autoref').checked) return;
  try{ const r=await fetch('/stats'+(firstStat?'?full=1':'')); renderStats(await r.json()); firstStat=false; }
  catch(e){}
}
tick(); setInterval(tick, 4000);
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):  # quiet
        pass

    def _send(self, code, body, ctype="application/json"):
        b = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            html = PAGE.replace("__ACTIONS__", json.dumps(slim_actions()))
            self._send(200, html, "text/html; charset=utf-8")
        elif self.path == "/health":
            self._send(200, json.dumps({"ok": True}))
        elif self.path.startswith("/stats"):
            full = "full=1" in self.path
            cmd = [PY, os.path.join(BIN, "mac-stats"), "--json"]
            if not full:
                cmd.append("--fast")
            try:
                p = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
                self._send(200, p.stdout or json.dumps({"error": p.stderr}))
            except Exception as e:  # noqa: BLE001
                self._send(200, json.dumps({"error": str(e)}))
        else:
            self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(length) if length else b"{}"
        if self.path == "/shutdown":
            self._send(200, json.dumps({"ok": True}))
            threading.Thread(target=self.server.shutdown, daemon=True).start()
            return
        if self.path != "/run":
            self._send(404, json.dumps({"error": "not found"}))
            return
        try:
            data = json.loads(raw or b"{}")
        except Exception:  # noqa: BLE001
            self._send(400, json.dumps({"ok": False, "err": "bad JSON"}))
            return
        action = ACTION_BY_ID.get(data.get("id", ""))
        if not action:
            self._send(404, json.dumps({"ok": False, "err": "unknown action"}))
            return
        result = run_action(action, data.get("arg", ""))
        self._send(200, json.dumps(result))


def pick_port(preferred):
    for port in [preferred] + [preferred + i for i in range(1, 12)]:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            if s.connect_ex(("127.0.0.1", port)) != 0:
                return port
    return preferred


def slim_actions():
    """The publishable registry — id/label/group/kind/arg, no internals.
    Shared by the web page, the machine card, and the run modes."""
    return [{"id": a["id"], "group": a["group"], "kind": a["kind"],
             "label": a["label"], "desc": a["desc"], "arg": a["arg"]} for a in ACTIONS]


def main(argv):
    port = 8787
    do_open = True
    just_print = False
    args = argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-h", "--help"):
            print(__doc__)
            return 0
        elif a == "--port":
            i += 1
            port = int(args[i])
        elif a == "--no-open":
            do_open = False
        elif a == "--print":
            just_print = True
        elif a == "--actions-json":
            # Dump the curated registry as JSON. The machine card embeds this so
            # a fleet peer knows what this machine can run.
            print(json.dumps(slim_actions()))
            return 0
        elif a == "--run":
            # Headless execute one registered action: the single executor shared
            # by Fleet-local and the remote panel-worker. Curated id only — never
            # an arbitrary command. Optional value via --arg.
            i += 1
            run_id = args[i] if i < len(args) else ""
            run_arg = ""
            j = i + 1
            while j < len(args):
                if args[j] == "--arg" and j + 1 < len(args):
                    run_arg = args[j + 1]
                    j += 2
                    continue
                j += 1
            action = ACTION_BY_ID.get(run_id)
            if not action:
                print(f"unknown action: {run_id!r}", file=sys.stderr)
                return 2
            res = run_action(action, run_arg)
            if res.get("out"):
                sys.stdout.write(res["out"])
            if res.get("err"):
                sys.stderr.write(res["err"])
            return 0 if res.get("ok") else (res.get("rc") or 1)
        i += 1

    port = pick_port(port)
    url = f"http://127.0.0.1:{port}/"

    if just_print:
        print(url)
        for a in ACTIONS:
            print(f"  [{a['kind']:6}] {a['group']:20} {a['label']}")
        return 0

    # warm the mac-temps cache in the background so the first /stats poll never
    # blocks on the one-time Swift compile
    def _warm():
        try:
            subprocess.run([os.path.join(BIN, "mac-temps"), "--json"],
                           capture_output=True, timeout=60)
        except Exception:  # noqa: BLE001
            pass
    threading.Thread(target=_warm, daemon=True).start()

    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"\n  🧰 Apple Panel is live at  {url}")
    print("     (local only · Ctrl-C to stop · or the Stop button on the page)\n")
    if do_open:
        try:
            subprocess.run(["open", url], timeout=5)
        except Exception:  # noqa: BLE001
            webbrowser.open(url)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n  stopped.\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
