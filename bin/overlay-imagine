#!/usr/bin/env python3
"""overlay-imagine — draw a box, get a generated picture back in the box.

The generative half of the overlay. Given a PNG crop of the region the user
selected, produce an image and print the path to it on stdout. Overlay.app then
renders that image INTO the rectangle that asked for it.

    overlay-imagine <crop.png> [--prompt "..."] [--style sketch] [-o out.png]

Where the prompt comes from, in order:

    --prompt            what you typed, if you typed one
    Vision OCR          the text inside the region — "make a picture of THIS"
    Vision classifier   what the region looks like, when it holds no text

so selecting a chunk of a whiteboard and pressing the button does the obvious
thing without making you describe what you just pointed at.

Everything is on-device and Apple-shipped:

    bin/vision-ocr    Vision — text + VNClassifyImageRequest labels
    bin/fm-submit     FoundationModels on the Mini — turns that into an image
                      prompt (optional; skipped if the bridge is down)
    bin/image-create  Image Playground — the actual generation (macOS 15.4+)

Prints the generated PNG path on stdout. Diagnostics go to stderr.
"""

import os
import subprocess
import sys
import time

BIN = os.path.dirname(os.path.realpath(__file__))
OUT_DIR = os.path.expanduser("~/.overlay/generated")
TIMEOUT_READ = 45
TIMEOUT_MODEL = 45
# Image Playground is a real diffusion pass driven through a GUI app; it is slow
# the first time a style is used.
TIMEOUT_IMAGE = 240
HEARTBEAT = os.path.expanduser("~/work/comms/queue/fm-worker-heartbeat.json")
STALE_AFTER = 120
PROMPT_LIMIT = 220      # Image Playground wants a phrase, not an essay


def run(argv, timeout):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        out = (p.stdout or "").strip()
        if p.returncode != 0:
            return False, (p.stderr or out or f"exit {p.returncode}").strip()
        return True, out
    except subprocess.TimeoutExpired:
        return False, f"timed out after {timeout}s"
    except FileNotFoundError:
        return False, f"{argv[0]} not found"
    except Exception as e:                                  # noqa: BLE001
        return False, str(e)


def read_region(png):
    """What is in the region: its text, and what it looks like."""
    ok, text = run([os.path.join(BIN, "vision-ocr"), png], TIMEOUT_READ)
    seen = text.strip() if ok else ""

    labels = []
    ok, out = run([os.path.join(BIN, "vision-ocr"), "--classify", png], TIMEOUT_READ)
    if ok:
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) == 2:
                try:
                    if float(parts[1]) >= 0.25:
                        labels.append(parts[0])
                except ValueError:
                    pass
    return seen, labels[:6]


def model_fresh():
    try:
        return (time.time() - os.path.getmtime(HEARTBEAT)) <= STALE_AFTER
    except OSError:
        return False


def distil(seen, labels):
    """Turn what is in the region into a short image prompt.

    Uses the on-device LLM when it is reachable, because raw OCR of a UI is full
    of noise that makes a poor generation prompt. Falls back to the raw text,
    which is imperfect but never blocks the generation."""
    raw = seen or ", ".join(labels)
    if not raw:
        return ""
    if not model_fresh():
        print("overlay-imagine: FM bridge stale — using the raw region text as the "
              "prompt", file=sys.stderr)
        return " ".join(raw.split())[:PROMPT_LIMIT]

    ask = ("Below is text and labels read from a region of a screen that someone "
           "selected because they want a picture of it.\n\n"
           f"--- text ---\n{seen[:1500] or '(none)'}\n"
           f"--- looks like ---\n{', '.join(labels) or '(none)'}\n--- end ---\n\n"
           "Write ONE short vivid image-generation prompt (under 20 words) for what "
           "this describes. Output only the prompt, no preamble, no quotes.")
    ok, out = run([os.path.join(BIN, "fm-submit"), ask], TIMEOUT_MODEL)
    if ok and out:
        return " ".join(out.split())[:PROMPT_LIMIT]
    print(f"overlay-imagine: FM gave no prompt ({out}) — using raw text",
          file=sys.stderr)
    return " ".join(raw.split())[:PROMPT_LIMIT]


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0

    png = argv[1]
    if not os.path.exists(png):
        print(f"no such crop: {png}", file=sys.stderr)
        return 2

    def flag(name, default=None):
        if name in argv:
            i = argv.index(name)
            if i + 1 < len(argv):
                return argv[i + 1]
        return default

    prompt = flag("--prompt")
    style = flag("--style", "illustration")

    if not prompt:
        seen, labels = read_region(png)
        prompt = distil(seen, labels)
    if not prompt:
        print("nothing in that region to make a picture from", file=sys.stderr)
        return 1
    print(f"overlay-imagine: prompt = {prompt}", file=sys.stderr)

    os.makedirs(OUT_DIR, exist_ok=True)
    out = flag("-o", os.path.join(OUT_DIR, f"gen-{int(time.time())}.png"))

    # --no-open: the picture belongs on the overlay, not in Preview.
    ok, err = run([os.path.join(BIN, "image-create"), prompt,
                   "-o", out, "-s", style, "--no-open"], TIMEOUT_IMAGE)
    if not ok or not os.path.exists(out):
        # This message goes to STDOUT so it reaches the callout on screen. The first
        # version printed only to stderr and returned 1, so the overlay displayed
        # "gave no output (exit 1)" — technically true, completely useless.
        # Apple's content filter is the usual cause and it does not say so plainly.
        print(f"Image Playground refused this prompt (often its content filter) — "
              f"try rephrasing: {prompt[:60]}")
        print(f"image-create said: {err}", file=sys.stderr)
        return 0

    print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
