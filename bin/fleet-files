#!/usr/bin/env python3
"""fleet-files — make a LAN-only fleet peer's files available + queryable from
anywhere on the tailnet, by hopping through an always-on node that is on BOTH
the LAN and Tailscale (the Mac Mini).

No subnet router, no IP forwarding, no daemon. Pure SSH ProxyJump + an on-demand
file catalog. The Mini's App Store Tailscale can't advertise routes, so we use it
as a jump host instead — robust wins over brittle.

  RayMac ──(Tailscale)──▶ cloudcity ──(LAN)──▶ hertsimacpro

Verbs:
  fleet-files setup  <peer>            write a ~/.ssh/config jump block for <peer>
  fleet-files ls     <peer> [path]     list files under path (default: $HOME)
  fleet-files index  <peer> [path]     build a searchable catalog [--publish]
  fleet-files find   <term> [--peer P] grep the catalog(s) (fixed-string, safe)
  fleet-files mount  <peer> [path]     sshfs-mount locally (or print sftp howto)

Known peers (host is resolved on the JUMP side, so DHCP churn doesn't matter):
  hertsimacpro  user=esaruoho  via=cloudcity  legacy-rsa sshd
"""
import argparse, json, os, subprocess, sys

HOME = os.path.expanduser("~")
INDEX_DIR = os.path.join(HOME, ".fleet-index")
PUBLISH_DIR = os.path.join(HOME, "work/comms/queue/fleet-index")
SSH_CONFIG = os.path.join(HOME, ".ssh/config")
BEGIN = "# >>> fleet-files managed >>>"
END = "# <<< fleet-files managed <<<"

# LAN-only peers reached via a jump host that's on both the LAN and the tailnet.
# These Macs can't run Tailscale themselves (macOS < 10.15), so the Mini bridges
# them. host is resolved on the JUMP side (router DNS), so DHCP churn is fine.
PEERS = {
    "hertsimacpro": {"user": "esaruoho", "host": "hertsimacpro", "via": "cloudcity",
                     "legacy_rsa": True, "alias": "hertsi"},
    "esarmbp": {"user": "esaruoho", "host": "esarmbp", "via": "cloudcity",
                "legacy_rsa": True, "alias": "esarmbp"},
    "olgas-mbp": {"user": "esaruoho", "host": "olgas-mbp", "via": "cloudcity",
                  "legacy_rsa": True, "alias": "olga"},
}


def base_ssh_opts(peer):
    o = ["-o", "ConnectTimeout=12", "-o", "BatchMode=yes",
         "-o", "StrictHostKeyChecking=accept-new", "-J", peer["via"]]
    if peer.get("legacy_rsa"):
        o += ["-o", "PubkeyAcceptedAlgorithms=+ssh-rsa"]
    return o


def target(peer):
    return f'{peer["user"]}@{peer["host"]}'


def find_peer(name):
    # Case-insensitive across the PEERS key, the friendly alias, AND the host
    # field, so callers can pass any of them — including a Machine Card's `id`
    # (e.g. "HertsiMacPro") straight from Fleet/AppleToolbox without lowercasing.
    # Returns None when the name isn't a known LAN-bridge peer.
    n = name.lower()
    for key, p in PEERS.items():
        if n in (key.lower(), p.get("alias", "").lower(), p.get("host", "").lower()):
            return p
    return None


def resolve(name):
    p = find_peer(name)
    if p:
        return p
    known = ", ".join(sorted({*PEERS, *(p.get("alias", "") for p in PEERS.values())}))
    print(f"  unknown peer '{name}' (known: {known})", file=sys.stderr)
    sys.exit(2)


def run_remote(peer, cmd, timeout=120):
    return subprocess.run(["ssh", *base_ssh_opts(peer), target(peer), cmd],
                          capture_output=True, text=True, timeout=timeout)


def _mapped_ip(alias):
    """Live IP for a peer from the Mini-maintained map (comms queue). Pinning to
    this survives the Mini's mDNSResponder choking under load — the failure mode
    that breaks ProxyJump-by-hostname. Falls back to the bare hostname if absent."""
    for d in (PUBLISH_DIR, INDEX_DIR):
        f = os.path.join(d, "peers.json")
        if os.path.exists(f):
            try:
                rec = json.load(open(f)).get("peers", {}).get(alias)
                if rec and rec.get("ip") and rec.get("up"):
                    return rec["ip"]
            except Exception:
                pass
    return None


def _write_one(name):
    """Idempotently install a per-peer jump block in ~/.ssh/config."""
    peer = resolve(name)
    alias = peer.get("alias", name)
    hostname = _mapped_ip(alias) or peer["host"]
    begin, end = f"# >>> fleet-files:{alias} >>>", f"# <<< fleet-files:{alias} <<<"
    block = [begin,
             f"Host {alias} {peer['host']}",
             f"    HostName {hostname}",
             f"    User {peer['user']}",
             f"    ProxyJump {peer['via']}",
             "    StrictHostKeyChecking accept-new"]
    if peer.get("legacy_rsa"):
        block.append("    PubkeyAcceptedAlgorithms +ssh-rsa")
    block.append(end)
    block = "\n".join(block) + "\n"

    existing = ""
    if os.path.exists(SSH_CONFIG):
        with open(SSH_CONFIG) as f:
            existing = f.read()
    # drop only THIS peer's prior block (per-peer markers → blocks coexist)
    if begin in existing and end in existing:
        pre = existing.split(begin)[0].rstrip("\n")
        post = existing.split(end, 1)[1].lstrip("\n")
        existing = (pre + "\n" + post).strip("\n")
        existing = (existing + "\n") if existing else ""
    os.makedirs(os.path.dirname(SSH_CONFIG), exist_ok=True)
    with open(SSH_CONFIG, "w") as f:
        f.write((existing + "\n" if existing else "") + block)
    os.chmod(SSH_CONFIG, 0o600)
    print(f"  ✓ ssh {alias} → {peer['host']} via {peer['via']} (Tailscale)")
    return alias


def cmd_setup(args):
    names = list(PEERS) if args.peer in ("all", None) else [args.peer]
    for n in names:
        _write_one(n)
    print(f"  also per peer: sftp <alias> · rsync -e ssh <alias>:… · sshfs <alias>:")
    return 0


def cmd_ls(args):
    peer = resolve(args.peer)
    path = args.path or "$HOME"
    r = run_remote(peer, f'ls -lah "{path}" 2>&1 | head -200')
    sys.stdout.write(r.stdout)
    return r.returncode


def cmd_index(args):
    peer = resolve(args.peer)
    path = args.path or "$HOME"
    print(f"  indexing {args.peer}:{path} through {peer['via']}… (this reads the "
          f"peer's tree over the jump; large trees take a moment)")
    # path<TAB>size<TAB>mtime ; bounded to files, skip the noisy caches.
    remote = (f'find "{path}" -type f '
              f'-not -path "*/Library/Caches/*" -not -path "*/.Trash/*" '
              f'-print0 2>/dev/null | xargs -0 stat -f "%N\t%z\t%Sm" 2>/dev/null')
    r = run_remote(peer, remote, timeout=600)
    lines = [l for l in r.stdout.splitlines() if l.strip()]
    os.makedirs(INDEX_DIR, exist_ok=True)
    cat = os.path.join(INDEX_DIR, f"{args.peer}.tsv")
    with open(cat, "w") as f:
        f.write("\n".join(lines) + ("\n" if lines else ""))
    print(f"  ✓ catalog: {cat}  ({len(lines)} files)")
    if args.publish:
        os.makedirs(PUBLISH_DIR, exist_ok=True)
        pub = os.path.join(PUBLISH_DIR, f"{args.peer}.tsv")
        with open(pub, "w") as f:
            f.write("\n".join(lines) + ("\n" if lines else ""))
        print(f"  ✓ published to Syncthing queue: {pub}")
        print(f"    → searchable from every tailnet machine, even when "
              f"{args.peer} is asleep.")
    return 0


def cmd_find(args):
    term = args.term
    cats = []
    if args.peer:
        host = resolve(args.peer)["host"]      # accept alias OR key
        cats = [os.path.join(d, f"{host}.tsv") for d in (PUBLISH_DIR, INDEX_DIR)]
    else:
        for d in (INDEX_DIR, PUBLISH_DIR):
            if os.path.isdir(d):
                cats += [os.path.join(d, f) for f in os.listdir(d) if f.endswith(".tsv")]
    cats = [c for c in cats if os.path.exists(c)]
    if not cats:
        print("  no catalog yet — run: fleet-files index <peer> --publish", file=sys.stderr)
        return 1
    hits, seen = 0, set()
    for c in cats:
        name = os.path.splitext(os.path.basename(c))[0]
        # fixed-string match on the path column — safe (no regex backtracking).
        r = subprocess.run(["grep", "-iF", term, c], capture_output=True, text=True)
        for line in r.stdout.splitlines():
            parts = line.split("\t")
            p = parts[0]
            if (name, p) in seen:          # same catalog mirrored in two dirs
                continue
            seen.add((name, p))
            sz = parts[1] if len(parts) > 1 else "?"
            mt = parts[2] if len(parts) > 2 else "?"
            print(f"  [{name}] {p}\t({sz}B, {mt})")
            hits += 1
    print(f"  — {hits} match(es) for '{term}'")
    return 0 if hits else 1


def cmd_mount(args):
    peer = resolve(args.peer)
    alias = peer.get("alias", args.peer)
    path = args.path or f'/Users/{peer["user"]}'
    mnt = os.path.join(HOME, "mnt", args.peer)
    if subprocess.run(["which", "sshfs"], capture_output=True).returncode != 0:
        print("  sshfs not installed. Either install macFUSE+sshfs, or use sftp:")
        print(f"    sftp {alias}            # then `get`/`put` interactively")
        print(f"    open 'sftp://{alias}/'  # Finder mount via SFTP")
        return 1
    os.makedirs(mnt, exist_ok=True)
    jump = peer["via"]
    opts = "-o reconnect,ProxyJump=%s" % jump
    if peer.get("legacy_rsa"):
        opts += ",PubkeyAcceptedAlgorithms=+ssh-rsa"
    cmd = f'sshfs {target(peer)}:{path} "{mnt}" {opts}'
    print(f"  mounting: {cmd}")
    rc = subprocess.run(cmd, shell=True).returncode
    if rc == 0:
        print(f"  ✓ {args.peer} files at {mnt}  (unmount: umount {mnt})")
    return rc


JUMP_RELAY = "cloudcity"   # the node on both the LAN and Tailscale
# kind -> (local port, remote port, url scheme, human label)
TUN = {"screen": (5901, 5900, "vnc", "Screen Sharing"),
       "finder": (1445, 445, "smb", "File Sharing (Finder + Quick Look)")}


def _peer_ip(name):
    """(ip, up) for a peer from the Mini-maintained map."""
    peer = resolve(name)
    alias = peer.get("alias", name)
    for d in (PUBLISH_DIR, INDEX_DIR):
        f = os.path.join(d, "peers.json")
        if os.path.exists(f):
            try:
                rec = json.load(open(f)).get("peers", {}).get(alias, {})
                if rec.get("ip"):
                    return rec["ip"], rec.get("up", False)
            except Exception:
                pass
    return None, False


def _wake_via_mini(host):
    """Wake-on-LAN is link-local — it can't route over Tailscale, so the Mini
    (on the peer's LAN) sends the magic packet on our behalf."""
    print(f"  {host} is asleep — asking the Mini to Wake-on-LAN it…")
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                            JUMP_RELAY, f"~/work/apple/bin/fleet-wake {host} --wait"],
                           capture_output=True, text=True, timeout=90)
        sys.stdout.write("    " + r.stdout.replace("\n", "\n    ").rstrip() + "\n")
        return "is up" in r.stdout
    except Exception as e:
        print(f"    wake failed: {e}", file=sys.stderr)
        return False


def cmd_wake(args):
    return 0 if _wake_via_mini(resolve(args.peer)["host"]) else 2


def _peer_offset(name):
    """Stable 0-based slot for a peer in PEERS, so each gets its OWN local port.
    A single fixed port per kind (5901 screen / 1445 finder) is shared across
    every peer — so the FIRST peer you VIEW wins the port and every later peer
    silently connects to that first tunnel's target instead of its own. Offset
    the local port by the peer's slot to keep tunnels distinct (Hertsi=5901,
    esarmbp=5902, …). (2026-06-17: clicking VIEW on Hertsi opened esarMBP.)"""
    n = name.lower()
    for i, (key, p) in enumerate(PEERS.items()):
        if n in (key.lower(), p.get("alias", "").lower(), p.get("host", "").lower()):
            return i
    return 0


def _tunnel_pids(lport):
    """PIDs of `ssh … -L {lport}:…` forwards. Matched by PID, not pkill: a pkill
    pattern of '-L {lport}:' starts with '-', which pkill parses as an OPTION
    flag (not a pattern) and silently no-ops — that's why --stop never worked."""
    out = subprocess.run(["ps", "-axo", "pid,command"], capture_output=True, text=True).stdout
    pids = []
    for line in out.splitlines():
        if "ssh" in line and f"-L {lport}:" in line:
            pids.append(line.split(None, 1)[0])
    return pids


def _tunnel_target(lport):
    """'ip:rport' the existing `ssh -L {lport}:…` forward points at, else None.
    Lets us reap a stale tunnel that forwards to a peer's OLD ip (DHCP churn) or
    — before the per-peer-port fix — to a wholly different machine."""
    out = subprocess.run(["ps", "-axo", "command"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if "ssh" in line and f"-L {lport}:" in line:
            toks = line.split()
            for i, t in enumerate(toks):
                if t == "-L" and i + 1 < len(toks):
                    seg = toks[i + 1].split(":")        # lport:ip:rport
                    if len(seg) == 3:
                        return f"{seg[1]}:{seg[2]}"
    return None


def _kill_tunnel(lport):
    """Reap any ssh -L forward on lport. By PID — see _tunnel_pids on why."""
    pids = _tunnel_pids(lport)
    for pid in pids:
        subprocess.run(["kill", pid], capture_output=True)
    return len(pids)


def cmd_tunnel(args):
    """VNC/SMB to a LAN-only peer from anywhere — forwarded through the Mini over
    Tailscale. VNC/SMB aren't SSH, so ProxyJump can't carry them; an `ssh -L`
    port-forward through the relay does."""
    kind = args.kind
    base_lport, rport, scheme, label = TUN[kind]
    name = args.peer
    lport = base_lport + _peer_offset(name)   # per-peer port — no cross-peer collision
    if args.stop:
        n = _kill_tunnel(lport)
        print(f"  ✓ stopped {label} tunnel" if n else f"  (no {label} tunnel on :{lport})")
        return 0
    # Not a LAN-bridge Mac → directly reachable (Tailscale / same LAN). Skip the
    # tunnel and point the viewer straight at the hostname. Lets a single VIEW
    # action work for every peer: bridge Macs get the ssh -L hop, the rest open
    # vnc://<host> / smb://<host> directly.
    if find_peer(name) is None:
        url = f"{scheme}://{name}"
        print(f"  ✓ {label} (direct): {url}")
        if not args.no_open:
            subprocess.run(["open", url])
        return 0
    ip, up = _peer_ip(name)
    if not up and not args.no_wake:
        if _wake_via_mini(resolve(name)["host"]):
            ip, up = _peer_ip(name)        # re-read after the wake
    if not ip:
        print(f"  no live IP for {name} — run: fleet-files-refresh", file=sys.stderr); return 1
    if not up:
        print(f"  ⚠ {name} is still DOWN — it must be awake on the LAN for this to "
              f"connect (WoL only wakes from sleep, not power-off).", file=sys.stderr)
    want = f"{ip}:{rport}"
    cur = _tunnel_target(lport)
    if cur and cur != want:        # stale tunnel to a different/old target — reap it
        _kill_tunnel(lport)
        print(f"  ↻ replaced stale tunnel (was → {cur})")
        cur = None
    if not cur:
        rc = subprocess.run(["ssh", "-f", "-N", "-o", "ExitOnForwardFailure=yes",
                             "-L", f"{lport}:{ip}:{rport}", JUMP_RELAY]).returncode
        if rc != 0:
            print(f"  ✗ tunnel failed (is {JUMP_RELAY} reachable?)", file=sys.stderr); return 1
    url = f"{scheme}://localhost:{lport}"
    print(f"  ✓ {label}: {url}")
    print(f"    (localhost:{lport} → {JUMP_RELAY} over Tailscale → {name} {ip}:{rport})")
    if not args.no_open:
        subprocess.run(["open", url])
    print(f"    stop: fleet-files {kind} {name} --stop")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="fleet-files")
    sub = ap.add_subparsers(dest="verb", required=True)
    s = sub.add_parser("setup"); s.add_argument("peer", nargs="?", default="all")
    s.set_defaults(func=cmd_setup)
    l = sub.add_parser("ls"); l.add_argument("peer"); l.add_argument("path", nargs="?")
    l.set_defaults(func=cmd_ls)
    i = sub.add_parser("index"); i.add_argument("peer"); i.add_argument("path", nargs="?")
    i.add_argument("--publish", action="store_true"); i.set_defaults(func=cmd_index)
    f = sub.add_parser("find"); f.add_argument("term"); f.add_argument("--peer")
    f.set_defaults(func=cmd_find)
    m = sub.add_parser("mount"); m.add_argument("peer"); m.add_argument("path", nargs="?")
    m.set_defaults(func=cmd_mount)
    for k in ("screen", "finder"):
        t = sub.add_parser(k); t.add_argument("peer")
        t.add_argument("--stop", action="store_true")
        t.add_argument("--no-open", action="store_true")
        t.add_argument("--no-wake", action="store_true", help="don't auto-WoL if asleep")
        t.set_defaults(func=cmd_tunnel, kind=k)
    w = sub.add_parser("wake"); w.add_argument("peer"); w.set_defaults(func=cmd_wake)
    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
