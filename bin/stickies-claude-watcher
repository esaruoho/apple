#!/bin/bash
# stickies-claude-watcher — scan Stickies for #claude-tagged notes and
# launch Claude Code with the matching skill + prompt in a new Terminal
# window.
#
# Sticky format the watcher reacts to:
#
#     #claude #apple
#     do the thing in the apple repo
#     more lines of prompt body
#
# Rules:
#   - Must contain a "#claude" token (case-insensitive).
#   - The first OTHER #tag selects:
#       · the slash command (/<tag>) Claude is launched with
#       · the working directory, via etc/stickies-claude-tagmap.txt
#         (falls back to $HOME if the tag isn't mapped)
#   - All #tags are stripped from the body before it becomes the prompt.
#   - Each sticky's content is hashed; the watcher only re-fires when the
#     content changes (state lives in state/stickies-claude/<uuid>.sha).
#
# Loop cadence is set by the LaunchAgent (com.esa.stickies-claude.plist).

set -u
APPLE_ROOT="/Users/esaruoho/work/apple"
STICKIES_DIR="$HOME/Library/Containers/com.apple.Stickies/Data/Library/Stickies"
STATE_DIR="$APPLE_ROOT/state/stickies-claude"
TAGMAP="$APPLE_ROOT/etc/stickies-claude-tagmap.txt"
LOG="$HOME/work/comms/queue/stickies-claude.log"

mkdir -p "$STATE_DIR" "$(dirname "$LOG")"

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

# Single-instance lock. AppleToolbox fires the watcher from BOTH a 1.5s
# poll AND an FSEvents source on the Stickies dir; the FSEvents source can
# fire several times for a single sticky save (one event per file inside
# the .rtfd bundle). Without this lock, two concurrent watcher processes
# both see "hash != state_file" and both dispatch → two iTerm windows.
# mkdir is the atomic primitive bash 3.2 has on macOS (no flock).
LOCK_DIR="$STATE_DIR/.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    # Stale-lock guard: if the lock is older than 60s, the previous
    # watcher crashed before cleanup — steal it.
    if [[ -d "$LOCK_DIR" ]] && [[ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; then
        log "stealing stale lock (>60s old) pid=$$"
        rm -rf "$LOCK_DIR" && mkdir "$LOCK_DIR" 2>/dev/null || exit 0
    else
        log "watcher already running; skipping pid=$$"
        exit 0
    fi
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT

log "watcher fired pid=$$ ppid=$PPID"

lookup_cwd() {
    local tag="$1"
    if [[ -f "$TAGMAP" ]]; then
        local hit
        # Tagmap value is "<cwd>" or "<cwd>|<canonical-skill-name>".
        # Strip the optional |alias suffix for the cwd lookup.
        hit=$(grep -E "^${tag}=" "$TAGMAP" | head -1 | cut -d= -f2- | cut -d'|' -f1)
        if [[ -n "$hit" && -d "$hit" ]]; then
            printf '%s' "$hit"
            return 0
        fi
    fi
    printf '%s' "$HOME"
}

# If the tagmap line is "<tag>=<cwd>|<skill-alias>", return the alias.
# Lets short tags like #fe → "free-energy" skill instead of "FE skill".
lookup_skill_alias() {
    local tag="$1"
    [[ -f "$TAGMAP" ]] || return 0
    local line value
    line=$(grep -E "^${tag}=" "$TAGMAP" | head -1)
    value="${line#*=}"
    if [[ "$value" == *"|"* ]]; then
        printf '%s' "${value#*|}"
    fi
}

# Shell-quote a string for safe interpolation into a bash command line.
# Uses printf %q (bash builtin) — always produces a re-parseable token,
# correctly handles apostrophes, backticks, dollars, newlines, etc.
shquote() {
    printf '%q' "$1"
}

# AppleScript-quote: escape \ and " for use inside an AppleScript string.
asquote() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

dispatch() {
    # Args: uuid, primary_skill, cwd, prompt, [extra_skill ...]
    local uuid="$1" skill="$2" cwd="$3" prompt="$4"
    shift 4
    local extras=("$@")

    # Natural-language skill invocation: Claude reads "Use Foo Bar skill."
    # for each tag and calls the Skill tool itself. Title-case across
    # hyphens so "impulse-tracker" becomes "Impulse Tracker".
    title_case() {
        printf '%s' "$1" | awk -F'-' '{ for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2); print }' OFS=' '
    }
    local skill_header
    skill_header="Use $(title_case "$skill") skill."
    local s
    for s in "${extras[@]}"; do
        skill_header+=$'\n'"Use $(title_case "$s") skill."
    done
    local full_prompt="${skill_header}

${prompt}"

    # ROBUSTNESS: iTerm/Terminal "do script" / "write text" types the command
    # character-by-character into the new window. If Esa is typing into ANOTHER
    # sticky (or any other app) while this runs, focus can shift mid-stream and
    # his keystrokes interleave with the prompt body — silently corrupting
    # whatever Claude receives. Mitigation: write the long content to a
    # launcher script in a private tempdir, then have AppleScript type ONLY
    # a short fixed path. Worst case if keystrokes still bleed in: a mangled
    # path → "command not found", not a mutated prompt.
    local launcher_dir launcher
    launcher_dir="$STATE_DIR/launchers"
    mkdir -p "$launcher_dir"
    chmod 700 "$launcher_dir"
    # Clean launchers older than 24h on the way in (harmless if none exist).
    find "$launcher_dir" -type f -mmin +1440 -delete 2>/dev/null
    launcher="$launcher_dir/${uuid}.sh"
    {
        printf '#!/bin/bash\n'
        printf '# Auto-generated by stickies-claude-watcher. Self-deletes after launch.\n'
        printf '# Sticky uuid: %s\n' "$uuid"
        printf 'cd %s || { echo "stickies-claude: cd failed: %s" >&2; exit 1; }\n' \
            "$(shquote "$cwd")" "$cwd"
        # rm -- "$0" before exec so a successful launch leaves no breadcrumb;
        # if exec fails the file stays, the >24h sweep picks it up later.
        printf 'rm -f -- "$0"\n'
        printf 'exec claude %s\n' "$(shquote "$full_prompt")"
    } > "$launcher"
    chmod 700 "$launcher"

    # The string AppleScript types is now a short, fixed-shape path.
    local inner_cmd
    inner_cmd="bash $(shquote "$launcher")"
    local as_cmd
    as_cmd=$(asquote "$inner_cmd")

    # Prefer iTerm if installed; fall back to Terminal.app.
    if [[ -d "/Applications/iTerm.app" ]]; then
        osascript >> "$LOG" 2>&1 <<APPLESCRIPT
tell application "iTerm"
    activate
    set newWindow to (create window with default profile)
    tell current session of newWindow
        write text "$as_cmd"
    end tell
end tell
APPLESCRIPT
    else
        osascript >> "$LOG" 2>&1 <<APPLESCRIPT
tell application "Terminal"
    activate
    do script "$as_cmd"
end tell
APPLESCRIPT
    fi
    local rc=$?
    if [[ $rc -ne 0 ]]; then
        log "dispatch FAILED rc=$rc uuid=$uuid skill=$skill cwd=$cwd"
        return 1
    fi
    log "dispatched uuid=$uuid skill=$skill cwd=$cwd"
    return 0
}

shopt -s nullglob
for rtfd in "$STICKIES_DIR"/*.rtfd; do
    uuid=$(basename "$rtfd" .rtfd)
    body=$(textutil -convert txt -encoding UTF-8 -stdout "$rtfd" 2>/dev/null) || continue
    [[ -z "$body" ]] && continue

    # Case-insensitive #claude detection.
    shopt -s nocasematch
    [[ "$body" =~ \#claude([[:space:]]|$) ]] || { shopt -u nocasematch; continue; }
    shopt -u nocasematch

    # Collect ALL non-#claude tags in source order.
    #   - First tag → cwd (via lookup_cwd)
    #   - Every tag → "Use <Title> skill." line prepended to the prompt
    # So `#fe #apple #rbi #claude` opens ONE window in ~/work/merlib-dump
    # and tells Claude to load Free Energy + Apple + Rhythmic Balanced
    # Interchange skills in that order.
    skill=""
    extra_skills=()
    while IFS= read -r tag; do
        tl=$(printf '%s' "$tag" | tr '[:upper:]' '[:lower:]')
        [[ "$tl" == "claude" ]] && continue
        if [[ -z "$skill" ]]; then
            skill="$tl"
        else
            # Deduplicate — same tag twice in a sticky shouldn't double-Use.
            local_dup=0
            for s in "${extra_skills[@]}"; do
                [[ "$s" == "$tl" ]] && { local_dup=1; break; }
            done
            [[ "$tl" == "$skill" ]] && local_dup=1
            [[ $local_dup -eq 0 ]] && extra_skills+=("$tl")
        fi
    done < <(printf '%s' "$body" | grep -oE '#[A-Za-z][A-Za-z0-9_-]*' | sed 's/^#//')

    [[ -z "$skill" ]] && continue

    # Strip all #tags from the prompt body.
    prompt=$(printf '%s' "$body" | sed -E 's/#[A-Za-z][A-Za-z0-9_-]+//g' | awk 'NF{f=1} f' | sed -E 's/[[:space:]]+$//')
    # Trim leading blanks.
    prompt=$(printf '%s' "$prompt" | awk 'NF{p=1} p')
    [[ -z "$prompt" ]] && continue

    # Hash content (all skills + prompt) so edits re-fire but reboots don't.
    # Including extra_skills means adding a new skill tag re-fires.
    hash=$(printf '%s\n%s\n%s' "$skill" "${extra_skills[*]:-}" "$prompt" | shasum -a 256 | awk '{print $1}')
    state_file="$STATE_DIR/$uuid.sha"
    if [[ -f "$state_file" ]] && [[ "$(cat "$state_file")" == "$hash" ]]; then
        continue
    fi

    cwd=$(lookup_cwd "$skill")
    # Each tag may be a short alias (#fe → free-energy). Resolve every tag
    # to its canonical skill name so dispatch builds correct "Use X skill."
    # lines.
    skill_alias=$(lookup_skill_alias "$skill")
    [[ -n "$skill_alias" ]] && skill="$skill_alias"
    resolved_extras=()
    for s in "${extra_skills[@]}"; do
        a=$(lookup_skill_alias "$s")
        resolved_extras+=("${a:-$s}")
    done
    if dispatch "$uuid" "$skill" "$cwd" "$prompt" "${resolved_extras[@]}"; then
        printf '%s' "$hash" > "$state_file"
    fi
done
