#!/usr/bin/env bash
# fm-mlx — ask the CloudcityMacMini's MLX server (Qwen3-4B) over Tailscale.
#
#   fm-mlx hello                          # prompt as args (speaks + shows richtext)
#   fm-mlx "summarise this in 5 words"    # quote multi-word prompts
#   echo "long prompt..." | fm-mlx        # or pipe it in
#   fm-mlx --quiet "..."                  # don't speak, just show
#   fm-mlx --voice Zoe "..."              # pick the spoken voice
#   fm-mlx --raw --system "..." "..."     # reply text only (the brain interface)
#
# Talks to mlx_lm.server on the Mini via Tailscale Serve (tailnet-only, encrypted).
# Override the endpoint with FM_MLX_HOST if needed.
#
# The reply is shown the SAME way as fm-chat — green `fm  ›` label, Markdown
# rendered as richtext, dim [host · round-trip] stats line — and SPOKEN aloud by
# default (karaoke highlight, Zoe (Premium) voice — the premium voice, not Eddy).
# Auto-talk is gated to an interactive terminal, so when a script captures fm-mlx
# (e.g. the MLX roundtable) it stays silent; pass --say to force speech when piped.
#
# DRY — this tool OWNS the MLX round-trip only. Showing the reply is ONE shared
# call, `fm_render.py --present`, which bundles all three concerns so fm-mlx never
# re-rolls them: rich Markdown→ANSI render + karaoke speech (say-karaoke) + the
# premium voice (Zoe (Premium); FM_MLX_VOICE / FM_SPEAK_BACKEND override). See
# wiki/concepts/reply-presentation.md.
# FEATURE-CARD >> features/fm-mlx-dry.feature
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
HOST="${FM_MLX_HOST:-http://cloudcitymacmini:8080}"

say="auto"                      # auto = talk on an interactive terminal; --say forces, --quiet disables
raw=0                           # --raw = reply text ONLY (no fm-chat framing, no speech) — the brain interface
voice="${FM_MLX_VOICE:-Zoe (Premium)}"   # premium voice (the one convey's roundtable uses), not Eddy
system=""                       # --system: an optional system instruction (used by the MLX roundtable)
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    -s|--say)            say=1; shift ;;
    -q|--quiet|--no-say) say=0; shift ;;
    --raw)               raw=1; say=0; shift ;;
    --voice)             voice="$2"; shift 2 ;;
    --system)            system="$2"; shift 2 ;;
    -h|--help)           sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)                   rest+=("$1"); shift ;;
  esac
done

prompt="${rest[*]:-}"
if [ -z "$prompt" ] && [ ! -t 0 ]; then prompt="$(cat)"; fi
if [ -z "$prompt" ]; then
  echo "usage: fm-mlx [--quiet] [--voice NAME] \"your prompt\"   (or pipe text in)" >&2
  exit 1
fi

body=$(python3 -c 'import json,sys,os
sysmsg, user = sys.argv[1], sys.argv[2]
msgs = ([{"role":"system","content":sysmsg}] if sysmsg else []) + [{"role":"user","content":user}]
print(json.dumps({"messages": msgs, "max_tokens": int(os.environ.get("FM_MLX_MAX_TOKENS","4096"))}))' "$system" "$prompt")

t0=$(python3 -c 'import time; print(time.time())')
reply=$(curl -s -m 180 -X POST "$HOST/v1/chat/completions" \
  -H "Content-Type: application/json" -d "$body" \
| python3 -c '
import sys, json
raw = sys.stdin.read()
if not raw.strip():
    sys.exit("fm-mlx: no response — is the MLX server up on the Mini? (first call after a reboot waits ~30s for model load)")
try:
    d = json.loads(raw)
    print(d["choices"][0]["message"]["content"])
except Exception:
    sys.exit("fm-mlx: unexpected response:\n" + raw[:500])
') || exit 1
rt=$(python3 -c "import time; print(f'{time.time()-$t0:.1f}')")

# Output mode — behave like a proper Unix tool:
#   • --raw, OR stdout is NOT a terminal (piped into a program) → RAW reply text only.
#     A program reading fm-mlx (fm-chat --mlx, convey roundtable, any subprocess) must
#     never get the "fm ›" label or [host · round-trip] stats leaking into its data.
#   • interactive terminal → present(): rich-markdown render + speak, in ONE call.
if [ "$raw" -eq 1 ] || [ ! -t 1 ]; then
  printf '%s\n' "$reply"
else
  # Decide whether to speak: --say forces, --quiet/--raw mute, auto = speak on a TTY.
  nospeak="--no-speak"
  case "$say" in
    1) nospeak="" ;;
    auto) [ -t 1 ] && nospeak="" ;;
  esac
  host="${HOST#*://}"; host="${host%%:*}"
  # The ONE shared "show a reply" call (bin/fm_render.py --present): rich markdown
  # + karaoke speech in the premium voice. fm-mlx no longer re-rolls render or speak.
  printf '%s\n' "$reply" | python3 "$HERE/fm_render.py" --present \
    --host "$host" --model "MLX/Qwen3-4B" --rt "$rt" --voice "$voice" $nospeak
fi
