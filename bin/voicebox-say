#!/usr/bin/env python3
"""voicebox-say — speak text aloud through the LOCAL Voicebox (Kokoro/Heart),
the same engine and voice as the Claude Code Stop hook. This is the ONE "Claude
talks" speaker for the fm-chat / fm-mlx family — NOT macOS `say`/say-karaoke (the
"1980s robot" voice Esa doesn't want).

    echo "hello" | voicebox-say          # read text from stdin
    voicebox-say "hello"                 # or pass it as an argument
    voicebox-say --profile Heart "..."   # override the voice profile

Behavior, on purpose:
  • Honors the global speak switch (~/.config/voicebox/speak.state == "off" → silent).
  • Silent no-op if the Voicebox server isn't up (never blocks the caller).
  • Plays in the FOREGROUND so the parent can stop it with a single Ctrl-C / SIGTERM.
  • Writes its afplay PID to /tmp/voicebox-speak.pid — the SAME file the Stop hook,
    `/voiceboxstop`, and the ⇧⌥⌘. hotkey use, so all the existing stop paths also
    stop fm-chat's speech.
  • Ctrl-C / SIGTERM stops playback cleanly and exits 0.

DRY: reuses fm_render.md_to_plain for markdown→speech-text (same as fm-chat/fm-mlx).
FEATURE-CARD >> features/arm-apple-skill.feature
"""
import json
import os
import signal
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
try:
    from fm_render import md_to_plain
except Exception:
    def md_to_plain(t):  # minimal fallback if fm_render isn't importable
        return t

VB = os.environ.get("VOICEBOX_ENDPOINT", "http://127.0.0.1:17493")
PROFILE = os.environ.get("VOICEBOX_PROFILE", "Heart")
ENGINE = os.environ.get("VOICEBOX_ENGINE", "kokoro")
MAX_CHARS = 1500
PID_FILE = "/tmp/voicebox-speak.pid"
AUDIO_FILE = "/tmp/voicebox-say.wav"
SPEAK_STATE_FILE = os.path.expanduser("~/.config/voicebox/speak.state")

_player = None  # the afplay Popen, so the signal handler can stop it


def speech_enabled():
    try:
        with open(SPEAK_STATE_FILE) as f:
            return f.read().strip().lower() != "off"
    except OSError:
        return True


def _stop_and_exit(*_):
    global _player
    if _player and _player.poll() is None:
        try:
            os.killpg(os.getpgid(_player.pid), signal.SIGTERM)
        except Exception:
            try:
                _player.terminate()
            except Exception:
                pass
    sys.exit(0)


def http_json(method, path, body=None, timeout=10):
    req = urllib.request.Request(VB + path, method=method)
    data = json.dumps(body).encode() if body is not None else None
    if data is not None:
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, data=data, timeout=timeout) as r:
        return json.loads(r.read())


def main():
    text = " ".join(sys.argv[1:]) if len(sys.argv) > 1 and not sys.argv[1].startswith("--") else ""
    # --profile passthrough
    if "--profile" in sys.argv:
        i = sys.argv.index("--profile")
        global PROFILE
        if i + 1 < len(sys.argv):
            PROFILE = sys.argv[i + 1]
        text = " ".join(a for j, a in enumerate(sys.argv[1:], 1)
                        if j not in (i, i + 1))
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read()
    text = md_to_plain(text or "").strip()
    if not text:
        return 0

    if not speech_enabled():
        return 0
    try:                                       # bail fast if server is down
        urllib.request.urlopen(VB + "/health", timeout=1).read()
    except Exception:
        return 0

    if len(text) > MAX_CHARS:
        text = text[:MAX_CHARS] + " ... (truncated for speech)"

    try:
        resp = http_json("POST", "/speak", {"text": text, "profile": PROFILE, "engine": ENGINE})
    except Exception:
        return 0
    gen_id = resp.get("id")
    if not gen_id:
        return 0

    deadline = time.time() + 120
    completed = False
    while time.time() < deadline and not completed:
        try:
            with urllib.request.urlopen(f"{VB}/generate/{gen_id}/status", timeout=5) as r:
                for raw in r:
                    line = raw.decode().strip()
                    if line.startswith("data:"):
                        ev = json.loads(line[5:].strip())
                        if ev.get("status") == "completed":
                            completed = True
                            break
                        if ev.get("status") == "failed":
                            return 0
        except Exception:
            pass
        if not completed:
            time.sleep(1)
    if not completed:
        return 0

    try:
        urllib.request.urlretrieve(f"{VB}/audio/{gen_id}", AUDIO_FILE)
    except Exception:
        return 0

    global _player
    _player = subprocess.Popen(["afplay", AUDIO_FILE],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               start_new_session=True)
    try:
        with open(PID_FILE, "w") as f:
            f.write(str(_player.pid))
    except OSError:
        pass
    _player.wait()                              # foreground → parent's Ctrl-C reaches us
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGINT, _stop_and_exit)
    signal.signal(signal.SIGTERM, _stop_and_exit)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        _stop_and_exit()
