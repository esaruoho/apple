#!/usr/bin/env bash
# REPORT-CARD >> features/icdcopy.feature
set -u
set -o pipefail

usage() {
  cat <<'USAGE'
Usage:
  icdcopy SOURCE DESTINATION_FOLDER
  icdcopy N

Copies an iCloud Drive file or folder to DESTINATION_FOLDER with resumable rsync,
then verifies the copied tree with a checksum dry-run.
If SOURCE is a number, it resolves to that row from the latest `icdsizefolder` list
and copies it to the current directory.

Examples:
  icdcopy "082_HLER itis 2022-07-09 Project" "/Volumes/T9/iCloudDrive AbletonCloud"
  icdcopy "/path/to/file.wav" "/Volumes/T9/iCloudDrive AbletonCloud"
  cd "/Volumes/T9/iCloudDrive AbletonCloud" && icdcopy 5

Notes:
  - This never deletes the source.
  - iCloud downloads wait without a timeout; use Ctrl-C if you want to stop.
  - If copy is interrupted, rerun the same command to resume.
  - A clean verification prints "VERIFY OK".
USAGE
}

die() {
  printf 'icdcopy: %s\n' "$*" >&2
  exit 1
}

normalize_path_arg() {
  local path=$1
  local candidate

  [[ -e "$path" ]] && {
    printf '%s\n' "$path"
    return
  }

  candidate=$path
  candidate=${candidate//\\ / }
  candidate=${candidate//\\\~/\~}
  candidate=${candidate//\\(/(}
  candidate=${candidate//\\)/)}
  candidate=${candidate//\\[/[}
  candidate=${candidate//\\]/]}
  candidate=${candidate//\\&/&}
  candidate=${candidate//\\;/;}

  if [[ -e "$candidate" || "$candidate" != "$path" ]]; then
    printf '%s\n' "$candidate"
    return
  fi

  printf '%s\n' "$path"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

resolve_manifest_index() {
  local idx=$1
  local manifest="${HOME}/.cache/icdcopy/last-folders.json"
  [[ -f "$manifest" ]] || die "no icdsizefolder mapping found. Run icdsizefolder first."
  python3 - "$manifest" "$idx" <<'PY'
import json
import sys

manifest, raw_idx = sys.argv[1], sys.argv[2]
try:
    idx = int(raw_idx)
except ValueError:
    sys.exit(f"icdcopy: not a numeric icdsizefolder index: {raw_idx}")

with open(manifest, "r", encoding="utf-8") as f:
    data = json.load(f)

for entry in data.get("entries", []):
    if entry.get("index") == idx:
        print(entry["path"])
        sys.exit(0)

count = len(data.get("entries", []))
sys.exit(f"icdcopy: index {idx} not in latest icdsizefolder mapping (1..{count})")
PY
}

if [[ $# -eq 1 && "${1:-}" =~ ^[0-9]+$ ]]; then
  src=$(resolve_manifest_index "$1")
  dest_root=$(pwd -P)
elif [[ $# -eq 2 && "${1:-}" =~ ^[0-9]+$ ]]; then
  src=$(resolve_manifest_index "$1")
  dest_root=$(normalize_path_arg "${2%/}")
elif [[ $# -eq 2 ]]; then
  src=$(normalize_path_arg "${1%/}")
  dest_root=$(normalize_path_arg "${2%/}")
else
  usage >&2
  exit 64
fi

[[ -e "$src" ]] || die "source does not exist: $src"

rsync_bin="/opt/homebrew/bin/rsync"
if [[ ! -x "$rsync_bin" ]]; then
  rsync_bin=$(command -v rsync 2>/dev/null || true)
fi
[[ -n "${rsync_bin:-}" && -x "$rsync_bin" ]] || die "rsync not found"

rsync_version=$("$rsync_bin" --version | sed -n '1p')
if ! printf '%s\n' "$rsync_version" | grep -Eq 'version 3\.'; then
  die "rsync 3.x is required; found: $rsync_version"
fi

mkdir -p "$dest_root" || die "could not create destination folder: $dest_root"

src_abs=$(cd "$(dirname "$src")" && pwd -P)/$(basename "$src")
src_name=$(basename "$src")
target="$dest_root/$src_name"
verify_log=$(mktemp "${TMPDIR:-/tmp}/icdcopy-verify.XXXXXX") || die "mktemp failed"
trap 'rm -f "$verify_log"' EXIT
materialize_needed=1
rsync_common=(
  -aAXN
  --fileflags
  --crtimes
  --exclude=.DS_Store
  --exclude='._*'
)

printf 'icdcopy source:      %s\n' "$src_abs"
printf 'icdcopy destination: %s\n' "$target"

if [[ -d "$src" ]]; then
  logical_bytes=$(find "$src" -type f -print0 | xargs -0 stat -f '%z' 2>/dev/null | awk '{s+=$1} END {printf "%.0f", s}')
  local_kbytes=$(du -sk "$src" 2>/dev/null | awk '{print $1}')
  logical_size=$(awk -v s="${logical_bytes:-0}" 'BEGIN {printf "%.2f GiB", s/1024/1024/1024}')
  local_size=$(du -sh "$src" 2>/dev/null | awk '{print $1}')
  printf 'icdcopy logical:     %s\n' "${logical_size:-unknown}"
  printf 'icdcopy local now:   %s\n' "${local_size:-unknown}"
  if [[ "${logical_bytes:-0}" -gt 0 && "${local_kbytes:-0}" -gt 0 ]]; then
    local_bytes=$((local_kbytes * 1024))
    if [[ "$local_bytes" -ge $((logical_bytes * 95 / 100)) ]]; then
      materialize_needed=0
      printf 'icdcopy iCloud:      already local; skipping download request\n'
    fi
  fi
elif [[ -f "$src" ]]; then
  logical_bytes=$(stat -f '%z' "$src" 2>/dev/null || printf '0')
  local_kbytes=$(du -sk "$src" 2>/dev/null | awk '{print $1}')
  if [[ "${logical_bytes:-0}" -gt 0 && "${local_kbytes:-0}" -gt 0 ]]; then
    local_bytes=$((local_kbytes * 1024))
    if [[ "$local_bytes" -ge $((logical_bytes * 95 / 100)) ]]; then
      materialize_needed=0
    fi
  fi
fi

materialize_bin="/Users/esaruoho/work/apple/bin/icloud-materialize.swift"
if [[ "$materialize_needed" -eq 1 && -x "$materialize_bin" ]]; then
  printf '\n== Asking iCloud to download source files first. ==\n'
  materialize_status=0
  for materialize_attempt in 1 2; do
    "$materialize_bin" --max-wait 0 "$src"
    materialize_status=$?
    if [[ $materialize_status -eq 0 ]]; then
      break
    fi
    if [[ $materialize_status -eq 130 || $materialize_status -eq 143 ]]; then
      printf 'icdcopy: stopped during iCloud download phase. Rerun the same command to continue.\n' >&2
      exit "$materialize_status"
    fi
    printf 'icdcopy: ICLOUD DOWNLOAD INCOMPLETE (exit %d). iCloud did not make the source fully local.\n' "$materialize_status" >&2
    exit "$materialize_status"
  done
fi

printf '\n== Copying. If interrupted, rerun the same command. ==\n'
"$rsync_bin" \
  "${rsync_common[@]}" \
  --partial \
  --append-verify \
  --human-readable \
  --info=progress2 \
  "$src" "$dest_root/"
copy_status=$?

if [[ $copy_status -ne 0 ]]; then
  printf '\nicdcopy: COPY INCOMPLETE (rsync exit %d). Rerun the same command to resume.\n' "$copy_status" >&2
  exit "$copy_status"
fi

printf '\n== Verifying checksums. This can take a while on large projects. ==\n'
for attempt in 1 2 3; do
  : >"$verify_log"
  if [[ -d "$src" ]]; then
    "$rsync_bin" \
      "${rsync_common[@]}" \
      --checksum \
      --dry-run \
      --delete \
      --itemize-changes \
      "$src/" "$target/" >"$verify_log"
  else
    "$rsync_bin" \
      "${rsync_common[@]}" \
      --checksum \
      --dry-run \
      --itemize-changes \
      "$src" "$dest_root/" >"$verify_log"
  fi
  verify_status=$?

  if [[ $verify_status -ne 0 || ! -s "$verify_log" ]]; then
    break
  fi

  if [[ $attempt -lt 3 ]]; then
    printf 'icdcopy: verification found differences; repairing automatically (%d/2).\n' "$attempt" >&2
    "$rsync_bin" \
      "${rsync_common[@]}" \
      --partial \
      --append-verify \
      --human-readable \
      "$src" "$dest_root/"
    continue
  fi
done

if [[ $verify_status -ne 0 ]]; then
  printf 'icdcopy: VERIFY FAILED (rsync exit %d). Rerun the same command.\n' "$verify_status" >&2
  cat "$verify_log" >&2
  exit "$verify_status"
fi

if [[ -s "$verify_log" ]]; then
  printf 'icdcopy: VERIFY FOUND DIFFERENCES after automatic repair attempts.\n' >&2
  cat "$verify_log" >&2
  exit 2
fi

printf 'icdcopy: VERIFY OK — copied and checksum-matched.\n'
printf 'icdcopy: Source was not deleted: %s\n' "$src_abs"
