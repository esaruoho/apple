#!/usr/bin/env bash
# snap — tile windows into a non-uniform auto-sized grid.
#
# Standalone wrapper around scripts/workflows/system-events/compiled/DockSnap.scpt
# that the apple-skill, terminal, slash commands, and AppleToolbox menu all
# call into. Same engine, one source of truth.
#
# Modes
#   snap                       Tile every visible foreground app, one cell per app
#   snap <appname>             Tile <appname>'s windows in a grid (main screen)
#   snap <appname> <screen>    Tile on a specific screen (0=main, 1=second, …)
#   snap <appname> all         Distribute round-robin across every screen
#   snap --screens             List available displays with index + visible-frame
#   snap --passes N <args…>    Cap the convergence loop (default 5; early-exits)
#   snap --show [<appname>]    Report current window geometry without tiling
#                              (delegates to bin/window-frame; Goldilocks
#                              pre-pass: check before mutating).
#   snap --quiet               Suppress per-pass observation output
#
# Convergence (observation-based, since 2026-05-22):
#   bin/snap is a Goldilocks loop: after each DockSnap pass it captures
#   window-frame --json for the affected app(s) and stops as soon as two
#   consecutive snapshots show every window within ±2 px of itself. Replaces
#   the previous dumb "always run 3 passes" loop. Sequoia apps that silently
#   fail the first `set position` call still get retries — but apps with
#   stable window IDs (Safari/Mail/iTerm/…) converge in one pass and exit.
#   Pass cap (--passes) is a safety bound, not a target.
#
# See: wiki/concepts/dock-management.md for the full state of the dispatcher,
#      the System-Events positional-reference bug, and how to add more apps.

set -euo pipefail

APPLE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SCPT="$APPLE_DIR/scripts/workflows/system-events/compiled/DockSnap.scpt"

if [[ ! -f "$SCPT" ]]; then
    echo "snap: compiled script missing: $SCPT" >&2
    exit 1
fi

passes=5
quiet=0
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        --passes|-p)
            shift
            if [[ -z "${1:-}" || ! "$1" =~ ^[0-9]+$ ]]; then
                echo "snap: --passes needs a number" >&2
                exit 2
            fi
            passes="$1"
            shift
            ;;
        --screens)
            /usr/bin/swift -e 'import AppKit; print("idx\tname\tvisible-frame"); for (i, s) in NSScreen.screens.enumerated() { let v = s.visibleFrame; print("\(i)\t\(s.localizedName)\t\(Int(v.origin.x)),\(Int(v.origin.y)) \(Int(v.size.width))x\(Int(v.size.height))") }'
            exit 0
            ;;
        --show)
            shift
            exec "$APPLE_DIR/bin/window-frame" "${@}"
            ;;
        --quiet|-q)
            quiet=1
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

# AppleScript expects at most two positional args: <appname> and <screen|all>
# (or zero args = tile every visible foreground app).
osa_args=()
if [[ ${#args[@]} -ge 1 ]]; then osa_args+=("${args[0]}"); fi
if [[ ${#args[@]} -ge 2 ]]; then osa_args+=("${args[1]}"); fi

# window-frame filter: only the targeted app when one was supplied.
WF="$APPLE_DIR/bin/window-frame"
wf_args=("--json")
if [[ ${#args[@]} -ge 1 ]]; then wf_args+=("${args[0]}"); fi

# Stable-rect comparator: returns 0 if every window in $2 matches a window in
# $1 (by pid + title) within ±TOL pixels on each of x/y/w/h, AND counts match.
# Uses Python stdlib (no third-party deps).
compare_snapshots() {
    /usr/bin/python3 - "$1" "$2" <<'PY'
import json, sys
TOL = 2
a = json.loads(sys.argv[1]).get("windows", [])
b = json.loads(sys.argv[2]).get("windows", [])
if len(a) != len(b):
    sys.exit(1)
# window-frame already sorts (screen, owner, y, x). When two snapshots show
# identical rects, the sort orders match too — zip-compare works. Duplicate
# (pid,title) windows would have collided in a keyed compare.
for p, w in zip(a, b):
    for f in ("x", "y", "w", "h"):
        if abs(p[f] - w[f]) > TOL: sys.exit(1)
sys.exit(0)
PY
}

# One-line summary of a snapshot (count + per-window rect).
summarize() {
    /usr/bin/python3 - "$1" <<'PY'
import json, sys
wins = json.loads(sys.argv[1]).get("windows", [])
print(f"  {len(wins)} window(s)")
for w in wins:
    t = w["title"][:36] if w["title"] else "—"
    print(f"    [{w['owner']}] {t:36s}  {w['x']:>5},{w['y']:>5}  {w['w']:>4}x{w['h']:<4}  scr{w['screen']}  ({w['w_pct_of_visibleframe']}%x{w['h_pct_of_visibleframe']}%)")
PY
}

before_snap="$("$WF" "${wf_args[@]}")"
if (( quiet == 0 )); then
    printf 'Before:\n'
    summarize "$before_snap"
fi

prev_snap=""
final_pass=0
for ((i = 1; i <= passes; i++)); do
    /usr/bin/osascript "$SCPT" "${osa_args[@]+"${osa_args[@]}"}" >/dev/null 2>&1 || true
    sleep 0.25
    curr_snap="$("$WF" "${wf_args[@]}")"
    final_pass=$i

    if [[ -n "$prev_snap" ]] && compare_snapshots "$prev_snap" "$curr_snap"; then
        if (( quiet == 0 )); then
            printf 'Pass %d: converged (no rect moved >2 px since pass %d)\n' "$i" "$((i-1))"
        fi
        break
    fi
    if (( quiet == 0 )); then
        printf 'Pass %d: still settling…\n' "$i"
    fi
    prev_snap="$curr_snap"
done

if (( quiet == 0 )); then
    printf 'After:\n'
    summarize "$curr_snap"
fi
printf '(converged after %d pass(es); cap %d)\n' "$final_pass" "$passes"
