#!/usr/bin/env python3
"""
apple-sentiment-cache — persistent per-file sentiment store.

One JSON sidecar per source file at ~/.vault-sentiment/<sha1>.json:
  {
    "file":         absolute path,
    "source_mtime": epoch,
    "scored_at":    ISO timestamp,
    "lang":         "en" | "fi" | ... (NLLanguageRecognizer),
    "chars":        text length AFTER html-strip,
    "doc": {
      "sentences": N, "average": -0.42, "positive": P, "neutral": Z, "negative": Q,
      "min": -.99, "max": +.85
    }
  }

Strips HTML so the cache works against any mirror — Kelly's free-energy-info,
the Dutch tuks.nl mirror, etc. Re-runs are no-ops unless --rebuild or the
source mtime advanced.

Usage:
  apple-sentiment-cache --root <dir>           [--ext .md,.txt,.html]
                        [--sample N]           random sample N files
                        [--max-bytes B]        skip files larger than B (default 250000)
                        [--rebuild]            re-score everything
                        [--verbose]
"""
import hashlib, json, os, re, subprocess, sys, time, random

HOME = os.path.expanduser("~")
CACHE_DIR = f"{HOME}/.vault-sentiment"
SENT = f"{HOME}/work/apple/bin/apple-sentiment"
LANG = f"{HOME}/work/apple/bin/apple-lang"

DEFAULT_EXTS = (".md", ".txt", ".html", ".htm")
MIN_BYTES = 400
MAX_BYTES_DEFAULT = 250_000

TAG_RE = re.compile(r"<[^>]+>")
WS_RE  = re.compile(r"[ \t]+")

def strip_html(text):
    # Drop <script>/<style> blocks
    text = re.sub(r"<script\b[^>]*>.*?</script>", " ", text, flags=re.S|re.I)
    text = re.sub(r"<style\b[^>]*>.*?</style>", " ", text, flags=re.S|re.I)
    text = TAG_RE.sub(" ", text)
    # Decode a few common entities
    text = text.replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;","<").replace("&gt;",">").replace("&quot;","\"")
    text = WS_RE.sub(" ", text)
    return text


def cache_path_for(p):
    sha = hashlib.sha1(p.encode("utf-8")).hexdigest()
    return os.path.join(CACHE_DIR, sha + ".json")


def walk(root, exts, max_bytes):
    out = []
    for base, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in
                   ("node_modules","__pycache__","venv",".venv","build")]
        for fn in files:
            if not fn.lower().endswith(exts): continue
            p = os.path.join(base, fn)
            try: sz = os.path.getsize(p)
            except OSError: continue
            if sz < MIN_BYTES or sz > max_bytes: continue
            out.append((p, sz))
    return out


def score_one(path, verbose=False):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            txt = f.read()
    except OSError:
        return None
    if path.lower().endswith((".html",".htm")):
        txt = strip_html(txt)
    if len(txt) < 200: return None
    # Detect language first — apple-sentiment is English-tuned
    lang = "en"
    try:
        p = subprocess.run([LANG], input=txt[:4000], text=True,
                           capture_output=True, timeout=15)
        if p.returncode == 0:
            lang = p.stdout.strip() or "en"
    except Exception:
        pass
    try:
        p = subprocess.run([SENT, "--doc"], input=txt, text=True,
                           capture_output=True, timeout=40)
        if p.returncode != 0: return None
        d = json.loads(p.stdout.strip())
    except Exception:
        return None
    return {"lang": lang, "chars": len(txt), "doc": d}


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h","--help"):
        print(__doc__); sys.exit(0)
    root = None; sample = 0; max_bytes = MAX_BYTES_DEFAULT
    rebuild = False; verbose = False; exts = DEFAULT_EXTS
    i = 0
    while i < len(a):
        x = a[i]
        if x == "--root" and i+1 < len(a):
            root = os.path.abspath(os.path.expanduser(a[i+1])); i += 2; continue
        if x == "--sample" and i+1 < len(a): sample = int(a[i+1]); i += 2; continue
        if x == "--max-bytes" and i+1 < len(a): max_bytes = int(a[i+1]); i += 2; continue
        if x == "--rebuild": rebuild = True; i += 1; continue
        if x == "--verbose": verbose = True; i += 1; continue
        if x == "--ext" and i+1 < len(a):
            exts = tuple("." + e.strip().lstrip(".") for e in a[i+1].split(","))
            i += 2; continue
        i += 1
    if not root or not os.path.isdir(root):
        print("usage: apple-sentiment-cache --root <dir>", file=sys.stderr); sys.exit(2)
    os.makedirs(CACHE_DIR, exist_ok=True)

    files = walk(root, exts, max_bytes)
    n_total = len(files)
    if sample and n_total > sample:
        random.seed(42)
        files = random.sample(files, sample)
    n_pick = len(files)
    print(f"▸ {n_total} files under {root} (sampled {n_pick})", flush=True)

    scored = skipped = errored = 0
    t0 = time.time()
    for i, (p, sz) in enumerate(files, 1):
        cp = cache_path_for(p)
        if not rebuild and os.path.exists(cp):
            try:
                d = json.load(open(cp))
                if d.get("source_mtime", 0) >= os.path.getmtime(p):
                    skipped += 1; continue
            except Exception: pass
        r = score_one(p, verbose=verbose)
        if not r:
            errored += 1; continue
        r["file"] = p
        r["source_mtime"] = os.path.getmtime(p)
        r["scored_at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
        with open(cp, "w") as f:
            json.dump(r, f, ensure_ascii=False)
        scored += 1
        if verbose or i % 20 == 0:
            el = time.time() - t0
            eta = el / max(1,(scored or 1)) * (n_pick - i)
            print(f"  [{i}/{n_pick}] scored {scored} · skip {skipped} · err {errored}  ({el:.0f}s, eta {eta:.0f}s)", flush=True)
    print(f"\n▸ done in {time.time()-t0:.0f}s · scored {scored}, skipped {skipped}, errors {errored}", flush=True)


if __name__ == "__main__":
    main()
