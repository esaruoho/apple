#!/usr/bin/env python3
"""morning-digest — "you woke up; here's what the Mac Mini cooked up overnight."

Gathers what changed since yesterday — the 3am Readings pass, overnight commits, the
read-batch log — hands the facts to the Mini's Qwen3-4B for a short spoken briefing,
then writes today's FOLDER (markdown + a rendered .wav) and opens it. It does NOT talk
at you: 7:30am is not the hour to wake the family. Press play when you're ready.

The markdown is the point. It must explain ITSELF: what a "reading" is, what produced
it, whether anything is genuinely new, and what you can actually DO about it. A bare
count ("96 new readings") is not information.

Truth comes from `analyses/read-batch-last-run.json` — the record `convey graph
read-batch` writes about what it DECIDED (skip / append / rebuild, per lens). Before
that record existed the nightly re-read the whole corpus, so counts meant nothing; the
readings-index heuristic below is the fallback for days predating it.

    morning-digest            # build the folder (md + wav) and open it — silent
    morning-digest --speak    # also say it out loud, now
    morning-digest --no-open  # don't open the Finder window
"""
import json
import os
import subprocess
import sys
from datetime import date, timedelta
from pathlib import Path

HOME = Path.home()
ANALYSES = HOME / "work" / "convey" / "analyses"
FM_MLX = HOME / "work" / "apple" / "bin" / "fm-mlx"

today = date.today().isoformat()
recent = {today, (date.today() - timedelta(days=1)).isoformat()}
facts = []

# ── 1) The Readings pass. What did it decide, and did anything actually change? ────────
# A "reading" = one source markdown under ~/work/merlib-dump handed to the Mini's MLX,
# which extracts entities + concepts into that lens's DreamGraph. Nothing is downloaded.
run = None
runp = ANALYSES / "read-batch-last-run.json"
if runp.exists():
    try:
        run = json.loads(runp.read_text(encoding="utf-8"))
    except Exception:
        run = None
ran_last_night = bool(run) and run.get("date") in recent

# Concepts for anything actually read, pulled from the append-only journal.
idx = ANALYSES / "readings-index.jsonl"
rows = []
if idx.exists():
    for line in idx.read_text(encoding="utf-8", errors="ignore").splitlines():
        if line.strip():
            try:
                rows.append(json.loads(line))
            except Exception:
                pass
seen_before = {(r.get("realm"), r.get("source")) for r in rows if (r.get("date") or "") < min(recent)}
new_rows = [r for r in rows if r.get("date") in recent]
first_ever = [r for r in new_rows if (r.get("realm"), r.get("source")) not in seen_before]
pass_date = max((r.get("date") or "") for r in new_rows) if new_rows else ""

lenses = (run or {}).get("lenses", [])
read_n = sum(l.get("read", 0) for l in lenses)
if ran_last_night:
    checked = sum(l.get("total", 0) for l in lenses)
    left = [l["realm"] for l in lenses if l.get("action") == "skip"]
    if read_n:
        bits = []
        for l in lenses:
            if l.get("read"):
                bits.append(f"lens '{l['realm']}' ({l['action']}): {l['read']} document(s) read — "
                            f"{l.get('added', 0)} added, {l.get('changed', 0)} changed, "
                            f"{l.get('removed', 0)} removed")
        facts.append(f"the 3am Readings pass checked {checked} sources across {len(lenses)} lenses "
                     f"and read {read_n} of them because those files actually changed")
        facts += bits
        for l in lenses:
            for nm in (l.get("added_files") or [])[:6]:
                facts.append(f"newly added source in '{l['realm']}': {nm}")
    else:
        facts.append(f"the 3am Readings pass checked {checked} sources across {len(lenses)} lenses and "
                     f"found NOTHING changed, so it read nothing and left every graph untouched — "
                     f"this is the healthy quiet outcome, not a failure")
    if left:
        facts.append("lenses left untouched because their sources are unchanged: " + ", ".join(left))
elif new_rows:
    facts.append(f"no run record for last night; the most recent Readings pass was {pass_date}, when "
                 f"{len(new_rows)} documents were re-read and {len(first_ever)} were new")
else:
    facts.append("the 3am Readings pass logged nothing and left no run record")

# ── 2) Overnight commits across the working repos. ────────────────────────────────────
commits = {}
for repo in ("convey", "comms", "apple", "converse"):
    g = HOME / "work" / repo
    if (g / ".git").exists():
        try:
            out = subprocess.run(["git", "-C", str(g), "log", "--since=18 hours ago", "--oneline"],
                                 capture_output=True, text=True, timeout=10).stdout.strip()
            if out:
                commits[repo] = out.splitlines()
                facts.append(f"{repo}: {len(out.splitlines())} commits overnight")
        except Exception:
            pass

# ── 3) Nightly read-batch log tail (did it run at all?). ──────────────────────────────
log = ANALYSES / "read-batch-nightly.log"
log_tail = []
if log.exists():
    log_tail = [l for l in log.read_text(encoding="utf-8", errors="ignore").splitlines() if l.strip()][-4:]
    if log_tail:
        facts.append("nightly read-batch log: " + " / ".join(log_tail[-2:]))

blob = "Facts about what happened overnight:\n" + "\n".join(f"- {f}" for f in facts)

# ── 4) The Mini's Qwen3-4B writes the spoken briefing (its own voice — it did the work).
system = ("You are the Cloudcity Mac Mini — a warm, capable overnight assistant. Esa just woke up. "
          "In 4-6 short spoken sentences, greet him by name and tell him what you did overnight, "
          "based ONLY on the facts below. Be precise about what actually CHANGED — never imply "
          "documents were downloaded, discovered, or newly read when they were not. If nothing "
          "changed, say so plainly and without apology; a quiet night is a good outcome. "
          "Warm and brief. No markdown, no lists, no headers — just speech.")
try:
    briefing = subprocess.run([str(FM_MLX), "--raw", "--system", system, blob],
                              capture_output=True, text=True, timeout=180).stdout.strip()
except Exception:
    briefing = ""
if not briefing:
    briefing = ("Good morning, Esa. I couldn't reach my own brain this time — the MLX server may be "
                "down (try `fm-mlx hello`). Here's the raw overnight tally instead:\n" + blob)

# ── 5) The markdown that EXPLAINS ITSELF. ─────────────────────────────────────────────
L = [f"# ☕ Morning digest — {today}", "",
     "> Spoken version: the `.wav` beside this file. Press play whenever.", "",
     briefing, "", "---", "", "## What a “reading” is", "",
     "At **3am** `com.esa.readings-nightly` runs `~/work/convey/bin/nightly-readings.sh`,",
     "which calls **`convey graph read-batch`**. For each lens in `analyses/topics.json` it",
     "takes source markdown already sitting in **`~/work/merlib-dump`**, hands each file to the",
     "Mini's MLX brain, and extracts entities + concepts into that lens's **DreamGraph**",
     "(`analyses/<lens>/dream_graph.json` → `analysis.md` + `entities/*.md`).", "",
     "**Nothing is downloaded.** No papers are fetched, no sources discovered. A “reading” is",
     "*analysis of a document you already have*. To acquire new material you want `convey book`,",
     "`convey cite`, or `convey scihub` — different belts entirely.", "",
     "Since 2026-09-01 the pass is **incremental**: it sha1s every source and reads only what",
     "changed. Unchanged lens → skipped. Files added → those read, appended. Files changed or",
     "removed → that lens rebuilt, so stale nodes can't linger. **A zero here is an answer,",
     "not an absence.**", ""]

if ran_last_night:
    L += ["## Last night's pass", "",
          "| lens | sources | added | changed | removed | what it did | read |",
          "|---|---|---|---|---|---|---|"]
    for l in lenses:
        L.append(f"| {l.get('realm')} | {l.get('total', 0)} | {l.get('added', 0)} | "
                 f"{l.get('changed', 0)} | {l.get('removed', 0)} | **{l.get('action')}** | {l.get('read', 0)} |")
    L.append("")
    if read_n:
        L += [f"**{read_n} document(s) were actually read**, because those files changed on disk.", ""]
        conc = {(r.get("realm"), r.get("source")): (r.get("concepts") or []) for r in new_rows}
        for l in lenses:
            names = (l.get("added_files") or []) + (l.get("changed_files") or [])
            if names:
                L.append(f"### {l.get('realm')} — what came in")
                for nm in names:
                    cs = ", ".join(conc.get((l.get("realm"), nm), [])[:6])
                    L.append(f"- **{nm}**" + (f" · {cs}" if cs else ""))
                L.append("")
            if l.get("removed_files"):
                L += [f"*Gone from {l.get('realm')}:* " + ", ".join(l["removed_files"]), ""]
    else:
        L += ["**Nothing changed, so nothing was read.** Every lens's sources hash identically to",
              "the last time they were read; the graphs already reflect them. No MLX time spent,",
              "no files churned.", ""]
elif new_rows:
    L += [f"## The Readings pass of {pass_date} — *not last night*", "",
          "> Last night's run left no record (see the log tail below). This was the last pass that ran,",
          "> under the old behaviour that re-read the whole corpus every night.", "",
          f"{len(new_rows)} documents re-read across "
          f"{len({r.get('realm') for r in new_rows})} lenses · **{len(first_ever)} genuinely new**.", ""]
else:
    L += ["## Last night's pass", "", "No readings logged and no run record — the pass did not run.",
          "Check the log tail below; the usual cause is the Mini's MLX server being unreachable.", ""]

if commits:
    L += ["## Overnight commits", ""]
    for repo, lines in commits.items():
        L.append(f"**{repo}** — {len(lines)} commit(s)")
        L += [f"- `{c}`" for c in lines[:12]]
        if len(lines) > 12:
            L.append(f"- …and {len(lines) - 12} more")
        L.append("")

if log_tail:
    L += ["## Nightly log tail", "", "```", *log_tail, "```", ""]

# The actionable close — every digest ends with things you can DO, not things to admire.
L += ["## What you can actually do about this", ""]
if ran_last_night and read_n:
    L += ["- **Read the sources listed above** — they're the only material that moved the graph.",
          "  `open ~/work/convey/analyses/<lens>/analysis.md`"]
elif ran_last_night:
    L += ["- **Nothing here needs you.** The corpus is unchanged and the graphs already match it.",
          "  To give the pass something to chew on, feed the corpus:",
          "  `convey book <title>` · `convey cite <pdf>` · `convey scihub <doi>`",
          "- Or widen the reach: raise `max` / add `discover` terms in",
          "  `~/work/convey/analyses/topics.json` so lenses see files they currently ignore."]
else:
    L += ["- **The pass didn't run.** Check the Mini's MLX server (`fm-mlx hello`), then run it by",
          "  hand: `convey graph read-batch`"]
L += ["- See the plan without doing any work: `convey graph read-batch --dry-run`",
      "- Force a full re-read of a lens: `convey graph read-batch --only \"<lens>\" --force`",
      "- Query the catalog: `convey graph readings --realm \"<lens>\"`", ""]
L += ["---", "", "## Raw facts handed to the briefing model", "", "```", blob, "```", ""]

folder = ANALYSES / "morning-digest" / today
folder.mkdir(parents=True, exist_ok=True)
md = folder / f"morning-digest-{today}.md"
md.write_text("\n".join(L), encoding="utf-8")

voice = os.environ.get("MORNING_VOICE", "Zoe (Premium)")   # the good local voice (NOT Eddy)
wav = folder / f"morning-digest-{today}.wav"
try:                                                       # render to file, don't play it
    subprocess.run(["say", "-v", voice, "-o", str(wav),
                    "--data-format=LEI16@22050", "--", briefing], timeout=300)
except Exception:
    pass

print("\n☕ " + briefing + "\n")
print(f"   (saved → {folder})")

if "--speak" in sys.argv:                                  # opt-in: actually talk out loud
    if "--voicebox" in sys.argv:                           # the Mini's AI voice studio, if you want it
        try:
            subprocess.run([str(HOME / "work/apple/bin/voicebox-submit"),
                            "--id", f"morning-{today}", "--text", briefing,
                            "--wait", f"morning-{today}"], timeout=240)
        except Exception:
            pass
    else:
        try:
            subprocess.run(["say", "-v", voice, "--", briefing], timeout=180)
        except Exception:
            pass

if "--no-open" not in sys.argv:                            # the folder IS the interface
    try:
        subprocess.run(["open", str(folder)], timeout=20)
    except Exception:
        pass
