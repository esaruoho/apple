#!/usr/bin/env python3
"""morning-digest — "you woke up; here's what the Mac Mini cooked up overnight."

Gathers what changed since yesterday — the 3am Readings pass, overnight commits, the
read-batch log — hands the facts to the Mini's Qwen3-4B for a short spoken briefing,
then writes today's FOLDER (markdown + a rendered .wav) and opens it. It does NOT talk
at you: 7:30am is not the hour to wake the family. Press play when you're ready.

The markdown is the point. It must explain ITSELF: what a "reading" is, what produced
it, whether anything is genuinely new, and what you can actually DO about it. A bare
count ("96 new readings") is not information.

DRY: the brain is fm-mlx (--raw), the readings come from analyses/readings-index.jsonl
(written by `convey graph read-batch`, scheduled 3am by com.esa.readings-nightly), the
voice is `say`.

    morning-digest            # build the folder (md + wav) and open it — silent
    morning-digest --speak    # also say it out loud, now
    morning-digest --no-open  # don't open the Finder window
"""
import json
import os
import subprocess
import sys
from datetime import date, timedelta
from pathlib import Path

HOME = Path.home()
ANALYSES = HOME / "work" / "convey" / "analyses"
FM_MLX = HOME / "work" / "apple" / "bin" / "fm-mlx"

today = date.today().isoformat()
recent = {today, (date.today() - timedelta(days=1)).isoformat()}

# ── 1) The Readings pass: what did the 3am job actually read, and was ANY of it new? ──
# A "reading" = one source markdown under ~/work/merlib-dump handed to the Mini's MLX,
# which extracts entities + concepts into that lens's DreamGraph. Nothing is downloaded.
# read-batch wipes each lens dir and re-reads the whole corpus, so the raw count tracks
# CORPUS SIZE, not novelty. The only interesting number is first-time-ever reads.
idx = ANALYSES / "readings-index.jsonl"
rows = []
if idx.exists():
    for line in idx.read_text(encoding="utf-8", errors="ignore").splitlines():
        if line.strip():
            try:
                rows.append(json.loads(line))
            except Exception:
                pass
seen_before = {(r.get("realm"), r.get("source")) for r in rows if (r.get("date") or "") < min(recent)}
new = [r for r in rows if r.get("date") in recent]
first_ever = [r for r in new if (r.get("realm"), r.get("source")) not in seen_before]

by_realm = {}
for r in new:
    by_realm.setdefault(r.get("realm") or "?", []).append(r)

facts = []
pass_date = max((r.get("date") or "") for r in new) if new else ""
stale = bool(new) and pass_date != today          # nothing logged today = last night skipped
if new:
    when = f"on {pass_date}" + (" (NOT last night — last night's 3am run logged nothing)" if stale else " (last night)")
    facts.append(f"the Readings pass {when} re-read {len(new)} source documents across "
                 f"{len(by_realm)} lenses; {len(first_ever)} of them had never been read before")
    for realm, rs in by_realm.items():
        concepts = []
        for r in rs:
            concepts += (r.get("concepts") or [])
        top = list(dict.fromkeys(concepts))[:8]
        facts.append(f"lens '{realm}': {len(rs)} documents re-read; recurring concepts: {', '.join(top) or '—'}")
else:
    facts.append("the 3am Readings pass did not run (or logged nothing)")

# ── 2) Overnight commits across the working repos. ──
commits = {}
for repo in ("convey", "comms", "apple", "converse"):
    g = HOME / "work" / repo
    if (g / ".git").exists():
        try:
            out = subprocess.run(["git", "-C", str(g), "log", "--since=18 hours ago", "--oneline"],
                                 capture_output=True, text=True, timeout=10).stdout.strip()
            if out:
                commits[repo] = out.splitlines()
                facts.append(f"{repo}: {len(out.splitlines())} commits overnight")
        except Exception:
            pass

# ── 3) Nightly read-batch log tail (did it run at all?). ──
log = ANALYSES / "read-batch-nightly.log"
log_tail = []
if log.exists():
    log_tail = [l for l in log.read_text(encoding="utf-8", errors="ignore").splitlines() if l.strip()][-4:]
    if log_tail:
        facts.append("nightly read-batch log: " + " / ".join(log_tail[-2:]))

if not new and not commits:
    facts.append("A quiet night — nothing new in the catalog or repos since yesterday.")

blob = "Facts about what happened overnight:\n" + "\n".join(f"- {f}" for f in facts)

# ── 4) The Mini's Qwen3-4B writes the spoken briefing (its own voice — it did the work). ──
system = ("You are the Cloudcity Mac Mini — a warm, capable overnight assistant. Esa just woke up. "
          "In 4-6 short spoken sentences, greet him by name and tell him what you did overnight, "
          "based ONLY on the facts below. Be precise about what is genuinely NEW versus merely "
          "re-read — never imply documents were downloaded or discovered when they were only "
          "re-analysed. Warm and brief. No markdown, no lists, no headers — just speech.")
try:
    briefing = subprocess.run([str(FM_MLX), "--raw", "--system", system, blob],
                              capture_output=True, text=True, timeout=180).stdout.strip()
except Exception:
    briefing = ""
if not briefing:
    briefing = ("Good morning, Esa. I couldn't reach my own brain this time — the MLX server may be "
                "down (try `fm-mlx hello`). Here's the raw overnight tally instead:\n" + blob)

# ── 5) Build the markdown that EXPLAINS ITSELF. ──
L = [f"# ☕ Morning digest — {today}", "",
     "> Spoken version: the `.wav` beside this file. Press play whenever.", "",
     briefing, "", "---", "", "## What a “reading” is", "",
     "At **3am** `com.esa.readings-nightly` runs `~/work/convey/bin/nightly-readings.sh`,",
     "which calls **`convey graph read-batch`**. For each lens in `analyses/topics.json` it",
     "picks source markdown files already sitting in **`~/work/merlib-dump`**, hands each one",
     "to the Mini's MLX brain, and extracts entities + concepts into that lens's **DreamGraph**",
     "(`analyses/<lens>/dream_graph.json` → `analysis.md` + `entities/*.md`).", "",
     "**Nothing is downloaded.** No papers are fetched, no new sources appear. A “reading” is",
     "*re-analysis of a document you already have*. To actually acquire new material you want",
     "`convey book`, `convey cite`, or `convey scihub` — different belts entirely.", ""]

if new:
    L += [f"## The Readings pass of {pass_date}" + (" — *not last night*" if stale else ""), ""]
    if stale:
        L += ["> Last night's 3am run logged no readings (see the log tail below — the MLX",
              "> server was likely unreachable). What follows is the most recent pass that did run.", ""]
    L += [
          "| lens | documents read | first time ever | nodes | edges | report |",
          "|---|---|---|---|---|---|"]
    for realm, rs in sorted(by_realm.items()):
        fe = len([r for r in rs if (r.get("realm"), r.get("source")) not in seen_before])
        nodes = max([r.get("nodes") or 0 for r in rs] or [0])
        edges = max([r.get("edges") or 0 for r in rs] or [0])
        rep = rs[0].get("report") or ""
        L.append(f"| {realm} | {len(rs)} | **{fe}** | {nodes} | {edges} | [`analysis.md`]({rep}) |")
    L += ["", f"**{len(first_ever)} of {len(new)} documents were genuinely new.**", ""]
    if not first_ever:
        L += ["`read-batch` deletes each lens folder and re-reads the whole corpus every night,",
              "so the document count tracks **how big the corpus is**, not what arrived. Last night",
              "added no material — it rebuilt the same graphs from the same files.", "",
              "*Side effect worth knowing:* that nightly wipe is why `git status` in convey shows",
              "hundreds of deleted/untracked `analyses/**/entities/*.md`. It's churn, not loss.", ""]
    else:
        L += ["### Genuinely new sources — the only list worth your attention", ""]
        for r in first_ever:
            cs = ", ".join((r.get("concepts") or [])[:6])
            L.append(f"- **{r.get('source')}** — *{r.get('realm')}* · {cs}")
        L.append("")

if commits:
    L += ["## Overnight commits", ""]
    for repo, lines in commits.items():
        L.append(f"**{repo}** — {len(lines)} commit(s)")
        L += [f"- `{c}`" for c in lines[:12]]
        if len(lines) > 12:
            L.append(f"- …and {len(lines) - 12} more")
        L.append("")

if log_tail:
    L += ["## Nightly log tail", "", "```", *log_tail, "```", ""]

# The actionable close — every digest ends with things you can DO, not things to admire.
L += ["## What you can actually do about this", ""]
if first_ever:
    L += [f"- **Read the {len(first_ever)} new source(s) above** — they're the only material that",
          "  changed the graph. Open the lens report and see where they attached.",
          "  `convey graph open \"<lens>\"`"]
else:
    L += ["- **Nothing here needs you.** No new material arrived; last night was a rebuild.",
          "  If you want new material *into* the lenses, feed the corpus first:",
          "  `convey book <title>` · `convey cite <pdf>` · `convey scihub <doi>` — then the",
          "  3am pass will pick it up.",
          "- **If the nightly count never changes, that's the signal**: `read-batch` is re-reading",
          "  a static corpus. Either add sources, or widen the `discover` terms / raise `max` in",
          "  `~/work/convey/analyses/topics.json` so it reaches files it currently ignores."]
L += ["- Browse a lens: `open ~/work/convey/analyses/<lens>/analysis.md`",
      "- See the whole catalog: `convey ledger` · re-run a single lens now:",
      "  `convey graph read-batch --only \"<lens>\"`", ""]
L += ["---", "", "## Raw facts handed to the briefing model", "", "```", blob, "```", ""]

folder = ANALYSES / "morning-digest" / today
folder.mkdir(parents=True, exist_ok=True)
md = folder / f"morning-digest-{today}.md"
md.write_text("\n".join(L), encoding="utf-8")

voice = os.environ.get("MORNING_VOICE", "Zoe (Premium)")   # the good local voice (NOT Eddy)
wav = folder / f"morning-digest-{today}.wav"
try:                                                       # render to file, don't play it
    subprocess.run(["say", "-v", voice, "-o", str(wav),
                    "--data-format=LEI16@22050", "--", briefing], timeout=300)
except Exception:
    pass

print("\n☕ " + briefing + "\n")
print(f"   (saved → {folder})")

if "--speak" in sys.argv:                                  # opt-in: actually talk out loud
    if "--voicebox" in sys.argv:                           # the Mini's AI voice studio, if you want it
        try:
            subprocess.run([str(HOME / "work/apple/bin/voicebox-submit"),
                            "--id", f"morning-{today}", "--text", briefing,
                            "--wait", f"morning-{today}"], timeout=240)
        except Exception:
            pass
    else:
        try:
            subprocess.run(["say", "-v", voice, "--", briefing], timeout=180)
        except Exception:
            pass

if "--no-open" not in sys.argv:                            # the folder IS the interface
    try:
        subprocess.run(["open", str(folder)], timeout=20)
    except Exception:
        pass
