#!/usr/bin/env python3
"""paketti-spine-report — run the Paketti harness and write the TRUE spine report.

Runs bin/paketti-harness.lua under luajit (Paketti's real registration code, mocked
Renoise), then writes ~/.paketti-spine/SPINE-TRUE.md + spine-true.json: every place
Paketti touches Renoise, loop-expanded and validated against Paketti's OWN runtime
counters, plus the robust-vs-brittle file map.
"""
import json
import shutil
import subprocess
import sys
from pathlib import Path

# The spine lives in the Paketti repo (.spine/), not here. It used to be duplicated:
# a harness copy in this folder and outputs in ~/.paketti-spine, which silently drifted
# from the repo's own (the repo's harness was a day newer and slightly different).
# Resolve the repo first; fall back to the old home dotdir so nothing breaks mid-migration.
_REPO_SPINE = Path("/Users/esaruoho/work/paketti/.spine")
SPINE_DIR = _REPO_SPINE if _REPO_SPINE.is_dir() else Path.home() / ".paketti-spine"

HERE = Path(__file__).resolve().parent
HARNESS = SPINE_DIR / "harness.lua"
PAKETTI = "/Users/esaruoho/work/paketti"
OUT = SPINE_DIR
JSON = OUT / "spine-true.json"


def run_harness():
    luajit = shutil.which("luajit") or shutil.which("lua")
    if not luajit:
        sys.exit("paketti-spine-report: need luajit (brew install luajit)")
    OUT.mkdir(parents=True, exist_ok=True)
    r = subprocess.run([luajit, str(HARNESS), PAKETTI, str(JSON)],
                       capture_output=True, text=True, timeout=180)
    if not JSON.exists():
        sys.exit(f"harness produced no output.\n{r.stderr[:500]}")
    return json.loads(JSON.read_text())


# Renoise GUI regions vs the global/MIDI buckets, for grouping in the report.
GROUPS = {
    "Song & pattern": ["PatternEditor", "PatternMatrix", "PatternSequencer",
                       "PhraseEditor", "PhraseGrid", "PhraseMappings"],
    "Samples & instruments": ["SampleEditor", "SampleEditorRuler", "SampleNavigator",
                              "InstrumentBox", "SampleKeyzone", "SampleFXMixer",
                              "SampleModulationMatrix"],
    "Mixing, FX & automation": ["Mixer", "TrackDSPDevice", "TrackDSPChain",
                                "Automation", "TrackAutomationList", "DSPDeviceAutomation"],
    "Files": ["DiskBrowserFiles"],
    "Menus & global": ["MainMenuTools", "MainMenuView", "MainMenuFile", "Global", "Paketti"],
}


def main():
    d = run_harness()
    t, u = d["totals"], d["unique"]
    regions = d["regions"]
    files = d["files"]
    psc = d.get("paketti_self_counts", {})
    nloaded = d["file_stats"]["loaded"]
    nbad = d["file_stats"]["errored"]
    ntot = d["file_stats"]["total"]
    grand = u["keybinding"] + u["menu_entry"] + u["midi_mapping"]

    md = []
    md.append("# Paketti — the TRUE spine (from the running code)")
    md.append("")
    md.append("*Captured by executing Paketti's own registration code under a mocked "
              "Renoise (`paketti-harness.lua`) — for-loops expanded, concatenation resolved, "
              "wrappers honoured. NOT from stale XML or a text scan.*")
    md.append("")
    md.append("## Headline: where Paketti touches Renoise")
    md.append("")
    md.append(f"- **{grand:,} unique registration points** total")
    md.append(f"  - **{u['keybinding']:,} keyboard shortcuts**")
    md.append(f"  - **{u['menu_entry']:,} menu entries**")
    md.append(f"  - **{u['midi_mapping']:,} MIDI mappings**")
    md.append("")
    md.append(f"**Validation:** Paketti's *own* runtime counters say "
              f"{psc.get('keybindings', 0):,} keybindings / {psc.get('midi_mappings', 0):,} MIDI / "
              f"{psc.get('menu_tally_total', 0):,} menus — matching the harness within a handful. "
              f"The numbers are real.")
    md.append("")
    md.append("**For contrast:** the stale `KeyBindings.xml` (2025-07) shows ~8,383 keybindings; "
              "a text scan of the source shows ~2,935. The code registers ~3–4× more than either — "
              "because of the for-loops. *This* is the only count that's true.")
    md.append("")
    md.append("## Where the features live (Renoise regions, by Paketti's own taxonomy)")
    md.append("")
    md.append("| Region | shortcuts | menus | MIDI | total |")
    md.append("|---|--:|--:|--:|--:|")
    for grp, keys in GROUPS.items():
        md.append(f"| **{grp}** | | | | |")
        rows = [(k, regions[k]) for k in keys if k in regions]
        for k, c in sorted(rows, key=lambda x: -(x[1]["keybinding"] + x[1]["menu_entry"] + x[1]["midi_mapping"])):
            tot = c["keybinding"] + c["menu_entry"] + c["midi_mapping"]
            md.append(f"| &nbsp;&nbsp;{k} | {c['keybinding']:,} | {c['menu_entry']:,} | {c['midi_mapping']:,} | {tot:,} |")
    # any region not in GROUPS
    other = [(r, c) for r, c in regions.items() if not any(r in v for v in GROUPS.values())]
    if other:
        md.append("| **Other / uncategorized** | | | | |")
        for r, c in sorted(other, key=lambda x: -(x[1]["keybinding"] + x[1]["menu_entry"] + x[1]["midi_mapping"])):
            tot = c["keybinding"] + c["menu_entry"] + c["midi_mapping"]
            md.append(f"| &nbsp;&nbsp;{r} | {c['keybinding']:,} | {c['menu_entry']:,} | {c['midi_mapping']:,} | {tot:,} |")
    md.append("")
    md.append("*(MIDI mappings are named `Paketti:…` without a GUI region, so they bucket under "
              "Global/Paketti — they fire regardless of focus.)*")
    md.append("")
    md.append(f"## Robustness: {nloaded}/{ntot} files load clean, {nbad} brittle")
    md.append("")
    md.append(f"**Robust ({nloaded}):** loaded and registered without error under the harness.")
    md.append("")
    if nbad:
        md.append(f"**Brittle ({nbad}):** errored during the harness run. Most are the *mock's* "
                  "limits (a stub stand-in reached a stdlib call), not necessarily real Paketti "
                  "bugs — but each is a file that does something unusual at load time worth a look:")
        md.append("")
        for f in files:
            if not f["ok"]:
                md.append(f"- **{f['module']}** — `{f.get('err','')[:140]}`")
    md.append("")
    md.append("## How to regenerate")
    md.append("```")
    md.append("paketti-spine-report      # runs the harness + rewrites this file")
    md.append("```")
    md.append("Mechanism: `bin/paketti-harness.lua` (LuaJIT, mocked Renoise) → `spine-true.json`.")

    text = "\n".join(md)
    (OUT / "SPINE-TRUE.md").write_text(text)
    # Also drop it in the Paketti repo's docs/ — useful Paketti documentation.
    try:
        (Path(PAKETTI) / "docs").mkdir(exist_ok=True)
        (Path(PAKETTI) / "docs" / "SPINE-TRUE.md").write_text(text)
    except Exception:
        pass
    print(f"wrote {OUT}/SPINE-TRUE.md  +  {PAKETTI}/docs/SPINE-TRUE.md")
    print(f"  {grand:,} registration points "
          f"({u['keybinding']:,} shortcuts · {u['menu_entry']:,} menus · {u['midi_mapping']:,} MIDI)")
    print(f"  {nloaded}/{ntot} files robust · {nbad} brittle")
    return 0


if __name__ == "__main__":
    sys.exit(main())
