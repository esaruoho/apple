#!/usr/bin/env python3
"""secret-scan — refuse to commit an account id, bank last-4, key or token.

This exists because the tool built to hide a bank last-4 from a screencast shipped that
exact last-4 in its own --help output, to a PUBLIC repo, along with the bank's name and a
live Stripe account id — and nobody noticed until it was asked about, days later. A
scrubbed working tree does not un-publish anything; the only fix that works is not
committing it in the first place.

The patterns are NOT redefined here. They are imported from bin/recburn-redact, which
already knows how to spot exactly these things in a video frame. One definition, two
consumers: the redactor looks at pixels, this looks at diffs.

    secret-scan                # scan what is staged (what the hook does)
    secret-scan --all          # scan every tracked file
    secret-scan FILE [FILE…]   # scan specific files

Exit 0 = clean, 1 = something found, 2 = could not run.

Allowing a deliberate example:
  • add `secret-scan: allow` on the same line, or
  • list a path glob in .secret-scan-allow (one per line, # comments ok)
A blanket escape hatch still exists — `git commit --no-verify` — but it should feel like
a decision, not a default.
"""
import fnmatch
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys

ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                      capture_output=True, text=True).stdout.strip() or os.getcwd()
ALLOW_MARK = "secret-scan: allow"

# Two of recburn-redact's patterns are right for a VIDEO and wrong for a REPO:
#
#   email          — a repo legitimately contains addresses: Esa's own published contact,
#                    example.com samples, git@github.com. It also false-positives on
#                    "icon_16x16@2x.png". On screen someone else's address is an
#                    exposure; in a source tree it is just text.
#   password-label — matches the string "Password:" in a UI prompt, not a password.
#
# Including them produced 150+ hits on a clean tree. A hook that blocks every commit is
# bypassed on the first day and then protects nothing, so the noisy ones are dropped and
# what stays is the credential-shaped set: account ids, keys, tokens, cards, IBANs,
# masked account digits, private keys.
HOOK_EXCLUDE = {"email", "password-label"}

# Binary and generated things a text scan has no business reading.
SKIP_EXT = {".png", ".jpg", ".jpeg", ".gif", ".pdf", ".mov", ".mp4", ".m4a", ".wav",
            ".zip", ".icns", ".ico", ".woff", ".woff2", ".ttf", ".webp", ".heic"}


def load_patterns():
    """Reuse recburn-redact's PATTERNS rather than keeping a second copy in sync."""
    src = os.path.join(ROOT, "bin", "recburn-redact")
    if not os.path.exists(src):
        return None
    try:
        loader = importlib.machinery.SourceFileLoader("_rr", src)
        spec = importlib.util.spec_from_loader("_rr", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return [p for p in mod.PATTERNS if p[0] not in HOOK_EXCLUDE]
    except Exception as e:                                    # noqa: BLE001
        print(f"secret-scan: could not import patterns from {src}: {e}", file=sys.stderr)
        return None


def allowed_paths():
    p = os.path.join(ROOT, ".secret-scan-allow")
    out = []
    if os.path.exists(p):
        for line in open(p):
            line = line.split("#", 1)[0].strip()
            if line:
                out.append(line)
    return out


def staged_files():
    r = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                       capture_output=True, text=True)
    return [f for f in r.stdout.splitlines() if f.strip()]


def all_files():
    r = subprocess.run(["git", "ls-files"], capture_output=True, text=True)
    return [f for f in r.stdout.splitlines() if f.strip()]


def staged_text(path):
    """The STAGED content, not the working tree — they can differ, and what gets
    committed is what matters."""
    r = subprocess.run(["git", "show", f":{path}"], capture_output=True)
    if r.returncode != 0:
        return None
    try:
        return r.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None


def scan(paths, patterns, allow, read):
    hits = []
    for path in paths:
        if os.path.splitext(path)[1].lower() in SKIP_EXT:
            continue
        # `git ls-files` can name a submodule/gitlink, which is a directory on disk.
        full = os.path.join(ROOT, path)
        if os.path.isdir(full):
            continue
        if any(fnmatch.fnmatch(path, g) for g in allow):
            continue
        text = read(path)
        if text is None:
            continue
        for n, line in enumerate(text.splitlines(), 1):
            if ALLOW_MARK in line:
                continue
            for name, rx, redact in patterns:
                for m in re.finditer(rx, line):
                    s = m.group(0).strip()
                    shown = (s[:6] + "…" + f"[{len(s)} chars]") if redact else s
                    hits.append((path, n, name, shown))
    return hits


def main():
    args = sys.argv[1:]
    patterns = load_patterns()
    if patterns is None:
        print("secret-scan: no patterns available — NOT blocking the commit", file=sys.stderr)
        return 0

    allow = allowed_paths()
    if args and args[0] == "--all":
        paths, read = all_files(), lambda p: (open(os.path.join(ROOT, p), encoding="utf-8",
                                                   errors="ignore").read()
                                              if os.path.exists(os.path.join(ROOT, p)) else None)
    elif args:
        paths, read = args, lambda p: (open(p, encoding="utf-8", errors="ignore").read()
                                       if os.path.exists(p) else None)
    else:
        paths, read = staged_files(), staged_text

    hits = scan(paths, patterns, allow, read)
    if not hits:
        return 0

    print("", file=sys.stderr)
    print("╭─ secret-scan: refusing this commit ─────────────────────────────────", file=sys.stderr)
    for path, n, name, shown in hits:
        print(f"│  {path}:{n}", file=sys.stderr)
        print(f"│      {name}: {shown}", file=sys.stderr)
    print("│", file=sys.stderr)
    print("│  If it is a deliberate example, put an obviously-fake value in it,", file=sys.stderr)
    print(f"│  or add `{ALLOW_MARK}` on that line, or glob the path in", file=sys.stderr)
    print("│  .secret-scan-allow. Committing it and scrubbing later does NOT", file=sys.stderr)
    print("│  un-publish it — the value stays in history and in every clone.", file=sys.stderr)
    print("╰─────────────────────────────────────────────────────────────────────", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
