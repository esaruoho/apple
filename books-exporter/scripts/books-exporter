#!/usr/bin/env bash
# books-exporter — symlink-safe wrapper
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    d="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$d/$src"
done
SCRIPT_DIR="$(cd "$(dirname "$src")" && pwd)"
exec "${PYTHON:-python3}" "$SCRIPT_DIR/books_exporter.py" "$@"
