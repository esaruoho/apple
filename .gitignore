# ─── Private (local-only, not pushed) ───
# Personal bash profile extract — contains Ray-specific aliases and paths
wiki/entities/bash-aliases.md

# Report-card bundled session transcripts — the FULL spawning conversation is
# bundled BESIDE each card (for fm-converse) but stays local; the repo is public
# and transcripts carry personal/infra context. Curated *.session.md IS committed.
features/*.transcript.jsonl
features/*.transcript.md

# Generated whiteboards — large PNGs, personal learning material
whiteboards/

# macOS junk
.DS_Store
**/.DS_Store

# Extracted app icons — regenerable via bin/extract-icons.sh
icons/

# Raw sdef XML (large, regenerable via bin/sdef-extract.py)
dictionaries/**/*.sdef.xml
shortcuts/

# GitHub Watcher — private runtime data
github-watcher/.state/
github-watcher/logs/
github-watcher/repos.json

# Python cache
__pycache__/
bin/__pycache__/
**/__pycache__/

