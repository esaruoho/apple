# ─── Local export vaults — generated by the export packages ───
# Each user runs `<package>-export export` to populate their own vault.
# Vault content stays local; only the README lands in git.
exported/*
!exported/README.md

# Compiled Swift binaries (regenerable via swiftc on first use)
bin/sal-take-photo
bin/sal-qr

# Per-machine exporter target paths (VAULT_PATH)
*-exporter/.env
# Built menu-bar app + Finder-toolbar drop-target wrappers
topbar/AppleToolbox.app/
topbar/AppleToolboxDrop.app/
topbar/CloudcityOCRDrop.app/

# Per-machine Claude Code permission allowlist
.claude/settings.local.json

# stickies-claude watcher runtime state (per-note content hashes)
state/stickies-claude/
bin/.apple-names.cache

# Generated artifacts from bin/apple-report (one-off machine stack reports)
analysis/apple-report-*.stack.txt
analysis/apple-report-*.json

# Runtime log dir (worker stdout, etc.)
var/

# Fleet build artifact (rebuilt via fleet/build.sh)
fleet/Fleet.app/

# FoundationModelsChat build artifact (rebuilt via FoundationModelsChat/build.sh)
FoundationModelsChat/build/
.minilm-venv/
models/
*.mlpackage

# ApplePanel build artifact (rebuilt via /apple-panel-app)
panel-app/ApplePanel.app/

# Runtime scratch / locks
.claude/scheduled_tasks.lock
.ocrloop.txt

# Convey bundles the full session transcript beside each IMPORTED principle too —
